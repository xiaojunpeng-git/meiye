[Unit]
Description=Mohe AI dedicated execution worker (%i)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=@APP_ROOT@
ExecStart=@PHP_BIN@ think mohe-ai:execution-worker --sleep=1
Restart=always
RestartSec=5
TimeoutStopSec=35
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mohe-ai-execution-worker-%i

[Install]
WantedBy=multi-user.target
