[Unit]
Description=Mohe AI current member-rights index refresh
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=@APP_ROOT@
ExecStart=@PHP_BIN@ think mohe-ai:rights-index --tenant=@TENANT@
Restart=always
RestartSec=5
TimeoutStopSec=35
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mohe-ai-rights-index

[Install]
WantedBy=multi-user.target
