[Unit]
Description=Mohe AI durable execution supervisor
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=@APP_ROOT@
ExecStart=@PHP_BIN@ think mohe-ai:supervise --watch
Restart=always
RestartSec=5
TimeoutStopSec=35
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mohe-ai-supervisor

[Install]
WantedBy=multi-user.target
