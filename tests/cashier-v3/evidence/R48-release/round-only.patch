+<?php
+declare(strict_types=1);
+
+// Local-only transactional fixtures. DDL is idempotent; every business row rolls back.
+$backend = getenv('CASHIER_V3_BACKEND') ?: '/var/www/html';
+require $backend . '/vendor/autoload.php';
