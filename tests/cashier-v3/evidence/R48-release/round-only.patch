+    $reject(static fn() => $issuer->saveCoupon($badRule, (int)$savedRule['id'], 0), 'issued face is immutable across editors');
+} finally { Db::rollback(); }
+echo 'R48_ALLOWANCE_MYSQL passed=' . $passed . "\n";
