+    $later = $pay($base + 10, $a, $start, 120000); $reverse($later, $end, 30000, 'refund');
+    $voided = $pay($base + 11, $a, $start, 120000); $reverse($voided, $end, 120000, 'void');
+
+    $detail = $query('market_detail', ['_internal_all' => true]);
