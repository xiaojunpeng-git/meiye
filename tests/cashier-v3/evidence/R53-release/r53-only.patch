+        {
+            $query = self::$pdo->prepare('SELECT COUNT(*) AS n FROM sqlite_master WHERE type=? AND name=?');
+            $query->execute(['table', $parameters[0]]);
+            return $query->fetchAll(\PDO::FETCH_ASSOC);
