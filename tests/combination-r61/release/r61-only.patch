@@ -0,0 +1,62 @@
+<?php
+declare(strict_types=1);
+namespace app\services\activity\combination;
+
+use think\exception\ValidateException;
+use think\facade\Db;
+
+/** Participant grain is shared by detail and export. Virtual seats never impersonate paying members. */
+class CombinationRecordServices
+{
+    public const HEADERS = ['门店名称','会员编号','会员姓名','手机号码','拼团编号','拼团名称','支付金额',
+        '拼团总数','参加人数','状态','是否团长','支付时间','过期时间','订单号','序号','支付状态'];
+    public const KEYS = ['store_name','member_no','member_name','phone','group_no','group_name','paid_amount',
+        'target_people','joined_people','group_status','leader_role','paid_at','expires_at','order_id','participant_no','payment_status'];
+
+    public function rows(int $groupId): array
+    {
+        $root = Db::name('store_pink')->where('id', $groupId)->where('k_id', 0)->find();
+        if (!$root) throw new ValidateException('拼团不存在');
+        $origin = Db::name('combination_group_origin')->where('group_id', $groupId)->find();
+        $rows = Db::name('store_pink')->alias('p')
+            ->leftJoin('store_order o', 'o.id=p.order_id_key')->leftJoin('user u', 'u.uid=p.uid')
+            ->leftJoin('system_store s', 's.id=o.store_id')->leftJoin('combination_order_refund r', 'r.order_id=o.id')
+            ->where('p.id|p.k_id', $groupId)->order('p.id')
+            ->field('p.*,o.pay_price as paid_amount,o.real_name,o.user_phone,o.paid,o.pay_time,o.refund_status,o.trade_no,u.bar_code,u.real_name as member_real_name,u.phone as member_phone,u.delete_time,s.name as store_name,r.state as refund_state')
+            ->select()->toArray();
+        $joined = count(array_filter($rows, static function ($row) {
+            return !(int)$row['is_virtual'] && (int)$row['paid'] === 1;
+        }));
+        // Old completed groups overwrote their deadline; do not invent one from today's edited activity settings.
+        $expires = $origin ? (int)$origin['expires_at'] : ((int)$root['status'] !== 2 ? (int)$root['stop_time'] : 0);
+        $activity = Db::name('store_combination')->where('id', $root['cid'])->value('title');
+        foreach ($rows as &$row) {
+            $row['member_no'] = (string)($row['bar_code'] ?? '');
+            $row['member_name'] = (string)($row['real_name'] ?: ($row['member_real_name'] ?: $row['nickname']));
+            $row['phone'] = (string)($row['user_phone'] ?: $row['member_phone']);
+            $row['group_no'] = (string)$groupId;
+            $row['group_name'] = (string)($origin['activity_name'] ?? $activity ?? '');
+            $row['paid_amount'] = (int)$row['is_virtual'] ? 0 : (float)($row['paid_amount'] ?? 0);
+            $row['target_people'] = (int)$root['people'];
+            $row['joined_people'] = $joined;
+            $row['group_status'] = [1=>'进行中',2=>'成功',3=>'失败'][(int)$root['status']] ?? '';
+            $row['leader_role'] = (int)$row['id'] === $groupId ? '团长' : '团员';
+            $row['paid_at'] = !empty($row['pay_time']) ? date('Y-m-d H:i:s', (int)$row['pay_time']) : '';
+            $row['expires_at'] = $expires > 0 ? date('Y-m-d H:i:s', $expires) : '';
+            $row['participant_no'] = (string)$row['id'];
+            $row['payment_status'] = (int)$row['refund_status'] === 2 ? '已退款'
+                : ((int)$row['refund_status'] === 1 ? '退款中' : ((int)$row['paid'] ? '已支付' : '未支付'));
+        }
+        unset($row);
+        return $rows;
+    }
+
+    /** Exact 16-column user template. All real participants, including refunded/kicked rows, remain traceable. */
+    public function export(int $groupId): array
+    {
+        $rows = array_values(array_filter($this->rows($groupId), static function ($row) { return !(int)$row['is_virtual']; }));
+        $output = [];
+        foreach ($rows as $row) $output[] = array_intersect_key($row, array_fill_keys(self::KEYS, true));
+        return ['header'=>self::HEADERS,'filekey'=>self::KEYS,'export'=>$output,'filename'=>'拼团记录-'.$groupId];
+    }
+}
diff --git a/后端代码/app/services/activity/combination/CombinationRefundServices.php b/后端代码/app/services/activity/combination/CombinationRefundServices.php
new file mode 100644
index 00000000..0b8dbe12
--- /dev/null
+++ b/后端代码/app/services/activity/combination/CombinationRefundServices.php
@@ -0,0 +1,242 @@
+<?php
+declare(strict_types=1);
+
+namespace app\services\activity\combination;
+
+use app\services\order\StoreOrderRefundDomainServices;
+use app\services\pay\FuyouCombinationRefundGateway;
+use app\services\pay\PayServices;
+use think\exception\ValidateException;
+use think\facade\Db;
+
+/**
+ * Per-participant whole refund. Application and query are outside DB transactions;
+ * refund_status=1 fences use while result is unknown. The existing terminal domain
+ * remains the only writer of refund money, inventory and reversal facts.
+ */
+class CombinationRefundServices
+{
+    private $gateway;
+    public function __construct(?FuyouCombinationRefundGateway $gateway = null)
+    {
+        $this->gateway = $gateway;
+    }
+
+    private function gateway(): FuyouCombinationRefundGateway
+    {
+        return $this->gateway ?: FuyouCombinationRefundGateway::instance();
+    }
+
+    public static function isGroupOrder(int $orderId): bool
+    {
+        return (bool)Db::name('store_pink')->where('order_id_key', $orderId)->find();
+    }
+
+    /** No amount supplied by the browser is accepted. Admin identity comes from authenticated context. */
+    public function refundOrder(int $orderId, string $reason, int $operatorId = 0, bool $retry = true, int $kickGroupId = 0): array
+    {
+        $reason = trim($reason);
+        if ($reason === '' || mb_strlen($reason) > 300) throw new ValidateException('请填写300字以内退款原因');
+        $send = false;
+        $claimed = false;
+        $receipt = Db::transaction(function () use ($orderId, $reason, $operatorId, $retry, $kickGroupId, &$send, &$claimed) {
+            $memberIdentity = Db::name('store_pink')->where('order_id_key', $orderId)->find();
+            if (!$memberIdentity) throw new ValidateException('拼团订单不存在');
+            $rootId = (int)$memberIdentity['k_id'] ?: (int)$memberIdentity['id'];
+            Db::name('store_pink')->where('id', $rootId)->lock(true)->find();
+            $order = Db::name('store_order')->where('id', $orderId)->lock(true)->find();
+            if (!$order || !self::isGroupOrder($orderId)) throw new ValidateException('拼团订单不存在');
+            $row = Db::name('combination_order_refund')->where('order_id', $orderId)->lock(true)->find();
+            if ($row && $row['state'] === 'success') return $row;
+            if ($row && (int)$row['lease_until'] > time()) return $row;
+            if (!$row || ($row['state'] === 'failed' && $retry)) {
+                if ($kickGroupId > 0) {
+                    $root = Db::name('store_pink')->where('id', $kickGroupId)->lock(true)->find();
+                    $member = Db::name('store_pink')->where('order_id_key', $orderId)->lock(true)->find();
+                    if (!$root || (int)$root['status'] !== 1 || (int)$root['stop_time'] < time()
+                        || (int)$root['is_refund'] !== 0 || !$member || (int)$member['k_id'] !== $kickGroupId
+                        || (int)$member['is_virtual'] !== 0 || (int)$member['uid'] <= 0)
+                        throw new ValidateException('只能踢出进行中拼团的真实非团长成员');
+                }
+                $this->assertUnused($order);
+                $mapping = $this->paymentOrigin($order);
+                $attempt = $row ? (int)$row['attempt'] + 1 : 1;
+                // Prefix follows the actual original channel order, never a customer-name conditional.
+                $prefix = $mapping['channel_order_no'] !== '' ? substr($mapping['channel_order_no'], 0, 5) : 'GROUP';
+                $row = ['order_id' => $orderId, 'refund_no' => $prefix . str_pad((string)random_int(0, 999999999999999), 15, '0', STR_PAD_LEFT),
+                    'attempt' => $attempt, 'state' => $mapping['channel'] === 'balance' ? 'confirmed' : 'sending',
+                    'channel_order_no' => $mapping['channel_order_no'], 'channel' => $mapping['channel'],
+                    'merchant_id' => $mapping['merchant_id'], 'amount_cents' => (int)bcmul((string)$order['pay_price'], '100', 0),
+                    'channel_refund_id' => '', 'fuyou_refund_trace_no' => '', 'channel_transaction_id' => $mapping['channel'] === 'balance' ? '' : (string)($order['trade_no'] ?? ''),
