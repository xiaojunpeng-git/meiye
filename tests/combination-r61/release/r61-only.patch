+                            ->update(['write_surplus_times' => 0, 'surplus_num' => 0, 'is_writeoff' => 1]);
+                        Db::name('combination_order_fulfillment')->where('order_id', $orderId)->update(['state' => 'refunded']);
+                        Db::name('combination_order_refund')->where('order_id', $orderId)
