+				if (!item.children.length) return this.submit(next);
+				this.path = next;
+				this.resetScroll();
+			},
+			resetScroll() {
+				this.scrollTop = 1;
+				this.$nextTick(() => {this.scrollTop = 0;});
+			},
+			submit(path) {
+				// 只传地区 ID/名称，不把服务端树或门店信息带进列表查询。
