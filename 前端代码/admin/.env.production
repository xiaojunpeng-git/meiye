# 生产环境
NODE_ENV=production
VUE_APP_ENV='production'

# 页面 title
VUE_APP_TITLE=''
# socket 系统连接地址 (ws)或(wss)://www.mohe.com(换成你的域名)/ws 非独立部署默认为空
VUE_APP_WS_ADMIN_URL=''
# 接口请求地址 (http)或 (https)://www.mohe.com(换成你的域名)/adminapi 非独立部署默认为空
VUE_APP_API_URL=''

# 平台 iframe 加载 Vue 3 门店运营报表时使用该版本参数更新入口 HTML，避免浏览器沿用旧的静态索引。
VUE_APP_CASHIER_V3_REPORT_VERSION='44aa777b'
