  background: #f9f9f9;
  font-size: 14px;
  line-height: 36px;
  color: #303133;
  cursor: pointer;
}

.swiper-slide.active {
  background: #F7FBFF;
  border: 1px solid #1890FF;
  color: #1890FF;
}

.ivu-alert {
  padding: 20px 18px;
  border: 1px solid #1890FF;
  border-radius: 10px;
  margin-top: 20px;
  background: #F7FBFF;
  font-size: 14px;
  line-height: 22px;
  color: #1890FF;
}

.open-image {
  display: flex;
  align-items: center;
  justify-content: center;
  position: fixed;
  width: 130px;
  height: 580px;
  top: 50%;
  right: 40px;
  transform: translateY(-50%);
  z-index: 1000;
  cursor: pointer;
}

.open-image img {
  width: 130px;
}

.open-image .iconfont {
  position: absolute;
  top: -20px;
  right: -20px;
  font-size: 20px;
  color: #ddd;
}

/deep/.ivu-input:focus {
  box-shadow: none;
}

.cart-bottom-actions{
  margin-left: 5px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
}

.cart-bottom-toolbar{
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  flex: 1;
  min-width: 0;

  .toyeji,
  .yuePayBtn{
    flex-shrink: 0;
  }

  .yuePayBtn{
    margin-left: 20px;
  }

  .card-upgrade-info{
    margin-left: 20px;
  }
}

.yue-pay-input-wrap{
  display: flex;
  align-items: center;
  margin-left: 20px;
}

.card-upgrade-info {
  display: flex;
  align-items: center;
  gap: 6px;
}

.card-upgrade-label {
  font-size: 12px;
  color: #1890FF;
  cursor: pointer;
}

.card-upgrade-amount-box {
  display: flex;
  align-items: center;
  background-color: #f0f9eb;
  border: 1px solid #e1f5d4;
  border-radius: 4px;
  padding: 2px 8px;
  gap: 6px;
  position: relative;
}

.card-upgrade-amount {
  font-size: 12px;
  color: #67c23a;
  font-weight: 500;
}

.card-upgrade-close {
  font-size: 14px;
  color: #909399;
  cursor: pointer;
  line-height: 1;
  margin-left: 4px;
}

.card-upgrade-close:hover {
  color: #FF4D4F;
}

/* 卡升级选择旧卡弹窗样式 */
.card-upgrade-modal .ivu-modal-body {
  padding: 24px;
}

.card-upgrade-modal .ivu-modal-header {
  padding: 16px 24px;
  border-bottom: 1px solid #ebeef5;
}

.card-upgrade-modal .ivu-modal-title {
  font-size: 16px;
  font-weight: 600;
  color: #303133;
}

/* 搜索框样式 */
.card-upgrade-search .card-upgrade-search-input {
  width: 100%;
}

.card-upgrade-search .card-upgrade-search-input .ivu-input {
  height: 44px;
  border-radius: 22px;
  padding-left: 40px;
}

.card-upgrade-search .card-upgrade-search-input .ivu-input-group-addon {
  border-radius: 0 22px 22px 0;
  background-color: #f5f7fa;
  border-left: 1px solid #dcdfe6;
}

/* 滚动容器样式 */
.card-upgrade-scroll {
  max-height: 400px;
  overflow-y: auto;
  padding-right: 8px;
}

.card-upgrade-scroll::-webkit-scrollbar {
  width: 6px;
}

.card-upgrade-scroll::-webkit-scrollbar-track {
  background: #f1f1f1;
  border-radius: 3px;
}

.card-upgrade-scroll::-webkit-scrollbar-thumb {
  background: #c1c1c1;
  border-radius: 3px;
}

.card-upgrade-scroll::-webkit-scrollbar-thumb:hover {
  background: #a8a8a8;
}

/* 卡片网格样式 */
.card-upgrade-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16px;
  margin: 0 -8px;
  padding: 0 8px;
}

/* 卡片样式 */
.card-upgrade-card {
  border: 2px solid #f0f0f0;
  border-radius: 12px;
  transition: all 0.3s ease;
  cursor: pointer;
  overflow: hidden;
}

.card-upgrade-card:hover {
  border-color: #dcdfe6;
  box-shadow: 0 4px 16px 0 rgba(0, 0, 0, 0.1);
  transform: translateY(-2px);
}

.card-upgrade-card.card-upgrade-card-selected {
  border-color: #1890FF;
  box-shadow: 0 0 0 2px rgba(24, 144, 255, 0.2);
  background-color: #f6faff;
}

.card-upgrade-card-content {
  padding: 24px;
}

/* 订单号样式 */
.card-upgrade-card-order {
  font-size: 12px;
  color: #909399;
  margin-bottom: 8px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-upgrade-card-title {
  font-size: 16px;
  font-weight: 500;
  color: #303133;
  margin-bottom: 12px;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.card-upgrade-card-value {
  font-size: 14px;
  margin-top: 8px;
}

/* 底部按钮样式 */
.card-upgrade-footer {
  display: flex;
  justify-content: flex-end;
  gap: 12px;
  padding: 16px 24px;
  border-top: 1px solid #ebeef5;
}

.card-upgrade-btn-cancel {
  min-width: 80px;
}

.card-upgrade-btn-confirm {
  min-width: 100px;
}

/* 加载动画 */
.loading-spinner {
  width: 40px;
  height: 40px;
  border: 3px solid #f3f3f3;
  border-top: 3px solid #1890FF;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin: 0 auto;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* 响应式调整 */
@media screen and (max-width: 768px) {
  .card-upgrade-grid {
    grid-template-columns: 1fr;
  }
}