<template>
	<view class="page">
		<view class="beauty-orb beauty-orb--rose"></view>
		<view class="beauty-orb beauty-orb--peach"></view>
		<view class="beauty-orb beauty-orb--lavender"></view>
		<view class="beauty-spark beauty-spark--one">✦</view>
		<view class="beauty-spark beauty-spark--two">✦</view>
		<view class="hero">
			<text class="title">商家端登录</text>
			<text class="subtitle">使用员工档案中的登录账号进入工作台</text>
		</view>
		<view class="login-card">
			<text v-if="platformCode !== 'MP_WEIXIN'" class="field-label">服务地址</text>
			<input v-if="platformCode !== 'MP_WEIXIN'" class="field-input" :value="apiOrigin" placeholder="例如 http://127.0.0.1:8080" @input="apiOrigin = $event.detail.value" />
			<text class="field-label">员工账号</text>
			<input class="field-input" :value="account" placeholder="请输入员工账号" @input="account = $event.detail.value" />
			<text class="field-label">登录密码</text>
			<input class="field-input" :value="password" password placeholder="请输入登录密码" @input="password = $event.detail.value" />
				<view class="login-command" role="button" :aria-label="loading ? '正在登录' : '登录并进入商家端'" @tap="login"><text>{{ loading ? '正在登录…' : '登录并进入商家端' }}</text></view>
			<text v-if="message.length > 0" class="message">{{ message }}</text>
		</view>
		<view class="status-row">
			<view class="status-dot" :class="{ 'status-dot--error': !foundationReady }"></view>
			<text class="status-text">{{ foundationReady ? (platformCode === 'MP_WEIXIN' ? '已连接瑞昊正式服务' : '本机调试使用真实手机端接口') : '基础校验未通过' }}</text>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { currentMobilePlatform, declaredPlatformCapabilityCount } from '../../../shared/platform/mobile-platform.uts'
	import { merchantContextIsComplete, merchantStateIdentifiersAreCleared } from '../../state/root-state.uts'
	import { currentMobileApiOrigin, enterMerchantWithPassword, updateMobileApiOrigin } from '../../../shared/api/mobile-login-client.uts'
	import { openMerchantCustomerDetailAfterBootstrap, openMerchantCustomers, openMerchantHome } from '../../../shared/platform/mobile-navigation.uts'

	const platformCode = ref(currentMobilePlatform())
	const foundationReady = ref(
		declaredPlatformCapabilityCount() == 5 &&
		!merchantContextIsComplete('', '') &&
		merchantStateIdentifiersAreCleared('', '', '', '')
	)
	const apiOrigin = ref(currentMobileApiOrigin())
	const account = ref('')
	const password = ref('')
	const message = ref('')
	const loading = ref(false)
	const returnTarget = ref('')
	const returnMemberId = ref('')
	const returnLookup = ref('')

	onLoad((options : any) => {
		let target = String(options != null ? options.returnTarget || '' : '')
		let memberId = String(options != null ? options.memberId || '' : '')
		let lookup = String(options != null ? options.lookup || '' : '')
		if (target == 'customers') {
			returnTarget.value = target
			return
		}
		if (target == 'customer-detail' && memberId.length > 0 && lookup.length > 0) {
			returnTarget.value = target
			returnMemberId.value = memberId
			returnLookup.value = lookup
		}
	})

	function login() {
		message.value = ''
		if (platformCode.value !== 'MP_WEIXIN' && !updateMobileApiOrigin(apiOrigin.value)) { message.value = '服务地址格式无效。'; return }
		loading.value = true
		enterMerchantWithPassword(account.value, password.value, (result : any) => {
			loading.value = false
			if (!result.ok) { message.value = String(result.message || '登录未完成。'); return }
			completeLoginNavigation()
		})
	}

	function completeLoginNavigation() : void {
		if (returnTarget.value == 'customers') {
			openMerchantCustomers()
			return
		}
		if (returnTarget.value == 'customer-detail') {
			openMerchantCustomerDetailAfterBootstrap(returnMemberId.value, returnLookup.value)
			return
		}
		openMerchantHome()
	}
</script>

<style>
	.page {
		position: relative;
		display: flex;
		flex: 1;
		flex-direction: column;
		justify-content: space-between;
		padding: 72px 28px 44px 28px;
		overflow: hidden;
		background-color: #fff7f5;
	}
	.beauty-orb { position:absolute; border-radius:999px; opacity:.68; }
	.beauty-orb--rose { top:44px; right:-76px; width:218px; height:218px; background:#f6d8df; }
	.beauty-orb--peach { top:384px; left:-104px; width:216px; height:216px; background:#f9e0cc; }
	.beauty-orb--lavender { right:34px; bottom:110px; width:82px; height:82px; background:#e7dcf2; }
	.beauty-spark { position:absolute; z-index:0; color:#c78796; font-size:18px; }
	.beauty-spark--one { top:110px; right:54px; }
	.beauty-spark--two { top:344px; left:38px; color:#d3a66e; font-size:13px; }

	.hero {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		margin-top: 64px;
	}

	.login-card {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		padding: 20px;
		border-width: 1px;
		border-style: solid;
		border-color: #f2e2e3;
		border-radius: 20px;
		background-color: #ffffff;
		box-shadow: 0 14px 34px rgba(126, 82, 96, .10);
	}

	.field-label { margin-top: 12px; font-size: 12px; color: #9a7580; }
	.field-label:first-child { margin-top: 0; }
	.field-input { margin-top: 7px; height: 42px; padding: 0 12px; border-radius: 11px; background-color: #fff5f3; color: #563b48; font-size: 15px; }
	.login-command { margin-top: 20px; display: flex; justify-content: center; align-items: center; height: 46px; border-radius: 23px; background-color: #b76875; box-shadow: 0 8px 16px rgba(183,104,117,.24); color: #ffffff; font-size: 15px; font-weight: 600; }
	.message { margin-top: 13px; color: #a44848; font-size: 13px; line-height: 19px; }

	.platform {
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 1px;
		color: #668073;
	}

	.title {
		margin-top: 18px;
		font-size: 42px;
		font-weight: 700;
		color: #563545;
	}

	.subtitle {
		margin-top: 14px;
		font-size: 18px;
		color: #886775;
	}

	.status-row {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: row;
		align-items: center;
		padding-top: 20px;
		border-top-width: 1px;
		border-top-style: solid;
		border-top-color: #efdfe0;
	}

	.status-dot {
		width: 8px;
		height: 8px;
		border-radius: 4px;
		background-color: #bb7583;
	}
	.status-dot--error { background-color: #a44848; }

	.status-text {
		margin-left: 10px;
		font-size: 14px;
		color: #896b76;
	}
</style>
