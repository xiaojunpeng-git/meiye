export function growthKey() : string { return 'growth-' + Date.now().toString() + '-' + Math.random().toString(36).slice(2) }

/** 页面只消费growth业务载荷，协议错误与业务错误都保留输入并给出原因。 */
export function growthRequest(endpoint : string, data : any, done : (value : any) => void) : void {
  let session = merchantRequestSession(currentMerchantRoot())
  if (session == null) { done({ ok: false, message: '请先登录商家端。' }); return }
  let plan : any = buildMobileRequestPlan(growthContract, endpoint, session)
  if (!mobileRequestPlanMatchesContract(growthContract, endpoint, session, plan)) { done({ ok: false, message: '成长请求上下文无效。' }); return }
  let body : any = data
  if (plan.method == 'GET') {
    let query : Array<string> = []
    if (data != null) Object.keys(data).forEach((key : string) => { if (data[key] != null) query.push(encodeURIComponent(key) + '=' + encodeURIComponent(String(data[key]))) })
    plan = { method: plan.method, path: plan.path + (query.length > 0 ? '?' + query.join('&') : ''), headers: plan.headers }
    body = null
  }
  sendMobileRequest(plan, body, (r : any) => {
    let ok = r.ok && r.body != null && r.body.growth != null
    // 明确的业务拒绝允许更正输入；网络/服务器结果未知则保留原操作用于重试。
    let rejected = !ok && (r.statusCode >= 400 && r.statusCode < 500 || r.body != null && Number(r.body.status) >= 400 && Number(r.body.status) < 500)
    done({ ok: ok, rejected: rejected, data: ok ? r.body.growth : null, message: ok ? '' : String(r.message || (r.body != null ? r.body.msg : '') || '操作未完成，请重试。') })
  })
}

/** 先认证取本次任务资源，返回设备临时地址；原存储定位不会公开。 */
export function growthDownload(assetId : number, taskId : number, done : (value : any) => void) : any {
  let session = merchantRequestSession(currentMerchantRoot())
  if (session == null) { done({ ok: false, message: '请先登录。' }); return null }
  let plan : any = buildMobileRequestPlan(growthContract, 'asset', session)
  // WEB私有附件与JSON请求遵循同一无Cookie凭据规则，支持章节切换时取消下载。
  // #ifdef WEB
  let controller = new AbortController()
  fetch(mobileApiOrigin() + '/api' + plan.path + '?id=' + assetId.toString() + '&task_id=' + taskId.toString(), { headers: plan.headers, credentials: 'omit', signal: controller.signal })
    .then(async (r:any) => { if(r.status!=200){done({ok:false,message:'资源读取失败，请检查任务状态。'});return};let blob=await r.blob();done({ok:true,url:URL.createObjectURL(blob),message:''}) })
    .catch(() => done({ok:false,message:'资源加载失败，请重试。'}))
  return { abort: () => controller.abort() }
  // #endif
  // #ifndef WEB
  return uni.downloadFile({ url: mobileApiOrigin() + '/api' + plan.path + '?id=' + assetId.toString() + '&task_id=' + taskId.toString(), header: plan.headers,
    success: (r : any) => done({ ok: r.statusCode == 200, url: r.tempFilePath, message: r.statusCode == 200 ? '' : '资源读取失败，请检查任务状态。' }),
    fail: () => done({ ok: false, message: '资源加载失败，请重试。' }) })
  // #endif
}

// 证据文件沿用商家认证上传，上传成功仍须提交原业务才能成为正式证据。
export function growthUploadFile(filePath : string, done : (value : any) => void) : void {
  let session = merchantRequestSession(currentMerchantRoot())
  if (session == null) { done({ ok: false, message: '请先登录。' }); return }
  let plan : any = buildMobileRequestPlan(growthContract, 'upload', session)
  // WEB选择器给出的临时blob只在浏览器读取；上传正文交给FormData自动设置边界。
  // #ifdef WEB
  fetch(filePath, {credentials:'omit'}).then(async (local:any) => {
    if(!local.ok)throw new Error('无法读取所选文件')
    let blob=await local.blob();let form=new FormData();let name=String((blob as any).name||'growth-evidence')
    if(name=='growth-evidence'){let ext:any={'image/png':'png','image/jpeg':'jpg','image/webp':'webp','video/mp4':'mp4','video/webm':'webm','application/pdf':'pdf'};name+='.'+String(ext[blob.type]||'bin')}
    form.append('file',blob,name)
    let response=await fetch(mobileApiOrigin()+'/api'+plan.path,{method:'POST',headers:plan.headers,credentials:'omit',body:form})
    let body=await response.json();let ok=body.growth!=null&&body.growth.state=='READY'
    done({ok:ok,data:body.growth,message:ok?'':String(body.msg||(body.growth!=null?body.growth.error_message:'')||'证据上传失败')})
  }).catch(()=>done({ok:false,message:'上传失败，请检查网络。'}))
  return
  // #endif
  // #ifndef WEB
  uni.uploadFile({ url: mobileApiOrigin() + '/api' + plan.path, filePath: filePath, name: 'file', header: plan.headers,
    success: (r : any) => { try { let body : any = JSON.parse(String(r.data)); let ok = body.growth != null && body.growth.state == 'READY'; done({ ok: ok, data: body.growth, message: ok ? '' : String(body.msg || (body.growth != null ? body.growth.error_message : '') || '证据上传失败') }) } catch (_e) { done({ ok: false, message: '证据处理失败，请重试。' }) } },
    fail: () => done({ ok: false, message: '上传失败，请检查网络。' }) })
  // #endif
}

// 按实际资源形式预览，视频与PDF不能交给图片预览器。
export function growthViewAsset(assetId:number,taskId:number):void{uni.navigateTo({url:'/src/merchant/pages/growth/resource?id='+assetId.toString()+'&task_id='+taskId.toString()})}

// 成长任务导航统一引用原领域入口，档案和消息不创建另一套结果处理页面。
export function growthTaskUrl(task:any):string{let kind=String(task.kind);if(kind=='appraisal')return '/src/merchant/pages/growth/appraisal?id='+String(task.source_id);if(kind=='inspection'||kind=='rectification')return '/src/merchant/pages/growth/inspection?id='+String(task.source_id)+'&type='+(kind=='inspection'?'inspection':'issue');let page=['exam','practice'].indexOf(kind)>=0?'exam':(['assignment','evaluation','coaching','offline'].indexOf(kind)>=0?'work':'learn');return '/src/merchant/pages/growth/'+page+'?id='+String(task.id)}
