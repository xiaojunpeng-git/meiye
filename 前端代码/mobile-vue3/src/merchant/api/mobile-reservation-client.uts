import { buildMobileRequestPlan, mobileRequestPlanMatchesContract } from '../../shared/api/request-context.uts'
import { sendMobileRequest } from '../../shared/api/mobile-http.uts'
import { currentMerchantRoot, merchantRequestSession } from '../platform/mobile-merchant-session.uts'

// Runtime mirror of the mobile reservation lifecycle contract.
const reservationTransportContract : any = {
	contractVersion: 'mobile-merchant-v1',
	 endpoints: {
		listReservations: { method: 'GET', path: '/mobile/merchant/reservations', requestMetadataProfile: 'MERCHANT_SESSION' },
		reservationDetail: { method: 'GET', path: '/mobile/merchant/reservations/:reservationId', requestMetadataProfile: 'MERCHANT_SESSION' },
		openReservationEditor: { method: 'POST', path: '/mobile/merchant/reservations/editor', requestMetadataProfile: 'MERCHANT_SESSION' },
		reservationProjectCatalog: { method: 'POST', path: '/mobile/merchant/reservations/project-catalog', requestMetadataProfile: 'MERCHANT_SESSION' },
		queryMemberCandidates: { method: 'POST', path: '/mobile/merchant/reservations/member-candidates', requestMetadataProfile: 'MERCHANT_SESSION' },
		recalculateReservation: { method: 'POST', path: '/mobile/merchant/reservations/recalculate', requestMetadataProfile: 'MERCHANT_SESSION' },
		createReservation: { method: 'POST', path: '/mobile/merchant/reservations', requestMetadataProfile: 'MERCHANT_SESSION' },
		updateReservation: { method: 'PUT', path: '/mobile/merchant/reservations/:reservationId', requestMetadataProfile: 'MERCHANT_SESSION' },
		deleteReservation: { method: 'DELETE', path: '/mobile/merchant/reservations/:reservationId', requestMetadataProfile: 'MERCHANT_SESSION' },
		startReservationService: { method: 'POST', path: '/mobile/merchant/reservations/:reservationId/start-service', requestMetadataProfile: 'MERCHANT_SESSION' },
		endReservationService: { method: 'POST', path: '/mobile/merchant/reservations/:reservationId/end-service', requestMetadataProfile: 'MERCHANT_SESSION' }
	},
	requestMetadataProfiles: {
		MERCHANT_SESSION: {
			required: { 'X-Mobile-Contract-Version': 'contractVersion', 'X-Mobile-Client-Session-Id': 'clientSessionId', 'X-Mobile-Platform': 'platform', 'X-Mobile-Request-Id': 'requestId', Authorization: 'Bearer <merchantToken>', 'X-Mobile-Active-Context-Id': 'activeContextId', 'X-Mobile-State-Context-Id': 'stateContextId' },
			forbidden: ['X-Mobile-App-Session', 'Cookie', 'queryToken', 'bodyToken', 'headerAlias']
		}
	}
}

function request(endpointName : string, payload : any, done : (value : any) => void) : void {
	let root = currentMerchantRoot()
	let session = merchantRequestSession(root)
	if (session == null) { done({ ok: false, message: '请先完成商家端登录。', body: null }); return }
	let plan = buildMobileRequestPlan(reservationTransportContract, endpointName, session)
	if (!mobileRequestPlanMatchesContract(reservationTransportContract, endpointName, session, plan)) { done({ ok: false, message: '预约请求上下文无效，请重新进入商家端。', body: null }); return }
	sendMobileRequest(plan, payload, done)
}

export function queryMobileReservations(done : (value : any) => void) : void { request('listReservations', {}, done) }
export function queryMobileReservationDetail(reservationId : string, done : (value : any) => void) : void { let plan = buildPlan('reservationDetail', reservationId); if (plan == null) { done({ ok: false, message: '请先完成商家端登录。', body: null }); return }; sendMobileRequest(plan, {}, done) }
export function openMobileReservationEditor(payload : any, done : (value : any) => void) : void { request('openReservationEditor', payload == null ? {} : payload, done) }
export function queryMobileReservationProjectCatalog(payload : any, done : (value : any) => void) : void { request('reservationProjectCatalog', payload == null ? {} : payload, done) }
export function queryMobileReservationMembers(payload : any, done : (value : any) => void) : void { request('queryMemberCandidates', payload, done) }
export function recalculateMobileReservation(payload : any, done : (value : any) => void) : void { request('recalculateReservation', payload, done) }
export function createMobileReservation(payload : any, done : (value : any) => void) : void { request('createReservation', payload, done) }
export function updateMobileReservation(reservationId : string, payload : any, done : (value : any) => void) : void { let plan = buildPlan('updateReservation', reservationId); if (plan == null) { done({ ok: false, message: '请先完成商家端登录。', body: null }); return }; sendMobileRequest(plan, payload == null ? {} : payload, done) }
export function deleteMobileReservation(reservationId : string, payload : any, done : (value : any) => void) : void { let plan = buildPlan('deleteReservation', reservationId); if (plan == null) { done({ ok: false, message: '请先完成商家端登录。', body: null }); return }; sendMobileRequest(plan, payload == null ? {} : payload, done) }
export function startMobileReservationService(reservationId : string, payload : any, done : (value : any) => void) : void { let plan = buildPlan('startReservationService', reservationId); if (plan == null) { done({ ok: false, message: '请先完成商家端登录。', body: null }); return }; sendMobileRequest(plan, payload == null ? {} : payload, done) }
export function endMobileReservationService(reservationId : string, payload : any, done : (value : any) => void) : void { let plan = buildPlan('endReservationService', reservationId); if (plan == null) { done({ ok: false, message: '请先完成商家端登录。', body: null }); return }; sendMobileRequest(plan, payload == null ? {} : payload, done) }

function buildPlan(endpointName : string, reservationId : string) : any {
	let root = currentMerchantRoot()
	let session = merchantRequestSession(root)
	if (session == null) return null
	let plan = buildMobileRequestPlan(reservationTransportContract, endpointName, session)
	if (!mobileRequestPlanMatchesContract(reservationTransportContract, endpointName, session, plan)) return null
	plan.path = plan.path.replace(':reservationId', reservationId)
	return plan
}
