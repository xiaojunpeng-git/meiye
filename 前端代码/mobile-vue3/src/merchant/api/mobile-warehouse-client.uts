import { buildMobileRequestPlan, mobileRequestPlanMatchesContract } from '../../shared/api/request-context.uts'
import { sendMobileRequest } from '../../shared/api/mobile-http.uts'
import { currentMerchantRoot, merchantRequestSession } from '../platform/mobile-merchant-session.uts'

const warehouseTransportContract : any = {
	contractVersion: 'mobile-merchant-v1',
	endpoints: {
		queryWarehouseOverview: { method: 'POST', path: '/mobile/merchant/warehouse/overview', requestMetadataProfile: 'MERCHANT_SESSION' }
	},
	requestMetadataProfiles: {
		MERCHANT_SESSION: {
			required: { 'X-Mobile-Contract-Version': 'contractVersion', 'X-Mobile-Client-Session-Id': 'clientSessionId', 'X-Mobile-Platform': 'platform', 'X-Mobile-Request-Id': 'requestId', Authorization: 'Bearer <merchantToken>', 'X-Mobile-Active-Context-Id': 'activeContextId', 'X-Mobile-State-Context-Id': 'stateContextId' },
			forbidden: ['X-Mobile-App-Session', 'Cookie', 'queryToken', 'bodyToken', 'headerAlias']
		}
	}
}

export function queryMobileWarehouse(payload : any, done : (value : any) => void) : void {
	let root = currentMerchantRoot()
	let session = merchantRequestSession(root)
	if (session == null) { done({ ok: false, message: '请先完成商家端登录。', body: null }); return }
	let plan = buildMobileRequestPlan(warehouseTransportContract, 'queryWarehouseOverview', session)
	if (!mobileRequestPlanMatchesContract(warehouseTransportContract, 'queryWarehouseOverview', session, plan)) { done({ ok: false, message: '数仓请求上下文无效，请重新进入商家端。', body: null }); return }
	sendMobileRequest(plan, payload, done)
}
