<template>
  <MoheAiEntry />
	<view class="care-page" :class="{ 'care-page--native-mini': platformUsesNativeCanvas }">
		<view class="care-page__topbar">
			<view class="care-page__back" role="button" aria-label="返回工作台" @tap="returnToWorkbench"><text>‹</text></view>
		</view>
		<view class="care-page__tabs" role="tablist">
			<view v-for="tab in tabs" :key="tab.key" class="care-page__tab" :class="{ 'care-page__tab--active': activeTab === tab.key }" role="tab" :aria-selected="activeTab === tab.key" @tap="selectTab(tab.key)"><text>{{ tab.label }}</text></view>
		</view>
		<view v-if="activeTab === 'tasks'" class="care-page__filters">
			<view class="care-page__segment"><view v-for="bucket in buckets" :key="bucket.key" class="care-page__segment-item" :class="{ 'care-page__segment-item--active': activeBucket === bucket.key }" @tap="selectBucket(bucket.key)"><text>{{ bucket.label }}</text></view></view>
		</view>
		<scroll-view scroll-y="true" class="care-page__content">
			<view v-if="activeTab === 'tasks' && metrics.length > 0" class="care-page__metrics"><view v-for="metric in metrics" :key="metric.code" class="care-page__metric-card"><text class="care-page__metric-label">{{ metric.label }}</text><text class="care-page__metric-value">{{ metric.value }}{{ metric.unit }}</text><text class="care-page__metric-copy">{{ metric.description }}</text></view></view>
			<view v-if="activeTab === 'customers'" class="care-page__member-search">
				<text class="care-page__member-search-symbol">⌕</text>
				<input class="care-page__member-search-input" type="text" :value="customerKeyword" placeholder="搜索会员姓名、手机号或会员编号" @input="updateCustomerKeyword" @confirm="loadWorkbench" />
				<view class="care-page__member-search-submit" @tap="loadWorkbench"><text>搜索</text></view>
			</view>
			<view v-if="activeTab === 'records'" class="care-page__record-toolbar">
				<view class="care-page__member-search care-page__member-search--record">
					<text class="care-page__member-search-symbol">⌕</text>
					<input class="care-page__member-search-input" type="text" :value="recordKeyword" placeholder="搜索会员姓名、手机号或会员编号" @input="updateRecordKeyword" @confirm="loadWorkbench" />
					<view class="care-page__member-search-submit" @tap="loadWorkbench"><text>搜索</text></view>
				</view>
			</view>
			<view v-if="loading" class="care-page__empty"><text class="care-page__empty-title">正在读取客情数据</text></view>
			<view v-else-if="message.length > 0" class="care-page__empty"><text class="care-page__empty-title">{{ message }}</text><view class="care-page__reload" @tap="loadWorkbench"><text>重新加载</text></view></view>
			<view v-else-if="activeTab === 'tasks' && tasks.length === 0" class="care-page__empty"><text class="care-page__empty-title">{{ activeTabLabel }}</text><text class="care-page__empty-copy">当前筛选范围没有待跟进任务</text></view>
			<view v-else-if="activeTab === 'tasks'" class="care-page__list">
				<view v-if="createdTaskMemberId.length > 0" class="care-page__created-task-notice"><text>已定位新建任务</text><text class="care-page__created-task-clear" @tap="clearCreatedTaskFilter">查看全部</text></view>
				<view v-for="task in tasks" :key="task.taskId" class="care-page__card care-page__card--clickable" role="button" @tap="openTaskDetail(task)">
					<view class="care-page__card-row"><text class="care-page__card-title">{{ task.member.name }} · {{ task.typeLabel }}</text><text class="care-page__status">{{ task.statusLabel }}</text></view>
					<text class="care-page__card-copy">{{ task.plannedAt }} · {{ task.owner.name }}</text>
					<text v-if="task.note" class="care-page__card-copy">{{ task.note }}</text>
					<view class="care-page__card-detail-entry"><text>查看详情</text><text class="care-page__card-chevron">›</text></view>
				</view>
			</view>
			<view v-else-if="activeTab === 'customers' && customers.length === 0" class="care-page__empty"><text class="care-page__empty-title">暂无客户</text><text class="care-page__empty-copy">客户范围由服务端数据权限决定。</text></view>
			<view v-else-if="activeTab === 'customers'" class="care-page__list">
				<view v-for="customer in customers" :key="customer.memberId" class="care-page__card"><text class="care-page__card-title">{{ customer.name }} · {{ customer.phone }}</text><text class="care-page__card-copy">{{ customer.storeName }} · {{ customer.nextTaskLabel }}</text><text class="care-page__card-copy">最近客情：{{ customer.latestCareLabel }}</text><view class="care-page__complete-entry" @tap="openCreateTask(customer)"><text>新增客情任务</text></view></view>
			</view>
			<view v-else-if="activeTab === 'records' && records.length === 0" class="care-page__empty"><text class="care-page__empty-title">暂无客情记录</text><text class="care-page__empty-copy">点击右下角“＋”，可为授权范围内的会员补录正式客情记录。</text></view>
			<view v-else-if="activeTab === 'records'" class="care-page__list">
				<view v-for="record in records" :key="record.recordId" class="care-page__card"><view class="care-page__card-row"><text class="care-page__card-title">{{ record.memberName }} · {{ record.typeLabel }}</text><text class="care-page__status">{{ record.resultLabel }}</text></view><text class="care-page__card-copy">{{ record.followedAt }} · {{ record.methodLabel }}</text><text class="care-page__card-copy">{{ record.summary }}</text><view v-if="record.serviceBeforePhotos != null && record.serviceBeforePhotos.length > 0" class="care-page__record-photos"><text class="care-page__record-photos-label">服务前</text><image v-for="(photo, index) in record.serviceBeforePhotos" :key="'record-before-' + index" class="care-page__record-photo" :src="photo" mode="aspectFill" /></view><view v-if="record.serviceAfterPhotos != null && record.serviceAfterPhotos.length > 0" class="care-page__record-photos"><text class="care-page__record-photos-label">服务后</text><image v-for="(photo, index) in record.serviceAfterPhotos" :key="'record-after-' + index" class="care-page__record-photo" :src="photo" mode="aspectFill" /></view></view>
			</view>
			<view v-else-if="activeTab === 'statistics'" class="care-page__list"><view v-for="metric in metrics" :key="metric.code" class="care-page__card"><text class="care-page__card-title">{{ metric.label }}</text><text class="care-page__metric">{{ metric.value }}{{ metric.unit }}</text><text class="care-page__card-copy">{{ metric.userReady ? metric.description : '统计口径待确认' }}</text></view></view>
		</scroll-view>
		<view v-if="activeTab === 'tasks' || activeTab === 'records'" class="care-page__floating-create" role="button" :aria-label="activeTab === 'tasks' ? '新增跟进任务' : '新增客情记录'" @tap="openFloatingCreate"><text>＋</text></view>
		<view v-if="selectedTask != null" class="care-page__task-detail">
			<view class="care-page__detail-header"><text class="care-page__detail-cancel" @tap="closeTaskDetail">关闭</text><text class="care-page__detail-title">任务详情</text><text class="care-page__detail-placeholder"></text></view>
			<scroll-view scroll-y class="care-page__detail-body">
				<view class="care-page__detail-hero"><text class="care-page__detail-eyebrow">{{ selectedTask.typeLabel || '跟进任务' }}</text><text class="care-page__detail-member">{{ selectedTask.member != null ? selectedTask.member.name : '未命名会员' }}</text><text class="care-page__detail-member-copy">{{ selectedTask.taskNo || '—' }}<template v-if="selectedTask.member != null && selectedTask.member.phone"> · {{ selectedTask.member.phone }}</template></text></view>
				<view class="care-page__detail-status"><text class="care-page__status">{{ selectedTask.statusLabel || selectedTask.status || '—' }}</text><text v-if="selectedTask.isOverdue" class="care-page__detail-overdue">已逾期</text></view>
				<view class="care-page__detail-section"><text class="care-page__detail-section-title">任务信息</text><view class="care-page__detail-fact"><text>计划时间</text><text>{{ selectedTask.plannedAt || '—' }}</text></view><view class="care-page__detail-fact"><text>当前负责人</text><text>{{ selectedTask.owner != null ? selectedTask.owner.name : '—' }}</text></view><view class="care-page__detail-fact"><text>归属门店</text><text>{{ selectedTask.store != null ? selectedTask.store.name : '—' }}</text></view><view class="care-page__detail-fact"><text>任务来源</text><text>{{ selectedTask.sourceLabel || '—' }}</text></view></view>
				<view v-if="selectedTask.relatedBusiness != null" class="care-page__detail-section"><text class="care-page__detail-section-title">关联业务</text><text class="care-page__detail-section-strong">{{ selectedTask.relatedBusiness.label || '—' }}</text><text class="care-page__detail-section-copy">{{ selectedTask.relatedBusiness.summary || '暂无关联业务摘要' }}</text></view>
				<view v-if="selectedTask.latestCare != null" class="care-page__detail-section"><text class="care-page__detail-section-title">最近客情</text><text class="care-page__detail-section-strong">{{ selectedTask.latestCare.methodLabel || '跟进记录' }} · {{ selectedTask.latestCare.resultLabel || '—' }}</text><text class="care-page__detail-section-copy">{{ selectedTask.latestCare.followedAt || '—' }}</text><text class="care-page__detail-section-copy">{{ selectedTask.latestCare.content || '暂无跟进内容' }}</text></view>
			</scroll-view>
			<view class="care-page__detail-actions"><text v-if="taskDetailMessage.length > 0" class="care-page__detail-message">{{ taskDetailMessage }}</text><text v-else-if="!canCall(selectedTask) && !canStart(selectedTask) && !canComplete(selectedTask) && !canDelete(selectedTask)" class="care-page__detail-empty">当前任务没有可执行操作</text><view v-if="canCall(selectedTask)" class="care-page__call-entry" @tap="callCustomer(selectedTask)"><text>拨打电话</text></view><view v-if="canStart(selectedTask)" class="care-page__complete-entry" :class="{ 'care-page__complete-entry--loading': taskActionSubmitting }" @tap.stop="startSelectedTask"><text>{{ taskActionSubmitting ? '正在开始…' : '开始跟进' }}</text></view><view v-if="canComplete(selectedTask)" class="care-page__complete-entry" @tap="openCompleteFromDetail"><text>记录本次客情</text></view><view v-if="canDelete(selectedTask)" class="care-page__delete-entry" @tap.stop="requestDeleteSelectedTask"><text>删除任务</text></view></view>
		</view>
		<view v-if="deletingTask != null" class="care-page__confirm-mask" @tap="cancelDeleteTask"><view class="care-page__confirm-panel" @tap.stop><text class="care-page__confirm-title">删除未开始任务？</text><text class="care-page__confirm-copy">删除后任务不再出现在待跟进列表，审计记录会保留。</text><view class="care-page__confirm-actions"><view class="care-page__confirm-cancel" @tap="cancelDeleteTask"><text>取消</text></view><view class="care-page__confirm-danger" :class="{ 'care-page__confirm-danger--loading': taskActionSubmitting }" @tap.stop="confirmDeleteTask"><text>{{ taskActionSubmitting ? '正在删除…' : '确认删除' }}</text></view></view></view></view>
		<view v-if="completingTask != null" class="care-page__complete-panel">
			<view class="care-page__complete-header"><text class="care-page__complete-cancel" @tap="closeComplete">取消</text><text class="care-page__complete-title">完成客情</text><text class="care-page__complete-placeholder"></text></view>
			<scroll-view scroll-y class="care-page__complete-body"><text class="care-page__complete-member">{{ completingTask.member.name }} · {{ completingTask.typeLabel }}</text><text class="care-page__complete-label">联系方式</text><view class="care-page__choice-row"><view v-for="method in methods" :key="method.value" class="care-page__choice" :class="{ 'care-page__choice--active': methodCode === method.value }" @tap="methodCode = method.value"><text>{{ method.label }}</text></view></view><text class="care-page__complete-label">跟进结果</text><view class="care-page__choice-row"><view v-for="result in results" :key="result.value" class="care-page__choice" :class="{ 'care-page__choice--active': resultCode === result.value }" @tap="resultCode = result.value"><text>{{ result.label }}</text></view></view><text class="care-page__complete-label">本次内容</text><textarea class="care-page__complete-textarea" :value="completeContent" placeholder="如实记录沟通内容和后续约定" @input="completeContent = $event.detail.value" /><view class="care-page__next-toggle" @tap="createNextTask = !createNextTask"><text>{{ createNextTask ? '已创建下一次跟进' : '创建下一次跟进' }}</text></view><view v-if="createNextTask"><text class="care-page__complete-label">下次跟进时间</text><input class="care-page__datetime-input" :value="nextPlannedAt" placeholder="例如 2026-07-31 10:00" @input="nextPlannedAt = $event.detail.value" /><text class="care-page__complete-label">下次负责人</text><view class="care-page__choice-row"><view v-for="assignee in assignees" :key="'next-' + assignee.value" class="care-page__choice" :class="{ 'care-page__choice--active': nextOwnerId === assignee.value }" @tap="nextOwnerId = assignee.value"><text>{{ assignee.label }}</text></view></view></view><view class="care-page__complete-submit" @tap="submitComplete"><text>{{ submitting ? '正在提交…' : '完成并保存记录' }}</text></view></scroll-view>
		</view>
		<view v-if="creatingTaskPanel" class="care-page__complete-panel">
			<view class="care-page__complete-header"><text class="care-page__complete-cancel" @tap="closeCreateTask">取消</text><text class="care-page__complete-title">新增客情任务</text><text class="care-page__complete-placeholder"></text></view>
			<scroll-view scroll-y class="care-page__complete-body">
				<text class="care-page__complete-label care-page__complete-label--first">会员</text>
				<view v-if="creatingForCustomer == null" class="care-page__record-member-picker">
					<view class="care-page__member-search care-page__member-search--picker"><text class="care-page__member-search-symbol">⌕</text><input class="care-page__member-search-input" type="text" :value="taskMemberKeyword" placeholder="搜索要跟进的会员" @input="updateTaskMemberKeyword" @confirm="searchTaskMembers" /><view class="care-page__member-search-submit" @tap="searchTaskMembers"><text>{{ taskMemberLoading ? '查询中' : '查找' }}</text></view></view>
					<text v-if="taskMemberSearched && !taskMemberLoading && taskMemberCandidates.length === 0" class="care-page__record-member-empty">没有找到当前授权范围内的会员。</text>
					<view v-for="member in taskMemberCandidates" :key="'task-member-' + String(member.memberId)" class="care-page__record-member-option" @tap="selectTaskMember(member)"><text class="care-page__record-member-name">{{ member.name }}</text><text class="care-page__record-member-copy">{{ member.phone || '未登记手机号' }}</text></view>
				</view>
				<view v-else class="care-page__record-member-selected"><view><text class="care-page__record-member-name">{{ creatingForCustomer.name }}</text><text class="care-page__record-member-copy">{{ creatingForCustomer.phone || '未登记手机号' }}</text></view><text class="care-page__record-member-change" @tap="clearTaskMember">重新选择</text></view>
				<text class="care-page__complete-label">任务类型</text>
				<view class="care-page__choice-row" role="radiogroup">
					<view v-for="type in taskTypes" :key="type.value" class="care-page__choice" :class="{ 'care-page__choice--active': taskTypeCode === type.value }" role="radio" :aria-checked="taskTypeCode === type.value" @tap.stop="selectTaskType(type.value)"><text>{{ type.label }}</text></view>
				</view>
				<text class="care-page__complete-label">负责人</text>
				<view class="care-page__choice-row" role="radiogroup">
					<view v-for="assignee in assignees" :key="assignee.value" class="care-page__choice" :class="{ 'care-page__choice--active': ownerId === assignee.value }" role="radio" :aria-checked="ownerId === assignee.value" @tap.stop="selectOwner(assignee.value)"><text>{{ assignee.label }}</text></view>
				</view>
				<text class="care-page__complete-label">计划跟进时间</text>
				<view class="care-page__schedule-row">
					<picker class="care-page__schedule-picker" mode="date" :value="plannedDate" @change="changeCreatePlannedDate"><view class="care-page__schedule-value" :class="{ 'care-page__schedule-value--placeholder': plannedDate.length === 0 }"><text>{{ plannedDate.length > 0 ? plannedDate : '选择日期' }}</text><text class="care-page__schedule-arrow">›</text></view></picker>
					<view class="care-page__schedule-picker" @tap.stop="openCreateTimePicker"><view class="care-page__schedule-value" :class="{ 'care-page__schedule-value--placeholder': plannedTime.length === 0 }"><text>{{ plannedTime.length > 0 ? plannedTime : '选择时间' }}</text><text class="care-page__schedule-arrow">›</text></view></view>
				</view>
				<text class="care-page__complete-label">任务备注</text>
				<textarea class="care-page__complete-textarea" :value="taskContent" placeholder="填写本次需要跟进的事项" @input="updateTaskContent" />
				<text v-if="createFormMessage.length > 0" class="care-page__form-message">{{ createFormMessage }}</text>
				<view class="care-page__complete-submit" :class="{ 'care-page__complete-submit--loading': creatingTask }" @tap.stop="submitCreateTask"><text>{{ creatingTask ? '正在提交…' : '创建客情任务' }}</text></view>
			</scroll-view>
		</view>
		<view v-if="creatingRecord" class="care-page__complete-panel">
			<view class="care-page__complete-header"><text class="care-page__complete-cancel" @tap="closeCreateRecord">取消</text><text class="care-page__complete-title">新增客情记录</text><text class="care-page__complete-placeholder"></text></view>
			<scroll-view scroll-y class="care-page__complete-body">
				<text class="care-page__complete-label">会员</text>
				<view v-if="recordSelectedMember == null" class="care-page__record-member-picker">
					<view class="care-page__member-search care-page__member-search--picker"><text class="care-page__member-search-symbol">⌕</text><input class="care-page__member-search-input" type="text" :value="recordMemberKeyword" placeholder="搜索要记录客情的会员" @input="updateRecordMemberKeyword" @confirm="searchRecordMembers" /><view class="care-page__member-search-submit" @tap="searchRecordMembers"><text>{{ recordMemberLoading ? '查询中' : '查找' }}</text></view></view>
					<text v-if="recordMemberSearched && !recordMemberLoading && recordMemberCandidates.length === 0" class="care-page__record-member-empty">没有找到当前授权范围内的会员。</text>
					<view v-for="member in recordMemberCandidates" :key="member.memberId" class="care-page__record-member-option" @tap="selectRecordMember(member)"><text class="care-page__record-member-name">{{ member.name }}</text><text class="care-page__record-member-copy">{{ member.phone || '未登记手机号' }}</text></view>
				</view>
				<view v-else class="care-page__record-member-selected"><view><text class="care-page__record-member-name">{{ recordSelectedMember.name }}</text><text class="care-page__record-member-copy">{{ recordSelectedMember.phone || '未登记手机号' }}</text></view><text class="care-page__record-member-change" @tap="clearRecordMember">重新选择</text></view>
				<text class="care-page__complete-label">客情类型</text>
				<view class="care-page__choice-row"><view v-for="type in taskTypes" :key="'record-' + type.value" class="care-page__choice" :class="{ 'care-page__choice--active': recordTypeCode === type.value }" @tap="recordTypeCode = type.value"><text>{{ type.label }}</text></view></view>
				<text class="care-page__complete-label">联系方式</text>
				<view class="care-page__choice-row"><view v-for="method in methods" :key="'record-method-' + method.value" class="care-page__choice" :class="{ 'care-page__choice--active': recordMethodCode === method.value }" @tap="recordMethodCode = method.value"><text>{{ method.label }}</text></view></view>
				<text class="care-page__complete-label">跟进结果</text>
				<view class="care-page__choice-row"><view v-for="result in results" :key="'record-result-' + result.value" class="care-page__choice" :class="{ 'care-page__choice--active': recordResultCode === result.value }" @tap="recordResultCode = result.value"><text>{{ result.label }}</text></view></view>
				<text class="care-page__complete-label">实际跟进时间</text>
				<view class="care-page__schedule-row"><picker class="care-page__schedule-picker" mode="date" :value="recordDate" @change="changeRecordDate"><view class="care-page__schedule-value"><text>{{ recordDate }}</text><text class="care-page__schedule-arrow">›</text></view></picker><picker class="care-page__schedule-picker" mode="time" :value="recordTime" @change="changeRecordTime"><view class="care-page__schedule-value"><text>{{ recordTime }}</text><text class="care-page__schedule-arrow">›</text></view></picker></view>
				<text class="care-page__complete-label">本次内容</text>
				<textarea class="care-page__complete-textarea" :value="recordContent" placeholder="如实记录沟通内容和后续约定" @input="updateRecordContent" />
				<text class="care-page__complete-label">服务前照片</text>
				<view class="care-page__photo-row"><view v-for="(photo, index) in recordBeforePhotos" :key="'before-' + index" class="care-page__photo-item"><image class="care-page__photo-image" :src="photo" mode="aspectFill" /><text class="care-page__photo-remove" @tap="removeRecordPhoto('before', index)">×</text></view><view v-if="recordBeforePhotos.length < 9" class="care-page__photo-add" @tap="chooseRecordPhotos('before')"><text>＋</text><text>拍照/选图</text></view></view>
				<text class="care-page__complete-label">服务后照片</text>
				<view class="care-page__photo-row"><view v-for="(photo, index) in recordAfterPhotos" :key="'after-' + index" class="care-page__photo-item"><image class="care-page__photo-image" :src="photo" mode="aspectFill" /><text class="care-page__photo-remove" @tap="removeRecordPhoto('after', index)">×</text></view><view v-if="recordAfterPhotos.length < 9" class="care-page__photo-add" @tap="chooseRecordPhotos('after')"><text>＋</text><text>拍照/选图</text></view></view>
				<text v-if="recordPhotoUploading" class="care-page__photo-uploading">正在上传照片…</text>
				<text v-if="recordFormMessage.length > 0" class="care-page__form-message">{{ recordFormMessage }}</text>
				<view class="care-page__complete-submit" :class="{ 'care-page__complete-submit--loading': recordSubmitting || recordPhotoUploading }" @tap="submitCreateRecord"><text>{{ recordSubmitting ? '正在保存…' : '保存客情记录' }}</text></view>
			</scroll-view>
		</view>
		<view v-if="showCreateTimePicker" class="care-page__time-sheet-mask" @tap="closeCreateTimePicker">
			<view class="care-page__time-sheet" @tap.stop>
				<view class="care-page__time-sheet-head"><text class="care-page__time-sheet-cancel" @tap="closeCreateTimePicker">取消</text><text class="care-page__time-sheet-title">选择计划时间</text><text class="care-page__time-sheet-confirm" @tap="confirmCreateTimePicker">确定</text></view>
				<text class="care-page__time-sheet-label">小时</text>
				<view class="care-page__time-choice-grid"><view v-for="hour in timeHours" :key="'hour-' + hour" class="care-page__time-choice" :class="{ 'care-page__time-choice--active': draftCreateHour === hour }" @tap.stop="selectDraftCreateHour(hour)"><text>{{ hour }}</text></view></view>
				<text class="care-page__time-sheet-label">分钟</text>
				<scroll-view scroll-y class="care-page__time-minute-list"><view class="care-page__time-choice-grid care-page__time-choice-grid--minutes"><view v-for="minute in timeMinutes" :key="'minute-' + minute" class="care-page__time-choice" :class="{ 'care-page__time-choice--active': draftCreateMinute === minute }" @tap.stop="selectDraftCreateMinute(minute)"><text>{{ minute }}</text></view></view></scroll-view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
  import MoheAiEntry from '../../../shared/components/mohe-ai-entry.uvue'
	import { completeMobileCustomerCareTask, createMobileCustomerCareRecord, createMobileCustomerCareTask, deleteMobileCustomerCareTask, queryMobileCustomerCare, startMobileCustomerCareTask, uploadMobileCustomerCarePhoto } from '../../../shared/api/mobile-customer-care-client.uts'
	import { callMobilePhone, currentMobilePlatform } from '../../../shared/platform/mobile-platform.uts'
	import { openMerchantWorkbench } from '../../../shared/platform/mobile-navigation.uts'
	const platformUsesNativeCanvas = currentMobilePlatform() === 'MP_WEIXIN'
	const tabs = [
		{ key: 'tasks', label: '跟进任务' },
		{ key: 'customers', label: '客户视图' },
		{ key: 'records', label: '客情记录' }
	]
	const buckets = [
		{ key: 'all', label: '未完成' },
		{ key: 'today', label: '今日' },
		{ key: 'overdue', label: '逾期' },
		{ key: 'future', label: '未来' },
		{ key: 'completed', label: '已完成' }
	]
	const activeTab = ref('tasks')
	const activeBucket = ref('today')
	const taskStatusGroup = ref('')
	const activeTabLabel = ref('跟进任务')
	const loading = ref(false)
	const message = ref('')
	const tasks = ref<Array<any>>([])
	const customers = ref<Array<any>>([])
	const records = ref<Array<any>>([])
	const metrics = ref<Array<any>>([])
	const selectedTask = ref<any>(null)
	const deletingTask = ref<any>(null)
	const taskActionSubmitting = ref(false)
	const taskDetailMessage = ref('')
	const completingTask = ref<any>(null)
	const completeContent = ref('')
	const methodCode = ref('PHONE')
	const resultCode = ref('FOLLOW_UP')
	const submitting = ref(false)
	const methods = ref<Array<any>>([])
	const results = ref<Array<any>>([])
	const creatingForCustomer = ref<any>(null)
	const creatingTaskPanel = ref(false)
	const taskMemberKeyword = ref('')
	const taskMemberCandidates = ref<Array<any>>([])
	const taskMemberSearched = ref(false)
	const taskMemberLoading = ref(false)
	const taskContent = ref('')
	const plannedAt = ref('')
	const plannedDate = ref('')
	const plannedTime = ref('')
	const showCreateTimePicker = ref(false)
	const draftCreateHour = ref('09')
	const draftCreateMinute = ref('00')
	const taskTypeCode = ref('FOLLOWUP')
	const ownerId = ref('')
	const creatingTask = ref(false)
	const createFormMessage = ref('')
	const createdTaskMemberId = ref('')
	const assignees = ref<Array<any>>([])
	const createNextTask = ref(false)
	const nextPlannedAt = ref('')
	const nextOwnerId = ref('')
	const taskTypes = [{ value: 'FOLLOWUP', label: '回访' }, { value: 'DAILY_FOLLOWUP', label: '日常跟进' }, { value: 'INVITATION', label: '邀约' }, { value: 'SERVICE_FEEDBACK', label: '服务反馈' }]
	const timeHours = createTimeOptions(24)
	const timeMinutes = createTimeOptions(60)
	const memberFilterId = ref('')
	const customerKeyword = ref('')
	const recordKeyword = ref('')
	const creatingRecord = ref(false)
	const recordMemberKeyword = ref('')
	const recordMemberCandidates = ref<Array<any>>([])
	const recordMemberSearched = ref(false)
	const recordMemberLoading = ref(false)
	const recordSelectedMember = ref<any>(null)
	const recordTypeCode = ref('FOLLOWUP')
	const recordMethodCode = ref('PHONE')
	const recordResultCode = ref('FOLLOW_UP')
	const recordDate = ref('')
	const recordTime = ref('')
	const recordContent = ref('')
	const recordBeforePhotos = ref<Array<string>>([])
	const recordAfterPhotos = ref<Array<string>>([])
	const recordPhotoUploading = ref(false)
	const recordSubmitting = ref(false)
	const recordFormMessage = ref('')

	onLoad((options : any) => {
		memberFilterId.value = String(options != null ? options.memberId || '' : '')
		let bucket = String(options != null ? options.bucket || '' : '')
		let statusGroup = String(options != null ? options.statusGroup || '' : '')
		if (bucket == 'all' && statusGroup == 'open') { activeBucket.value = 'all'; taskStatusGroup.value = 'open' }
	})
	onShow(() => loadWorkbench())

	function selectTab(value : string) {
		activeTab.value = value
		for (let index = 0; index < tabs.length; index++) if (tabs[index].key == value) activeTabLabel.value = tabs[index].label
		loadWorkbench()
	}
	function selectBucket(value : string) { activeBucket.value = value; taskStatusGroup.value = value == 'all' ? 'open' : ''; if (activeTab.value == 'tasks') loadWorkbench() }
	function returnToWorkbench() { openMerchantWorkbench() }
	function clearCreatedTaskFilter() { createdTaskMemberId.value = ''; loadWorkbench() }
	function selectTaskType(value : string) { taskTypeCode.value = value; createFormMessage.value = '' }
	function selectOwner(value : string) { ownerId.value = value; createFormMessage.value = '' }
	function updateCustomerKeyword(event : any) { customerKeyword.value = String(event.detail != null ? event.detail.value || '' : '') }
	function updateRecordKeyword(event : any) { recordKeyword.value = String(event.detail != null ? event.detail.value || '' : '') }
	function updateTaskMemberKeyword(event : any) { taskMemberKeyword.value = String(event.detail != null ? event.detail.value || '' : '') }
	function updateRecordMemberKeyword(event : any) { recordMemberKeyword.value = String(event.detail != null ? event.detail.value || '' : '') }
	function updateRecordContent(event : any) { recordContent.value = String(event.detail != null ? event.detail.value || '' : '') }
	function changeCreatePlannedDate(event : any) { plannedDate.value = String(event.detail != null ? event.detail.value || '' : ''); syncCreatePlannedAt() }
	function changeRecordDate(event : any) { recordDate.value = String(event.detail != null ? event.detail.value || '' : '') }
	function changeRecordTime(event : any) { recordTime.value = String(event.detail != null ? event.detail.value || '' : '') }
	function createTimeOptions(limit : number) : Array<string> { let result = new Array<string>(); for (let index = 0; index < limit; index++) result.push(index < 10 ? '0' + index.toString() : index.toString()); return result }
	function openCreateTimePicker() { let parts = plannedTime.value.split(':'); draftCreateHour.value = parts.length == 2 && parts[0].length == 2 ? parts[0] : '09'; draftCreateMinute.value = parts.length == 2 && parts[1].length == 2 ? parts[1] : '00'; showCreateTimePicker.value = true }
	function closeCreateTimePicker() { showCreateTimePicker.value = false }
	function selectDraftCreateHour(value : string) { draftCreateHour.value = value }
	function selectDraftCreateMinute(value : string) { draftCreateMinute.value = value }
	function confirmCreateTimePicker() { plannedTime.value = draftCreateHour.value + ':' + draftCreateMinute.value; syncCreatePlannedAt(); showCreateTimePicker.value = false }
	function syncCreatePlannedAt() { plannedAt.value = plannedDate.value.length > 0 && plannedTime.value.length > 0 ? plannedDate.value + ' ' + plannedTime.value : ''; if (plannedAt.value.length > 0) createFormMessage.value = '' }
	function updateTaskContent(event : any) { taskContent.value = String(event.detail != null ? event.detail.value || '' : '') }
	function canComplete(task : any) : boolean {
		return hasTaskAction(task, 'complete-care-task')
	}
	function hasTaskAction(task : any, code : string) : boolean { let actions = task != null && Array.isArray(task.availableActions) ? task.availableActions : []; for (let index = 0; index < actions.length; index++) if (actions[index].code == code && actions[index].enabled === true) return Number(task.taskVersion || 0) > 0; return false }
	function canStart(task : any) : boolean { return hasTaskAction(task, 'start-care-task') }
	function canDelete(task : any) : boolean { return hasTaskAction(task, 'delete-care-task') }
	function canCall(task : any) : boolean {
		let actions = Array.isArray(task.navigationActions) ? task.navigationActions : []
		for (let index = 0; index < actions.length; index++) if (actions[index].code == 'call-member' && actions[index].enabled === true) return true
		return false
	}
	function callCustomer(task : any) { callMobilePhone(String(task.member != null ? task.member.phone : '')) }
	function openTaskDetail(task : any) { if (task != null && String(task.taskId || '').length > 0) { selectedTask.value = task; taskDetailMessage.value = '' } }
	function closeTaskDetail() { if (!taskActionSubmitting.value) { selectedTask.value = null; deletingTask.value = null; taskDetailMessage.value = '' } }
	function openCompleteFromDetail() { if (selectedTask.value == null) return; let task = selectedTask.value; selectedTask.value = null; openComplete(task) }
	function startSelectedTask() { if (selectedTask.value == null || taskActionSubmitting.value || !canStart(selectedTask.value)) return; taskActionSubmitting.value = true; taskDetailMessage.value = ''; startMobileCustomerCareTask({ taskId: Number(selectedTask.value.taskId), expectedVersion: Number(selectedTask.value.taskVersion), idempotencyKey: 'care-start-' + Date.now().toString() + '-' + Math.floor(Math.random() * 100000).toString() }, (response : any) => { taskActionSubmitting.value = false; if (!response.ok) { taskDetailMessage.value = String(response.message || '开始跟进失败。'); return }; selectedTask.value = null; loadWorkbench() }) }
	function requestDeleteSelectedTask() { if (selectedTask.value != null && !taskActionSubmitting.value && canDelete(selectedTask.value)) deletingTask.value = selectedTask.value }
	function cancelDeleteTask() { if (!taskActionSubmitting.value) deletingTask.value = null }
	function confirmDeleteTask() { if (deletingTask.value == null || taskActionSubmitting.value || !canDelete(deletingTask.value)) return; taskActionSubmitting.value = true; taskDetailMessage.value = ''; deleteMobileCustomerCareTask({ taskId: Number(deletingTask.value.taskId), expectedVersion: Number(deletingTask.value.taskVersion), reason: '用户确认删除未开始任务', idempotencyKey: 'care-delete-' + Date.now().toString() + '-' + Math.floor(Math.random() * 100000).toString() }, (response : any) => { taskActionSubmitting.value = false; if (!response.ok) { deletingTask.value = null; taskDetailMessage.value = String(response.message || '删除任务失败。'); return }; deletingTask.value = null; selectedTask.value = null; loadWorkbench() }) }
	function openComplete(task : any) { completingTask.value = task; completeContent.value = ''; methodCode.value = 'PHONE'; resultCode.value = 'FOLLOW_UP'; createNextTask.value = false; nextPlannedAt.value = ''; nextOwnerId.value = assignees.value.length > 0 ? String(assignees.value[0].value) : ''; message.value = '' }
	function closeComplete() { if (!submitting.value) completingTask.value = null }
	function openFloatingCreate() { if (activeTab.value == 'records') openCreateRecord(); else openCreateTask(null) }
	function openCreateTask(customer : any) { creatingTaskPanel.value = true; creatingForCustomer.value = customer; taskMemberKeyword.value = ''; taskMemberCandidates.value = []; taskMemberSearched.value = false; taskMemberLoading.value = false; taskContent.value = ''; plannedAt.value = ''; plannedDate.value = ''; plannedTime.value = ''; showCreateTimePicker.value = false; taskTypeCode.value = 'FOLLOWUP'; ownerId.value = assignees.value.length > 0 ? String(assignees.value[0].value) : ''; createFormMessage.value = ''; message.value = '' }
	function closeCreateTask() { if (!creatingTask.value) { creatingTaskPanel.value = false; creatingForCustomer.value = null; taskMemberCandidates.value = []; showCreateTimePicker.value = false; createFormMessage.value = '' } }
	function clearTaskMember() { if (!creatingTask.value) { creatingForCustomer.value = null; taskMemberCandidates.value = []; taskMemberSearched.value = false } }
	function searchTaskMembers() {
		if (taskMemberLoading.value) return
		let keyword = taskMemberKeyword.value.trim()
		if (keyword.length == 0) { createFormMessage.value = '请输入会员姓名、手机号或会员编号。'; return }
		taskMemberLoading.value = true
		taskMemberSearched.value = true
		createFormMessage.value = ''
		queryMobileCustomerCare({ view: 'customers', query: { keyword: keyword } }, (response : any) => {
			taskMemberLoading.value = false
			let projection = response != null && response.body != null && response.body.projection != null ? response.body.projection.customerCare : null
			if (!response.ok || projection == null || projection.customerView == null) { createFormMessage.value = String(response.message || '会员查询暂时不可用。'); return }
			taskMemberCandidates.value = Array.isArray(projection.customerView.records) ? projection.customerView.records : []
		})
	}
	function selectTaskMember(member : any) { if (member == null || String(member.memberId || '').length == 0) return; creatingForCustomer.value = member; taskMemberCandidates.value = []; taskMemberSearched.value = false; createFormMessage.value = '' }
	function submitComplete() {
		if (completingTask.value == null || submitting.value) return
		let content = completeContent.value.trim()
		if (content.length == 0) { message.value = '请如实填写本次客情内容。'; return }
		if (createNextTask.value && (nextOwnerId.value.length == 0 || nextPlannedAt.value.trim().length == 0)) { message.value = '请填写下一次跟进时间并选择负责人。'; return }
		submitting.value = true
		completeMobileCustomerCareTask({ taskId: completingTask.value.taskId, expectedVersion: Number(completingTask.value.taskVersion), methodCode: methodCode.value, resultCode: resultCode.value, content: content, createNextTask: createNextTask.value, nextPlannedAt: nextPlannedAt.value.trim(), nextOwnerId: Number(nextOwnerId.value), idempotencyKey: 'care-complete-' + Date.now().toString() + '-' + Math.floor(Math.random() * 100000).toString() }, (response : any) => {
			submitting.value = false
			if (!response.ok) { message.value = String(response.message || '客情记录保存失败。'); return }
			completingTask.value = null
			loadWorkbench()
		})
	}
	function submitCreateTask() {
		if (creatingTask.value) return
		if (creatingForCustomer.value == null) { createFormMessage.value = '请选择会员。'; return }
		if (ownerId.value.length == 0) { createFormMessage.value = '请选择负责人。'; return }
		if (plannedAt.value.trim().length == 0) { createFormMessage.value = '请选择计划跟进时间。'; return }
		createFormMessage.value = ''
		creatingTask.value = true
		createMobileCustomerCareTask({ memberId: creatingForCustomer.value.memberId, ownerId: Number(ownerId.value), taskTypeCode: taskTypeCode.value, plannedAt: plannedAt.value.trim(), content: taskContent.value.trim(), idempotencyKey: 'care-create-' + Date.now().toString() + '-' + Math.floor(Math.random() * 100000).toString() }, (response : any) => {
			creatingTask.value = false
			if (!response.ok) { createFormMessage.value = String(response.message || '客情任务创建失败。'); return }
			createdTaskMemberId.value = String(creatingForCustomer.value.memberId)
			creatingTaskPanel.value = false
			creatingForCustomer.value = null
			createFormMessage.value = ''
			activeTab.value = 'tasks'
			activeTabLabel.value = '跟进任务'
			activeBucket.value = 'all'
			taskStatusGroup.value = 'open'
			loadWorkbench()
		})
	}

	function openCreateRecord() {
		creatingRecord.value = true
		recordMemberKeyword.value = ''
		recordMemberCandidates.value = []
		recordMemberSearched.value = false
		recordMemberLoading.value = false
		recordSelectedMember.value = null
		recordTypeCode.value = 'FOLLOWUP'
		recordMethodCode.value = methods.value.length > 0 ? String(methods.value[0].value) : 'PHONE'
		recordResultCode.value = results.value.length > 0 ? String(results.value[0].value) : 'FOLLOW_UP'
		let now = new Date(Date.now() - 60000)
		recordDate.value = now.getFullYear().toString() + '-' + twoDigits(now.getMonth() + 1) + '-' + twoDigits(now.getDate())
		recordTime.value = twoDigits(now.getHours()) + ':' + twoDigits(now.getMinutes())
		recordContent.value = ''
		recordBeforePhotos.value = []
		recordAfterPhotos.value = []
		recordPhotoUploading.value = false
		recordFormMessage.value = ''
	}

	function closeCreateRecord() { if (!recordSubmitting.value) creatingRecord.value = false }
	function clearRecordMember() { if (!recordSubmitting.value) { recordSelectedMember.value = null; recordMemberCandidates.value = []; recordMemberSearched.value = false } }
	function twoDigits(value : number) : string { return value < 10 ? '0' + value.toString() : value.toString() }
	function chooseRecordPhotos(kind : string) {
		if (recordPhotoUploading.value || recordSubmitting.value) return
		let current = kind == 'before' ? recordBeforePhotos.value : recordAfterPhotos.value
		let remaining = 9 - current.length
		if (remaining <= 0) return
		uni.chooseImage({ count: remaining, sizeType: ['compressed'], sourceType: ['album', 'camera'], success: (result : any) => {
			let paths = result != null && Array.isArray(result.tempFilePaths) ? result.tempFilePaths : []
			uploadRecordPhotos(kind, paths, 0)
		}, fail: () => { recordFormMessage.value = '未选择服务照片。' } })
	}
	function uploadRecordPhotos(kind : string, paths : Array<any>, index : number) {
		if (index >= paths.length) { recordPhotoUploading.value = false; return }
		recordPhotoUploading.value = true
		let key = 'CARE_PHOTO-' + Date.now().toString() + '-' + Math.floor(Math.random() * 100000).toString()
		uploadMobileCustomerCarePhoto(String(paths[index]), key, (response : any) => {
			if (!response.ok || response.body == null || String(response.body.photoUrl || '').length == 0) {
				recordPhotoUploading.value = false
				recordFormMessage.value = String(response.message || '服务照片上传失败，请重试。')
				return
			}
			if (kind == 'before') recordBeforePhotos.value.push(String(response.body.photoUrl))
			else recordAfterPhotos.value.push(String(response.body.photoUrl))
			uploadRecordPhotos(kind, paths, index + 1)
		})
	}
	function removeRecordPhoto(kind : string, index : number) {
		if (recordPhotoUploading.value || recordSubmitting.value) return
		if (kind == 'before') recordBeforePhotos.value.splice(index, 1)
		else recordAfterPhotos.value.splice(index, 1)
	}

	function searchRecordMembers() {
		if (recordMemberLoading.value) return
		let keyword = recordMemberKeyword.value.trim()
		if (keyword.length == 0) { recordFormMessage.value = '请输入会员姓名、手机号或会员编号。'; return }
		recordMemberLoading.value = true
		recordMemberSearched.value = true
		recordFormMessage.value = ''
		queryMobileCustomerCare({ view: 'customers', query: { keyword: keyword } }, (response : any) => {
			recordMemberLoading.value = false
			let projection = response != null && response.body != null && response.body.projection != null ? response.body.projection.customerCare : null
			if (!response.ok || projection == null || projection.customerView == null) { recordFormMessage.value = String(response.message || '会员查询暂时不可用。'); return }
			recordMemberCandidates.value = Array.isArray(projection.customerView.records) ? projection.customerView.records : []
		})
	}

	function selectRecordMember(member : any) {
		if (member == null || String(member.memberId || '').length == 0) return
		recordSelectedMember.value = member
		recordMemberCandidates.value = []
		recordMemberSearched.value = false
		recordFormMessage.value = ''
	}

	function submitCreateRecord() {
		if (recordSubmitting.value || recordPhotoUploading.value) return
		if (recordSelectedMember.value == null) { recordFormMessage.value = '请选择会员。'; return }
		let content = recordContent.value.trim()
		if (content.length == 0) { recordFormMessage.value = '请如实填写本次客情内容。'; return }
		if (recordDate.value.length == 0 || recordTime.value.length == 0) { recordFormMessage.value = '请选择实际跟进时间。'; return }
		recordSubmitting.value = true
		recordFormMessage.value = ''
		createMobileCustomerCareRecord({
			memberId: Number(recordSelectedMember.value.memberId),
			recordTypeCode: recordTypeCode.value,
			followedAt: recordDate.value + ' ' + recordTime.value,
			methodCode: recordMethodCode.value,
			resultCode: recordResultCode.value,
			content: content,
			beforePhotos: recordBeforePhotos.value,
			afterPhotos: recordAfterPhotos.value,
			idempotencyKey: 'care-record-' + Date.now().toString() + '-' + Math.floor(Math.random() * 100000).toString()
		}, (response : any) => {
			recordSubmitting.value = false
			if (!response.ok) { recordFormMessage.value = String(response.message || '客情记录保存失败。'); return }
			creatingRecord.value = false
			loadWorkbench()
		})
	}

	function loadWorkbench() {
		loading.value = true
		message.value = ''
		let request : any = { view: activeTab.value, query: {} }
		let taskMemberId = memberFilterId.value.length > 0 ? Number(memberFilterId.value) : Number(createdTaskMemberId.value)
		if (activeTab.value == 'tasks') request.query = taskMemberId > 0
			? (taskStatusGroup.value == 'open'
				? { memberId: taskMemberId, bucket: 'all', statusGroup: 'open' }
				: { memberId: taskMemberId, scope: 'my', bucket: activeBucket.value })
			: (taskStatusGroup.value == 'open'
				? { bucket: 'all', statusGroup: 'open' }
				: { scope: 'my', bucket: activeBucket.value })
		if (activeTab.value == 'customers') request.query = memberFilterId.value.length > 0
			? { memberId: Number(memberFilterId.value) }
			: { keyword: customerKeyword.value.trim() }
		if (activeTab.value == 'records') request.query = memberFilterId.value.length > 0
			? { memberId: Number(memberFilterId.value), stream: 'human', dataScope: 'normal' }
			: { keyword: recordKeyword.value.trim(), stream: 'human', dataScope: 'normal' }
		queryMobileCustomerCare(request, (response : any) => {
			loading.value = false
			if (!response.ok || response.body == null || response.body.projection == null || response.body.projection.customerCare == null) { message.value = String(response.message || '客情数据暂时不可用。'); return }
			let projection = response.body.projection.customerCare
			tasks.value = Array.isArray(projection.taskView.records) ? projection.taskView.records : []
			customers.value = normalizeCustomers(Array.isArray(projection.customerView.records) ? projection.customerView.records : [])
			records.value = Array.isArray(projection.recordView.records) ? projection.recordView.records : []
			metrics.value = Array.isArray(projection.statistics.metrics) ? projection.statistics.metrics : []
			let completion = projection.preparations != null && projection.preparations.completion != null ? projection.preparations.completion : {}
			methods.value = Array.isArray(completion.methodOptions) ? completion.methodOptions : []
			let serverResults = Array.isArray(completion.resultOptions) ? completion.resultOptions : []
			let enabledResults = new Array<any>()
			for (let index = 0; index < serverResults.length; index++) if (serverResults[index].enabled !== false) enabledResults.push(serverResults[index])
			results.value = enabledResults
			assignees.value = Array.isArray(completion.assigneeOptions) ? completion.assigneeOptions : []
		})
	}

	function normalizeCustomers(source : Array<any>) : Array<any> {
		let result = new Array<any>()
		for (let index = 0; index < source.length; index++) {
			let customer = source[index]
			let nextTask = customer.nextTask
			let taskLabel = nextTask != null && typeof nextTask === 'object' ? String(nextTask.label || nextTask.statusLabel || '暂无待跟进任务') : String(nextTask || '暂无待跟进任务')
			let latestCare = customer.latestCare
			let careLabel = latestCare != null && typeof latestCare === 'object' ? String(latestCare.summary || latestCare.label || '暂无跟进记录') : String(latestCare || '暂无跟进记录')
			customer.nextTaskLabel = taskLabel
			customer.latestCareLabel = careLabel
			result.push(customer)
		}
		return result
	}
</script>

<style>
	.care-page { display: flex; flex: 1; height: 100%; min-height: 0; flex-direction: column; overflow: hidden; background-color: #f5f7fa; }
	.care-page__header { display: flex; flex-direction: column; padding: 52px 20px 16px 20px; border-bottom-width: 1px; border-bottom-style: solid; border-bottom-color: #dde4ed; background-color: #ffffff; }
	.care-page__eyebrow { font-size: 12px; font-weight: 600; line-height: 18px; color: #697586; }
	.care-page__title { margin-top: 6px; font-size: 24px; font-weight: 700; line-height: 34px; color: #1f2329; }
	.care-page__tabs { display: flex; min-height: 48px; flex-direction: row; align-items: stretch; border-bottom-width: 1px; border-bottom-style: solid; border-bottom-color: #dde4ed; background-color: #ffffff; }
	.care-page__tab { display: flex; min-width: 0; flex: 1; height: 48px; flex-direction: row; align-items: center; justify-content: center; border-bottom-width: 2px; border-bottom-style: solid; border-bottom-color: #ffffff; font-size: 12px; font-weight: 600; line-height: 18px; color: #697586; }
	.care-page__tab--active { border-bottom-color: #1677cc; color: #1677cc; }
	.care-page__filters { padding: 12px 20px 12px 20px; background-color: #ffffff; }
	.care-page__segment { display: flex; height: 34px; flex-direction: row; border-width: 1px; border-style: solid; border-color: #d8e0ea; }
