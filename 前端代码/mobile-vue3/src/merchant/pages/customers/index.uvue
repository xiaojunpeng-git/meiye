		font-size: 13px;
		line-height: 20px;
		color: #697586;
	}

	.customer-filter__field-grid {
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
		margin-top: 14px;
	}

	.customer-filter__field {
		display: flex;
		min-width: 96px;
		height: 34px;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		margin-right: 8px;
		margin-bottom: 8px;
		padding: 0px 10px 0px 10px;
		border-width: 1px;
		border-style: solid;
		border-color: #d8e0ea;
		background-color: #ffffff;
		font-size: 13px;
		line-height: 20px;
		color: #526071;
	}

	.customer-filter__field--selected {
		border-color: #1677cc;
		background-color: #f1f8ff;
		color: #1677cc;
	}

	.customer-filter__condition-heading { display: flex; min-height: 28px; flex-direction: row; align-items: center; justify-content: space-between; }
	.customer-filter__date-shortcut { display: flex; min-height: 28px; flex-direction: row; align-items: center; padding: 0 8px; border-width: 1px; border-style: solid; border-color: #d8e0ea; background-color: #ffffff; font-size: 12px; color: #3e5f7a; }
	.customer-filter__operator-row { display: flex; flex-direction: row; flex-wrap: wrap; margin-top: 8px; margin-bottom: -6px; }
	.customer-filter__operator-option { display: flex; min-width: 54px; min-height: 30px; flex-direction: row; align-items: center; justify-content: center; margin-right: 6px; margin-bottom: 6px; padding: 0 9px; border-width: 1px; border-style: solid; border-color: #d8e0ea; background-color: #ffffff; font-size: 12px; color: #526071; }
	.customer-filter__operator-option--active { border-color: #1677cc; background-color: #f1f8ff; color: #1677cc; }
	.customer-filter__shortcut-row { display: flex; flex-wrap: wrap; flex-direction: row; margin-top: 8px; margin-bottom: -6px; }
	.customer-filter__shortcut { display: flex; min-height: 30px; flex-direction: row; align-items: center; justify-content: center; margin-right: 6px; margin-bottom: 6px; padding: 0 9px; border-width: 1px; border-style: solid; border-color: #d8e0ea; background-color: #ffffff; font-size: 12px; color: #526071; }
	.customer-filter__shortcut--active { border-color: #1677cc; background-color: #f1f8ff; color: #1677cc; }
	.customer-filter__value-row { display: flex; min-height: 42px; flex-direction: row; margin-top: 8px; }
	.customer-filter__value-input, .customer-filter__value-picker {
		box-sizing: border-box;
		min-width: 0;
		flex: 1;
		height: 42px;
		padding: 0 12px;
		border-width: 1px;
		border-style: solid;
		border-color: #d8e0ea;
		background-color: #ffffff;
		font-size: 14px;
		color: #1f2329;
	}
	.customer-filter__value-picker { display: flex; flex-direction: row; align-items: center; }
	.customer-filter__value-unit { display: flex; width: 36px; align-items: center; justify-content: center; font-size: 14px; color: #526071; }
	.customer-filter__value-input + .customer-filter__value-input, .customer-filter__value-picker + .customer-filter__value-picker { margin-left: 8px; }

	.customer-filter__condition { display: flex; flex-direction: column; margin-top: 14px; }
	.customer-filter__condition-label { font-size: 13px; font-weight: 600; line-height: 20px; color: #526071; }

	.customer-group-entry__body {
		display: flex;
		flex: 1;
		flex-direction: column;
		justify-content: center;
		padding: 24px 32px 64px 32px;
	}

	.customer-group-entry__headline {
		font-size: 20px;
		font-weight: 700;
		line-height: 28px;
		color: #303133;
	}

	.customer-group-entry__copy {
		margin-top: 10px;
		font-size: 14px;
		line-height: 22px;
		color: #697586;
	}

	.customer-page__list {
		display: flex;
		flex-direction: column;
		padding: 12px 16px 28px 16px;
	}

	.customer-page__tabs-bottom { position: fixed; z-index: 40; right: 0; bottom: 0; left: 0; display: flex; min-height: 72px; flex-direction: row; padding: 6px 0 10px 0; border-top-width: 1px; border-top-style: solid; border-top-color: rgba(216, 226, 239, 0.92); background-color: rgba(255, 255, 255, 0.97); box-shadow: 0 -10px 26px rgba(35, 70, 110, 0.1); }
	.customer-page__tab-bottom { position: relative; display: flex; min-width: 0; flex: 1; flex-direction: column; align-items: center; justify-content: center; background-color: transparent; font-size: 11px; font-weight: 600; line-height: 15px; color: #728198; }
	.customer-page__tab-bottom text { margin-top: 4px; font-size: 11px; line-height: 15px; color: #728198; text-align: center; }
	.customer-page__tab-bottom--active { background-color: transparent; color: #1677cc; }
	.customer-page__tab-bottom--active text { font-weight: 700; color: #1677cc; }
	.customer-page__tab-icon { position: relative; display: flex; width: 24px; height: 24px; align-items: center; justify-content: center; border-radius: 12px; background-color: #edf3f8; box-shadow: inset 0 0 0 1px rgba(214, 225, 238, 0.9); }
	.customer-page__tab-icon::before, .customer-page__tab-icon::after { position: absolute; display: block; content: ''; box-sizing: border-box; }
	.customer-page__tab-bottom--active .customer-page__tab-icon { background-color: #1677cc; box-shadow: 0 6px 14px rgba(22, 119, 204, 0.22); }
	.customer-page__tab-bottom--warehouse .customer-page__tab-icon::before { width: 15px; height: 12px; border-width: 2px; border-style: solid; border-color: #7d91a8; border-radius: 3px; }
	.customer-page__tab-bottom--warehouse .customer-page__tab-icon::after { width: 9px; height: 2px; background-color: #7d91a8; box-shadow: 0 -4px 0 #7d91a8, 0 4px 0 #7d91a8; }
	.customer-page__tab-bottom--customers .customer-page__tab-icon::before { width: 8px; height: 8px; margin-top: -6px; border-radius: 4px; background-color: #7d91a8; box-shadow: 7px 3px 0 -1px #7d91a8; }
	.customer-page__tab-bottom--customers .customer-page__tab-icon::after { width: 17px; height: 8px; margin-top: 8px; border-radius: 8px 8px 3px 3px; background-color: #7d91a8; }
	.customer-page__tab-bottom--workbench .customer-page__tab-icon::before { width: 15px; height: 15px; border-width: 2px; border-style: solid; border-color: #7d91a8; border-radius: 3px; }
	.customer-page__tab-bottom--workbench .customer-page__tab-icon::after { width: 2px; height: 15px; background-color: #7d91a8; box-shadow: 6px 0 0 #7d91a8, -6px 0 0 #7d91a8; }
	.customer-page__tab-bottom--goals .customer-page__tab-icon::before { width: 16px; height: 16px; border-width: 2px; border-style: solid; border-color: #7d91a8; border-radius: 8px; }
	.customer-page__tab-bottom--goals .customer-page__tab-icon::after { width: 8px; height: 5px; border-left-width: 2px; border-left-style: solid; border-left-color: #7d91a8; border-bottom-width: 2px; border-bottom-style: solid; border-bottom-color: #7d91a8; transform: rotate(-45deg); }
	.customer-page__tab-bottom--profile .customer-page__tab-icon::before { width: 8px; height: 8px; margin-top: -6px; border-radius: 4px; background-color: #7d91a8; }
	.customer-page__tab-bottom--profile .customer-page__tab-icon::after { width: 15px; height: 8px; margin-top: 8px; border-radius: 8px 8px 3px 3px; background-color: #7d91a8; }
	.customer-page__tab-bottom--active .customer-page__tab-icon::before { border-color: #ffffff; background-color: transparent; }
	.customer-page__tab-bottom--active .customer-page__tab-icon::after { border-color: #ffffff; background-color: #ffffff; box-shadow: 0 -4px 0 #ffffff, 0 4px 0 #ffffff; }
	.customer-page__tab-bottom--active.customer-page__tab-bottom--customers .customer-page__tab-icon::before, .customer-page__tab-bottom--active.customer-page__tab-bottom--customers .customer-page__tab-icon::after, .customer-page__tab-bottom--active.customer-page__tab-bottom--profile .customer-page__tab-icon::before, .customer-page__tab-bottom--active.customer-page__tab-bottom--profile .customer-page__tab-icon::after { background-color: #ffffff; box-shadow: none; }
	.customer-page__tab-bottom--active.customer-page__tab-bottom--goals .customer-page__tab-icon::before { background-color: transparent; }
	.customer-page__tab-bottom--active.customer-page__tab-bottom--goals .customer-page__tab-icon::after { background-color: transparent; box-shadow: none; }

	.customer-page__customer-card,
	.customer-page__audience-card {
		display: flex;
		flex-direction: column;
		padding: 16px;
		margin-bottom: 10px;
		border-width: 1px;
		border-style: solid;
		border-color: #e5eaf0;
		background-color: #ffffff;
	}

	.customer-page__customer-card { border-color: #e6e9ed; border-radius: 8px; }

	.customer-page__customer-heading {
		display: flex;
		flex-direction: row;
		align-items: center;
	}

	.customer-page__customer-avatar { display: flex; width: 40px; height: 40px; flex-direction: row; align-items: center; justify-content: center; border-radius: 20px; background-color: #e9f3fb; font-size: 16px; font-weight: 700; line-height: 22px; color: #17689e; }
	.customer-page__customer-identity { display: flex; min-width: 0; flex: 1; flex-direction: column; margin-left: 11px; }
	.customer-page__customer-title-line { display: flex; min-width: 0; flex-direction: row; align-items: center; }

	.customer-page__customer-name,
	.customer-page__audience-name {
		font-size: 16px;
		font-weight: 700;
		line-height: 22px;
		color: #1f2329;
	}

	.customer-page__customer-tag { margin-left: 6px; padding: 2px 6px; border-radius: 3px; background-color: #f1f3f5; font-size: 10px; line-height: 16px; color: #66717f; }
	.customer-page__customer-tag--level { background-color: #fff4df; color: #9a6116; }
	.customer-page__customer-primary-meta { margin-top: 3px; font-size: 12px; line-height: 18px; color: #7b8694; }
	.customer-page__customer-relation-meta { margin-top: 10px; font-size: 12px; line-height: 18px; color: #596777; }
	.customer-page__customer-chevron { margin-left: 8px; font-size: 24px; line-height: 28px; color: #a7afb9; }

	.customer-page__customer-metrics {
		display: flex;
		flex-direction: row;
		margin-top: 13px;
		padding: 11px 0px 2px 0px;
		border-top-width: 1px;
		border-top-style: solid;
		border-top-color: #eef0f2;
	}

	.customer-page__customer-metric { display: flex; min-width: 0; flex: 1; flex-direction: column; }
	.customer-page__customer-metric-value { font-size: 14px; font-weight: 700; line-height: 20px; color: #26313c; }
	.customer-page__customer-metric-label { margin-top: 2px; font-size: 10px; line-height: 16px; color: #929ba6; }

	.customer-page__customer-extra-fields {
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
		margin-top: 8px;
		padding-top: 8px;
		border-top-width: 1px;
		border-top-style: solid;
		border-top-color: #f0f2f4;
	}

	.customer-page__customer-extra-field { display: flex; min-width: 50%; flex: 1; flex-direction: row; padding: 3px 10px 3px 0px; box-sizing: border-box; }
	.customer-page__customer-extra-label {
		font-size: 11px;
		font-weight: 600;
		line-height: 18px;
		color: #929ba6;
	}
	.customer-page__customer-extra-value { min-width: 0; flex: 1; margin-left: 5px; font-size: 11px; line-height: 18px; color: #596777; }

	.customer-page__audience-copy {
		margin-top: 6px;
		font-size: 13px;
		line-height: 19px;
		color: #697586;
	}

	.customer-group-entry__input {
		height: 42px;
		margin-top: 18px;
		padding: 0px 12px 0px 12px;
		border-width: 1px;
		border-style: solid;
		border-color: #d8e0ea;
		background-color: #ffffff;
		font-size: 15px;
		color: #1f2329;
	}
	.customer-group-entry__input--next { margin-top: 10px; }
	.customer-group-entry__error { margin-top: 12px; font-size: 13px; line-height: 20px; color: #c03c36; }

	.customer-group-entry__command {
		display: flex;
		width: 116px;
		height: 36px;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		margin-top: 20px;
		border-width: 1px;
		border-style: solid;
		border-color: #b8d6ef;
		background-color: #f7fbff;
		font-size: 13px;
		font-weight: 600;
		line-height: 20px;
		color: #1677cc;
	}

	.customer-group-entry__command--disabled {
		border-color: #d8e0ea;
		background-color: #f2f4f7;
		color: #98a2b3;
	}

	/* Merchant visual shell: keep existing customer behavior while sharing the
	 * warehouse page's mobile spacing, card treatment, and fixed icon tabbar. */
	.customer-page { background-color: #f6f9fc; }
	.customer-page__header { padding: 20px 18px 12px 18px; border-bottom-width: 0; background-color: transparent; }
	.customer-page__eyebrow { display: none; }
	.customer-page__title-row { margin-top: 0; align-items: center; justify-content: flex-start; }
	.customer-page__title { font-size: 20px; line-height: 28px; color: #173451; }
	.customer-page__org-filter { display: flex; box-sizing: border-box; width: 160px; min-width: 100px; height: 36px; align-items: center; justify-content: center; padding: 0 10px; border-width: 1px; border-style: solid; border-color: rgba(215, 226, 241, 0.9); border-radius: 18px; background-color: rgba(255, 255, 255, 0.88); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.7), 0 8px 20px rgba(63, 93, 137, 0.08); }
	.customer-page__org-filter text { overflow: hidden; width: 100%; font-size: 13px; font-weight: 700; line-height: 34px; color: #71839a; text-align: center; text-overflow: ellipsis; white-space: nowrap; }
	.customer-page__store { display: flex; min-width: 0; max-width: 166px; flex-direction: row; align-items: center; justify-content: flex-end; padding: 6px 9px; border-radius: 8px; background-color: #f2f7fc; }
	.customer-page__store-copy { display: flex; min-width: 0; flex-direction: column; align-items: flex-end; }
	.customer-page__store-label { font-size: 10px; font-weight: 600; line-height: 15px; color: #71839a; }
	.customer-page__store-name { max-width: 116px; overflow: hidden; font-size: 12px; font-weight: 700; line-height: 18px; color: #38516a; text-overflow: ellipsis; white-space: nowrap; }
	.customer-page__store-action { flex-shrink: 0; margin-left: 7px; font-size: 11px; font-weight: 700; color: #1677cc; }
	.customer-page__store-error { margin: 8px 18px 0 18px; padding: 8px 10px; border-radius: 8px; background-color: #fff2f0; font-size: 12px; line-height: 18px; color: #b14b44; }
	.customer-page__header-actions { justify-content: flex-end; margin-top: 10px; }
	.customer-page__new-group, .customer-page__new-customer { min-height: 32px; border-radius: 8px; }
	.customer-page__tabs { min-height: 42px; margin: 0 18px; padding: 0; border-bottom-color: #dfe8f2; background-color: transparent; }
	.customer-page__tab { font-size: 13px; color: #71839a; }
	.customer-page__tab--active { border-bottom-color: #1677cc; color: #1677cc; }
	.customer-page__tab-action { display: flex; height: 36px; flex-direction: row; align-items: center; justify-content: center; margin: 10px 18px 0 18px; border-radius: 10px; background-color: #eaf3ff; font-size: 13px; font-weight: 700; line-height: 20px; color: #1677cc; }
	.customer-page__tab-action-icon { margin-right: 5px; font-size: 20px; font-weight: 600; line-height: 20px; color: #1677cc; }
	.customer-page__floating-action { position: fixed; z-index: 105; right: 18px; bottom: 84px; display: flex; width: 54px; height: 54px; flex-direction: row; align-items: center; justify-content: center; border-radius: 27px; background-color: #7b4ff0; box-shadow: 0 8px 18px rgba(92, 58, 193, 0.32); }
	.customer-page__floating-action text { margin-top: -2px; font-size: 34px; font-weight: 300; line-height: 38px; color: #ffffff; }
	.customer-page__query-bar { padding: 12px 18px 8px 18px; background-color: transparent; }
	.customer-page__search { height: 40px; border-width: 1px; border-style: solid; border-color: #e3eaf2; border-radius: 12px; background-color: #ffffff; box-shadow: 0 5px 14px rgba(60, 88, 130, 0.06); }
	.customer-page__search-input { height: 22px; padding: 0px; border-width: 0; border-style: none; border-color: transparent; outline-style: none; background-color: transparent; font-size: 13px; line-height: 22px; color: #26384d; }
	.customer-page__search-input input { padding: 0px; border-width: 0; border-style: none; border-color: transparent; outline-style: none; background-color: transparent; font-size: 13px; line-height: 22px; color: #26384d; }
	.customer-page__search .uni-input-input { box-sizing: border-box; width: 100%; height: 22px; padding: 0px; border-width: 0px !important; border-style: none !important; outline: none !important; background: transparent; font-size: 13px; line-height: 22px; color: #26384d; }
	.customer-page__search .uni-input-wrapper { display: flex; align-items: center; height: 22px; border-width: 0px; background: transparent; }
	.customer-page__search :deep(.uni-input-input) { box-sizing: border-box; width: 100%; height: 22px; padding: 0px; border-width: 0px !important; border-style: none !important; outline: none !important; background: transparent; }
	:deep(.uni-input-input) { border-width: 0px !important; border-style: none !important; outline: none !important; background: transparent; }
	.customer-page__search-input input::placeholder { color: #9aa8b6; }
	.customer-page__filter-button, .customer-page__field-settings { height: 36px; border-width: 0; border-radius: 8px; background-color: #ffffff; box-shadow: 0 4px 12px rgba(60, 88, 130, 0.07); }
	.customer-page__scope-row { min-height: 30px; padding: 0 18px; background-color: transparent; }
	.customer-page__scope-label { font-size: 12px; color: #71839a; }
	.customer-page__audience-tabs { display: flex; height: 38px; flex-direction: row; align-items: center; margin: 0 18px; border-bottom-width: 1px; border-bottom-style: solid; border-bottom-color: #dfe8f2; background-color: transparent; }
	.customer-page__audience-tab { display: flex; height: 38px; min-width: 64px; flex-direction: row; align-items: center; justify-content: center; margin-right: 18px; border-bottom-width: 2px; border-bottom-style: solid; border-bottom-color: transparent; font-size: 13px; font-weight: 600; line-height: 20px; color: #71839a; }
	.customer-page__audience-tab--active { border-bottom-color: #1677cc; color: #1677cc; }
	.customer-page__audience-breadcrumbs { display: flex; min-height: 28px; margin: 0 18px; white-space: nowrap; }
	.customer-page__audience-breadcrumbs-inner { display: flex; min-height: 28px; flex-direction: row; align-items: center; }
	.customer-page__audience-breadcrumb { font-size: 11px; line-height: 18px; color: #5e86a5; }
	.customer-page__content { padding: 8px 0 104px 0; }
	.customer-page__list { padding: 8px 18px 24px 18px; }
	.customer-page__customer-card { margin-bottom: 10px; padding: 14px; border-width: 0; border-radius: 8px; box-shadow: 0 8px 20px rgba(60, 88, 130, 0.08); }
	.customer-page__audience-card { display: flex; min-height: 76px; flex-direction: row; align-items: center; margin-bottom: 10px; padding: 13px 14px; border-width: 0; border-radius: 8px; background-color: #ffffff; box-shadow: 0 8px 20px rgba(60, 88, 130, 0.08); }
	.customer-page__audience-card-icon { display: flex; width: 42px; height: 42px; flex-shrink: 0; flex-direction: row; align-items: center; justify-content: center; border-radius: 8px; font-size: 17px; font-weight: 700; line-height: 20px; }
	.customer-page__audience-card-icon--sleep { background-color: #eaf1ff; color: #4a72c5; }
	.customer-page__audience-card-icon--birthday { background-color: #fff2df; color: #c57a28; }
	.customer-page__audience-card-icon--group { background-color: #e7f5ee; color: #22865f; }
	.customer-page__audience-card-body { display: flex; min-width: 0; flex: 1; flex-direction: column; margin-left: 12px; }
	.customer-page__audience-card-body .customer-page__audience-name { overflow: hidden; font-size: 15px; font-weight: 700; line-height: 22px; text-overflow: ellipsis; white-space: nowrap; color: #26384d; }
	.customer-page__audience-card-body .customer-page__audience-copy { margin-top: 3px; font-size: 12px; line-height: 18px; color: #71839a; }
	.customer-page__audience-card-summary { display: flex; flex-shrink: 0; flex-direction: row; align-items: center; margin-left: 10px; }
	.customer-page__audience-card-total { font-size: 15px; font-weight: 700; line-height: 22px; color: #1677cc; }
	.customer-page__audience-card-chevron { margin-left: 7px; font-size: 21px; line-height: 24px; color: #9eacbb; }
	.customer-page__audience-overview-list { padding-top: 10px; }
	.customer-page__audience-overview-card { display: flex; flex-direction: column; padding: 15px 14px 14px 14px; margin-bottom: 12px; border-width: 0; border-radius: 8px; background-color: #ffffff; box-shadow: 0 8px 20px rgba(60, 88, 130, 0.08); }
	.customer-page__audience-heading { display: flex; min-width: 0; flex-direction: row; align-items: center; justify-content: space-between; }
	.customer-page__audience-total { flex-shrink: 0; margin-left: 12px; font-size: 16px; font-weight: 700; line-height: 22px; color: #1677cc; }
	.customer-page__audience-caption { margin-top: 3px; font-size: 11px; line-height: 17px; color: #71839a; }
	.customer-page__audience-bars { display: flex; flex-direction: column; margin-top: 13px; padding-top: 10px; border-top-width: 1px; border-top-style: solid; border-top-color: #edf1f5; }
	.customer-page__audience-bar-row { display: flex; flex-direction: column; margin-top: 9px; }
	.customer-page__audience-bar-row:first-child { margin-top: 0; }
	.customer-page__audience-bar-label { display: flex; min-width: 0; flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 5px; font-size: 12px; line-height: 18px; color: #526071; }
	.customer-page__audience-bar-label text:first-child { min-width: 0; flex: 1; padding-right: 10px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
	.customer-page__audience-bar-label text:last-child { flex-shrink: 0; font-weight: 600; color: #4e637b; }
	.customer-page__audience-bar-track { display: flex; height: 12px; overflow: hidden; border-radius: 3px; background-color: #edf2f7; }
	.customer-page__audience-bar-fill { display: flex; height: 12px; min-width: 0; border-radius: 3px; background-color: #1677cc; }
	.customer-page__audience-bar-fill--0 { background-color: #1677cc; }
	.customer-page__audience-bar-fill--1 { background-color: #21a179; }
	.customer-page__audience-bar-fill--2 { background-color: #d6971c; }
	.customer-page__audience-bar-fill--3 { background-color: #7c63d6; }
	.customer-page__audience-bar-fill--4 { background-color: #d76b45; }
	.customer-page__audience-bar-fill--5 { background-color: #2d9bb1; }
	.customer-page__audience-empty-bars { display: flex; min-height: 44px; flex-direction: row; align-items: center; margin-top: 12px; padding: 0 11px; border-radius: 5px; background-color: #f6f9fc; font-size: 12px; color: #8493a5; }
	.customer-page__page-status { display: flex; min-height: 38px; flex-direction: row; align-items: center; justify-content: center; padding: 0 8px 8px 8px; font-size: 11px; line-height: 17px; color: #8493a5; }
	.customer-page__empty { margin: 12px 18px 0 18px; padding: 18px; border-left-width: 0; border-radius: 8px; background-color: #ffffff; box-shadow: 0 8px 20px rgba(60, 88, 130, 0.08); }
	.customer-page--native-mini .customer-page__header { padding-top: 84px; }
	.customer-page__store-picker-mask { position: fixed; z-index: 110; top: 0; right: 0; bottom: 0; left: 0; display: flex; background-color: rgba(19, 37, 60, 0.42); }
	.customer-page__store-picker { display: flex; min-height: 0; flex: 1; flex-direction: column; padding: 18px 16px 24px 16px; background-color: #ffffff; }
	.customer-page__store-picker-head { display: flex; min-height: 42px; flex-direction: row; align-items: center; justify-content: space-between; }
	.customer-page__store-picker-back, .customer-page__store-picker-close { display: flex; width: 32px; height: 32px; flex-shrink: 0; flex-direction: row; align-items: center; justify-content: center; font-size: 28px; font-weight: 400; line-height: 28px; color: #40546b; }
	.customer-page__store-picker-title { display: flex; min-width: 0; flex: 1; flex-direction: column; align-items: center; padding: 0 8px; }
	.customer-page__store-picker-title > text:first-child { font-size: 17px; font-weight: 800; line-height: 24px; color: #10243b; }
	.customer-page__store-picker-title > text:last-child { margin-top: 1px; font-size: 11px; line-height: 16px; color: #8493a5; }
	.customer-page__store-search-wrap { display: flex; height: 42px; flex-direction: row; align-items: center; margin-top: 14px; padding: 0 12px; border-radius: 12px; background-color: #f4f7fb; }
	.customer-page__store-search { width: 100%; height: 40px; font-size: 14px; color: #26384d; }
	.customer-page__store-tree { min-height: 0; flex: 1; margin-top: 12px; }
	.customer-page__store-option { display: flex; min-height: 62px; flex-direction: row; align-items: center; padding: 0 12px; border-bottom-width: 1px; border-bottom-style: solid; border-bottom-color: #edf1f5; }
	.customer-page__store-option--selected { background-color: #f1f8ff; }
	.customer-page__store-option-type { display: flex; width: 28px; height: 28px; flex-shrink: 0; flex-direction: row; align-items: center; justify-content: center; border-radius: 8px; background-color: #e7f3ff; font-size: 12px; font-weight: 800; color: #1677cc; }
	.customer-page__store-option-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; margin-left: 10px; }
	.customer-page__store-option-copy > text:first-child { overflow: hidden; font-size: 14px; font-weight: 700; line-height: 21px; color: #26384d; text-overflow: ellipsis; white-space: nowrap; }
	.customer-page__store-option-copy > text:last-child { margin-top: 1px; font-size: 11px; line-height: 16px; color: #8493a5; }
	.customer-page__store-option-selected { flex-shrink: 0; margin-left: 8px; font-size: 12px; font-weight: 700; color: #1677cc; }
	.customer-page__store-empty { display: flex; min-height: 88px; flex-direction: row; align-items: center; justify-content: center; font-size: 13px; color: #8493a5; }
	.customer-page__store-picker-footer { display: flex; min-height: 56px; flex-direction: row; align-items: center; padding-top: 14px; border-top-width: 1px; border-top-style: solid; border-top-color: #edf1f5; }
	.customer-page__store-picker-footer > text { min-width: 0; flex: 1; overflow: hidden; font-size: 12px; line-height: 18px; color: #5f7185; text-overflow: ellipsis; white-space: nowrap; }
	.customer-page__store-picker-cancel, .customer-page__store-picker-confirm { display: flex; height: 38px; flex-shrink: 0; flex-direction: row; align-items: center; justify-content: center; margin-left: 8px; padding: 0 14px; border-radius: 10px; font-size: 13px; font-weight: 700; }
	.customer-page__store-picker-cancel { background-color: #f3f6fa; color: #5f7185; }
	.customer-page__store-picker-confirm { background-color: #1677cc; color: #ffffff; }

	/* System audience cards: server-defined rules stay read-only while members
	 * remain a live, permission-scoped query opened by tapping the card. */
	.customer-page__audience-card { position: relative; display: flex; min-height: 116px; flex-direction: row; align-items: center; overflow: hidden; margin-bottom: 12px; padding: 17px 14px 16px 15px; border-width: 0; border-radius: 14px; background-color: #ffffff; box-shadow: 0 9px 24px rgba(77, 64, 132, 0.10); }
	.customer-page__audience-card-stripe { position: absolute; top: 0; right: 0; left: 0; height: 5px; background-color: #8a7bd0; }
	.customer-page__audience-card--custom .customer-page__audience-card-stripe { background-color: #a7b8ca; }
	.customer-page__audience-card--birthday-month { background-color: #ffffff; }
	.customer-page__audience-card--birthday-month .customer-page__audience-card-stripe { background-color: #9a64bc; }
	.customer-page__audience-card--sleep { background-color: #ffffff; }
	.customer-page__audience-card--sleep .customer-page__audience-card-stripe { background-color: #5678bf; }
	.customer-page__audience-card--followup { background-color: #ffffff; }
	.customer-page__audience-card--followup .customer-page__audience-card-stripe { background-color: #ba794d; }
