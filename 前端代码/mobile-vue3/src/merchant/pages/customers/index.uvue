<template>
	<view class="customer-page" :class="{ 'customer-page--native-mini': platformUsesNativeCanvas }">
		<view class="customer-page__header">
			<view class="customer-page__title-row">
				<view class="customer-page__org-filter" @tap="openCustomerStorePicker"><text>{{ customerActiveStoreLabel }}›</text></view>
			</view>
		</view>
		<view v-if="customerStoreSwitchMessage.length > 0" class="customer-page__store-error" role="alert"><text>{{ customerStoreSwitchMessage }}</text></view>

		<view class="customer-page__tabs" role="tablist">
			<view
				v-for="tab in tabs"
				:key="tab.key"
				class="customer-page__tab"
				:class="{ 'customer-page__tab--active': activeTab === tab.key }"
				role="tab"
				:aria-selected="activeTab === tab.key"
				@tap="selectTab(tab.key)"
			>
				<text>{{ tab.label }}</text>
			</view>
		</view>
		<view v-if="showCustomerSearch()" class="customer-page__query-bar">
			<view class="customer-page__search">
				<text class="customer-page__search-symbol">⌕</text>
				<input
					class="customer-page__search-input"
					v-model="keyword"
					confirm-type="search"
					placeholder="姓名、手机号或会员编号"
					@confirm="applySearch"
				/>
			</view>
			<view v-if="activeTab === 'list'" class="customer-page__field-settings">
				<navigator url="/src/merchant/pages/customer-settings/index" open-type="navigate"><text>列表字段</text></navigator>
			</view>
			<view v-if="activeAudience == null" class="customer-page__filter-button" @tap="openFilter">
				<text>筛选</text>
				<text v-if="selectedFilterKeys.length > 0" class="customer-page__filter-count">{{ selectedFilterKeys.length }}</text>
			</view>
		</view>

		<view v-if="activeTab === 'groups' && activeAudience != null && audienceOverviewEnabled" class="customer-page__audience-tabs" role="tablist">
			<view class="customer-page__audience-tab" :class="{ 'customer-page__audience-tab--active': audienceViewMode === 'overview' }" role="tab" @tap="selectAudienceView('overview')"><text>概况</text></view>
			<view class="customer-page__audience-tab" :class="{ 'customer-page__audience-tab--active': audienceViewMode === 'details' }" role="tab" @tap="selectAudienceView('details')"><text>明细</text></view>
		</view>
		<scroll-view v-if="activeTab === 'groups' && activeAudience != null && audienceOverviewEnabled && audienceViewMode === 'overview'" class="customer-page__audience-breadcrumbs" scroll-x>
			<view class="customer-page__audience-breadcrumbs-inner"><text v-for="(crumb, index) in audienceOverviewBreadcrumbs" :key="crumb.entityType + '-' + crumb.entityId" class="customer-page__audience-breadcrumb" @tap="selectAudienceBreadcrumb(crumb)">{{ index > 0 ? ' / ' : '' }}{{ crumb.name }}</text></view>
		</scroll-view>

		<view class="customer-page__scope-row">
			<text class="customer-page__scope-label">{{ activeTabLabel }}</text>
			<text v-if="activeAudience != null" class="customer-page__scope-query" @tap="closeAudience">返回客群</text>
			<text v-else-if="searchApplied" class="customer-page__scope-query">已应用搜索</text>
		</view>

		<scroll-view class="customer-page__content" scroll-y refresher-enabled="true" :refresher-triggered="refreshing" @refresherrefresh="onPullRefresh" lower-threshold="120" @scrolltolower="loadMoreRecords">
			<view v-if="loading" class="customer-page__empty">
				<text class="customer-page__empty-title">正在加载客户数据</text>
			</view>
			<view v-else-if="loadMessage.length > 0" class="customer-page__empty">
				<text class="customer-page__empty-title">{{ loadMessage }}</text>
				<view class="customer-page__empty-command" @tap="loadActiveTab"><text>重新加载</text></view>
			</view>
			<view v-else-if="activeTab === 'groups' && activeAudience == null && audiences.length === 0" class="customer-page__empty">
				<text class="customer-page__empty-title">暂无客群</text>
				<text class="customer-page__empty-copy">客群只保存筛选规则，会员名单始终按当前权限实时查询。</text>
				<view class="customer-page__empty-command" @tap="openGroupEntry"><text>创建客群</text></view>
			</view>
			<view v-else-if="activeTab === 'groups' && activeAudience != null && audienceOverviewEnabled && audienceViewMode === 'overview'" class="customer-page__list customer-page__audience-overview-list">
				<view v-for="audience in audiences" :key="audience.audienceId" class="customer-page__audience-overview-card" @tap="openAudience(audience)">
					<view class="customer-page__audience-heading"><text class="customer-page__audience-name">{{ audience.name }}</text><text class="customer-page__audience-total">{{ audience.memberTotal }} 人</text></view>
					<text class="customer-page__audience-caption">{{ audienceNodeLabel() }}客群人数</text>
					<view v-if="audience.bars.length > 0" class="customer-page__audience-bars">
						<view v-for="bar in audience.bars" :key="bar.entityType + '-' + bar.entityId" class="customer-page__audience-bar-row" @tap.stop="drillAudienceNode(audience, bar)">
							<view class="customer-page__audience-bar-label"><text>{{ bar.name }}</text><text>{{ bar.memberCount }} 人{{ bar.hasChildren ? ' ›' : '' }}</text></view>
							<view class="customer-page__audience-bar-track"><view class="customer-page__audience-bar-fill" :class="'customer-page__audience-bar-fill--' + bar.colorIndex" :style="{ width: audienceBarWidth(audience, bar) }"></view></view>
						</view>
					</view>
					<view v-else class="customer-page__audience-empty-bars"><text>当前层级没有可继续拆分的组织</text></view>
				</view>
			</view>
			<view v-else-if="activeTab === 'groups' && activeAudience == null" class="customer-page__list">
				<view v-for="audience in audiences" :key="audience.audienceId || audience.audienceKey || audience.audienceCode || audience.systemKey || audience.key" class="customer-page__audience-card" :class="['customer-page__audience-card--' + audienceIconKind(audience), audienceIsSystem(audience) ? 'customer-page__audience-card--system' : 'customer-page__audience-card--custom']" @tap="openAudience(audience)">
					<view class="customer-page__audience-card-stripe"></view>
					<view class="customer-page__audience-card-icon" :class="'customer-page__audience-card-icon--' + audienceIconKind(audience)"><text>{{ audienceIconText(audience) }}</text></view>
					<view class="customer-page__audience-card-body"><view class="customer-page__audience-card-title-line"><text class="customer-page__audience-name">{{ audience.name }}</text><text v-if="audienceIsSystem(audience)" class="customer-page__audience-system-label">系统</text></view><text class="customer-page__audience-card-total">{{ audienceCardTotal(audience) }}</text><text class="customer-page__audience-card-rule">{{ audienceRuleDescription(audience) }}</text><text class="customer-page__audience-card-action">点击查看实时成员</text></view>
					<view class="customer-page__audience-card-summary"><view class="customer-page__audience-card-chevron"><text>›</text></view></view>
				</view>
			</view>
			<view v-else-if="records.length === 0" class="customer-page__empty">
				<text class="customer-page__empty-title">暂无客户</text>
				<text class="customer-page__empty-copy">客户列表将严格按照当前人员的数据权限显示</text>
			</view>
			<view v-else class="customer-page__list">
				<view v-for="record in records" :key="record.id" class="customer-page__customer-card" @tap="openCustomerDetail(record)">
					<view class="customer-page__customer-heading">
						<view class="customer-page__customer-avatar"><text>{{ customerInitial(record) }}</text></view>
						<view class="customer-page__customer-identity">
							<view class="customer-page__customer-title-line">
								<text class="customer-page__customer-name">{{ customerName(record) }}</text>
								<text v-if="customerLevel(record).length > 0" class="customer-page__customer-tag customer-page__customer-tag--level">{{ customerLevel(record) }}</text>
								<text v-if="customerStatus(record).length > 0" class="customer-page__customer-tag">{{ customerStatus(record) }}</text>
							</view>
							<text v-if="customerPrimaryMeta(record).length > 0" class="customer-page__customer-primary-meta">{{ customerPrimaryMeta(record) }}</text>
						</view>
						<text class="customer-page__customer-chevron">›</text>
					</view>
					<text v-if="customerRelationMeta(record).length > 0" class="customer-page__customer-relation-meta">{{ customerRelationMeta(record) }}</text>
					<view class="customer-page__customer-metrics">
						<view v-for="metric in customerMetrics(record)" :key="metric.key" class="customer-page__customer-metric">
							<text class="customer-page__customer-metric-value">{{ metric.value }}</text>
							<text class="customer-page__customer-metric-label">{{ metric.label }}</text>
						</view>
					</view>
					<view v-if="additionalCardFields(record).length > 0" class="customer-page__customer-extra-fields">
						<view v-for="field in additionalCardFields(record)" :key="field.key" class="customer-page__customer-extra-field">
							<text class="customer-page__customer-extra-label">{{ field.label }}</text>
							<text class="customer-page__customer-extra-value">{{ field.value }}</text>
						</view>
					</view>
				</view>
				<view v-if="showAudiencePageStatus()" class="customer-page__page-status"><text>{{ audiencePageStatus() }}</text></view>
			</view>
		</scroll-view>

		<MerchantPrimaryTabBar active-key="customers" />
		<view v-if="activeTab === 'groups'" class="customer-page__floating-action" role="button" aria-label="新建客群" @tap="openGroupEntry"><text>＋</text></view>
		<view v-else-if="activeTab === 'list'" class="customer-page__floating-action" role="button" aria-label="新建客户" @tap="openCustomerEntry"><text>＋</text></view>

		<view v-if="customerStorePickerVisible" class="customer-page__store-picker-mask" @tap="closeCustomerStorePicker"><view class="customer-page__store-picker" @tap.stop><view class="customer-page__store-picker-head"><text class="customer-page__store-picker-back" @tap="closeCustomerStorePicker">‹</text><view class="customer-page__store-picker-title"><text>选择组织/门店</text><text>仅显示当前数据权限范围内的门店</text></view><text class="customer-page__store-picker-close" @tap="closeCustomerStorePicker">×</text></view><view class="customer-page__store-search-wrap"><input class="customer-page__store-search" type="text" :value="customerStoreKeyword" placeholder="搜索门店" @input="updateCustomerStoreKeyword" /></view><scroll-view scroll-y="true" class="customer-page__store-tree"><view v-for="context in visibleCustomerStoreContexts()" :key="context.contextId" class="customer-page__store-option" :class="{ 'customer-page__store-option--selected': isPendingCustomerStoreContext(context) }" @tap="selectPendingCustomerStoreContext(context)"><view class="customer-page__store-option-type"><text>店</text></view><view class="customer-page__store-option-copy"><text>{{ context.label }}</text><text>门店 · 当前授权范围</text></view><text class="customer-page__store-option-selected">{{ isPendingCustomerStoreContext(context) ? '已选' : '' }}</text></view><view v-if="visibleCustomerStoreContexts().length === 0" class="customer-page__store-empty"><text>没有匹配的门店</text></view></scroll-view><view class="customer-page__store-picker-footer"><text>已选：{{ pendingCustomerStoreLabel() }}</text><view class="customer-page__store-picker-cancel" @tap="closeCustomerStorePicker"><text>取消</text></view><view class="customer-page__store-picker-confirm" @tap="confirmCustomerStoreContext"><text>确定</text></view></view></view></view>

		<view v-if="filterVisible" class="customer-filter">
			<view class="customer-filter__header">
				<text class="customer-filter__dismiss" @tap="closeFilter">取消</text>
				<text class="customer-filter__title">筛选客户</text>
				<text class="customer-filter__apply" @tap="applyFilter">应用</text>
			</view>
			<scroll-view scroll-y class="customer-filter__body">
				<text class="customer-filter__hint">选择要设置条件的字段</text>
				<view class="customer-filter__field-grid">
					<view
						v-for="field in filterFields"
						:key="field.key"
						class="customer-filter__field"
						:class="{ 'customer-filter__field--selected': isFieldSelected(field.key) }"
						@tap="toggleField(field.key)"
					>
						<text>{{ field.label }}</text>
					</view>
					</view>
					<view v-for="field in selectedFilterDefinitions()" :key="field.key" class="customer-filter__condition">
						<view class="customer-filter__condition-heading"><text class="customer-filter__condition-label">{{ field.label }}</text></view>
						<view v-if="showFilterOperator(field.key)" class="customer-filter__operator-row">
							<view v-for="option in filterOperatorOptions(field.key)" :key="option.value" class="customer-filter__operator-option" :class="{ 'customer-filter__operator-option--active': filterOperatorFor(field.key) === option.value }" @tap="setFilterOperatorValue(field.key, option.value)"><text>{{ option.label }}</text></view>
						</view>
						<view v-if="isBirthdayField(field.key)" class="customer-filter__shortcut-row"><view v-for="option in birthdayShortcutOptions" :key="option.value" class="customer-filter__shortcut" :class="{ 'customer-filter__shortcut--active': birthdayShortcutFor(field.key) === option.value }" @tap="setBirthdayShortcut(field.key, option.value)"><text>{{ option.label }}</text></view></view>
						<view v-if="isDateField(field.key) && !isBirthdayField(field.key)" class="customer-filter__shortcut-row"><picker class="customer-filter__date-shortcut" mode="selector" :range="dateShortcutLabelsFor(field.key)" @change="setDateShortcut(field.key, $event.detail.value)"><text>{{ dateShortcutLabel(field.key) }}⌄</text></picker></view>
						<view v-if="showFilterValue(field.key)" class="customer-filter__value-row">
							<input v-if="isRollingDayShortcut(field.key)" class="customer-filter__value-input" type="number" :value="filterValueFor(field.key)" :placeholder="rollingDayPlaceholder(field.key)" @input="setFilterValue(field.key, $event.detail.value)" />
							<text v-if="isRollingDayShortcut(field.key)" class="customer-filter__value-unit">天</text>
							<picker v-else-if="isDateField(field.key)" class="customer-filter__value-picker" mode="date" :value="filterValueFor(field.key)" @change="setFilterValue(field.key, $event.detail.value)"><text>{{ filterValueFor(field.key, '选择日期') }}</text></picker>
							<input v-else class="customer-filter__value-input" :value="filterValueFor(field.key)" :type="isNumberField(field.key) ? 'number' : 'text'" :placeholder="filterValuePlaceholder(field.key, false)" @input="setFilterValue(field.key, $event.detail.value)" />
							<picker v-if="filterOperatorFor(field.key) === 'between' && isDateField(field.key) && !isRollingDayShortcut(field.key)" class="customer-filter__value-picker" mode="date" :value="filterValueToFor(field.key)" @change="setFilterValueTo(field.key, $event.detail.value)"><text>{{ filterValueToFor(field.key, '结束日期') }}</text></picker>
							<input v-else-if="filterOperatorFor(field.key) === 'between' && !isRollingDayShortcut(field.key)" class="customer-filter__value-input" type="number" :value="filterValueToFor(field.key)" :placeholder="filterValuePlaceholder(field.key, true)" @input="setFilterValueTo(field.key, $event.detail.value)" />
						</view>
					</view>
			</scroll-view>
		</view>

		<view v-if="groupEntryVisible" class="customer-group-entry">
			<view class="customer-group-entry__header">
				<text class="customer-group-entry__dismiss" @tap="closeGroupEntry">关闭</text>
				<text class="customer-group-entry__title">新建客群</text>
				<text class="customer-group-entry__placeholder"></text>
			</view>
			<view class="customer-group-entry__body">
				<text class="customer-group-entry__headline">创建动态客群</text>
				<input class="customer-group-entry__input" v-model="groupName" placeholder="填写客群名称" @input="clearGroupEntryMessage" />
				<text class="customer-group-entry__copy">客群会保存为动态条件，名单始终以当前权限和最新客户数据为准。</text>
				<text v-if="groupEntryMessage.length > 0" class="customer-group-entry__error">{{ groupEntryMessage }}</text>
				<view class="customer-group-entry__command" @tap="openFilterFromGroup">
					<text>设置筛选条件</text>
				</view>
				<view class="customer-group-entry__command" :class="{ 'customer-group-entry__command--disabled': creatingGroup }" @tap="createGroup"><text>{{ creatingGroup ? '正在创建...' : '保存客群' }}</text></view>
			</view>
		</view>

	</view>
</template>

<script setup lang="uts">
	import { createMobileCustomerAudience, listMobileCustomerAudiences, queryMobileCustomerAudienceMembers, queryMobileCustomerAudienceOverview, queryMobileCustomers } from '../../../shared/api/mobile-customer-client.uts'
	import MerchantPrimaryTabBar from '../../../shared/components/merchant-primary-tab-bar.uvue'
	import { ensureMerchantTabAccess } from '../../../shared/platform/merchant-route-guard.uts'
	import { mobileHttpResultRequiresMerchantLogin } from '../../../shared/api/mobile-http.uts'
	import { currentMobilePlatform } from '../../../shared/platform/mobile-platform.uts'
	import { clearMerchantRoot, currentMerchantRoot } from '../../../shared/platform/mobile-merchant-session.uts'
	import { switchMobileMerchantContext } from '../../../shared/api/mobile-merchant-session-client.uts'
	import { openMerchantBootstrapForCustomers, openMerchantCustomerDetail, openMerchantCustomerProfile } from '../../../shared/platform/mobile-navigation.uts'
	const tabs = [
		{ key: 'exclusive', label: '专属客户' },
		{ key: 'groups', label: '我的客群' },
		{ key: 'list', label: '客户列表' }
	]
	const filterFields = [
		{ key: 'member_name', label: '会员姓名', type: 'text' },
		{ key: 'phone', label: '手机号', type: 'text' },
		{ key: 'member_no', label: '会员编号', type: 'text' },
		{ key: 'birthday', label: '生日', type: 'birthday' },
		{ key: 'member_status', label: '会员状态', type: 'text' },
		{ key: 'member_level', label: '会员等级', type: 'text' },
		{ key: 'member_tag', label: '会员标签', type: 'text' },
		{ key: 'store', label: '归属门店', type: 'text' },
		{ key: 'exclusive_service_staff', label: '专属服务人', type: 'text' },
		{ key: 'account_balance', label: '账户余额', type: 'number' },
		{ key: 'active_card_count', label: '有效卡项', type: 'number' },
		{ key: 'remaining_project_times', label: '剩余项目次数', type: 'number' },
		{ key: 'remaining_project_amount', label: '剩余项目金额', type: 'number' },
		{ key: 'debt_amount', label: '欠款金额', type: 'number' },
		{ key: 'total_consumption_amount', label: '总消费金额', type: 'number' },
		{ key: 'visit_count', label: '到店次数', type: 'number' },
		{ key: 'latest_purchase_date', label: '最近购买日期', type: 'date' },
		{ key: 'last_service_staff', label: '上次服务人员', type: 'text' },
		{ key: 'latest_visit_date', label: '最近到店日期', type: 'date' },
		{ key: 'created_at', label: '建档时间', type: 'date' }
	]
	const numberOperatorOptions = [{ value: 'greater_than', label: '大于' }, { value: 'greater_or_equal', label: '大于等于' }, { value: 'equal', label: '等于' }, { value: 'less_or_equal', label: '小于等于' }, { value: 'less_than', label: '小于' }, { value: 'between', label: '介于' }]
	const dateOperatorOptions = [{ value: 'equal', label: '等于' }, { value: 'greater_than', label: '晚于' }, { value: 'greater_or_equal', label: '不早于' }, { value: 'less_than', label: '早于' }, { value: 'less_or_equal', label: '不晚于' }, { value: 'between', label: '介于' }]
	const textOperatorOptions = [{ value: 'contains', label: '包含' }, { value: 'equal', label: '等于' }]
	const dateShortcutOptions = [{ value: 'custom', label: '自定义日期' }, { value: 'today', label: '今天' }, { value: 'yesterday', label: '昨天' }, { value: 'this_week', label: '本周' }, { value: 'last_week', label: '上周' }, { value: 'this_month', label: '本月' }, { value: 'last_month', label: '上月' }, { value: 'this_year', label: '本年' }]
	const birthdayShortcutOptions = [{ value: 'today', label: '今天生日' }, { value: 'this_week', label: '本周生日' }, { value: 'this_month', label: '本月生日' }, { value: 'custom', label: '指定生日' }]
	const defaultVisibleFieldKeys = ['member_name', 'phone', 'birthday', 'member_level', 'store']
	const platformUsesNativeCanvas = currentMobilePlatform() === 'MP_WEIXIN'

	const activeTab = ref('groups')
	const activeTabLabel = ref('我的客群')
	const keyword = ref('')
	const searchApplied = ref(false)
	const filterVisible = ref(false)
	const groupEntryVisible = ref(false)
	const filterForGroupEntry = ref(false)
	const selectedFilterKeys = ref<Array<string>>([])
	const listFilterSnapshotKeys = ref<Array<string>>([])
	const records = ref<Array<any>>([])
	const visibleFieldKeys = ref<Array<string>>(defaultVisibleFieldKeys)
	const fieldAliases = ref<any>({})
	const audiences = ref<Array<any>>([])
	const activeAudience = ref<any>(null)
	const audienceOverviewEnabled = ref(false)
	const audienceViewMode = ref('details')
	const audienceOverviewNode = ref<any>(null)
	const audienceOverviewCurrentNode = ref<any>(null)
	const audienceOverviewBreadcrumbs = ref<Array<any>>([])
	const recordsPage = ref(1)
	const recordsTotal = ref(0)
	const recordsLoadingMore = ref(false)
	let audienceMemberRequestVersion = 0
	const loading = ref(false)
	const refreshing = ref(false)
	const creatingGroup = ref(false)
	const loadMessage = ref('')
	const groupName = ref('')
	const groupEntryMessage = ref('')
	const filterValues = ref<any>({})
	const filterValueTos = ref<any>({})
	const filterOperators = ref<any>({})
	const dateShortcuts = ref<any>({})
	const birthdayShortcuts = ref<any>({})
	const listFilterSnapshotValues = ref<any>({})
	const listFilterSnapshotValueTos = ref<any>({})
	const listFilterSnapshotOperators = ref<any>({})
	const listFilterSnapshotDateShortcuts = ref<any>({})
	const listFilterSnapshotBirthdayShortcuts = ref<any>({})
	const customerStoreContexts = ref<Array<any>>([])
	const customerActiveStoreIndex = ref(0)
	const customerActiveStoreLabel = ref('门店信息加载中')
	const customerSwitchingStore = ref(false)
	const customerStoreSwitchMessage = ref('')
	const customerStorePickerVisible = ref(false)
	const pendingCustomerStoreContext = ref<any>(null)
	const customerStoreKeyword = ref('')
	const systemAudienceOrder = ['system-birthday-this-month', 'system-sleeping-90d', 'system-followup-7d', 'system-invite-30d', 'system-benefit-low-balance', 'birthday_month', 'birthday_today', 'new_month', 'debt', 'sleep']

	onShow(() => { if (ensureMerchantTabAccess('customers')) { loadCustomerStoreContext(); loadActiveTab() } })

	function loadCustomerStoreContext() : void {
		let root = currentMerchantRoot()
		let contexts = root != null && Array.isArray(root.contexts) ? root.contexts : []
		let activeId = root != null && root.activeContext != null ? String(root.activeContext.contextId || '') : ''
		customerStoreContexts.value = contexts
		let index = 0
		for (let position = 0; position < contexts.length; position++) if (String(contexts[position].contextId || '') == activeId) { index = position; break }
		customerActiveStoreIndex.value = index
		customerActiveStoreLabel.value = contexts.length > 0 ? String(contexts[index].label || '未命名门店') : '暂无可用门店'
	}

	function openCustomerStorePicker() : void {
		if (customerSwitchingStore.value || customerStoreContexts.value.length <= 1) return
		customerStoreKeyword.value = ''
		pendingCustomerStoreContext.value = customerStoreContexts.value[customerActiveStoreIndex.value] || null
		customerStorePickerVisible.value = true
	}
	function closeCustomerStorePicker() : void { if (!customerSwitchingStore.value) customerStorePickerVisible.value = false }
	function updateCustomerStoreKeyword(event : any) : void { customerStoreKeyword.value = String(event.detail != null ? event.detail.value || '' : '') }
	function visibleCustomerStoreContexts() : Array<any> {
		let keyword = customerStoreKeyword.value.trim()
		if (keyword.length === 0) return customerStoreContexts.value
		let result = new Array<any>()
		for (let index = 0; index < customerStoreContexts.value.length; index++) if (String(customerStoreContexts.value[index].label || '').indexOf(keyword) >= 0) result.push(customerStoreContexts.value[index])
		return result
	}
	function isPendingCustomerStoreContext(context : any) : boolean { return pendingCustomerStoreContext.value != null && String(context.contextId || '') === String(pendingCustomerStoreContext.value.contextId || '') }
	function selectPendingCustomerStoreContext(context : any) : void { pendingCustomerStoreContext.value = context }
	function pendingCustomerStoreLabel() : string { return pendingCustomerStoreContext.value == null ? '请选择门店' : String(pendingCustomerStoreContext.value.label || '未命名门店') }
	function confirmCustomerStoreContext() : void {
		if (pendingCustomerStoreContext.value == null) return
		customerStorePickerVisible.value = false
		switchCustomerStoreContext(pendingCustomerStoreContext.value)
	}
	function switchCustomerStoreContext(context : any) : void {
		if (customerSwitchingStore.value) return
		let targetContextId = String(context != null ? context.contextId || '' : '')
		if (targetContextId.length === 0 || targetContextId === String((customerStoreContexts.value[customerActiveStoreIndex.value] || {}).contextId || '')) return
		customerSwitchingStore.value = true
		customerStoreSwitchMessage.value = ''
		switchMobileMerchantContext(targetContextId, (result : any) => {
			customerSwitchingStore.value = false
			customerStorePickerVisible.value = false
			if (!result.ok) { customerStoreSwitchMessage.value = String(result.message || '门店切换失败。'); return }
			loadCustomerStoreContext()
			loadActiveTab()
		})
	}

	function selectTab(tab : string) {
		activeAudience.value = null
		activeTab.value = tab
		if (tab == 'groups') {
			activeTabLabel.value = '我的客群'
			loadActiveTab()
			return
		}
		if (tab == 'list') {
			activeTabLabel.value = '客户列表'
			loadActiveTab()
			return
		}
		activeTabLabel.value = '专属客户'
		loadActiveTab()
	}

	function applySearch() {
		searchApplied.value = keyword.value.trim().length > 0
		loadActiveTab()
	}

	function openFilter() {
		filterForGroupEntry.value = false
		filterVisible.value = true
	}

	function closeFilter() {
		filterVisible.value = false
		if (filterForGroupEntry.value) {
			filterForGroupEntry.value = false
			groupEntryVisible.value = true
		}
	}

	function applyFilter() {
		filterVisible.value = false
		if (filterForGroupEntry.value) {
			filterForGroupEntry.value = false
			groupEntryVisible.value = true
			return
		}
		loadActiveTab()
	}

	function isFieldSelected(fieldKey : string) : boolean {
		return selectedFilterKeys.value.indexOf(fieldKey) >= 0
	}

	function toggleField(fieldKey : string) {
		const index = selectedFilterKeys.value.indexOf(fieldKey)
		if (index >= 0) {
			selectedFilterKeys.value.splice(index, 1)
			delete filterValues.value[fieldKey]
			delete filterValueTos.value[fieldKey]
			delete filterOperators.value[fieldKey]
			delete dateShortcuts.value[fieldKey]
			delete birthdayShortcuts.value[fieldKey]
			return
		}
		selectedFilterKeys.value.push(fieldKey)
		if (isBirthdayField(fieldKey)) birthdayShortcuts.value[fieldKey] = 'today'
		else if (isDateField(fieldKey)) dateShortcuts.value[fieldKey] = 'custom'
	}

	function openGroupEntry() {
		listFilterSnapshotKeys.value = copyFilterKeys(selectedFilterKeys.value)
		listFilterSnapshotValues.value = copyFilterValues(filterValues.value)
		listFilterSnapshotValueTos.value = copyFilterValues(filterValueTos.value)
		listFilterSnapshotOperators.value = copyFilterValues(filterOperators.value)
		listFilterSnapshotDateShortcuts.value = copyFilterValues(dateShortcuts.value)
		listFilterSnapshotBirthdayShortcuts.value = copyFilterValues(birthdayShortcuts.value)
		selectedFilterKeys.value = new Array<string>()
		filterValues.value = {}
		filterValueTos.value = {}
		filterOperators.value = {}
		dateShortcuts.value = {}
		birthdayShortcuts.value = {}
		groupEntryMessage.value = ''
		groupEntryVisible.value = true
	}

	function openCustomerEntry() {
		openMerchantCustomerProfile('create')
	}

	function openCustomerDetail(record : any) {
		let memberId = String(record != null ? record.id || record.memberId || '' : '')
		let lookup = String(record != null ? record.phone || record.memberNo || '' : '')
		if (memberId.length == 0 || lookup.length == 0) { loadMessage.value = '该客户缺少可用于安全定位的联系方式，暂时无法打开详情。'; return }
		openMerchantCustomerDetail(memberId, lookup)
	}

	function openAudience(audience : any) {
		if (audience == null) return
		audienceMemberRequestVersion++
		audienceOverviewNode.value = null
		audienceOverviewEnabled.value = false
		activeAudience.value = audience
		activeTabLabel.value = String(audience.name || '客群成员')
		records.value = new Array<any>()
		audienceOverviewEnabled.value = false
		audienceViewMode.value = 'details'
		loadActiveTab()
	}

	function selectAudienceView(mode : string) {
		if (!audienceOverviewEnabled.value) return
		audienceViewMode.value = mode === 'overview' ? 'overview' : 'details'
		if (audienceViewMode.value == 'details' && activeAudience.value != null) loadActiveTab()
	}

	function audienceNodeLabel() : string {
		let name = String(audienceOverviewCurrentNode.value != null ? audienceOverviewCurrentNode.value.name || '' : '')
		return name.length > 0 ? name + ' · ' : ''
	}

	function audienceBarWidth(audience : any, bar : any) : string {
		let max = Number(audience != null ? audience.maxBarValue || 0 : 0)
		let value = Number(bar != null ? bar.memberCount || 0 : 0)
		if (max <= 0 || value <= 0) return '0%'
		return String(Math.max(8, Math.min(100, Math.round(value * 100 / max)))) + '%'
	}

	function drillAudienceNode(audience : any, bar : any) {
		if (bar == null) return
		audienceOverviewNode.value = { nodeType: String(bar.entityType || ''), nodeId: Number(bar.entityId || 0) }
		if (bar != null && Boolean(bar.hasChildren)) {
			loadAudienceOverview()
			return
		}
		activeAudience.value = audience
		audienceViewMode.value = 'details'
		loadActiveTab()
	}

	function selectAudienceBreadcrumb(crumb : any) {
		if (crumb == null) return
		audienceOverviewNode.value = { nodeType: String(crumb.entityType || ''), nodeId: Number(crumb.entityId || 0) }
		loadAudienceOverview()
	}

	function closeAudience() {
		audienceMemberRequestVersion++
		activeAudience.value = null
		audienceOverviewEnabled.value = false
		audienceOverviewNode.value = null
		audienceOverviewCurrentNode.value = null
		audienceOverviewBreadcrumbs.value = []
		activeTabLabel.value = '我的客群'
		records.value = new Array<any>()
		loadActiveTab()
	}

	function handleExpiredMerchantSession(result : any) : boolean {
		if (!mobileHttpResultRequiresMerchantLogin(result)) return false
		clearMerchantRoot()
		openMerchantBootstrapForCustomers()
		return true
	}


	function closeGroupEntry() {
		groupEntryVisible.value = false
		filterForGroupEntry.value = false
		restoreListFilters()
		groupName.value = ''
		groupEntryMessage.value = ''
	}

	function openFilterFromGroup() {
		groupEntryMessage.value = ''
		groupEntryVisible.value = false
		filterForGroupEntry.value = true
		filterVisible.value = true
	}

	function onPullRefresh() : void { if (refreshing.value) return; refreshing.value = true; loadActiveTab(); setTimeout(() => { refreshing.value = false }, 900) }

	function loadActiveTab() {
		loading.value = true
		loadMessage.value = ''
		if (activeTab.value == 'groups') {
			if (activeAudience.value != null) {
				loadAudienceMemberPage(1, false)
				return
			}
			listMobileCustomerAudiences((result : any) => {
				loading.value = false
				if (!result.ok) { if (handleExpiredMerchantSession(result)) return; loadMessage.value = String(result.message || '客群加载失败。'); return }
				audiences.value = normalizeAudiences(result.body != null && Array.isArray(result.body.audiences) ? result.body.audiences : [])
			})
			return
		}
		queryMobileCustomers(activeTab.value == 'exclusive', {
			page: 1,
			limit: 30,
			keyword: keyword.value.trim(),
			filters: selectedFilters(),
			filterRelation: 'all'
		}, (result : any) => {
			loading.value = false
			if (!result.ok) { if (handleExpiredMerchantSession(result)) return; loadMessage.value = String(result.message || '客户加载失败。'); return }
			records.value = Array.isArray(result.body.records) ? result.body.records : []
			let display = result.body.displayConfiguration || {}
			let savedVisible = Array.isArray(display.visibleFields) ? display.visibleFields : []
			visibleFieldKeys.value = savedVisible.length > 0 ? savedVisible : defaultVisibleFieldKeys
			fieldAliases.value = display.fieldAliases || {}
		})
	}

	function loadAudienceMemberPage(page : number, append : boolean) {
		if (activeAudience.value == null || (append && recordsLoadingMore.value)) return
		let requestVersion = ++audienceMemberRequestVersion
		if (append) recordsLoadingMore.value = true
		else {
			loading.value = true
			recordsLoadingMore.value = false
		}
		let memberPayload : any = { page: page, limit: 10, keyword: keyword.value.trim() }
		if (audienceOverviewNode.value != null) {
			memberPayload.nodeType = String(audienceOverviewNode.value.nodeType || '')
			memberPayload.nodeId = Number(audienceOverviewNode.value.nodeId || 0)
		}
		queryMobileCustomerAudienceMembers(String(activeAudience.value.audienceId || ''), memberPayload, (result : any) => {
			if (requestVersion != audienceMemberRequestVersion) return
			loading.value = false
			recordsLoadingMore.value = false
			if (!result.ok) { if (handleExpiredMerchantSession(result)) return; loadMessage.value = String(result.message || '客群成员加载失败。'); return }
			let incoming = Array.isArray(result.body.records) ? result.body.records : []
			records.value = append ? records.value.concat(incoming) : incoming
			recordsPage.value = page
			recordsTotal.value = Math.max(records.value.length, Number(result.body.total || 0))
			let display = result.body.displayConfiguration || {}
			let savedVisible = Array.isArray(display.visibleFields) ? display.visibleFields : []
			visibleFieldKeys.value = savedVisible.length > 0 ? savedVisible : defaultVisibleFieldKeys
			fieldAliases.value = display.fieldAliases || {}
		})
	}

	function loadMoreRecords() {
		if (activeTab.value != 'groups' || activeAudience.value == null || audienceViewMode.value != 'details') return
		if (loading.value || recordsLoadingMore.value || records.value.length >= recordsTotal.value) return
		loadAudienceMemberPage(recordsPage.value + 1, true)
	}

	function showAudiencePageStatus() : boolean {
		return activeTab.value == 'groups' && activeAudience.value != null && audienceViewMode.value == 'details' && recordsTotal.value > 0
	}

	function audiencePageStatus() : string {
		if (recordsLoadingMore.value) return '正在加载更多客户'
		if (records.value.length >= recordsTotal.value) return '已显示全部 ' + String(recordsTotal.value) + ' 位客户'
		return '已显示 ' + String(records.value.length) + ' / ' + String(recordsTotal.value) + ' 位客户，继续下拉加载'
	}

	function loadAudienceOverview(audience : any = null) {
		loading.value = true
		loadMessage.value = ''
		let payload : any = {}
		if (audienceOverviewNode.value != null) {
			payload.nodeType = String(audienceOverviewNode.value.nodeType || '')
			payload.nodeId = Number(audienceOverviewNode.value.nodeId || 0)
		}
		let selectedAudience = audience != null ? audience : activeAudience.value
		if (selectedAudience != null) payload.audienceId = String(selectedAudience.audienceId || selectedAudience.audienceKey || selectedAudience.audienceCode || '')
		queryMobileCustomerAudienceOverview(payload, (result : any) => {
			loading.value = false
			if (!result.ok) { if (handleExpiredMerchantSession(result)) return; loadMessage.value = String(result.message || '客群概况加载失败。'); return }
			let overview = result.body != null ? result.body.audienceOverview || {} : {}
			audienceOverviewEnabled.value = Boolean(overview.entry != null ? overview.entry.overviewEnabled : false)
			if (audienceOverviewEnabled.value && audienceViewMode.value != 'overview') audienceViewMode.value = 'overview'
			if (!audienceOverviewEnabled.value) audienceViewMode.value = 'details'
			audienceOverviewCurrentNode.value = overview.currentNode || null
			audienceOverviewBreadcrumbs.value = Array.isArray(overview.breadcrumbs) ? overview.breadcrumbs : []
			audiences.value = Array.isArray(overview.audiences) ? overview.audiences : []
			if (!audienceOverviewEnabled.value && audience != null) loadActiveTab()
		})
	}

	function showCustomerSearch() : boolean {
		return activeTab.value != 'groups' || activeAudience.value != null || audienceViewMode.value == 'details'
	}

	function audienceIconKind(audience : any) : string {
		let audienceKey = audience != null ? String(audience.audienceKey || audience.audienceCode || audience.systemKey || audience.key || '') : ''
		if (audienceKey == 'system-birthday-this-month' || audienceKey == 'birthday_month' || audienceKey == 'birthday_today') return 'birthday-month'
		if (audienceKey == 'system-sleeping-90d' || audienceKey == 'sleep') return 'sleep'
		if (audienceKey == 'system-followup-7d') return 'followup'
		if (audienceKey == 'system-invite-30d') return 'invite'
		if (audienceKey == 'system-benefit-low-balance') return 'low-balance'
		if (audienceKey == 'new_month') return 'new'
		if (audienceKey == 'debt') return 'debt'
		let filters = Array.isArray(audience != null && audience.validatedRule != null ? audience.validatedRule.filters : null) ? audience.validatedRule.filters : []
		let field = String(filters.length > 0 && filters[0] != null ? filters[0].field_key || '' : '')
		if (field == 'latest_visit_date') return 'sleep'
		if (field == 'birthday_month_day') return 'birthday'
		return 'group'
	}

	function audienceIconText(audience : any) : string {
		let kind = audienceIconKind(audience)
		if (kind == 'birthday-month') return '生'
		if (kind == 'new') return '新'
		if (kind == 'debt') return '欠'
		if (kind == 'sleep') return '眠'
		if (kind == 'followup') return '访'
		if (kind == 'invite') return '邀'
		if (kind == 'low-balance') return '卡'
		if (kind == 'birthday') return '生'
		return '群'
	}

	function audienceCardTotal(audience : any) : string {
		let total = audience != null ? audience.memberTotal : null
		if (total == null || String(total).length == 0) return '--'
		return wholeNumber(total) + ' 人'
	}

	function audienceIsSystem(audience : any) : boolean {
		let type = String(audience != null ? audience.type || audience.audienceType || '' : '').toUpperCase()
		return type == 'SYSTEM' || (audience != null && (audience.system === true || String(audience.system || '') == '1' || audience.isSystem === true))
	}

	function audienceRuleDescription(audience : any) : string {
		if (audience == null) return '按当前权限范围实时筛选'
		let description = String(audience.description || audience.ruleDescription || '')
		if (description.length > 0) return description
		let key = String(audience.audienceKey || audience.audienceCode || audience.systemKey || audience.key || '')
		const descriptions : any = {
			'system-birthday-this-month': '生日在本月的客户',
			'system-sleeping-90d': '超过90天未消费的客户',
			'system-followup-7d': '服务完成后超过7天未回访的客户',
			'system-invite-30d': '近30天到店且近7天未到店的客户',
			'system-benefit-low-balance': '卡项权益余额低于门店阈值的客户',
			birthday_today: '生日为今天的客户',
			birthday_month: '生日在本月的客户',
			new_month: '本月首次产生有效现金业绩的客户',
			debt: '存在未结清欠款的客户',
			sleep: '超过90天未消费的客户'
		}
		return String(descriptions[key] || (audienceIsSystem(audience) ? '系统规则实时筛选' : '按已保存规则实时筛选'))
	}

	function normalizeAudiences(source : Array<any>) : Array<any> {
		let systems = new Array<any>()
		let customs = new Array<any>()
		for (let index = 0; index < source.length; index++) {
			let audience = source[index]
			if (audienceIsSystem(audience)) systems.push(audience)
			else customs.push(audience)
		}
		systems.sort((left : any, right : any) => {
			let leftKey = String(left != null ? left.audienceKey || left.audienceCode || left.systemKey || left.key || '' : '')
			let rightKey = String(right != null ? right.audienceKey || right.audienceCode || right.systemKey || right.key || '' : '')
			let leftIndex = systemAudienceOrder.indexOf(leftKey)
			let rightIndex = systemAudienceOrder.indexOf(rightKey)
			if (leftIndex < 0) leftIndex = 99
			if (rightIndex < 0) rightIndex = 99
			return leftIndex - rightIndex
		})
		return systems.concat(customs)
	}

	function customerName(record : any) : string { let value = String(record != null ? record.name || '' : ''); return value.length > 0 ? value : '未命名客户' }
	function customerInitial(record : any) : string { return customerName(record).substring(0, 1) }
	function customerLevel(record : any) : string { return String(record != null ? record.level || '' : '') }
	function customerStatus(record : any) : string { return String(record != null ? record.status || '' : '') }
	function fieldLabel(key : string, fallback : string) : string { return String(fieldAliases.value[key] || fallback) }
	function customerPrimaryMeta(record : any) : string {
		let values = new Array<string>()
		let phone = String(record != null ? record.phone || '' : '')
		let birthday = String(record != null ? record.birthday || '' : '')
		if (phone.length > 0) values.push(phone)
		if (birthday.length > 0) values.push(fieldLabel('birthday', '生日') + ' ' + birthday)
		return values.join(' · ')
	}
	function customerRelationMeta(record : any) : string {
		let values = new Array<string>()
		let store = String(record != null ? record.storeName || '' : '')
		let staff = String(record != null ? record.exclusiveServiceStaff || '' : '')
		if (store.length > 0) values.push(store)
		if (staff.length > 0) values.push(fieldLabel('exclusive_service_staff', '专属服务人') + ' ' + staff)
		return values.join(' · ')
	}
	function wholeNumber(value : any) : string {
		let numberValue = Number(value == null || String(value).length == 0 ? 0 : value)
		if (isNaN(numberValue)) return '0'
		return String(Math.round(numberValue))
	}
	function totalBalance(record : any) : string { return wholeNumber(Number(record != null ? record.accountBalance || 0 : 0) + Number(record != null ? record.remainingProjectAmount || 0 : 0)) }
	function customerMetrics(record : any) : Array<any> { return [
		{ key: 'total_balance', label: '总余额', value: '¥' + totalBalance(record) },
		{ key: 'active_card_count', label: fieldLabel('active_card_count', '有效卡项'), value: wholeNumber(record != null ? record.activeCardCount : 0) },
		{ key: 'remaining_project_times', label: fieldLabel('remaining_project_times', '剩余次数'), value: wholeNumber(record != null ? record.remainingProjectTimes : 0) },
		{ key: 'debt_amount', label: fieldLabel('debt_amount', '当前欠款'), value: '¥' + wholeNumber(record != null ? record.debtAmount : 0) }
	] }
	function isPrimaryCardField(key : string) : boolean {
		return key == 'member_name' || key == 'phone' || key == 'birthday' || key == 'member_status' || key == 'member_level' || key == 'store' || key == 'exclusive_service_staff' || key == 'account_balance' || key == 'active_card_count' || key == 'remaining_project_times' || key == 'remaining_project_amount' || key == 'debt_amount'
	}
	function additionalCardFields(record : any) : Array<any> {
		let fields = new Array<any>()
		for (let index = 0; index < filterFields.length; index++) {
			let definition = filterFields[index]
			if (isPrimaryCardField(definition.key) || visibleFieldKeys.value.indexOf(definition.key) < 0) continue
			let value = customerFieldValue(record, definition.key)
			if (value.length == 0) continue
			fields.push({ key: definition.key, label: fieldLabel(definition.key, String(definition.label)), value: monetaryFieldValue(definition.key, value) })
		}
		return fields
	}

	function monetaryFieldValue(key : string, value : any) : string {
		if (key == 'account_balance' || key == 'remaining_project_amount' || key == 'debt_amount' || key == 'total_consumption_amount') return '¥' + wholeNumber(value)
		return String(value == null ? '' : value)
	}

	function customerFieldValue(record : any, key : string) : string {
		if (key == 'phone') return String(record.phone || '')
		if (key == 'member_no') return String(record.memberNo || '')
		if (key == 'birthday') return String(record.birthday || '')
		if (key == 'member_status') return String(record.status || '')
		if (key == 'member_level') return String(record.level || '')
		if (key == 'member_tag') return Array.isArray(record.tags) ? record.tags.join('、') : ''
		if (key == 'store') return String(record.storeName || '')
		if (key == 'exclusive_service_staff') return String(record.exclusiveServiceStaff || '')
		if (key == 'account_balance') return String(record.accountBalance || '')
		if (key == 'active_card_count') return String(record.activeCardCount || '')
		if (key == 'remaining_project_times') return String(record.remainingProjectTimes || '')
		if (key == 'remaining_project_amount') return String(record.remainingProjectAmount || '')
		if (key == 'debt_amount') return String(record.debtAmount || '')
		if (key == 'total_consumption_amount') return String(record.totalConsumptionAmount || '')
		if (key == 'visit_count') return String(record.visitCount || '')
		if (key == 'latest_purchase_date') return String(record.latestPurchaseDate || '')
		if (key == 'last_service_staff') return String(record.lastServiceStaff || '')
		if (key == 'latest_visit_date') return String(record.latestVisitDate || '')
		if (key == 'created_at') return String(record.createdAt || '')
		return ''
	}

	function createGroup() {
		let name = groupName.value.trim()
		if (creatingGroup.value) return
		if (name.length == 0) { groupEntryMessage.value = '请先填写客群名称。'; return }
		groupEntryMessage.value = ''
		creatingGroup.value = true
		createMobileCustomerAudience({
			name: name,
			filters: selectedFilters(),
			filterRelation: 'all',
			idempotencyKey: 'audience-' + Date.now().toString() + '-' + Math.floor(Math.random() * 100000).toString()
		}, (result : any) => {
			creatingGroup.value = false
			if (!result.ok) { if (handleExpiredMerchantSession(result)) return; groupEntryMessage.value = String(result.message || '客群保存失败。'); return }
			groupEntryVisible.value = false
			restoreListFilters()
			groupName.value = ''
			activeTab.value = 'groups'
			activeTabLabel.value = '我的客群'
			loadActiveTab()
		})
	}

	function clearGroupEntryMessage() { groupEntryMessage.value = '' }

	function selectedFilters() : Array<any> {
		let result = new Array<any>()
		for (let index = 0; index < selectedFilterKeys.value.length; index++) {
			let fieldKey = selectedFilterKeys.value[index]
			if (isBirthdayField(fieldKey)) {
				let shortcut = birthdayShortcutFor(fieldKey)
				if (shortcut !== 'custom') { result.push({ field_key: fieldKey, operator: 'mobile_birthday_' + shortcut, value: '' }); continue }
			}
			if (isDateField(fieldKey) && !isBirthdayField(fieldKey)) {
				let shortcut = dateShortcutFor(fieldKey)
				if (shortcut !== 'custom') { result.push({ field_key: fieldKey, operator: 'mobile_date_' + shortcut, value: isRollingDayShortcut(fieldKey) ? filterValueFor(fieldKey).trim() : '' }); continue }
			}
			let value = filterValueFor(fieldKey).trim()
			let operator = filterOperatorFor(fieldKey)
			if (operator === 'between') {
				let valueTo = filterValueToFor(fieldKey).trim()
				if (value.length > 0 && valueTo.length > 0) {
					if (isDateField(fieldKey)) result.push({ field_key: fieldKey, operator: 'mobile_date_between', value: value, valueTo: valueTo })
					else result.push({ field_key: fieldKey, operator: operator, value: [value, valueTo] })
				}
			} else if (value.length > 0) result.push({ field_key: fieldKey, operator: isDateField(fieldKey) ? 'mobile_date_' + operator : operator, value: value })
		}
		return result
	}

	function selectedFilterDefinitions() : Array<any> {
		let result = new Array<any>()
		for (let index = 0; index < filterFields.length; index++) if (isFieldSelected(filterFields[index].key)) result.push(filterFields[index])
		return result
	}

	function copyFilterKeys(source : Array<string>) : Array<string> {
		let copied = new Array<string>()
		for (let index = 0; index < source.length; index++) copied.push(source[index])
		return copied
	}

	function copyFilterValues(source : any) : any {
		let copied : any = {}
		for (let index = 0; index < filterFields.length; index++) {
			let key = filterFields[index].key
			if (source[key] != null) copied[key] = String(source[key])
		}
		return copied
	}

	function restoreListFilters() {
		selectedFilterKeys.value = copyFilterKeys(listFilterSnapshotKeys.value)
		filterValues.value = copyFilterValues(listFilterSnapshotValues.value)
		filterValueTos.value = copyFilterValues(listFilterSnapshotValueTos.value)
		filterOperators.value = copyFilterValues(listFilterSnapshotOperators.value)
		dateShortcuts.value = copyFilterValues(listFilterSnapshotDateShortcuts.value)
		birthdayShortcuts.value = copyFilterValues(listFilterSnapshotBirthdayShortcuts.value)
		listFilterSnapshotKeys.value = new Array<string>()
		listFilterSnapshotValues.value = {}
		listFilterSnapshotValueTos.value = {}
		listFilterSnapshotOperators.value = {}
		listFilterSnapshotDateShortcuts.value = {}
		listFilterSnapshotBirthdayShortcuts.value = {}
	}

	function filterDefinition(fieldKey : string) : any { for (let index = 0; index < filterFields.length; index++) if (filterFields[index].key === fieldKey) return filterFields[index]; return { key: fieldKey, label: fieldKey, type: 'text' } }
	function filterType(fieldKey : string) : string { return String(filterDefinition(fieldKey).type || 'text') }
	function isNumberField(fieldKey : string) : boolean { return filterType(fieldKey) === 'number' }
	function isDateField(fieldKey : string) : boolean { let type = filterType(fieldKey); return type === 'date' || type === 'birthday' }
	function isBirthdayField(fieldKey : string) : boolean { return filterType(fieldKey) === 'birthday' }
	function filterOperatorOptions(fieldKey : string) : Array<any> { if (isNumberField(fieldKey)) return numberOperatorOptions; if (isDateField(fieldKey)) return dateOperatorOptions; return textOperatorOptions }
	function filterOperatorFor(fieldKey : string) : string { let configured = String(filterOperators.value[fieldKey] || ''); if (configured.length > 0) return configured; return isNumberField(fieldKey) ? 'greater_than' : (isDateField(fieldKey) ? 'equal' : 'contains') }
	function setFilterOperatorValue(fieldKey : string, value : string) { filterOperators.value[fieldKey] = String(value) }
	function showFilterOperator(fieldKey : string) : boolean { if (isBirthdayField(fieldKey) || isRollingDayShortcut(fieldKey)) return false; if (isDateField(fieldKey)) return dateShortcutFor(fieldKey) === 'custom'; return true }
	function dateShortcutFor(fieldKey : string) : string { return String(dateShortcuts.value[fieldKey] || 'custom') }
	function dateShortcutOptionsFor(fieldKey : string) : Array<any> { let options = new Array<any>(); for (let index = 0; index < dateShortcutOptions.length; index++) options.push(dateShortcutOptions[index]); if (fieldKey === 'latest_visit_date') options.push({ value: 'inactive_days', label: '超过指定天数未到店' }); if (fieldKey === 'latest_purchase_date') options.push({ value: 'inactive_purchase_days', label: '超过指定天数未购买' }); return options }
	function dateShortcutLabelsFor(fieldKey : string) : Array<string> { let labels = new Array<string>(); let options = dateShortcutOptionsFor(fieldKey); for (let index = 0; index < options.length; index++) labels.push(String(options[index].label)); return labels }
	function dateShortcutLabel(fieldKey : string) : string { let value = dateShortcutFor(fieldKey); let options = dateShortcutOptionsFor(fieldKey); for (let index = 0; index < options.length; index++) if (options[index].value === value) return String(options[index].label); return '自定义日期' }
	function setDateShortcut(fieldKey : string, index : any) {
		let option = dateShortcutOptionsFor(fieldKey)[Number(index)]
		if (option == null) return
		let next = String(option.value)
		if (dateShortcutFor(fieldKey) !== next) {
			filterValues.value[fieldKey] = ''
			filterValueTos.value[fieldKey] = ''
			filterOperators.value[fieldKey] = 'equal'
		}
		dateShortcuts.value[fieldKey] = next
	}
	function birthdayShortcutFor(fieldKey : string) : string { return String(birthdayShortcuts.value[fieldKey] || 'today') }
	function setBirthdayShortcut(fieldKey : string, value : string) { birthdayShortcuts.value[fieldKey] = value }
	function isRollingDayShortcut(fieldKey : string) : boolean { let shortcut = dateShortcutFor(fieldKey); return shortcut === 'inactive_days' || shortcut === 'inactive_purchase_days' }
	function rollingDayPlaceholder(fieldKey : string) : string { return fieldKey === 'latest_purchase_date' ? '输入未购买天数' : '输入未到店天数' }
	function showFilterValue(fieldKey : string) : boolean { if (isBirthdayField(fieldKey)) return birthdayShortcutFor(fieldKey) === 'custom'; if (isDateField(fieldKey)) return dateShortcutFor(fieldKey) === 'custom' || isRollingDayShortcut(fieldKey); return true }
	function filterValuePlaceholder(fieldKey : string, ending : boolean) : string { if (isNumberField(fieldKey)) return ending ? '最大值' : '最小值'; return '填写' + String(filterDefinition(fieldKey).label) + '条件' }
	function filterValueFor(fieldKey : string, fallback : string = '') : string { let value = String(filterValues.value[fieldKey] || ''); return value.length > 0 ? value : fallback }
	function setFilterValue(fieldKey : string, value : string) { filterValues.value[fieldKey] = String(value || '') }
	function filterValueToFor(fieldKey : string, fallback : string = '') : string { let value = String(filterValueTos.value[fieldKey] || ''); return value.length > 0 ? value : fallback }
	function setFilterValueTo(fieldKey : string, value : string) { filterValueTos.value[fieldKey] = String(value || '') }
</script>

<style>
	.customer-page {
		display: flex;
		min-height: 100%;
		flex: 1;
		flex-direction: column;
		background-color: #f5f7fa;
	}

	.customer-page__header {
		display: flex;
		flex-direction: column;
		padding: 52px 20px 16px 20px;
		border-bottom-width: 1px;
		border-bottom-style: solid;
		border-bottom-color: #dde4ed;
		background-color: #ffffff;
	}

	.customer-page__eyebrow {
		font-size: 12px;
		font-weight: 600;
		line-height: 18px;
		color: #697586;
	}

	.customer-page__title-row {
		display: flex;
		min-width: 0;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		margin-top: 6px;
	}

	.customer-page__title {
		font-size: 24px;
		font-weight: 700;
		line-height: 34px;
		color: #1f2329;
	}

	.customer-page__header-actions { display: flex; flex-direction: row; align-items: center; }
	.customer-page__new-customer { display: flex; min-height: 34px; flex-direction: row; align-items: center; margin-left: 8px; padding: 0px 11px; border-width: 1px; border-style: solid; border-color: #1677cc; background-color: #1677cc; font-size: 13px; font-weight: 600; line-height: 20px; color: #ffffff; }
	.customer-page__new-customer-symbol { margin-right: 3px; font-size: 17px; line-height: 20px; }

	.customer-page__new-group {
		display: flex;
		min-height: 34px;
		flex-direction: row;
		align-items: center;
		padding: 0px 10px 0px 9px;
		border-width: 1px;
		border-style: solid;
		border-color: #b8d6ef;
		background-color: #f7fbff;
	}

	.customer-page__new-group-symbol {
		font-size: 18px;
		font-weight: 600;
		line-height: 20px;
		color: #1677cc;
	}

	.customer-page__new-group-label {
		margin-left: 4px;
		font-size: 13px;
		font-weight: 600;
		line-height: 20px;
		color: #1677cc;
	}

	.customer-page__tabs {
		display: flex;
		min-height: 48px;
		flex-direction: row;
		align-items: stretch;
		padding: 0px 20px 0px 20px;
		border-bottom-width: 1px;
		border-bottom-style: solid;
		border-bottom-color: #dde4ed;
		background-color: #ffffff;
	}

	.customer-page__tab {
		display: flex;
		min-width: 0;
		flex: 1;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		border-bottom-width: 2px;
		border-bottom-style: solid;
		border-bottom-color: #ffffff;
		font-size: 14px;
		font-weight: 600;
		line-height: 20px;
		color: #697586;
	}

	.customer-page__tab--active {
		border-bottom-color: #1677cc;
		color: #1677cc;
	}

	.customer-page__query-bar {
		display: flex;
		flex-direction: row;
		align-items: center;
		padding: 14px 20px 10px 20px;
		background-color: #ffffff;
	}

	.customer-page__search {
		display: flex;
		min-width: 0;
		flex: 1;
		flex-direction: row;
		align-items: center;
		height: 38px;
		padding: 0px 12px 0px 12px;
		border-width: 1px;
		border-style: solid;
		border-color: #d8e0ea;
		background-color: #f8fafc;
	}

	.customer-page__search-symbol {
		font-size: 18px;
		line-height: 20px;
		color: #98a2b3;
	}

	.customer-page__search-input {
		min-width: 0;
		flex: 1;
		height: 20px;
		padding: 0px;
		margin-left: 8px;
		border-width: 0;
		border-style: none;
		border-color: transparent;
		outline-style: none;
		background-color: transparent;
		font-size: 14px;
		line-height: 20px;
		color: #303133;
	}

	.customer-page__search-input input {
		padding: 0px;
		border-width: 0;
		border-style: none;
		border-color: transparent;
		outline-style: none;
		background-color: transparent;
		font-size: 14px;
		line-height: 20px;
		color: #303133;
	}

	.customer-page__search .uni-input-input {
		box-sizing: border-box;
		width: 100%;
		height: 22px;
		padding: 0px;
		border-width: 0px !important;
		border-style: none !important;
		outline: none !important;
		background: transparent;
		font-size: 14px;
		line-height: 22px;
		color: #303133;
	}

	.customer-page__search .uni-input-wrapper {
		display: flex;
		align-items: center;
		height: 22px;
		border-width: 0px;
		background: transparent;
	}

	.customer-page__search :deep(.uni-input-input) {
		box-sizing: border-box;
		width: 100%;
		height: 22px;
		padding: 0px;
		border-width: 0px !important;
		border-style: none !important;
		outline: none !important;
		background: transparent;
	}

	:deep(.uni-input-input) {
		border-width: 0px !important;
		border-style: none !important;
		outline: none !important;
		background: transparent;
	}

	.customer-page__filter-button {
		display: flex;
		min-width: 56px;
		height: 38px;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		margin-left: 8px;
		border-width: 1px;
		border-style: solid;
		border-color: #d8e0ea;
		background-color: #ffffff;
		font-size: 13px;
		font-weight: 600;
		line-height: 20px;
		color: #526071;
	}

	.customer-page__field-settings {
		display: flex;
		height: 38px;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		margin-left: 8px;
		padding: 0px 9px;
		border-width: 1px;
		border-style: solid;
		border-color: #d8e0ea;
		background-color: #ffffff;
		font-size: 13px;
		font-weight: 600;
		line-height: 20px;
		color: #526071;
	}

	.customer-page__filter-count {
		display: flex;
		min-width: 16px;
		height: 16px;
		align-items: center;
		justify-content: center;
		margin-left: 4px;
		background-color: #1677cc;
		font-size: 10px;
		font-weight: 700;
		line-height: 16px;
		color: #ffffff;
	}

	.customer-page__scope-row {
		display: flex;
		min-height: 36px;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		padding: 0px 20px 0px 20px;
		background-color: #ffffff;
	}

	.customer-page__scope-label {
		font-size: 13px;
		font-weight: 600;
		line-height: 20px;
		color: #526071;
	}

	.customer-page__scope-query {
		font-size: 12px;
		line-height: 18px;
		color: #1677cc;
	}

	.customer-page__content {
		display: flex;
		min-height: 0;
		flex: 1;
		flex-direction: column;
		padding: 24px 20px 32px 20px;
		box-sizing: border-box;
	}

	.customer-page__empty {
		display: flex;
		flex-direction: column;
		padding: 0px 0px 0px 12px;
		border-left-width: 3px;
		border-left-style: solid;
		border-left-color: #1677cc;
	}

	.customer-page__empty-title {
		font-size: 18px;
		font-weight: 700;
		line-height: 26px;
		color: #303133;
	}

	.customer-page__empty-copy {
		margin-top: 8px;
		font-size: 14px;
		line-height: 22px;
		color: #697586;
	}

	.customer-page__empty-command {
		display: flex;
		width: 92px;
		height: 34px;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		margin-top: 16px;
		background-color: #1677cc;
		font-size: 13px;
		font-weight: 600;
		line-height: 20px;
		color: #ffffff;
	}

	.customer-filter,
	.customer-group-entry {
		display: flex;
		position: absolute;
		top: 0px;
		right: 0px;
		bottom: 0px;
		left: 0px;
		z-index: 10;
		flex-direction: column;
		background-color: #ffffff;
	}

	.customer-filter__header,
	.customer-group-entry__header {
		display: flex;
		min-height: 58px;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		padding: 30px 20px 0px 20px;
		border-bottom-width: 1px;
		border-bottom-style: solid;
		border-bottom-color: #dde4ed;
	}

	.customer-filter__dismiss,
	.customer-group-entry__dismiss {
		font-size: 14px;
		line-height: 20px;
		color: #697586;
	}

	.customer-filter__title,
	.customer-group-entry__title {
		font-size: 16px;
		font-weight: 700;
		line-height: 22px;
		color: #1f2329;
	}

	.customer-filter__apply {
		font-size: 14px;
		font-weight: 600;
		line-height: 20px;
		color: #1677cc;
	}

	.customer-group-entry__placeholder {
		width: 28px;
	}

	.customer-filter__body {
		min-height: 0;
		flex: 1;
		padding: 24px 20px 36px 20px;
	}

