<template>
	<view class="employee-performance" :class="{ 'employee-performance--native-mini': platformUsesNativeCanvas }">
		<view class="employee-performance__header">
			<view class="employee-performance__back" @tap="returnToWarehouse"><text>‹</text></view>
			<view class="employee-performance__heading"><text class="employee-performance__title">员工业绩</text><text class="employee-performance__subtitle">{{ employeeName }}</text></view>
			<view class="employee-performance__header-space"></view>
		</view>

		<scroll-view scroll-y="true" class="employee-performance__content">
			<view class="employee-performance__inner">
				<view class="employee-performance__scope">
					<view v-for="item in quickPeriods" :key="item.code" class="employee-performance__filter-pill" :class="{ 'employee-performance__filter-pill--active': periodMode === item.code }" @tap="selectQuickPeriod(item.code)"><text>{{ item.label }}</text></view>
					<view class="employee-performance__filter-pill" :class="{ 'employee-performance__filter-pill--active': periodMode === 'custom' }" @tap="openCustomRange"><text>自定义</text></view>
				</view>

				<view v-if="loading" class="employee-performance__state"><text>正在读取员工业绩…</text></view>
				<view v-else-if="message.length > 0" class="employee-performance__state"><text>{{ message }}</text><view class="employee-performance__retry" @tap="reload"><text>重新加载</text></view></view>
				<template v-else>
					<view class="employee-performance__identity-card"><view class="employee-performance__avatar"><text>{{ employeeInitial() }}</text></view><view class="employee-performance__identity-copy"><text class="employee-performance__name">{{ employeeName }}</text><text class="employee-performance__period">{{ periodLabel }}</text></view></view>
					<view class="employee-performance__metrics"><view v-for="metric in metrics" :key="metric.code" class="employee-performance__metric"><text class="employee-performance__metric-name">{{ metric.name }}</text><text class="employee-performance__metric-value">{{ metric.value }}</text></view></view>
					<view class="employee-performance__details-card"><view class="employee-performance__detail-tabs"><view class="employee-performance__detail-tab" :class="{ 'employee-performance__detail-tab--active': detailMode === 'cash' }" @tap="selectDetailMode('cash')"><text>现金业绩</text></view><view class="employee-performance__detail-tab" :class="{ 'employee-performance__detail-tab--active': detailMode === 'labor' }" @tap="selectDetailMode('labor')"><text>劳动业绩</text></view></view>
						<view v-if="details.length === 0" class="employee-performance__empty"><text>当前时间范围内暂无{{ detailMode === 'cash' ? '现金' : '劳动' }}业绩明细</text></view>
						<view v-for="item in details" :key="item.factId" class="employee-performance__detail-row">
							<view class="employee-performance__detail-head"><text class="employee-performance__detail-order">{{ visibleDetailDocumentNo(item) }}</text><text class="employee-performance__detail-date">{{ item.businessDate }}</text></view>
							<!-- Contact and service labels are supplied from the authorized server detail, never inferred from the rendered order number. -->
							<view class="employee-performance__detail-member"><text>会员：{{ item.memberName || '—' }}</text><text>手机：{{ item.memberPhone || '—' }}</text></view>
							<view class="employee-performance__detail-business"><text class="employee-performance__detail-item">{{ item.isRecharge ? '充值' : '商品名称：' + (item.itemName || '—') }}</text><text class="employee-performance__detail-amount">{{ item.isRecharge ? '充值金额：' + (item.displayRechargeAmount || '—') : detailMode === 'cash' ? '销售金额：' + (item.displaySaleAmount || '—') : '消耗金额：' + (item.displayConsumptionAmount || '—') }}</text></view>
							<view v-if="detailMode === 'labor' && item.serviceQuantity" class="employee-performance__detail-service"><text>核销数量：{{ item.serviceQuantity }}{{ item.serviceUnit ? ' ' + item.serviceUnit : '' }}</text></view>
							<view v-if="detailMode === 'labor' && (item.serviceObject || item.participants)" class="employee-performance__detail-service"><text v-if="item.serviceObject">服务对象与客数：{{ item.serviceObject }}</text><text v-if="item.participants">参与：{{ item.participants }}</text></view>
							<view class="employee-performance__detail-result"><text>{{ detailMode === 'cash' ? '销售业绩：' : '劳动业绩：' }}{{ item.displayValue }}</text><text v-if="detailMode === 'labor'">项目数：{{ item.displayProjectCount || '—' }}</text><text v-if="detailMode === 'labor' && !calculated">手工费：{{ item.displayLaborFee || '—' }}</text></view>
                            <view v-if="detailMode === 'labor' && calculated" class="employee-performance__commission" @tap="toggleCommission(item.factId)">
                                <text>劳动提成（预计）：{{ item.displayCommission || '待核对' }}</text><text>{{ expandedFact === item.factId ? '收起' : '计算依据' }}</text>
                            </view>
                            <view v-if="detailMode === 'labor' && calculated && expandedFact === item.factId && item.commissionDetail != null" class="employee-performance__commission-proof">
                                <text>{{ item.commissionDetail.month }} · 月净销售业绩：{{ item.commissionDetail.display_threshold }}</text>
                                <text v-if="item.commissionDetail.amount_cents != null">劳动业绩 {{ item.commissionDetail.display_basis }} × {{ item.commissionDetail.rate_percent }}% · 预计提成 {{ item.commissionDetail.display_commission }}</text>
                                <text v-else>{{ item.commissionDetail.message || '项目提成条件待核对' }}</text>
                            </view>
						</view>
						<view v-if="hasMore" class="employee-performance__more" @tap="loadMore"><text>加载更多</text></view>
					</view>
				</template>
			</view>
		</scroll-view>

		<!-- Detail pages retain the permission-filtered merchant navigation; the data tab owns this drill-down. -->
		<MerchantPrimaryTabBar active-key="warehouse" />
		<view v-if="showCustomRange" class="employee-performance__sheet-mask" @tap="closeCustomRange"><view class="employee-performance__sheet" @tap.stop><view class="employee-performance__sheet-head"><text>选择日期区间</text><text class="employee-performance__sheet-close" @tap="closeCustomRange">×</text></view><view class="employee-performance__range-row"><text>开始日期</text><picker mode="date" :value="customStartDate" @change="changeCustomStart"><view class="employee-performance__range-value"><text>{{ customStartDate }}</text></view></picker></view><view class="employee-performance__range-row"><text>结束日期</text><picker mode="date" :value="customEndDate" @change="changeCustomEnd"><view class="employee-performance__range-value"><text>{{ customEndDate }}</text></view></picker></view><view class="employee-performance__sheet-primary" @tap="applyCustomRange"><text>查看区间数据</text></view></view></view>
	</view>
</template>

<script setup lang="uts">
	import MerchantPrimaryTabBar from '../../../shared/components/merchant-primary-tab-bar.uvue'
	import { queryMobileWarehouseEmployeePerformance } from '../../../shared/api/mobile-warehouse-client.uts'
	import { mobileHttpResultRequiresMerchantLogin } from '../../../shared/api/mobile-http.uts'
	import { currentMobilePlatform } from '../../../shared/platform/mobile-platform.uts'
	import { clearMerchantRoot, currentMerchantRoot, merchantRequestSession } from '../../../shared/platform/mobile-merchant-session.uts'
	import { openMerchantBootstrap, returnFromMerchantEmployeePerformance } from '../../../shared/platform/mobile-navigation.uts'

	const now = new Date()
	const quickPeriods = [{ code: 'today', label: '今天' }, { code: 'yesterday', label: '昨天' }, { code: 'last_month', label: '上月' }, { code: 'month', label: '本月' }]
	const platformUsesNativeCanvas = currentMobilePlatform() === 'MP_WEIXIN'
	const employeeId = ref(0)
	const returnTarget = ref('warehouse')
	const employeeName = ref('员工')
	const periodMode = ref('month')
	const month = ref(now.getFullYear().toString() + '-' + twoDigits(now.getMonth() + 1))
	const customStartDate = ref(month.value + '-01')
	const customEndDate = ref(now.getFullYear().toString() + '-' + twoDigits(now.getMonth() + 1) + '-' + twoDigits(now.getDate()))
	const periodLabel = ref('本月')
	const detailMode = ref('cash')
	const metrics = ref<Array<any>>([])
	const details = ref<Array<any>>([])
    const calculated = ref(false)
    const expandedFact = ref('')
	const page = ref(1)
	const hasMore = ref(false)
	const loading = ref(false)
	const loadingMore = ref(false)
	const message = ref('')
	const showCustomRange = ref(false)

	onLoad((options : any) => {
		employeeId.value = Number(options != null ? options.employeeId || 0 : 0)
		// Only these merchant tabs can be used as return targets; never accept a caller URL.
		let requestedReturn = String(options != null ? options.returnTarget || 'warehouse' : 'warehouse')
		returnTarget.value = requestedReturn === 'profile' || requestedReturn === 'home' ? requestedReturn : 'warehouse'
		periodMode.value = String(options != null ? options.periodMode || 'month' : 'month')
		month.value = String(options != null ? options.month || month.value : month.value)
		customStartDate.value = String(options != null ? options.startDate || customStartDate.value : customStartDate.value)
		customEndDate.value = String(options != null ? options.endDate || customEndDate.value : customEndDate.value)
		detailMode.value = String(options != null ? options.detailMode || 'cash' : 'cash') === 'labor' ? 'labor' : 'cash'
		if (employeeId.value <= 0) { message.value = '未识别到有效员工。'; return }
		reload()
	})

	function twoDigits(value : number) : string { return value < 10 ? '0' + value.toString() : value.toString() }
	function employeeInitial() : string { return employeeName.value.length > 0 ? employeeName.value.slice(0, 1) : '员' }
	// Old API responses can still contain the opaque completion receipt; never render it as a business document number.
	function visibleDetailDocumentNo(item : any) : string {
		let number = String(item.orderNo || '').trim()
		return number.length > 0 && !/^ECR-[0-9a-f]{40}$/i.test(number) ? number : '暂无单号'
	}
	function returnToWarehouse() : void { returnFromMerchantEmployeePerformance(returnTarget.value) }
	function selectQuickPeriod(mode : string) : void { periodMode.value = mode; reload() }
	function openCustomRange() : void { showCustomRange.value = true }
	function closeCustomRange() : void { showCustomRange.value = false }
	function changeCustomStart(event : any) : void { customStartDate.value = String(event.detail.value || customStartDate.value) }
	function changeCustomEnd(event : any) : void { customEndDate.value = String(event.detail.value || customEndDate.value) }
	function applyCustomRange() : void { periodMode.value = 'custom'; showCustomRange.value = false; reload() }
    // 手机只展开后端计算依据，不按当前页或所选日期重新落档。
    function toggleCommission(factId : string) : void { expandedFact.value = expandedFact.value === factId ? '' : factId }
	function selectDetailMode(mode : string) : void { if (detailMode.value === mode) return; detailMode.value = mode; reload() }

	function requestPayload(nextPage : number) : any {
		return { employeeId: employeeId.value, periodMode: periodMode.value, month: month.value, startDate: customStartDate.value, endDate: customEndDate.value, detailMode: detailMode.value, page: nextPage, pageSize: 20 }
	}
	function reload() : void {
		if (merchantRequestSession(currentMerchantRoot()) == null) { clearMerchantRoot(); openMerchantBootstrap(); return }
		loading.value = true; loadingMore.value = false; message.value = ''; page.value = 1; details.value = []; hasMore.value = false
		queryMobileWarehouseEmployeePerformance(requestPayload(1), (response : any) => {
			loading.value = false
			if (!response.ok || response.body == null || response.body.employeePerformance == null) {
				if (mobileHttpResultRequiresMerchantLogin(response)) { clearMerchantRoot(); openMerchantBootstrap(); return }
				message.value = String(response.message || '员工业绩暂时不可用。'); return
			}
			installProjection(response.body.employeePerformance, false)
		})
	}
	function loadMore() : void {
		if (!hasMore.value || loading.value || loadingMore.value) return
		loadingMore.value = true
		queryMobileWarehouseEmployeePerformance(requestPayload(page.value + 1), (response : any) => {
			loadingMore.value = false
			if (!response.ok || response.body == null || response.body.employeePerformance == null) { message.value = String(response.message || '更多业绩明细暂时不可用。'); return }
			installProjection(response.body.employeePerformance, true)
		})
	}
	function installProjection(payload : any, append : boolean) : void {
		employeeName.value = String(payload.employee != null ? payload.employee.name || '员工' : '员工')
		periodLabel.value = String(payload.period != null ? payload.period.label || '当前范围' : '当前范围')
        // 净销售基数仅在计算依据中展示；计算法另隐藏手工费，项目数与后端计算保持不变。
        calculated.value = payload.laborAlgorithm != null && payload.laborAlgorithm.code === 'project_tiers'
        let nextMetrics = Array.isArray(payload.metrics) ? payload.metrics : []
        metrics.value = nextMetrics.filter((metric : any) => metric.code !== 'staff_net_sales' && (!calculated.value || metric.code !== 'staff_labor_fee'))
        if (!append) expandedFact.value = ''
		let nextDetails = Array.isArray(payload.details) ? payload.details : []
		details.value = append ? details.value.concat(nextDetails) : nextDetails
		page.value = Number(payload.pagination != null ? payload.pagination.page || 1 : 1)
		hasMore.value = payload.pagination != null && payload.pagination.hasMore === true
	}
</script>

<style>
	.employee-performance { display: flex; min-height: 100%; flex: 1; flex-direction: column; background-color: #f6f9fc; }
	.employee-performance__header { display: flex; min-height: 56px; flex-direction: row; align-items: center; padding: 18px 18px 8px 18px; }
	.employee-performance__back, .employee-performance__header-space { display: flex; width: 36px; height: 36px; flex-shrink: 0; align-items: center; justify-content: center; }
	.employee-performance__back { border-radius: 18px; background-color: #ffffff; box-shadow: 0 4px 12px rgba(60, 88, 130, 0.08); }
	.employee-performance__back text { font-size: 28px; font-weight: 400; line-height: 30px; color: #40546b; }
	.employee-performance__heading { display: flex; min-width: 0; flex: 1; flex-direction: column; align-items: center; }
	.employee-performance__title { font-size: 18px; font-weight: 800; line-height: 24px; color: #173451; }
	.employee-performance__subtitle { max-width: 180px; overflow: hidden; margin-top: 1px; font-size: 11px; line-height: 16px; color: #71839a; text-overflow: ellipsis; white-space: nowrap; }
	.employee-performance__content { min-height: 0; flex: 1; }
	/* Reserve the fixed tab bar and safe area so the last detail row stays reachable. */
	.employee-performance__inner { box-sizing: border-box; width: 100%; max-width: 1200px; margin: 0 auto; padding: 8px 18px calc(96px + env(safe-area-inset-bottom)) 18px; }
	.employee-performance__scope { display: flex; min-height: 42px; flex-direction: row; align-items: center; padding: 4px; border-width: 1px; border-style: solid; border-color: rgba(215, 226, 241, 0.9); border-radius: 16px; background-color: rgba(255, 255, 255, 0.76); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.7), 0 8px 20px rgba(63, 93, 137, 0.08); }
	.employee-performance__filter-pill { display: flex; min-width: 0; flex: 1; height: 34px; align-items: center; justify-content: center; border-radius: 12px; }
	.employee-performance__filter-pill text { font-size: 13px; line-height: 20px; color: #71839a; }
	.employee-performance__filter-pill--active { background-color: #1677cc; box-shadow: 0 6px 14px rgba(22, 119, 204, 0.18); }
	.employee-performance__filter-pill--active text { font-weight: 700; color: #ffffff; }
	.employee-performance__identity-card { display: flex; min-height: 76px; flex-direction: row; align-items: center; margin-top: 12px; padding: 14px; border-radius: 8px; background-color: #ffffff; box-shadow: 0 8px 20px rgba(60, 88, 130, 0.08); }
	.employee-performance__avatar { display: flex; width: 46px; height: 46px; flex-shrink: 0; align-items: center; justify-content: center; border-radius: 23px; background-color: #e7f1ff; }
	.employee-performance__avatar text { font-size: 19px; font-weight: 800; line-height: 24px; color: #1677cc; }
	.employee-performance__identity-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; margin-left: 12px; }
	.employee-performance__name { overflow: hidden; font-size: 17px; font-weight: 800; line-height: 23px; color: #173451; text-overflow: ellipsis; white-space: nowrap; }
	.employee-performance__period { margin-top: 3px; font-size: 12px; line-height: 18px; color: #71839a; }
	.employee-performance__metrics { display: flex; flex-direction: row; flex-wrap: wrap; margin-top: 10px; padding: 6px 0; border-radius: 8px; background-color: #ffffff; box-shadow: 0 8px 20px rgba(60, 88, 130, 0.08); }
	.employee-performance__metric { display: flex; box-sizing: border-box; width: 33.33%; min-height: 64px; flex-direction: column; justify-content: center; padding: 8px 14px; }
	.employee-performance__metric-name { font-size: 11px; line-height: 16px; color: #71839a; }
	.employee-performance__metric-value { margin-top: 3px; overflow: hidden; font-size: 19px; font-weight: 800; line-height: 24px; color: #173451; text-overflow: ellipsis; white-space: nowrap; }
	.employee-performance__details-card { margin-top: 12px; overflow: hidden; border-radius: 8px; background-color: #ffffff; box-shadow: 0 8px 20px rgba(60, 88, 130, 0.08); }
	.employee-performance__detail-tabs { display: flex; min-height: 48px; flex-direction: row; border-bottom-width: 1px; border-bottom-style: solid; border-bottom-color: #edf2f7; }
	.employee-performance__detail-tab { display: flex; flex: 1; align-items: center; justify-content: center; border-bottom-width: 2px; border-bottom-style: solid; border-bottom-color: transparent; }
	.employee-performance__detail-tab text { font-size: 14px; font-weight: 600; line-height: 20px; color: #71839a; }
	.employee-performance__detail-tab--active { border-bottom-color: #1677cc; }
	.employee-performance__detail-tab--active text { color: #1677cc; }
	.employee-performance__detail-row { display: flex; min-height: 90px; flex-direction: column; padding: 12px 14px; border-bottom-width: 1px; border-bottom-style: solid; border-bottom-color: #edf2f7; }
	.employee-performance__detail-head, .employee-performance__detail-member, .employee-performance__detail-business, .employee-performance__detail-result, .employee-performance__detail-service { display: flex; min-width: 0; width: 100%; flex-direction: row; align-items: center; justify-content: space-between; }
	.employee-performance__detail-member, .employee-performance__detail-business, .employee-performance__detail-result, .employee-performance__detail-service { margin-top: 6px; }
	.employee-performance__detail-member text, .employee-performance__detail-service text { min-width: 0; font-size: 12px; line-height: 18px; color: #667b90; }
	.employee-performance__detail-service { flex-wrap: wrap; gap: 4px 10px; justify-content: flex-start; }
	.employee-performance__detail-order { overflow: hidden; font-size: 12px; font-weight: 700; line-height: 18px; color: #1677cc; text-overflow: ellipsis; white-space: nowrap; }
	.employee-performance__detail-date { flex-shrink: 0; margin-left: 10px; font-size: 11px; color: #8a99aa; }
	.employee-performance__detail-item { min-width: 0; flex: 1; overflow: hidden; font-size: 13px; line-height: 18px; color: #314257; text-overflow: ellipsis; white-space: nowrap; }
	.employee-performance__detail-amount { flex-shrink: 0; margin-left: 10px; font-size: 12px; line-height: 18px; color: #40546b; }
	/* 项目数两种模式都显示；可修改模式同时保留手工费，窄屏自然换行。 */
	.employee-performance__detail-result { flex-wrap: wrap; column-gap: 10px; row-gap: 4px; }
	.employee-performance__detail-result text { font-size: 13px; font-weight: 700; line-height: 20px; color: #173451; }
    .employee-performance__commission { display: flex; flex-direction: row; justify-content: space-between; margin-top: 8px; font-size: 12px; color: #1677cc; }
    .employee-performance__commission-proof { display: flex; flex-direction: column; gap: 6px; margin-top: 8px; padding: 10px; background-color: #f4f8fc; font-size: 12px; color: #40546b; }
	.employee-performance__empty, .employee-performance__state { display: flex; min-height: 110px; flex-direction: column; align-items: center; justify-content: center; padding: 18px; font-size: 13px; line-height: 20px; color: #71839a; text-align: center; }
	.employee-performance__state { margin-top: 12px; border-radius: 8px; background-color: #ffffff; box-shadow: 0 8px 20px rgba(60, 88, 130, 0.08); }
	.employee-performance__retry, .employee-performance__more { display: flex; min-height: 40px; align-items: center; justify-content: center; }
	.employee-performance__retry { min-width: 88px; margin-top: 12px; border-radius: 8px; background-color: #1677cc; }
	.employee-performance__retry text, .employee-performance__more text { font-size: 13px; font-weight: 700; color: #1677cc; }
	.employee-performance__retry text { color: #ffffff; }
	.employee-performance__sheet-mask { position: fixed; z-index: 80; top: 0; right: 0; bottom: 0; left: 0; display: flex; flex-direction: column; justify-content: flex-end; background-color: rgba(8, 22, 38, 0.28); }
	.employee-performance__sheet { display: flex; flex-direction: column; padding: 16px 16px 22px 16px; border-radius: 22px 22px 0 0; background-color: #ffffff; }
	.employee-performance__sheet-head { display: flex; min-height: 32px; flex-direction: row; align-items: center; justify-content: space-between; }
	.employee-performance__sheet-head > text:first-child { font-size: 17px; font-weight: 800; line-height: 24px; color: #10243b; }
	.employee-performance__sheet-close { display: flex; width: 32px; height: 32px; align-items: center; justify-content: center; border-radius: 16px; background-color: #eef4fa; font-size: 18px; color: #708196; }
	.employee-performance__range-row { display: flex; min-height: 52px; flex-direction: row; align-items: center; justify-content: space-between; margin-top: 10px; padding: 0 12px; border-radius: 8px; background-color: #f4f8fc; }
	.employee-performance__range-row text { font-size: 14px; color: #40546b; }
	.employee-performance__range-value { display: flex; min-width: 126px; height: 36px; align-items: center; justify-content: center; border-radius: 8px; background-color: #ffffff; }
	.employee-performance__range-value text { font-size: 14px; font-weight: 700; color: #1677cc; }
	.employee-performance__sheet-primary { display: flex; height: 44px; align-items: center; justify-content: center; margin-top: 16px; border-radius: 8px; background-color: #1677cc; }
	.employee-performance__sheet-primary text { font-size: 15px; font-weight: 800; color: #ffffff; }
	.employee-performance--native-mini .employee-performance__header { padding-top: 84px; }
	@media (max-width: 1236px) { .employee-performance__inner { max-width: none; } }
</style>
