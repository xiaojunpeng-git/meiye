<template><view class="appraisal-page"><text v-if="message.length>0" class="appraisal-error">{{ message }}</text><view v-if="detail!=null"><view class="appraisal-header"><text class="appraisal-kicker">回望努力，明确下一步</text><text class="appraisal-title">{{ detail.appraisal.title }}</text><text class="appraisal-note">{{ detail.appraisal.employee_name }} · {{ detail.appraisal.period_start }} 至 {{ detail.appraisal.period_end }}</text></view><view v-for="r in detail.results" :key="r.id" class="appraisal-card"><text class="appraisal-result">{{ Number(r.passed)?'✦ 本阶段已达标':'↗ 还有提升空间' }}</text><text class="appraisal-note">{{ r.score==null?'逐项通过制':String(r.score)+' 分' }}{{ Number(r.previous_result_id)>0?' · 更正后的结果，原记录保留':'' }}</text><text class="appraisal-body">{{ r.reason }}</text><text class="appraisal-note">下一步：{{ parse(String(r.snapshot_json)).next_steps||'保持练习，继续成长' }}</text></view><view v-for="o in detail.objections" :key="'o'+String(o.id)" class="appraisal-card"><text class="appraisal-heading">考评异议 · {{ o.state=='OPEN'?'等待处理':'已有回复' }}</text><text class="appraisal-body">{{ o.body }}</text><text v-if="o.resolution!=null" class="appraisal-note">{{ o.resolution }}</text><view v-if="detail.can_handle && o.state=='OPEN'"><textarea v-model="resolution" class="appraisal-textarea" placeholder="处理依据；需改分时先确认更正结果"></textarea><button :disabled="busy" class="appraisal-primary" @tap="resolve(Number(o.id))">记录异议处理</button></view></view><view v-if="detail.can_handle" class="appraisal-card"><text class="appraisal-heading">{{ detail.results.length>0?'更正考评（保留原结果）':'确认本次考评' }}</text><view v-for="item in detail.standard.items" :key="item.key" class="appraisal-item"><text class="appraisal-heading">{{ item.title }}{{ item.critical?' · 关键项':'' }}</text><text class="appraisal-note">{{ item.description }}</text><text v-if="item.allow_na" class="appraisal-option" @tap="toggle(String(item.key))">{{ items[item.key].not_applicable?'☑':'□' }} 本次不适用</text><textarea v-if="items[item.key].not_applicable" v-model="items[item.key].reason" class="appraisal-textarea" placeholder="说明不适用原因"></textarea><view v-else><input v-if="detail.standard.mode=='score'" v-model="items[item.key].score" type="number" class="appraisal-input" :placeholder="'分项得分 / '+String(item.max_score)"><view v-else class="appraisal-options"><text :class="items[item.key].passed===true?'appraisal-selected':''" @tap="choose(String(item.key),true)">通过</text><text :class="items[item.key].passed===false?'appraisal-selected':''" @tap="choose(String(item.key),false)">未通过</text></view><textarea v-model="items[item.key].note" class="appraisal-textarea" placeholder="评价依据"></textarea><text v-if="item.evidence_required" class="appraisal-option" @tap="evidence(String(item.key))">＋ 本项证据（{{ items[item.key].asset_ids.length }}）</text></view></view><textarea v-model="reason" class="appraisal-textarea" placeholder="考评依据 / 更正原因"></textarea><textarea v-model="nextSteps" class="appraisal-textarea" placeholder="下一步建议"></textarea><button class="appraisal-primary" :disabled="busy" @tap="confirm">确认并公布</button></view><view v-else-if="detail.results.length>0" class="appraisal-card"><text class="appraisal-heading">有疑问，可以说出来</text><textarea v-model="objection" class="appraisal-textarea" placeholder="说明对本次考评的疑问与依据"></textarea><button class="appraisal-primary" :disabled="busy" @tap="object">提交考评异议</button></view></view></view></template>
<script setup lang="uts">
import {growthRequest,growthKey,growthUploadFile} from '../../api/mobile-growth-client.uts'
const id=ref(0)
const detail=ref<any>(null)
const items=ref<any>({})
const reason=ref('')
const nextSteps=ref('')
const objection=ref('')
const resolution=ref('')
const message=ref('')
const busy=ref(false)
let pending:any=null
onLoad((o:any)=>{id.value=Number(o['id']||0);load()})
// 负责人确认与员工异议分别写入独立事实；正式更正不会覆盖原考评。
function load():void{growthRequest('appraisal',{id:id.value},(r:any)=>{if(!r.ok){message.value=r.message;return};detail.value=r.data;let input:any={};r.data.standard.items.forEach((v:any)=>{input[String(v.key)]={passed:null,score:'',note:'',not_applicable:false,reason:'',asset_ids:[]}});items.value=input})}
function parse(s:string):any{try{return JSON.parse(s)}catch(_e){return {}}}
function toggle(k:string):void{items.value[k].not_applicable=!items.value[k].not_applicable}
function choose(k:string,v:boolean):void{items.value[k].passed=v}
function command(endpoint:string,payload:any):void{if(busy.value)return;busy.value=true;if(pending==null)pending={endpoint:endpoint,payload:{...payload,idempotency_key:growthKey()}};growthRequest(pending.endpoint,pending.payload,(r:any)=>{busy.value=false;if(!r.ok){message.value=r.message;if(r.rejected)pending=null;return};pending=null;message.value=String(r.data.message||'已保存');load()})}
function confirm():void{uni.showModal({title:'确认公布考评',content:'结果将展示在员工档案中；更正会保留原记录。',success:(r:any)=>{if(r.confirm)command('appraisalConfirm',{id:id.value,items:items.value,reason:reason.value,next_steps:nextSteps.value})}})}
function object():void{command('appraisalObject',{id:id.value,body:objection.value})}
function resolve(o:number):void{command('objectionResolve',{objection_id:o,resolution:resolution.value})}
function evidence(k:string):void{uni.chooseImage({count:1,success:(r:any)=>{busy.value=true;growthUploadFile(String(r.tempFilePaths[0]),(v:any)=>{busy.value=false;if(!v.ok){message.value=v.message;return};items.value[k].asset_ids.push(Number(v.data.id))})}})}
</script>
<style>
.appraisal-page{min-height:100vh;background-color:#f6f7f2;color:#25483f;padding-bottom:30px}.appraisal-header{padding:30px 22px;background-color:#e6eee2}.appraisal-kicker{display:block;font-size:12px;color:#7d9071}.appraisal-title{display:block;font-size:25px;font-weight:700;margin-top:15px}.appraisal-note{display:block;font-size:12px;color:#8b9880;line-height:22px;margin-top:10px}.appraisal-card{margin:18px;padding:20px;border:1px solid #e1e8db;border-radius:13px;background-color:#fff}.appraisal-result{font-size:21px;font-weight:600;color:#2b7154}.appraisal-heading{display:block;font-size:16px;line-height:25px;font-weight:600}.appraisal-body{display:block;margin-top:15px;font-size:14px;line-height:24px}.appraisal-textarea{width:100%;height:90px;box-sizing:border-box;background-color:#f6f8f2;border-radius:8px;padding:12px;font-size:14px;margin-top:14px}.appraisal-item{padding-top:20px;margin-top:20px;border-top:1px solid #e9ede4}.appraisal-options{display:flex;flex-direction:row;gap:12px;margin-top:12px}.appraisal-options text{padding:10px 18px;background-color:#f1f4ed;border-radius:7px;color:#869278}.appraisal-options .appraisal-selected{background-color:#dbead4;color:#285a41}.appraisal-input{border:1px solid #dfe7d7;border-radius:7px;padding:12px;margin-top:12px}.appraisal-option{display:block;font-size:13px;color:#527851;margin-top:14px}.appraisal-primary{margin-top:20px;background-color:#23634d;color:#fff;border-radius:10px;font-size:14px}.appraisal-error{display:block;margin:12px;padding:12px;background-color:#fff0e8;color:#a55238;font-size:12px}
</style>
