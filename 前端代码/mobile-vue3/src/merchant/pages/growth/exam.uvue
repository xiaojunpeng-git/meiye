<template>
  <view class="exam-page" @touchstart="merchantSwipeBack.start" @touchmove="merchantSwipeBack.move" @touchend="merchantSwipeBack.end" @touchcancel="merchantSwipeBack.cancel"><view v-if="message.length > 0" class="exam-error"><text>{{ message }}</text><text v-if="pending != null" @tap="retry">重试确认</text></view>
    <view v-if="sheet == null && task != null && task.can_handle && !task.is_learner" class="exam-intro"><text class="exam-title">{{ task.title }}</text><text class="exam-note">学员尚未提交可处理的答卷，提交后可从待处理事项进入。</text><button class="exam-secondary" @tap="back">返回待处理</button></view><view v-else-if="sheet == null" class="exam-intro"><text class="exam-kicker">一次练习，一点进步</text><text class="exam-title">{{ task != null ? task.title : '能力检验' }}</text><text class="exam-note">作答可以保存后继续。交卷后本次答案固定；补考保留每次记录。</text><button class="exam-primary" :disabled="busy" @tap="start">{{ busy ? '正在准备…' : '开始作答' }}</button></view>
    <view v-else-if="sheet.can_handle && task != null && !task.is_learner" class="exam-head"><text class="exam-title">{{ sheet.title }} · 阅卷</text><text class="exam-note">只处理当前指派答卷，客观题按原冻结答案评分。</text><view v-for="q in sheet.questions" :key="q.id" class="exam-question"><text class="exam-stem">{{ q.stem }}</text><text class="exam-note">学员作答：{{ learnerAnswer(q) }}</text><text class="exam-note">{{ answerLabel(q) }}</text><view v-if="q.type=='text' && (sheet.state=='GRADING'||sheet.state=='HELD')"><text class="exam-note">本题得分（0—{{ q.score }}）</text><input type="number" v-model="manualGrades[String(q.id)].score" class="exam-textarea"  @touchstart.stop="merchantSwipeBack.cancel"/><textarea v-model="manualGrades[String(q.id)].note" class="exam-textarea" placeholder="填写评分依据" @touchstart.stop="merchantSwipeBack.cancel"></textarea></view></view><button v-if="sheet.state=='GRADING'||sheet.state=='HELD'" class="exam-primary" :disabled="busy" @tap="confirmGrade">确认评分并公布</button><text v-else class="exam-note">{{ sheet.state=='PUBLISHED'?'已公布；后续更正请在平台原答卷填写原因。':'当前答卷尚不可确认' }}</text><button class="exam-secondary" @tap="back">返回待处理</button></view>
    <view v-else-if="sheet.state == 'ANSWERING'"><view class="exam-head"><text class="exam-kicker">第 {{ sheet.attempt_no }} 次 · 共 {{ sheet.questions.length }} 题</text><text class="exam-title">{{ sheet.title }}</text><text v-if="sheet.deadline_at > 0" class="exam-timer">剩余 {{ countdown }}</text><text v-else class="exam-note">本次不限时</text><text class="exam-note">{{ sheet.instructions }}</text><text class="exam-note">已答 {{ answeredCount }} / {{ sheet.questions.length }} · {{ savedText }}</text></view>
      <view v-for="(q, index) in sheet.questions" :key="q.id" class="exam-question"><view class="exam-question-head"><text class="exam-question-no">{{ index + 1 }}</text><text class="exam-question-kind">{{ typeLabel(String(q.type)) }} · {{ q.score }}分</text></view><text class="exam-stem">{{ q.stem }}</text><text class="exam-note" @tap="openFeedback(q)">题目有疑问？反馈给负责人</text>
        <textarea v-if="q.type == 'text'" :value="String(answers[String(q.id)] || '')" class="exam-textarea" placeholder="写下你的专业理解…" maxlength="10000" :disabled="busy || pending != null" @input="writeText(String(q.id),$event)" @touchstart.stop="merchantSwipeBack.cancel"></textarea>
        <view v-else><text v-if="q.type == 'order'" class="exam-note">按正确先后点选全部选项，全部顺序正确才得分。点已选项可撤回。</text><text v-if="q.type == 'order'" class="exam-note">当前顺序：{{ orderLabel(q) }}</text><view v-for="(option, i) in q.options" :key="i" :class="['exam-option', selected(String(q.id),i) ? 'exam-option-selected' : '']" @tap="choose(q,i)"><text class="exam-option-mark">{{ q.type == 'order' && selected(String(q.id),i) ? String(answers[String(q.id)].indexOf(i)+1) : (selected(String(q.id),i) ? '✓' : String.fromCharCode(65+i)) }}</text><text class="exam-option-copy">{{ option }}</text></view></view>
        <view v-if="sheet.kind=='practice' && sheet.practice_analysis_timing=='immediate' && q.type!='text'"><button class="exam-secondary" :disabled="busy||pending!=null" @tap="checkPractice(q)">看看本题解析</button><view v-if="practiceFeedback[String(q.id)]!=null"><text class="exam-note">{{ practiceFeedback[String(q.id)].message }}</text><text class="exam-note">{{ feedbackAnswer(q,practiceFeedback[String(q.id)]) }}</text><text class="exam-note">{{ practiceFeedback[String(q.id)].explanation }}</text><text class="exam-note">即时反馈不代表已交卷或任务完成。</text></view></view>
      </view><view class="exam-footer"><button class="exam-secondary" :disabled="busy" @tap="save">保存，稍后继续</button><button class="exam-primary" :disabled="busy" @tap="askSubmit">确认交卷</button></view>
    </view>
    <view v-else-if="sheet.state == 'GRADING' || sheet.state == 'HELD'" class="exam-result"><text class="exam-result-symbol">◷</text><text class="exam-title">答卷已收好</text><text class="exam-note">{{ sheet.state == 'GRADING' ? '正在等待阅卷，结果出来后会通知你。' : '成绩正在等待负责人公布。' }}</text><button class="exam-secondary" @tap="refresh">刷新处理进度</button><button class="exam-secondary" @tap="back">返回我的成长</button></view>
    <view v-else-if="sheet.state == 'CANCELLED'" class="exam-result"><text class="exam-title">本次练考已作废</text><text class="exam-note">原作答记录保留；后续安排请联系负责人。</text><button class="exam-secondary" @tap="back">返回我的成长</button></view>
    <view v-else-if="sheet.state == 'PUBLISHED'" :class="['exam-result', sheet.passed ? 'exam-result-pass' : 'exam-result-retry']"><view :class="['exam-result-art', celebrate ? 'exam-celebrate' : '']"><text class="exam-result-symbol">{{ sheet.passed ? '✦' : '❀' }}</text><text v-if="sheet.passed" class="exam-spark exam-spark-one">✧</text><text v-if="sheet.passed" class="exam-spark exam-spark-two">✧</text></view><text class="exam-kicker">{{ sheet.passed ? '这份进步，值得被看见' : '把不会的，变成下一次的底气' }}</text><text class="exam-title">{{ sheet.self_practice ? '练习完成！' : (sheet.passed ? '通过啦！' : '这次还差一点') }}</text><text class="exam-score">{{ sheet.score }}<text class="exam-score-total"> / {{ sheet.max_score }} 分</text></text><text class="exam-note">{{ sheet.passed ? '专业又扎实了一点，继续向前吧。' : '结果已记录，按安排补强后再出发。' }}</text><button v-if="sheet.can_retake" class="exam-primary" :disabled="busy" @tap="retake">准备好了，再试一次</button><text v-else-if="!sheet.passed" class="exam-note">本次暂不能补考，请查看负责人后续安排。</text><button class="exam-secondary" :disabled="busy" @tap="practiceMistakes">客观错题再练</button><button class="exam-secondary" @tap="back">返回我的成长</button>
      <view v-for="q in sheet.questions" :key="q.id" class="exam-analysis"><view v-if="q.answer != null || q.basis != null"><text class="exam-stem">{{ q.stem }}</text><text class="exam-note">{{ answerLabel(q) }}</text><text class="exam-note" @tap="openFeedback(q)">反馈这道题目</text><text v-if="q.explanation" class="exam-note">{{ q.explanation }}</text></view></view>
    </view>
    <view v-if="feedbackQuestion!=null" class="exam-feedback"><text class="exam-stem">题目反馈</text><text class="exam-note">{{ feedbackQuestion.stem }}</text><textarea v-model="feedbackBody" class="exam-textarea" placeholder="描述题目、答案或解析的疑问…" @touchstart.stop="merchantSwipeBack.cancel"></textarea><button class="exam-primary" :disabled="busy" @tap="sendFeedback">提交反馈</button><button class="exam-secondary" @tap="feedbackQuestion=null">取消</button></view>
  </view>
</template>
<script setup lang="uts">
	import { useMerchantSwipeBack, returnByMerchantSwipe } from '../../../shared/platform/merchant-swipe-back.uts'
import { growthRequest, growthKey } from '../../api/mobile-growth-client.uts'
const id = ref(0)
const task = ref<any>(null)
const sheet = ref<any>(null)
const practiceFeedback=ref<any>({})
// 反馈仅解释当前冻结练习题；正式成绩仍以整份最终交卷为准。
function checkPractice(q:any):void{if(busy.value||pending.value!=null)return;busy.value=true;growthRequest('practiceCheck',{attempt_id:sheet.value.id,answer_session_key:sheet.value.answer_session_key,question_id:q.id,answer:answers.value[String(q.id)]||[],idempotency_key:growthKey()},(r:any)=>{busy.value=false;if(!r.ok){message.value=r.message;return};practiceFeedback.value={...practiceFeedback.value,[String(q.id)]:r.data}})}
function feedbackAnswer(q:any,r:any):string{return '参考答案：'+r.answer.map((i:number)=>String(q.options[i])).join(q.type=='order'?' → ':'、')}
const answers = ref<any>({})
const message = ref('')
const busy = ref(false)
const pending = ref<any>(null)
const celebrate = ref(false)
const feedbackQuestion=ref<any>(null)
const feedbackBody=ref('')
const manualGrades=ref<any>({})
let gradePending:any=null
let mistakesPending:any=null
let feedbackPending:any=null
const seconds = ref(0)
let offset = 0
let timer : any = null
let autoSave : any = null
let submitQueued = false
const answeredCount = computed(() : number => { let count = 0; Object.keys(answers.value).forEach((key : string) => { let v : any = answers.value[key]; if ((Array.isArray(v) && v.length > 0) || (typeof v == 'string' && v.trim().length > 0)) count++ }); return count })
const countdown = computed(() : string => Math.floor(seconds.value/60).toString().padStart(2,'0') + ':' + (seconds.value%60).toString().padStart(2,'0'))
const savedText = computed(() : string => sheet.value != null && Number(sheet.value.saved_at) > 0 ? '已保存 ' + new Date(Number(sheet.value.saved_at)*1000).toLocaleTimeString() : '尚未保存' )
onLoad((options : any) => { id.value = Number(options['id'] || 0); growthRequest('task', { id: id.value }, (r : any) => { if (!r.ok) { message.value = r.message; if (r.rejected) pending.value = null; return }; task.value = r.data; if (Array.isArray(r.data.attempts) && r.data.attempts.length > 0) { let a : any = r.data.attempts[0]; if (a.state == 'ANSWERING' && r.data.is_learner) start(); else growthRequest('attempt', { id: a.id }, receive) } }) })
onUnload(() => { if (timer != null) clearInterval(timer); if (autoSave != null) clearInterval(autoSave) })
// 正式结果只依服务端公布状态展示；同一结果刷新不反复庆祝。
function receive(r : any) : void {
  busy.value = false
  if (!r.ok) { message.value = r.message; if(r.rejected)pending.value=null; return }
  pending.value = null; message.value = ''; sheet.value = r.data
  if(r.data.can_handle && task.value!=null && !task.value.is_learner){let grades:any={};r.data.questions.forEach((q:any)=>{if(q.type=='text')grades[String(q.id)]={score:r.data.grades!=null&&r.data.grades[String(q.id)]!=null?r.data.grades[String(q.id)].score:0,note:''}});manualGrades.value=grades;return}
  if (r.data.state == 'ANSWERING') { answers.value = r.data.answers || {}; offset = Number(r.data.server_time)*1000 - Date.now(); if (timer != null) clearInterval(timer); timer = setInterval(tick,1000); if (autoSave != null) clearInterval(autoSave); autoSave = setInterval(() => { if (!busy.value && pending.value == null) save() },20000); tick() }
  else { if (timer != null) clearInterval(timer); if (autoSave != null) clearInterval(autoSave); if (r.data.state == 'PUBLISHED') { let marker = 'growth.result.seen.'+String(r.data.id); celebrate.value = !uni.getStorageSync(marker); uni.setStorageSync(marker,true) } }
  if (submitQueued && r.data.state == 'ANSWERING') { submitQueued = false; command('examSubmit') }
}
function start() : void { if (busy.value) return; busy.value = true; pending.value = { endpoint: 'examStart', payload: { task_id: id.value, idempotency_key: growthKey() } }; growthRequest(pending.value.endpoint,pending.value.payload,receive) }
function command(endpoint : string) : void { if (sheet.value == null || sheet.value.state != 'ANSWERING') return; if (busy.value) { if (endpoint == 'examSubmit') submitQueued = true; return }; if (pending.value != null) { retry(); return }; busy.value = true; pending.value = { endpoint: endpoint, payload: { attempt_id: sheet.value.id, answer_session_key: sheet.value.answer_session_key, answers: JSON.parse(JSON.stringify(answers.value)), idempotency_key: growthKey() } }; growthRequest(endpoint,pending.value.payload,receive) }
function retry() : void { if (pending.value == null || busy.value) return; busy.value = true; growthRequest(pending.value.endpoint,pending.value.payload,receive) }
function save() : void { command('examSave') }
function askSubmit() : void { uni.showModal({ title: '确认交卷', content: '已答 '+answeredCount.value.toString()+' / '+sheet.value.questions.length.toString()+' 题。交卷后本次答案固定，是否确认？', success: (r : any) => { if (r.confirm) command('examSubmit') } }) }
function choose(q : any,index : number) : void { if (busy.value || pending.value != null) return; let key = String(q.id);practiceFeedback.value={...practiceFeedback.value,[key]:null}; let values : Array<number> = Array.isArray(answers.value[key]) ? [...answers.value[key]] : []; if (q.type == 'multiple' || q.type == 'order') { let at = values.indexOf(index); if (at >= 0) values.splice(at,1); else values.push(index) } else values = [index]; answers.value = { ...answers.value, [key]: values } }
function writeText(key : string,event : any) : void { if (!busy.value && pending.value == null) answers.value = { ...answers.value, [key]: String(event.detail.value || '') } }
function orderLabel(q : any) : string { let values : Array<any> = Array.isArray(answers.value[String(q.id)]) ? answers.value[String(q.id)] : []; return values.length > 0 ? values.map((i : any) : string => String(q.options[Number(i)])).join(' → ') : '尚未选择' }
function selected(key : string,index : number) : boolean { return Array.isArray(answers.value[key]) && answers.value[key].indexOf(index) >= 0 }
function tick() : void { if (sheet.value == null || Number(sheet.value.deadline_at) == 0) return; seconds.value = Math.max(0,Math.floor((Number(sheet.value.deadline_at)*1000 - Date.now() - offset)/1000)); if (seconds.value == 0 && !busy.value) { if (timer != null) clearInterval(timer); message.value = '答题时间已到，正在确认截止前已保存的答案。'; command('examSubmit') } }
function refresh() : void { if (sheet.value != null) growthRequest('attempt', { id: sheet.value.id },receive) }
function retake() : void { uni.showModal({ title: '开始新的尝试', content: '本次建立新答卷，保留此前记录，按最高有效成绩计入。', success: (r : any) => { if (r.confirm) start() } }) }
function typeLabel(type : string) : string { let names : any = { single: '单选', multiple: '多选', boolean: '判断', order: '顺序题', text: '简答' }; return String(names[type] || type) }
function answerLabel(q : any) : string { if (q.type == 'text') return '评分依据：'+String(q.basis || ''); let values : Array<any> = q.answer || []; return '参考答案：'+values.map((i : any) : string => String(q.options[Number(i)])).join(q.type == 'order' ? ' → ' : '、') }
function openFeedback(q:any):void{feedbackQuestion.value=q;feedbackBody.value='';feedbackPending=null}
function sendFeedback():void{if(busy.value||feedbackQuestion.value==null||sheet.value==null)return;busy.value=true;if(feedbackPending==null)feedbackPending={attempt_id:sheet.value.id,question_id:feedbackQuestion.value.id,description:feedbackBody.value,idempotency_key:growthKey()};growthRequest('questionFeedback',feedbackPending,(r:any)=>{busy.value=false;if(!r.ok){message.value=r.message;if(r.rejected)feedbackPending=null;return};feedbackPending=null;feedbackQuestion.value=null;message.value=r.data.message})}
function practiceMistakes():void{if(busy.value||sheet.value==null)return;busy.value=true;if(mistakesPending==null)mistakesPending={attempt_id:sheet.value.id,idempotency_key:growthKey()};growthRequest('practiceMistakes',mistakesPending,(r:any)=>{busy.value=false;if(!r.ok){message.value=r.message;if(r.rejected)mistakesPending=null;return};mistakesPending=null;uni.navigateTo({url:'/src/merchant/pages/growth/exam?id='+String(r.data.task_id)})})}
// 阅卷只提交简答得分与依据，客观题答案和正式总分由服务端重新计算。
function learnerAnswer(q:any):string{let value=sheet.value.answers[String(q.id)];if(q.type=='text')return String(value||'未作答');let choices:Array<any>=Array.isArray(value)?value:[];return choices.map((i:any):string=>String(q.options[Number(i)])).join(q.type=='order'?' → ':'、')||'未作答'}
function confirmGrade():void{if(busy.value)return;uni.showModal({title:'确认评分并公布',content:'正式成绩将公布给学员，请核对得分和依据。',success:(v:any)=>{if(!v.confirm)return;busy.value=true;if(gradePending==null){let grades:any={};Object.keys(manualGrades.value).forEach((k:string)=>{grades[k]={score:Number(manualGrades.value[k].score),note:manualGrades.value[k].note}});gradePending={attempt_id:sheet.value.id,grades:grades,idempotency_key:growthKey()}};growthRequest('examGrade',gradePending,(r:any)=>{busy.value=false;if(!r.ok){message.value=r.message;if(r.rejected)gradePending=null;return};gradePending=null;receive(r)})}})}
function back() : void { uni.navigateBack() }

	// Swipe/back closes only one local layer; no submit or business command is triggered.
	const merchantSwipeBack = useMerchantSwipeBack(() : boolean => {
		if (busy.value) return true
		return false
	}, () : void => { returnByMerchantSwipe('workbench') })
	// Page lifecycle hooks stay in .uvue; shared UTS has no page-hook imports.
	onHide(() => { merchantSwipeBack.cancel() })
	onUnload(() => { merchantSwipeBack.cancel() })
</script>
<style>
.exam-page{min-height:100vh;background-color:#f6f7f2;color:#25483f;padding:0 18px 28px;box-sizing:border-box}.exam-head,.exam-intro{padding:30px 8px 22px}.exam-kicker{display:block;font-size:11px;color:#a49468;line-height:21px;letter-spacing:1px}.exam-title{display:block;font-size:25px;line-height:36px;font-weight:700;margin-top:10px}.exam-note{display:block;font-size:12px;line-height:22px;color:#8b9686;margin-top:12px}.exam-timer{display:block;font-size:19px;color:#ad7553;margin-top:15px}.exam-question{background-color:white;border:1px solid #e6ece0;border-radius:14px;padding:21px;margin-bottom:14px}.exam-question-head{display:flex;flex-direction:row;align-items:center;gap:9px}.exam-question-no{display:flex;align-items:center;justify-content:center;background-color:#edf2e5;border-radius:8px;width:28px;height:28px;font-size:13px;color:#637b51}.exam-question-kind{font-size:11px;color:#9aa38f}.exam-stem{display:block;margin:16px 0;font-size:16px;line-height:27px;font-weight:500}.exam-option{display:flex;flex-direction:row;align-items:center;padding:12px;border:1px solid #e7ece2;border-radius:8px;margin-top:10px;gap:11px}.exam-option-selected{background-color:#eff6e8;border-color:#6e9a6b}.exam-option-mark{font-size:12px;color:#6d8260;flex-shrink:0;width:18px}.exam-option-copy{font-size:14px;color:#52634a;line-height:23px}.exam-textarea{box-sizing:border-box;width:100%;height:160px;border:1px solid #e1e8d9;border-radius:8px;padding:12px;font-size:14px;line-height:24px}.exam-primary,.exam-secondary{font-size:14px;border-radius:24px;margin-top:18px;padding:4px 20px}.exam-primary{background-color:#1b5b4e;color:#fff}.exam-secondary{background-color:#eaf0e2;color:#587347}.exam-footer{padding:4px 4px 24px}.exam-error{padding:13px;background-color:#fff1e8;color:#9b5940;border-radius:8px;font-size:12px;line-height:22px;margin-top:14px}.exam-result{display:flex;flex-direction:column;align-items:center;padding:45px 12px 25px;text-align:center}.exam-result-art{position:relative;width:160px;height:160px;display:flex;align-items:center;justify-content:center;border-radius:80px;background-color:#e9f1d9;margin-bottom:28px}.exam-result-symbol{font-size:70px;color:#a79b59}.exam-spark{position:absolute;font-size:30px;color:#bcad70}.exam-spark-one{left:-10px;top:5px}.exam-spark-two{right:-15px;bottom:12px}.exam-score{display:block;margin-top:20px;font-size:48px;line-height:62px;font-weight:700;color:#30644d}.exam-score-total{font-size:14px;color:#8b9a7d;font-weight:400}.exam-result-retry .exam-result-art{background-color:#f3eadb}.exam-result-retry .exam-score{color:#b18a5e}.exam-analysis{text-align:left;width:100%}.exam-celebrate{animation:growth-bloom .65s ease-out}@keyframes growth-bloom{0%{transform:scale(.7);opacity:.2}70%{transform:scale(1.07);opacity:1}100%{transform:scale(1)}}@media(prefers-reduced-motion:reduce){.exam-celebrate{animation:none}}
.exam-feedback{position:fixed;left:18px;right:18px;top:12vh;max-height:75vh;overflow:auto;padding:22px;background-color:#fff;border:1px solid #dfe7d5;border-radius:15px;box-shadow:0 0 0 100vh #25483f66;z-index:100}
</style>
