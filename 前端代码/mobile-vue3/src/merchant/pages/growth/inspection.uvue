<template>
  <view class="field-page" @touchstart="merchantSwipeBack.start" @touchmove="merchantSwipeBack.move" @touchend="merchantSwipeBack.end" @touchcancel="merchantSwipeBack.cancel"><view v-if="message.length>0" class="field-message"><text>{{ message }}</text></view>
    <view v-if="data != null && mode=='issue'"><view class="field-head"><text class="field-kicker">现场改善，认真闭环</text><text class="field-title">{{ data.issue.item_title }}</text><text class="field-note">{{ data.issue.store_name }} · {{ issueState(String(data.issue.state)) }}</text></view><view class="field-card"><text class="field-body">{{ data.issue.description }}</text><text class="field-note">期限 {{ date(Number(data.issue.due_at)) }}</text></view>
      <view v-for="r in data.rectifications" :key="r.id" class="field-card"><text class="field-card-title">整改记录 · {{ date(Number(r.submitted_at)) }}</text><text class="field-body">{{ parse(String(r.snapshot_json)).body }}</text><text v-for="asset in parse(String(r.snapshot_json)).asset_ids || []" :key="asset" class="field-link" @tap="viewAsset(Number(asset))">查看整改证据 ↗</text></view><view v-for="r in data.reviews" :key="r.id" class="field-card"><text class="field-card-title">{{ Number(r.passed)>0?'复查通过':'退回整改' }}</text><text class="field-body">{{ r.note }}</text></view>
      <view v-if="data.issue.state=='OPEN' && Number(data.issue.responsible_employee_id)==actor" class="field-card"><text class="field-card-title">提交整改</text><textarea v-model="body" class="field-textarea" placeholder="做了哪些改善，如何验证结果…" maxlength="10000" @touchstart.stop="merchantSwipeBack.cancel"></textarea><text class="field-link" @tap="addImage('')">＋ 新的整改证据（{{ assetIds.length }}）</text><button class="field-primary" :disabled="busy" @tap="rectify">提交，等待复查</button></view>
      <view v-if="data.issue.state=='PENDING_REVIEW' && Number(data.issue.reviewer_employee_id)==actor" class="field-card"><text class="field-card-title">本次复查</text><view class="field-choices"><text :class="passed?'field-selected':''" @tap="passed=true">通过并关闭</text><text :class="!passed?'field-selected':''" @tap="passed=false">退回整改</text></view><textarea v-model="note" class="field-textarea" placeholder="复查依据或退回原因…" @touchstart.stop="merchantSwipeBack.cancel"></textarea><text class="field-link" @tap="addImage('')">＋ 复查证据（{{ assetIds.length }}）</text><button class="field-primary" :disabled="busy" @tap="reviewIssue">确认本次复查</button></view>
      <view v-if="data.issue.state=='CLOSED'" class="field-closed"><text>✓ 问题已复查关闭</text><text class="field-note">谢谢你的认真，让现场更好一点。</text></view>
    </view>
    <view v-if="data != null && mode=='inspection'"><view class="field-head"><text class="field-kicker">让标准落在每一次现场</text><text class="field-title">{{ data.inspection.title }}</text><text class="field-note">{{ data.inspection.store_name }}</text></view><view v-if="data.inspection.state=='ASSIGNED' && Number(data.inspection.executor_employee_id)==actor"><view v-for="item in data.standard.items" :key="item.key" class="field-card"><text class="field-card-title">{{ item.title }}{{ item.critical?' · 关键项':'' }}</text><text class="field-note">{{ item.description }}</text><view v-if="item.allow_na" class="field-link" @tap="items[item.key].not_applicable=!items[item.key].not_applicable"><text>{{ items[item.key].not_applicable?'☑':'□' }} 本次不适用</text></view><textarea v-if="items[item.key].not_applicable" v-model="items[item.key].reason" class="field-textarea" placeholder="说明不适用原因" @touchstart.stop="merchantSwipeBack.cancel"></textarea><view v-else><input v-if="data.standard.mode=='score'" v-model="items[item.key].score" type="number" class="field-input" :placeholder="'本项得分，满分'+item.max_score" @touchstart.stop="merchantSwipeBack.cancel"/><view v-else class="field-choices"><text :class="items[item.key].passed===true?'field-selected':''" @tap="items[item.key].passed=true">达到要求</text><text :class="items[item.key].passed===false?'field-selected':''" @tap="items[item.key].passed=false">有改善项</text></view><textarea v-model="items[item.key].note" class="field-textarea" placeholder="记录实际检查依据…" @touchstart.stop="merchantSwipeBack.cancel"></textarea><text class="field-link" @tap="addImage(String(item.key))">＋ 现场证据（{{ items[item.key].asset_ids.length }}）</text></view><view class="field-link" @tap="problems[item.key].enabled=!problems[item.key].enabled"><text>{{ problems[item.key].enabled?'☑':'□' }} 安排整改</text></view><view v-if="problems[item.key].enabled"><textarea v-model="problems[item.key].description" class="field-textarea" placeholder="具体问题与整改要求" @touchstart.stop="merchantSwipeBack.cancel"></textarea><picker :range="people" range-key="name" @change="choosePerson(String(item.key),'responsible_employee_id',$event)" @touchstart.stop="merchantSwipeBack.cancel"><view class="field-picker">责任人：{{ personName(Number(problems[item.key].responsible_employee_id)) }} ›</view></picker><picker :range="people" range-key="name" @change="choosePerson(String(item.key),'reviewer_employee_id',$event)" @touchstart.stop="merchantSwipeBack.cancel"><view class="field-picker">复查人：{{ personName(Number(problems[item.key].reviewer_employee_id)) }} ›</view></picker><picker mode="date" @change="chooseDate(String(item.key),$event)" @touchstart.stop="merchantSwipeBack.cancel"><view class="field-picker">整改期限：{{ problems[item.key].date || '请选择' }} ›</view></picker></view></view><button class="field-primary" :disabled="busy" @tap="submitInspection">确认提交巡检</button></view><view v-else class="field-card"><text class="field-card-title">{{ data.inspection.state=='PENDING_REVIEW'?'巡检待复核':'本次检查已记录' }}</text><text v-if="data.inspection.result_json" class="field-body">{{ parse(String(data.inspection.result_json)).passed?'本次达到检查标准':'本次仍有待改善事项' }}</text><view v-if="data.inspection.state=='PENDING_REVIEW' && Number(data.inspection.reviewer_employee_id)==actor"><textarea v-model="note" class="field-textarea" placeholder="复核依据…" @touchstart.stop="merchantSwipeBack.cancel"></textarea><button class="field-primary" :disabled="busy" @tap="confirmInspection">确认巡检复核</button></view></view></view>
    <button class="field-secondary" @tap="back">返回成长</button>
  </view>
</template>
<script setup lang="uts">
	import { useMerchantSwipeBack, returnByMerchantSwipe } from '../../../shared/platform/merchant-swipe-back.uts'
import{growthRequest,growthKey,growthUploadFile,growthDownload,growthViewAsset}from '../../api/mobile-growth-client.uts'
import{currentMerchantRoot}from '../../../shared/platform/mobile-merchant-session.uts'
const id=ref(0)
const mode=ref('issue')
const data=ref<any>(null)
const message=ref('')
const actor=ref(0)
const people=ref<Array<any>>([])
const items=ref<any>({})
const problems=ref<any>({})
const body=ref('')
const note=ref('')
const assetIds=ref<Array<number>>([])
const passed=ref(true)
const busy=ref(false)
let pending : any=null
onLoad((options : any)=>{id.value=Number(options['id']||0);mode.value=String(options['type']||'issue');let root : any=currentMerchantRoot();actor.value=root!=null?Number(root.employee.id):0;growthRequest('inspections',{},(r : any)=>{if(r.ok)people.value=r.data.employees||[]});load()})
// 巡检结果与整改结果分别提交；整改界面永不把“已提交”显示为“已关闭”。
function load() : void {growthRequest(mode.value=='issue'?'issue':'inspection',{id:id.value},(r : any)=>{if(!r.ok){message.value=r.message;return};data.value=r.data;if(mode.value=='inspection'){let values : any={};let p : any={};r.data.standard.items.forEach((v : any)=>{values[String(v.key)]={passed:null,score:'',note:'',not_applicable:false,reason:'',asset_ids:[]};p[String(v.key)]={enabled:false,description:'',responsible_employee_id:0,reviewer_employee_id:0,date:'',due_at:0}});items.value=values;problems.value=p}})}
function command(endpoint : string,payload : any) : void {if(busy.value)return;busy.value=true;if(pending==null)pending={endpoint:endpoint,payload:{...payload,idempotency_key:growthKey()}};growthRequest(pending.endpoint,pending.payload,(r : any)=>{busy.value=false;if(!r.ok){message.value=r.message;if(r.rejected)pending=null;return};pending=null;message.value=String(r.data.message||'已记录');body.value='';note.value='';assetIds.value=[];load()})}
function rectify() : void {command('issueRectify',{issue_id:id.value,body:body.value,asset_ids:assetIds.value})}
function reviewIssue() : void {command('issueReview',{issue_id:id.value,passed:passed.value,note:note.value,asset_ids:assetIds.value})}
function submitInspection() : void {let list : Array<any>=[];Object.keys(problems.value).forEach((key : string)=>{let p : any=problems.value[key];if(p.enabled)list.push({item_key:key,description:p.description,responsible_employee_id:p.responsible_employee_id,reviewer_employee_id:p.reviewer_employee_id,due_at:p.due_at,asset_ids:items.value[key].asset_ids})});command('inspectionSubmit',{id:id.value,items:items.value,problems:list})}
function confirmInspection() : void {command('inspectionConfirm',{id:id.value,note:note.value})}
function addImage(item : string) : void {if(busy.value)return;uni.chooseImage({count:1,success:(r : any)=>{busy.value=true;growthUploadFile(String(r.tempFilePaths[0]),(u : any)=>{busy.value=false;if(!u.ok){message.value=u.message;return};if(item.length>0)items.value[item].asset_ids.push(Number(u.data.id));else assetIds.value.push(Number(u.data.id))})}})}
function choosePerson(key : string,field : string,event : any) : void {let person : any=people.value[Number(event.detail.value)];if(person!=null)problems.value[key][field]=Number(person.id)}
function chooseDate(key : string,event : any) : void {let value=String(event.detail.value);problems.value[key].date=value;problems.value[key].due_at=Math.floor(new Date(value+'T23:59:59').getTime()/1000)}
function personName(id : number) : string {let p : any=people.value.find((v : any):boolean=>Number(v.id)==id);return p!=null?String(p.name):'请选择'}
function parse(value : string) : any {try{return JSON.parse(value)}catch(_e){return {}}}
function issueState(value : string) : string {let labels : any={OPEN:'待整改',PENDING_REVIEW:'待复查',CLOSED:'已关闭',CANCELLED:'已撤销'};return String(labels[value]||value)}
function date(value : number) : string {return value>0?new Date(value*1000).toLocaleString():'未设置'}
function viewAsset(asset:number):void{growthViewAsset(asset,Number(data.value.issue!=null?data.value.issue.task_id:0))}

function back() : void {uni.navigateBack()}

	// Swipe/back closes only one local layer; no submit or business command is triggered.
	const merchantSwipeBack = useMerchantSwipeBack(() : boolean => {
		if (busy.value) return true
		return false
	}, () : void => { returnByMerchantSwipe('workbench') })
	// Page lifecycle hooks stay in .uvue; shared UTS has no page-hook imports.
	onHide(() => { merchantSwipeBack.cancel() })
	onUnload(() => { merchantSwipeBack.cancel() })
</script>
<style>
.field-page{min-height:100vh;background-color:#f6f7f2;color:#25483f;padding:0 18px 30px}.field-head{padding:28px 7px 10px}.field-kicker{display:block;font-size:11px;color:#a49468;letter-spacing:1px}.field-title{display:block;font-size:24px;line-height:35px;font-weight:700;margin-top:10px}.field-note{display:block;font-size:12px;line-height:22px;color:#8b9686;margin-top:10px}.field-card{background-color:#fff;border-radius:14px;padding:20px;margin-top:16px;border:1px solid #e4ebde}.field-card-title{display:block;font-size:17px;font-weight:600;line-height:26px}.field-body{display:block;white-space:pre-wrap;line-height:26px;font-size:14px;color:#5b6f51;margin-top:15px}.field-textarea{box-sizing:border-box;width:100%;height:100px;padding:13px;margin-top:15px;font-size:14px;line-height:24px;background-color:#f8faf5;border:1px solid #e5ebdf;border-radius:8px}.field-primary,.field-secondary{font-size:14px;border-radius:24px;margin-top:20px;padding:4px 18px}.field-primary{background-color:#1b5b4e;color:#fff}.field-secondary{background-color:#eaf0e2;color:#587347}.field-link{display:block;color:#3e7857;font-size:12px;line-height:24px;margin-top:12px}.field-choices{display:flex;flex-direction:row;gap:12px;margin-top:14px;font-size:12px}.field-choices text{padding:9px 13px;border:1px solid #e4eadc;border-radius:7px;color:#768a68}.field-choices .field-selected{background-color:#eaf3df;border-color:#8eab71;color:#386244}.field-input,.field-picker{padding:12px;border:1px solid #e0e8d6;border-radius:7px;margin-top:13px;font-size:13px;line-height:24px}.field-message{padding:12px;background-color:#fff1e8;color:#a06544;font-size:12px;line-height:22px}.field-closed{margin-top:20px;padding:25px 18px;background-color:#edf3e3;border-radius:12px;color:#647f49;text-align:center}
</style>
