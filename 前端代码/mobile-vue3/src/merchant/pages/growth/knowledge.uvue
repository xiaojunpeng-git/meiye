<template><view class="knowledge-page" @touchstart="merchantSwipeBack.start" @touchmove="merchantSwipeBack.move" @touchend="merchantSwipeBack.end" @touchcancel="merchantSwipeBack.cancel"><view class="knowledge-head"><text class="knowledge-kicker">专业，随手可得</text><text class="knowledge-title">随手学 · 有问有答</text><view class="knowledge-tabs"><text :class="tab=='knowledge'?'knowledge-active':''" @tap="switchTab('knowledge')">知识库</text><text :class="tab=='favorite'?'knowledge-active':''" @tap="switchTab('favorite')">我的收藏</text><text :class="tab=='help'?'knowledge-active':''" @tap="switchTab('help')">人工答疑</text></view></view><text v-if="message.length>0" class="knowledge-error">{{ message }}</text><view v-if="tab!='help'"><view class="knowledge-search"><input v-model="keyword" placeholder="搜索想学的知识" confirm-type="search" @confirm="search" @touchstart.stop="merchantSwipeBack.cancel"><text @tap="search">搜索</text></view><view v-for="r in rows" :key="r.id" class="knowledge-card"><text class="knowledge-tag">{{ r.category||'专业知识' }}</text><text class="knowledge-heading" @tap="open(r)">{{ r.title }} →</text><text class="knowledge-note">{{ r.description }}</text><text class="knowledge-link" @tap="favorite(r)">{{ r.favorite?'★ 已收藏，点击取消':'☆ 收藏这条知识' }}</text></view><text v-if="rows.length==0" class="knowledge-empty">暂时没有符合条件的知识</text></view><view v-else><view class="knowledge-card"><text class="knowledge-heading">把问题交给专业的人</text><textarea v-model="body" class="knowledge-textarea" placeholder="描述遇到的问题、已尝试的方法…" @touchstart.stop="merchantSwipeBack.cancel"></textarea><picker :range="people" range-key="name" @change="selectHandler" @touchstart.stop="merchantSwipeBack.cancel"><view class="knowledge-picker">{{ handlerName }} ▾</view></picker><button :disabled="busy" class="knowledge-primary" @tap="ask">提交问题</button></view><view v-for="q in rows" :key="q.id" class="knowledge-card"><text class="knowledge-heading">{{ q.body }}</text><text class="knowledge-note">{{ q.state=='OPEN'?'等待负责人答复':q.state=='CLOSED'?'答疑已完成':'已有解答' }}</text><view v-for="r in q.replies" :key="r.id" class="knowledge-reply"><text>{{ r.body }}</text><text v-if="Number(r.transfer_to)>0" class="knowledge-note">已转交给新的负责人</text></view><view v-if="(Number(q.handler_employee_id)==operator || Number(q.employee_id)==operator) && q.state!='CLOSED'"><textarea v-model="replies[String(q.id)]" class="knowledge-textarea" :placeholder="Number(q.handler_employee_id)==operator?'专业解答与建议':'补充问题说明与依据'" @touchstart.stop="merchantSwipeBack.cancel"></textarea><button :disabled="busy" class="knowledge-primary" @tap="reply(q)">{{ Number(q.handler_employee_id)==operator?'回复问题':'补充说明' }}</button></view></view></view><view v-if="pages>1" class="knowledge-pagination"><text @tap="previous">上一页</text><text>{{ page }} / {{ pages }}</text><text @tap="next">下一页</text></view></view></template>
<script setup lang="uts">
	import { useMerchantSwipeBack, returnByMerchantSwipe } from '../../../shared/platform/merchant-swipe-back.uts'
import {growthRequest,growthKey} from '../../api/mobile-growth-client.uts'
const tab=ref('knowledge')
const focusQuestion=ref(0)
onLoad((options:any)=>{focusQuestion.value=Number(options['question_id']||0);if(focusQuestion.value>0)tab.value='help'})
const keyword=ref('')
const rows=ref<Array<any>>([])
const people=ref<Array<any>>([])
const page=ref(1)
const pages=ref(1)
const operator=ref(0)
const handler=ref(0)
const handlerName=ref('请选择答疑负责人')
const body=ref('')
const replies=ref<any>({})
const message=ref('')
const busy=ref(false)
let pending:any=null
let loadSequence=0
onShow(()=>load())
// 收藏只操作本人；阅读先获得本人唯一查阅任务，再进入同一阅读器。
function load():void{let sequence=++loadSequence;growthRequest(tab.value=='help'?'help':'knowledge',{page:page.value,question_id:focusQuestion.value,keyword:keyword.value,favorite:tab.value=='favorite'?1:0},(r:any)=>{if(sequence!=loadSequence)return;if(!r.ok){message.value=r.message;return};rows.value=r.data.rows;page.value=Number(r.data.page);pages.value=Number(r.data.total_pages);if(tab.value=='help'){people.value=r.data.employees;operator.value=Number(r.data.operator_employee_id)}})}
function switchTab(t:string):void{focusQuestion.value=0;tab.value=t;page.value=1;message.value='';load()}
function search():void{page.value=1;load()}
function selectHandler(e:any):void{let p:any=people.value[Number(e.detail.value)];handler.value=Number(p.id);handlerName.value=String(p.name)}
function command(endpoint:string,data:any,after:(r:any)=>void):void{if(busy.value)return;busy.value=true;if(pending==null)pending={endpoint:endpoint,payload:{...data,idempotency_key:growthKey()}};growthRequest(pending.endpoint,pending.payload,(r:any)=>{busy.value=false;if(!r.ok){message.value=r.message;if(r.rejected)pending=null;return};pending=null;message.value='';after(r.data)})}
function open(r:any):void{command('knowledgeOpen',{id:r.id},(v:any)=>uni.navigateTo({url:'/src/merchant/pages/growth/learn?id='+String(v.task_id)}))}
function favorite(r:any):void{command('knowledgeFavorite',{id:r.id,favorite:!r.favorite},(_v:any)=>load())}
function ask():void{command('helpAsk',{body:body.value,handler_employee_id:handler.value},(_v:any)=>{body.value='';load()})}
function reply(q:any):void{command('helpReply',{id:q.id,body:replies.value[String(q.id)]||''},(_v:any)=>{replies.value[String(q.id)]='';load()})}
function previous():void{if(page.value>1){page.value--;load()}}
function next():void{if(page.value<pages.value){page.value++;load()}}

	// Swipe/back closes only one local layer; no submit or business command is triggered.
	const merchantSwipeBack = useMerchantSwipeBack(() : boolean => {
		if (busy.value) return true
		return false
	}, () : void => { returnByMerchantSwipe('workbench') })
	// Page lifecycle hooks stay in .uvue; shared UTS has no page-hook imports.
	onHide(() => { merchantSwipeBack.cancel() })
	onUnload(() => { merchantSwipeBack.cancel() })
</script>
<style>
.knowledge-page{min-height:100vh;background-color:#f6f7f2;color:#25483f;padding-bottom:30px}.knowledge-head{padding:28px 22px 18px;background-color:#e6eee2}.knowledge-kicker{display:block;color:#8c987e;font-size:12px}.knowledge-title{display:block;font-size:25px;margin-top:12px;font-weight:700}.knowledge-tabs{display:flex;flex-direction:row;gap:22px;font-size:14px;color:#8e9c82;margin-top:25px}.knowledge-active{color:#2d6c4f;font-weight:600}.knowledge-search{display:flex;flex-direction:row;gap:14px;margin:20px}.knowledge-search input{flex:1;font-size:14px;background-color:#fff;padding:10px;border-radius:7px}.knowledge-search text{font-size:14px;padding-top:10px;color:#426b4c}.knowledge-card{margin:18px;padding:20px;border-radius:12px;background-color:#fff;border:1px solid #e1e8d9}.knowledge-tag{font-size:10px;color:#9c936b}.knowledge-heading{display:block;font-size:17px;line-height:27px;margin-top:8px;font-weight:500}.knowledge-note{display:block;color:#919d86;font-size:12px;line-height:22px;margin-top:9px}.knowledge-link{display:block;color:#68875e;font-size:12px;margin-top:18px}.knowledge-empty{display:block;text-align:center;padding:40px 15px;color:#8b9981;font-size:13px}.knowledge-textarea{box-sizing:border-box;width:100%;height:100px;padding:12px;font-size:14px;background-color:#f4f7ef;border-radius:8px;margin-top:14px}.knowledge-picker{border:1px solid #dfe6d7;border-radius:7px;padding:12px;font-size:14px;margin-top:14px}.knowledge-primary{background-color:#28664e;color:#fff;border-radius:9px;margin-top:16px;font-size:14px}.knowledge-reply{padding:14px;background-color:#f1f6ec;border-radius:8px;margin-top:15px;font-size:14px;line-height:23px}.knowledge-error{display:block;margin:12px;padding:12px;background-color:#fff0e8;color:#a55238;font-size:12px}.knowledge-pagination{display:flex;flex-direction:row;justify-content:space-around;font-size:13px;padding:20px;color:#49714f}
</style>
