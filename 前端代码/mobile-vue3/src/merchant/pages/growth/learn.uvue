<template>
  <view class="growth-learn" @touchstart="touchLearning"><view v-if="message.length > 0" class="learn-message"><text>{{ message }}</text><text v-if="pending != null" @tap="retryReport"> · 重试确认</text></view>
    <view v-if="task != null"><view class="learn-head"><text class="learn-kicker">给专业一点时间</text><text class="learn-title">{{ task.title }}</text><text class="learn-note">{{ task.state == 'COMPLETED' ? '本次学习已完成，记录已保存' : '完成所有必学章节，即可记录本次成长' }}</text></view>
      <view v-if="task.content" class="learn-content"><text v-if="task.rules && task.rules.description" class="learn-text">{{ task.rules.description }}</text><text v-if="task.content.lecturer" class="learn-note">讲师：{{ task.content.lecturer }}</text><text v-if="Number(task.content.estimated_minutes)>0" class="learn-note">预计学习 {{ task.content.estimated_minutes }} 分钟</text><text v-if="task.content.description" class="learn-text">{{ task.content.description }}</text><button v-if="Number(task.content.cover_asset_id)>0" class="learn-secondary" @tap="viewCover">查看课程封面</button><view v-for="a in task.content.materials||[]" :key="a.id"><button class="learn-secondary" @tap="viewMaterial(a)">补充资料 · {{ a.original_name }}</button></view></view><scroll-view scroll-x class="learn-chapters"><view class="learn-chapter-row"><view v-for="(ch, i) in task.content != null ? task.content.chapters : []" :key="ch.key" :class="['learn-chip', i == chapterIndex ? 'learn-chip-active' : '']" @tap="selectChapter(i)"><text>{{ completed(String(ch.key)) ? '✓ ' : '' }}{{ ch.title }}</text></view></view></scroll-view>
      <view v-if="chapter != null" class="learn-content"><view class="learn-section-head"><text class="learn-section-title">{{ chapter.title }}</text><text class="learn-required">{{ chapter.required ? '必学' : '选学' }}</text></view>
        <scroll-view :scroll-y="chapter.type=='text'||chapter.type=='image'" :scroll-top="readerScrollTop" :class="chapter.type=='text'||chapter.type=='image'?'learn-reader':'learn-media-reader'" @scroll="readScroll"><view v-for="block in contentBlocks" :key="block.key"><text v-if="block.type=='text'" class="learn-text learn-paragraph">{{ block.body }}</text><view v-else-if="block.type=='media'">
        <text v-if="resourceLoading" class="learn-note">正在加载课程内容…</text>
        <image v-else-if="chapter.type == 'image' && resourceUrl.length > 0" :src="resourceUrl" mode="widthFix" class="learn-image" @tap="zoom" @load="restoreReadPosition"></image>
        <video id="growth-course-video" v-else-if="chapter.type == 'video' && resourceUrl.length > 0" :src="resourceUrl" :initial-time="resumePosition" controls class="learn-video" @play="playing=true" @pause="playing=false" @ended="videoEnded" @timeupdate="videoTime"></video>
        <view v-else-if="resourceUrl.length > 0" class="learn-document">
          <!-- #ifdef WEB -->
          <iframe :src="documentUrl" title="课程文档预览" class="learn-pdf"></iframe>
          <!-- #endif -->
          <!-- #ifndef WEB -->
          <button class="learn-secondary" @tap="openDocument">打开课程文档预览</button>
          <!-- #endif -->
          <text class="learn-note">支持放大查看，阅读后在下方确认。</text><picker v-if="documentPages.length>0" :range="documentPages" @change="changeDocumentPage"><view class="learn-progress-picker">阅读位置：第 {{ Math.max(1,Math.floor(position)) }} 页 · 选择并保存续读页 ▾</view></picker>
        </view>
        <picker v-if="chapter.type=='video' && chapter.allow_speed" :range="chapter.allowed_rates" @change="changeSpeed"><view class="learn-progress-picker">播放速度 {{ playbackRate }} 倍 ▾</view></picker>
        </view><view v-for="quiz in block.type=='quiz'?[block.quiz]:[]" :key="quiz.key" class="learn-quiz"><view v-if="showQuiz(quiz)"><text class="learn-section-title">随堂练习{{ quiz.satisfied?' · 已完成':'' }}</text><text class="learn-text">{{ quiz.question.stem }}</text><text v-if="quiz.question.type=='order'" class="learn-note">按正确顺序点选全部选项，编号表示你的选择顺序。</text><view v-if="!quiz.satisfied && ['COMPLETED','PAUSED','CANCELLED'].indexOf(String(task.state))<0"><view v-for="(option,oi) in quiz.question.options" :key="oi" :class="['learn-quiz-option',quizSelected(String(quiz.key),oi)?'learn-quiz-selected':'']" @tap="chooseQuiz(quiz,oi)"><text>{{ quiz.question.type=='order' && quizSelected(String(quiz.key),oi)?String(quizAnswers[String(quiz.key)].indexOf(oi)+1):(quizSelected(String(quiz.key),oi)?'✓':String.fromCharCode(65+oi)) }} · {{ option }}</text></view><button class="learn-secondary" :disabled="quizBusy||busy" @tap="submitQuiz(quiz)">确认本题答案</button></view><view v-if="quizResults[String(quiz.key)]!=null"><text class="learn-note">{{ quizResults[String(quiz.key)].message }}</text><text v-if="quizResults[String(quiz.key)].explanation" class="learn-note">{{ quizResults[String(quiz.key)].explanation }}</text><text v-if="quizResults[String(quiz.key)].wrong_policy=='review' && !quizResults[String(quiz.key)].passed" class="learn-note" @tap="reviewQuiz(quizResults[String(quiz.key)])">回看相关位置 →</text></view></view></view></view></scroll-view>
        <view v-if="task.state != 'COMPLETED' && task.state != 'PAUSED' && task.state != 'CANCELLED'" class="learn-bottom"><text class="learn-note">{{ chapter.completion == 'coverage' ? '本章需达到 ' + chapter.coverage_percent + '% 有效观看覆盖' : '理解本章内容后，确认本次阅读' }}</text><button class="learn-primary" :disabled="busy || (chapter.completion == 'coverage' && !completed(String(chapter.key)))" @tap="confirmChapter">{{ completed(String(chapter.key)) ? '本章已完成' : '我已学习本章' }}</button></view>
        <view v-if="task.state == 'COMPLETED'" class="learn-finished"><text class="learn-flower">✦</text><text class="learn-finished-title">又向前迈进了一步</text><text class="learn-note">学习已完成，去把专业用在服务里。</text><button class="learn-secondary" @tap="back">返回我的成长</button></view>
      </view><view v-if="task.learning_complete && task.state!='COMPLETED' && task.dependencies.length>0" class="learn-content"><text class="learn-section-title">章节已学完，还差最后一步</text><text class="learn-note">完成关联练考或实操要求后，整课才记录完成。待阅卷不算已通过。</text></view><view v-for="d in task.dependencies||[]" :key="d.id" class="learn-content" @tap="openDependency(d)"><text class="learn-section-title">{{ d.title }} →</text><text class="learn-note">{{ d.satisfied?'已满足':d.state=='PENDING'?'等待负责人确认':'待完成' }}{{ d.dependency_type=='exam'?(Number(d.require_passed)?' · 需通过':' · 成绩公布即可'):'' }}</text></view><view v-if="task.reference" class="learn-content"><text class="learn-note">{{ task.reference.valid?'本次引用原任务 #'+task.reference.source_task_id+' 的有效结果，不重复生成答卷或奖励。':'原引用结果已失效，本次任务暂停，请联系负责人安排后续学习。' }}</text></view><view v-if="task.reference_candidates && task.reference_candidates.length>0" class="learn-content"><text class="learn-section-title">你已有相同内容的有效结果</text><button v-for="candidate in task.reference_candidates" :key="candidate.id" class="learn-secondary" :disabled="busy" @tap="reference(candidate)">引用 {{ new Date(Number(candidate.completed_at)*1000).toLocaleDateString() }} 的完成结果</button></view>
    </view><view v-else-if="loading" class="learn-loading"><text>正在打开学习任务…</text></view>
  </view>
</template>
<script setup lang="uts">
import { nextTick } from 'vue'
import { growthRequest, growthKey, growthDownload, growthViewAsset } from '../../api/mobile-growth-client.uts'
const task = ref<any>(null)
const id = ref(0)
const chapterIndex = ref(0)
const chapter = computed(() : any => task.value != null && task.value.content != null ? task.value.content.chapters[chapterIndex.value] : null)
const message = ref('')
const resourceUrl = ref('')
const resourceLoading = ref(false)
const loading = ref(true)
const busy = ref(false)
const playing = ref(false)
const foreground = ref(true)
const position = ref(0)
const resumePosition = ref(0)
const readerScrollTop=ref(0)
let resourceRequest=0
let downloadTask:any=null
// 图文随堂题按稳定段落排入正文；阅读位置只用于续学，不作为掌握证明。
const contentBlocks=computed(():Array<any>=>{let blocks:Array<any>=[];let ch:any=chapter.value;if(ch==null)return blocks;let quizzes:Array<any>=ch.quizzes||[];if(ch.type=='text'){quizzes.forEach((q:any)=>{if(Number(q.position)==0)blocks.push({type:'quiz',key:'quiz-'+String(q.key),quiz:q})});let paragraphs=String(ch.body).split('\n');paragraphs.forEach((body:string,index:number)=>{blocks.push({type:'text',key:'paragraph-'+index.toString(),body:body});quizzes.forEach((q:any)=>{if(Number(q.position)==index+1)blocks.push({type:'quiz',key:'quiz-'+String(q.key),quiz:q})})})}else{if(ch.type=='image')quizzes.forEach((q:any)=>{if(Number(q.position)==0)blocks.push({type:'quiz',key:'quiz-'+String(q.key),quiz:q})});blocks.push({type:'media',key:'media'});quizzes.forEach((q:any)=>{if(ch.type!='image'||Number(q.position)>0)blocks.push({type:'quiz',key:'quiz-'+String(q.key),quiz:q})})};return blocks})
const session = growthKey()
let lastReport = 0
let sequenceNo=0
let lastInteraction=Date.now()
let idleShowing=false
const playbackRate=ref(1)
const documentUrl=computed(():string=>resourceUrl.value+(chapter.value!=null&&['word','ppt','pdf'].indexOf(String(chapter.value.type))>=0?'#page='+Math.max(1,Math.floor(position.value)).toString():''))
const documentPages=computed(():Array<string>=>{let values:Array<string>=[];if(chapter.value!=null&&chapter.value.asset!=null){for(let i=1;i<=Number(chapter.value.asset.page_count);i++)values.push('第 '+i.toString()+' 页')};return values})
let pending : any = null
let endedQueued = false
const quizAnswers=ref<any>({})
const quizResults=ref<any>({})
const quizBusy=ref(false)
const showQuizPrompt=ref(false)
let quizPending:any=null
onLoad((options : any) => { id.value = Number(options['id'] || 0); load() })
onHide(() => { foreground.value = false; playing.value = false;report(false) })
onShow(() => { foreground.value = true;if(task.value!=null)load(false) })
// 同一页面串行上报；响应未知保留同一标识，位置不作为阅读完成的证明。
function report(confirm : boolean, ended : boolean = false, open : boolean = false) : void {
  if (busy.value && ended) endedQueued = true
  if (busy.value || chapter.value == null || task.value == null || ['COMPLETED','PAUSED','CANCELLED'].indexOf(String(task.value.state))>=0) return
  busy.value = true
  if (pending == null) pending = { task_id: id.value, chapter_key: chapter.value.key, position: Math.floor(position.value), session_key: session, foreground: foreground.value, playing: playing.value || ended, playback_rate:playbackRate.value, responsive:chapter.value==null||!chapter.value.idle_prompt||Date.now()-lastInteraction<=Number(chapter.value.idle_seconds)*1000, sequence_no:++sequenceNo,client_time:Date.now(), session_open: open, confirm: confirm, idempotency_key: growthKey() }
  growthRequest('learn', pending, (r : any) => { busy.value = false; if (!r.ok) { message.value = r.message; if (r.rejected) pending = null; return }; pending = null; message.value=''; if(chapter.value.type=='video'&&chapter.value.seek_policy=='watched_only'&&position.value>Number(r.data.confirmed_position)+2){uni.createVideoContext('growth-course-video').seek(Number(r.data.confirmed_position));position.value=Number(r.data.confirmed_position)} if (confirm || r.data.chapter_complete) load(false); if (endedQueued && !r.data.chapter_complete) {endedQueued=false;report(false,true)} })
}
function load(select : boolean = true) : void { growthRequest('task', { id: id.value }, (r : any) => { loading.value = false; if (!r.ok) { message.value = r.message;task.value=null; return }; task.value = r.data; if (select) selectChapter(chapterIndex.value) }) }
function selectChapter(index : number) : void { if (busy.value || pending != null) return; chapterIndex.value = index;playbackRate.value=1;lastInteraction=Date.now();quizAnswers.value={};quizResults.value={};showQuizPrompt.value=false; releaseResource();resourceRequest++;if(downloadTask!=null){downloadTask.abort();downloadTask=null};readerScrollTop.value=0; resourceUrl.value = ''; message.value = ''; position.value = 0; resumePosition.value = 0; if (chapter.value == null) return; let rows : Array<any> = task.value.learning || []; rows.forEach((row : any) => { if (row.chapter_key == chapter.value.key) { position.value = Number(row.position); resumePosition.value = position.value } }); if(chapter.value.type=='text')nextTick(()=>restoreReadPosition());if (Number(chapter.value.asset_id) > 0) { let request=resourceRequest;resourceLoading.value = true; downloadTask=growthDownload(Number(chapter.value.asset_id), id.value, (r : any) => { if(request!=resourceRequest){
// #ifdef WEB
if(r.ok && String(r.url).startsWith('blob:'))URL.revokeObjectURL(String(r.url))
// #endif
return};downloadTask=null;resourceLoading.value = false; if (!r.ok) { message.value = r.message; return }; resourceUrl.value = String(r.url) }) }; report(false,false,true) }
// 图文在内容容器内记住实际滚动位置，文档仍按页、视频仍按有效播放位置续学。
function readScroll(e:any):void{if(chapter.value==null||['text','image'].indexOf(String(chapter.value.type))<0)return;position.value=Number(e.detail.scrollTop||0);if(Date.now()-lastReport>=5000){lastReport=Date.now();report(false)}}
function restoreReadPosition():void{if(chapter.value!=null&&['text','image'].indexOf(String(chapter.value.type))>=0)nextTick(()=>{readerScrollTop.value=resumePosition.value})}
function releaseResource():void{
 // #ifdef WEB
 if(resourceUrl.value.startsWith('blob:'))URL.revokeObjectURL(resourceUrl.value)
 // #endif
}
onUnload(()=>{resourceRequest++;if(downloadTask!=null)downloadTask.abort();releaseResource()})
function confirmChapter() : void {let missing=(chapter.value.quizzes||[]).some((q:any):boolean=>q.required&&!q.satisfied);if(missing){showQuizPrompt.value=true;message.value='先完成本章随堂题，再确认学习。';return};report(true)}
function videoTime(event : any) : void { if(chapter.value.idle_prompt&&Date.now()-lastInteraction>Number(chapter.value.idle_seconds)*1000&&!idleShowing){idleShowing=true;uni.createVideoContext('growth-course-video').pause();uni.showModal({title:'还在认真学习吗？',content:'休息一下也没关系，准备好了再继续。',confirmText:'继续学习',success:(r:any)=>{idleShowing=false;if(r.confirm){lastInteraction=Date.now();uni.createVideoContext('growth-course-video').play()}}});return}; position.value = Number(event.detail.currentTime || 0); if((chapter.value.quizzes||[]).some((q:any):boolean=>q.required&&!q.satisfied&&position.value>=Number(q.position)))uni.createVideoContext('growth-course-video').pause(); if (Date.now() - lastReport >= 5000) { lastReport = Date.now(); report(false) } }
// 原生播放器可能先发pause再发ended；结束帧仍属于刚刚发生的实际播放区间。
function videoEnded() : void { report(false,true); playing.value = false }
function retryReport():void{report(false)}
function completed(key : string) : boolean { if (task.value == null) return false; let rows : Array<any> = task.value.learning || []; return rows.some((r : any) : boolean => r.chapter_key == key && Number(r.confirmed) == 1) }
// 随堂正式尝试沿用请求回执；答错后的再次作答是新尝试，旧答案保留。
function showQuiz(q:any):boolean{return q.satisfied||showQuizPrompt.value||chapter.value.type!='video'||position.value>=Number(q.position)}
function quizSelected(key:string,i:number):boolean{return Array.isArray(quizAnswers.value[key])&&quizAnswers.value[key].indexOf(i)>=0}
function chooseQuiz(q:any,i:number):void{if(quizBusy.value||quizPending!=null)return;let key=String(q.key);let choices:Array<number>=Array.isArray(quizAnswers.value[key])?[...quizAnswers.value[key]]:[];if(q.question.type=='multiple'||q.question.type=='order'){let at=choices.indexOf(i);if(at>=0)choices.splice(at,1);else choices.push(i)}else choices=[i];quizAnswers.value={...quizAnswers.value,[key]:choices}}
function submitQuiz(q:any):void{if(quizBusy.value||busy.value)return;quizBusy.value=true;if(quizPending==null)quizPending={task_id:id.value,chapter_key:chapter.value.key,quiz_key:q.key,answers:quizAnswers.value[String(q.key)]||[],idempotency_key:growthKey()};growthRequest('inlineAnswer',quizPending,(r:any)=>{quizBusy.value=false;if(!r.ok){message.value=r.message;if(r.rejected)quizPending=null;return};quizPending=null;quizResults.value[String(q.key)]=r.data;load(false)})}
function reviewQuiz(r:any):void{if(chapter.value.type=='video'){uni.createVideoContext('growth-course-video').seek(Number(r.review_position));position.value=Number(r.review_position)}else message.value='请回看本章第'+String(r.review_position)+'页 / 段，再作答。'}
function openDependency(d:any):void{if(!task.value.learning_complete){message.value='请先完成课程必学章节。';return};uni.navigateTo({url:'/src/merchant/pages/growth/'+(['exam','practice'].indexOf(String(d.kind))>=0?'exam':'work')+'?id='+String(d.id)})}
function reference(c:any):void{uni.showModal({title:'引用已有有效结果',content:'同一发布内容与规则校验后，使用原正式结果完成本任务，不重复生成奖励。',success:(r:any)=>{if(r.confirm){busy.value=true;growthRequest('referenceResult',{task_id:id.value,source_task_id:c.id,idempotency_key:growthKey()},(v:any)=>{busy.value=false;if(!v.ok){message.value=v.message;return};message.value=v.data.message;load(false)})}}})}
function touchLearning():void{lastInteraction=Date.now()}
function changeSpeed(e:any):void{playbackRate.value=Number(chapter.value.allowed_rates[Number(e.detail.value)]);uni.createVideoContext('growth-course-video').playbackRate(playbackRate.value)}
function changeDocumentPage(e:any):void{position.value=Number(e.detail.value)+1;report(false)}
// H5切换浏览器标签仍须暂停有效覆盖；原生应用继续使用页面前后台生命周期。
// #ifdef WEB
function visibilityChanged():void{foreground.value=!document.hidden;if(document.hidden){playing.value=false;uni.createVideoContext('growth-course-video').pause()}}
onMounted(()=>document.addEventListener('visibilitychange',visibilityChanged))
onUnload(()=>document.removeEventListener('visibilitychange',visibilityChanged))
// #endif
function zoom() : void { uni.previewImage({ urls: [resourceUrl.value] }) }
function openDocument() : void { uni.openDocument({ filePath: resourceUrl.value, fileType: 'pdf', showMenu: false, fail: () => { message.value = '当前设备暂不能预览，请稍后使用支持文档预览的设备。' } }) }
// 资料沿用当前任务的私有资源授权，不能凭资源编号读取其他课程。
function viewMaterial(a:any):void{growthViewAsset(Number(a.id),id.value)}
function viewCover():void{growthViewAsset(Number(task.value.content.cover_asset_id),id.value)}
function back() : void { uni.navigateBack() }
</script>
<style>
.growth-learn{min-height:100vh;background-color:#f6f7f2;color:#25483f;padding-bottom:32px}.learn-head{padding:28px 23px 20px}.learn-kicker{display:block;font-size:11px;color:#9b8c64;letter-spacing:2px}.learn-title{display:block;margin-top:10px;font-size:24px;font-weight:700;line-height:34px}.learn-note{display:block;margin-top:10px;color:#899282;font-size:12px;line-height:21px}.learn-chapters{padding:0 18px;box-sizing:border-box;white-space:nowrap}.learn-chapter-row{display:flex;flex-direction:row}.learn-chip{flex-shrink:0;padding:10px 15px;margin-right:8px;background-color:#e9eee4;color:#6f8068;border-radius:20px;font-size:12px}.learn-chip-active{background-color:#1e604f;color:#fff}.learn-content{padding:24px 20px;margin:18px;background-color:#fff;border-radius:14px}.learn-section-head{display:flex;flex-direction:row;justify-content:space-between;margin-bottom:20px;align-items:center}.learn-section-title{font-size:18px;font-weight:600;line-height:27px;flex:1}.learn-required{font-size:10px;color:#8b9b7d;margin-left:10px}.learn-text{display:block;font-size:15px;line-height:29px;color:#4c5c50;white-space:pre-wrap}.learn-image{width:100%}.learn-video{width:100%;height:230px}.learn-document{width:100%}.learn-pdf{width:100%;height:65vh;border:0}.learn-bottom{padding-top:24px;margin-top:25px;border-top:1px solid #edf0e8}.learn-primary,.learn-secondary{margin-top:15px;border-radius:24px;padding:4px 18px;font-size:14px}.learn-primary{background-color:#1b5b4e;color:white}.learn-secondary{background-color:#eff3e8;color:#4b6f52}.learn-message{padding:12px 18px;background-color:#fff0e8;color:#9f5940;font-size:12px;line-height:22px}.learn-finished{display:flex;flex-direction:column;align-items:center;margin-top:30px;padding:22px 10px;background-color:#f5f8ee;border-radius:10px}.learn-flower{font-size:40px;color:#a8955c}.learn-finished-title{margin-top:14px;font-size:18px;font-weight:600}.learn-loading{padding:80px 20px;text-align:center;color:#899282;font-size:14px}
.learn-quiz{margin-top:20px;padding:18px;background-color:#f4f7ee;border-radius:10px}.learn-quiz-option{padding:12px;border:1px solid #dfe6d5;border-radius:7px;margin-top:10px;font-size:14px;line-height:24px}.learn-quiz-selected{background-color:#e3eed8;border-color:#7d9c6e}
.learn-reader{height:60vh}.learn-paragraph{margin-bottom:15px}.learn-media-reader{width:100%}
.learn-progress-picker{font-size:12px;color:#648451;padding:14px;background-color:#f2f6eb;border-radius:8px;margin-top:14px}
</style>
