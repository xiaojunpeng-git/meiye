<template><view class="profile-page"><text v-if="message.length>0" class="profile-error">{{ message }}</text><view v-if="profile!=null"><view class="profile-hero"><text class="profile-kicker">每一步，都算数</text><text class="profile-name">{{ profile.employee.name }}的成长</text><text class="profile-level">{{ profile.level!=null?profile.level.title:'从今天开始积累' }}</text><text class="profile-points">{{ profile.point_balance }} <text class="profile-unit">成长积分</text></text></view><view class="profile-section"><text class="profile-card-title" @tap="openHistory">全部成长来源与历史 →</text><text class="profile-note">下方为最近记录，完整历史可按类别逐页查看。</text></view><view class="profile-section"><text class="profile-heading">我的能力</text><text v-if="profile.capabilities.length==0" class="profile-note">完成实操鉴定，让你的专业被看见。</text><view v-for="r in profile.capabilities" :key="r.id" class="profile-card"><text class="profile-card-title">{{ r.title }}</text><text class="profile-note">{{ label(String(r.conclusion)) }}</text></view></view><view class="profile-section"><text class="profile-heading">我的证书</text><text v-if="profile.certificates.length==0" class="profile-note">下一次达标，就离认可更近一步。</text><view v-for="r in profile.certificates" :key="r.id" class="profile-card profile-certificate"><text class="profile-medal">✧</text><text class="profile-card-title">{{ r.title }}</text><text class="profile-note">{{ label(String(r.state)) }} · {{ Number(r.expires_at)>0?date(Number(r.expires_at))+'到期':'长期有效' }}</text><text class="profile-number">{{ r.certificate_number }}</text><text v-if="r.evidence && r.evidence.basis" class="profile-note">依据：{{ r.evidence.basis }}</text><text v-for="asset in r.evidence && r.evidence.asset_ids || []" :key="asset" class="profile-note" @tap="growthViewAsset(Number(asset),0)">查看证书附件 →</text><text v-for="h in r.history||[]" :key="h.id" class="profile-note">{{ h.reason }}</text></view></view><view class="profile-section"><text class="profile-heading">阶段考评</text><text v-if="appraisals.length==0" class="profile-note">暂无阶段考评</text><view v-for="r in appraisals" :key="r.id" class="profile-card" @tap="openAppraisal(Number(r.id))"><text class="profile-card-title">{{ r.title }} →</text><text class="profile-note">{{ r.employee_name }} · {{ r.period_start }} 至 {{ r.period_end }}</text><text class="profile-note">{{ label(String(r.state)) }}</text></view></view><view class="profile-section"><text class="profile-heading">任职与成长历史</text><view v-for="r in profile.personnel_history||[]" :key="r.id" class="profile-card"><text class="profile-card-title">{{ r.position_name||'原岗位' }}</text><text class="profile-note">{{ Number(r.start_time)>0?date(Number(r.start_time)):'原系统任职记录' }} · {{ Number(r.end_time)>0?'已结束任职':'当前任职' }} {{ r.reason }}</text></view></view><view class="profile-section" v-if="profile.organization_history && profile.organization_history.length>0"><text class="profile-heading">组织归属记录</text><view v-for="r in profile.organization_history" :key="r.id" class="profile-card"><text class="profile-card-title">{{ r.organization_name }}</text><text class="profile-note">{{ Number(r.status)==1 && Number(r.is_del)==0 ? '有效归属':'历史归属' }}</text></view></view><view class="profile-section"><text class="profile-heading">积分足迹</text><text v-if="profile.point_ledger.length==0" class="profile-note">认真完成任务，积累成长积分。</text><view v-for="r in profile.point_ledger" :key="r.id" class="profile-ledger"><view><text class="profile-card-title">{{ r.reason }}</text><text class="profile-note">{{ date(Number(r.occurred_at)) }}</text></view><text class="profile-delta">{{ Number(r.delta)>0?'+':'' }}{{ r.delta }}</text></view></view></view></view></template>
<script setup lang="uts">
import {growthRequest,growthViewAsset} from '../../api/mobile-growth-client.uts'
const profile=ref<any>(null)
const appraisals=ref<Array<any>>([])
const message=ref('')
// 档案只取当前会话本人；等待公布的答卷不会出现在正式成绩区。
onShow(()=>{growthRequest('profile',{},(r:any)=>{if(!r.ok){message.value=r.message;return};profile.value=r.data});growthRequest('appraisals',{},(r:any)=>{if(r.ok)appraisals.value=r.data.rows})})
function date(t:number):string{return new Date(t*1000).toLocaleDateString()}
function label(s:string):string{let names:any={VALID:'有效',EXPIRED:'已到期，待复核',REVOKED:'已撤销',QUALIFIED:'已达标',NEED_PRACTICE:'还需练习',NOT_EVALUATED:'等待鉴定',ASSIGNED:'等待考评',PUBLISHED:'结果已公布'};return String(names[s]||s)}
function openHistory():void{uni.navigateTo({url:'/src/merchant/pages/growth/history'})}
function openAppraisal(id:number):void{uni.navigateTo({url:'/src/merchant/pages/growth/appraisal?id='+id.toString()})}
</script>
<style>
.profile-page{min-height:100vh;background-color:#f6f7f2;color:#25483f;padding-bottom:30px}.profile-hero{background-color:#1b5b4e;padding:30px 24px;color:#fff;display:flex;flex-direction:column}.profile-kicker{font-size:12px;color:#c5d9c8}.profile-name{font-size:26px;font-weight:700;margin-top:12px}.profile-level{font-size:13px;color:#decf9e;margin-top:14px}.profile-points{font-size:42px;font-weight:700;margin-top:12px}.profile-unit{font-size:12px;font-weight:400;color:#c5d9c8}.profile-section{padding:22px 20px 0}.profile-heading{display:block;font-size:18px;font-weight:600;margin-bottom:12px}.profile-card{display:flex;flex-direction:column;background-color:#fff;border:1px solid #e6eadd;border-radius:12px;padding:19px;margin-top:12px}.profile-card-title{display:block;font-size:15px;line-height:23px}.profile-note{display:block;font-size:12px;line-height:21px;color:#899782;margin-top:7px}.profile-certificate{border-color:#ded4b7;background-color:#fffdf7}.profile-medal{font-size:32px;color:#ad8a43;margin-bottom:10px}.profile-number{display:block;font-size:10px;color:#aa9e83;margin-top:16px}.profile-ledger{display:flex;flex-direction:row;justify-content:space-between;border-bottom:1px solid #e1e8db;padding:15px 0}.profile-delta{font-size:19px;color:#35725b}.profile-error{display:block;padding:12px;background-color:#fff0e8;color:#a55238}
</style>
