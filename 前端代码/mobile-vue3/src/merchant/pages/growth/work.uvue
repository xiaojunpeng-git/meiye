<template>
  <view class="work-page" @touchstart="merchantSwipeBack.start" @touchmove="merchantSwipeBack.move" @touchend="merchantSwipeBack.end" @touchcancel="merchantSwipeBack.cancel"><view v-if="message.length>0" class="work-error"><text>{{ message }}</text></view><view v-if="work != null"><view class="work-head"><text class="work-kicker">把专业练到手上</text><text class="work-title">{{ work.task.title }}</text><text class="work-note">{{ work.activity.description }}</text><text class="work-note">{{ work.task.employee_name }} · {{ stateLabel(String(work.task.state)) }}</text></view>
    <view v-for="s in work.submissions" :key="s.id" class="work-card"><text class="work-card-title">第 {{ s.attempt_no }} 次提交 · {{ submissionLabel(String(s.state)) }}</text><text class="work-body">{{ parse(String(s.snapshot_json)).body }}</text><view v-for="asset in parse(String(s.snapshot_json)).asset_ids || []" :key="asset"><text class="work-link" @tap="viewAsset(Number(asset))">查看提交证据 ↗</text></view><text v-if="s.review_json != null" class="work-note">点评：{{ parse(String(s.review_json)).note }}</text></view>
    <view v-if="!work.can_handle && ['assignment','evaluation'].indexOf(String(work.activity.kind))>=0 && ['NOT_STARTED','IN_PROGRESS','RETURNED'].indexOf(String(work.task.state))>=0" class="work-card"><text class="work-card-title">{{ work.task.state=='RETURNED'?'补交新内容':'提交本次成果' }}</text><textarea v-model="body" class="work-textarea" placeholder="写下练习内容、过程与收获…" maxlength="10000" :disabled="busy" @touchstart.stop="merchantSwipeBack.cancel"></textarea><view class="work-upload"><text @tap="addImage('')">＋ 图片证据</text><text @tap="addVideo">＋ 视频证据</text></view><view v-for="(asset,i) in assetIds" :key="asset" class="work-inline"><text>证据 {{ i+1 }}</text><text class="work-link" @tap="removeAsset(i)">移除</text></view><text v-if="work.activity.evidence_required" class="work-note">本任务需要至少一份有效证据。</text><button class="work-primary" :disabled="busy" @tap="submit">{{ busy?'正在确认…':'确认提交' }}</button></view>
    <view v-if="work.can_handle && work.task.state=='PENDING'" class="work-card"><text class="work-card-title">本次评价</text><view v-for="item in work.standard != null ? work.standard.items : []" :key="item.key" class="work-item"><text class="work-item-title">{{ item.title }}{{ item.critical?' · 关键项':'' }}</text><text class="work-note">{{ item.description }}</text><view v-if="item.allow_na" class="work-toggle" @tap="toggleNA(String(item.key))"><text>{{ items[item.key].not_applicable?'☑':'□' }} 本次不适用</text></view><textarea v-if="items[item.key].not_applicable" v-model="items[item.key].reason" class="work-textarea work-textarea-small" placeholder="说明不适用原因" @touchstart.stop="merchantSwipeBack.cancel"></textarea><view v-else><input v-if="work.standard.mode=='score'" v-model="items[item.key].score" type="number" class="work-input" :placeholder="'本项得分，满分'+item.max_score" @touchstart.stop="merchantSwipeBack.cancel"/><view v-else class="work-choices"><text :class="items[item.key].passed===true?'work-choice-active':''" @tap="setPassed(String(item.key),true)">通过</text><text :class="items[item.key].passed===false?'work-choice-active':''" @tap="setPassed(String(item.key),false)">未通过</text></view><textarea v-model="items[item.key].note" class="work-textarea work-textarea-small" placeholder="评价依据与说明" @touchstart.stop="merchantSwipeBack.cancel"></textarea><text v-if="item.evidence_required" class="work-link" @tap="addImage(String(item.key))">＋ 提供本项证据（{{ items[item.key].asset_ids.length }}）</text></view></view><textarea v-model="note" class="work-textarea" placeholder="点评、未达标原因与下一步建议…" maxlength="10000" @touchstart.stop="merchantSwipeBack.cancel"></textarea><view v-if="work.activity.kind=='assignment'" class="work-choices"><text :class="accepted?'work-choice-active':''" @tap="accepted=true">确认本次提交</text><text :class="!accepted?'work-choice-active':''" @tap="accepted=false">退回补交</text></view><button class="work-primary" :disabled="busy" @tap="review">确认本次评价</button></view>
    <view v-if="work.can_handle && ['coaching','offline'].indexOf(String(work.activity.kind))>=0 && ['NOT_STARTED','IN_PROGRESS'].indexOf(String(work.task.state))>=0" class="work-card"><text class="work-card-title">{{ work.activity.kind=='coaching'?'记录实际带教':'确认实际活动' }}</text><input v-model="actualDate" class="work-input" placeholder="实际日期 YYYY-MM-DD（留空今天）"  @touchstart.stop="merchantSwipeBack.cancel"/><textarea v-model="note" class="work-textarea" placeholder="实际带教 / 活动内容" @touchstart.stop="merchantSwipeBack.cancel"></textarea><view v-if="work.activity.kind=='coaching'"><textarea v-model="problems" class="work-textarea work-textarea-small" placeholder="发现问题（可选）" @touchstart.stop="merchantSwipeBack.cancel"></textarea><textarea v-model="mentorComment" class="work-textarea work-textarea-small" placeholder="师傅点评（可选）" @touchstart.stop="merchantSwipeBack.cancel"></textarea><textarea v-model="nextSteps" class="work-textarea work-textarea-small" placeholder="下一步建议（可选）" @touchstart.stop="merchantSwipeBack.cancel"></textarea></view><view v-if="work.activity.kind=='offline'" class="work-toggle" @tap="attended=!attended"><text>{{ attended?'☑':'□' }} 员工实际到场</text></view><text class="work-link" @tap="addImage('')">＋ 活动证据（{{ assetIds.length }}）</text><button class="work-primary" :disabled="busy" @tap="confirmActivity">确认活动记录</button></view>
    <view v-for="e in work.evaluations" :key="'eval'+String(e.id)" class="work-card"><text class="work-card-title">{{ e.conclusion=='QUALIFIED'?'✦ 实操已达标':'↗ 还需补练' }}</text><text class="work-note">{{ date(Number(e.occurred_at)) }} · {{ e.score==null?'逐项通过制':String(e.score)+' 分' }}</text><text class="work-body">{{ parse(String(e.result_json)).note }}</text><view v-for="key in Object.keys(parse(String(e.result_json)).items||{})" :key="key"><text class="work-note">{{ itemName(String(key)) }} · {{ parse(String(e.result_json)).items[key].not_applicable?'不适用：'+parse(String(e.result_json)).items[key].reason:parse(String(e.result_json)).items[key].note }}</text><text v-for="asset in parse(String(e.result_json)).items[key].asset_ids||[]" :key="asset" class="work-link" @tap="viewAsset(Number(asset))">查看评价证据 →</text></view></view><view v-for="r in work.coaching" :key="'coach'+String(r.id)" class="work-card"><text class="work-card-title">师傅带教 · {{ date(Number(r.occurred_at)) }}</text><text class="work-body">{{ parse(String(r.snapshot_json)).body }}</text><text class="work-note">发现问题：{{ parse(String(r.snapshot_json)).problems||'未记录' }}</text><text class="work-note">点评：{{ parse(String(r.snapshot_json)).comment||'未记录' }}</text><text class="work-note">下一步：{{ parse(String(r.snapshot_json)).next_steps||'按安排继续练习' }}</text><text v-for="asset in parse(String(r.snapshot_json)).asset_ids||[]" :key="asset" class="work-link" @tap="viewAsset(Number(asset))">查看带教证据 →</text></view><view v-for="r in work.attendance||[]" :key="'attendance'+String(r.id)" class="work-card"><text class="work-card-title">{{ Number(r.attended)?'已实际到场':'未到场' }}</text><text class="work-note">{{ date(Number(r.occurred_at)) }}</text><text class="work-body">{{ parse(String(r.evidence_json)).body }}</text></view>
    <view v-if="work.task.state=='COMPLETED'" class="work-complete"><text>✦ 本次成长已记录</text><text class="work-note">{{ work.task.conclusion=='QUALIFIED'?'实操鉴定已达标，继续保持专业。':'每一次认真练习，都会成为你的底气。' }}</text></view><button class="work-secondary" @tap="back">返回成长</button>
  </view></view>
</template>
<script setup lang="uts">
	import { useMerchantSwipeBack, returnByMerchantSwipe } from '../../../shared/platform/merchant-swipe-back.uts'
import { growthRequest, growthKey, growthUploadFile, growthViewAsset } from '../../api/mobile-growth-client.uts'
const id=ref(0)
const work=ref<any>(null)
const message=ref('')
const busy=ref(false)
const body=ref('')
const note=ref('')
const actualDate=ref('')
const problems=ref('')
const mentorComment=ref('')
const nextSteps=ref('')
const accepted=ref(true)
const attended=ref(true)
const assetIds=ref<Array<number>>([])
const items=ref<any>({})
let pending : any = null
onLoad((options : any)=>{id.value=Number(options['id']||0);load()})
function parse(value : string) : any {try{return JSON.parse(value)}catch(_e){return {}}}
function load() : void {growthRequest('work',{task_id:id.value},(r : any)=>{if(!r.ok){message.value=r.message;return};work.value=r.data;let values : any={};if(r.data.standard!=null)r.data.standard.items.forEach((v : any)=>{values[String(v.key)]={passed:null,score:'',note:'',not_applicable:false,reason:'',asset_ids:[]}});items.value=values})}
// 成果提交和处理均保留同一待确认请求，回执未知不能换标识重复生成结果。
function command(endpoint : string,payload : any) : void {if(busy.value)return;busy.value=true;if(pending==null)pending={endpoint:endpoint,payload:{...payload,idempotency_key:growthKey()}};growthRequest(pending.endpoint,pending.payload,(r : any)=>{busy.value=false;if(!r.ok){message.value=r.message;if(r.rejected)pending=null;return};pending=null;message.value=String(r.data.message||'已保存');body.value='';note.value='';assetIds.value=[];load()})}
function submit() : void {uni.showModal({title:'确认提交成果',content:'本次内容与证据将作为正式记录保存。',success:(r : any)=>{if(r.confirm)command('workSubmit',{task_id:id.value,body:body.value,asset_ids:assetIds.value})}})}
function review() : void {let rows : Array<any>=work.value.submissions||[];let s : any=rows.find((v : any):boolean=>v.state=='PENDING');if(s==null){message.value='当前没有待处理提交';return};command('workReview',{submission_id:s.id,accepted:accepted.value,note:note.value,items:items.value})}
function confirmActivity() : void {command('activityConfirm',{task_id:id.value,body:note.value,problems:problems.value,comment:mentorComment.value,next_steps:nextSteps.value,occurred_at:actualDate.value.length>0?Math.floor(Date.parse(actualDate.value+'T12:00:00')/1000):Math.floor(Date.now()/1000),attended:attended.value,asset_ids:assetIds.value})}
function addImage(itemKey : string) : void {if(busy.value)return;uni.chooseImage({count:1,success:(r : any)=>{upload(String(r.tempFilePaths[0]),itemKey)}})}
function addVideo() : void {if(busy.value)return;uni.chooseVideo({success:(r : any)=>upload(String(r.tempFilePath),'')})}
function upload(path : string,itemKey : string) : void {busy.value=true;growthUploadFile(path,(r : any)=>{busy.value=false;if(!r.ok){message.value=r.message;return};if(itemKey.length>0)items.value[itemKey].asset_ids.push(Number(r.data.id));else assetIds.value.push(Number(r.data.id))})}
function removeAsset(index : number) : void {if(!busy.value)assetIds.value.splice(index,1)}
function setPassed(key : string,value : boolean) : void {items.value[key].passed=value}
function toggleNA(key : string) : void {items.value[key].not_applicable=!items.value[key].not_applicable}
function viewAsset(asset:number):void{growthViewAsset(asset,Number(work.value.task.id))}

function back() : void {uni.navigateBack()}
function date(t:number):string{return t>0?new Date(t*1000).toLocaleString():'原记录时间'}
function itemName(key:string):string{let standard:any=work.value.standard;if(standard==null)return key;let item:any=standard.items.find((r:any):boolean=>String(r.key)==key);return item!=null?String(item.title):key}
function stateLabel(value : string) : string {let labels : any={NOT_STARTED:'未开始',IN_PROGRESS:'进行中',PENDING:'等待处理',RETURNED:'待补交',COMPLETED:'已完成',PAUSED:'已暂停',CANCELLED:'已取消'};return String(labels[value]||value)}
function submissionLabel(value : string) : string {let labels : any={PENDING:'待点评',ACCEPTED:'已确认',RETURNED:'已退回'};return String(labels[value]||value)}

	// Swipe/back closes only one local layer; no submit or business command is triggered.
	const merchantSwipeBack = useMerchantSwipeBack(() : boolean => {
		if (busy.value) return true
		return false
	}, () : void => { returnByMerchantSwipe('workbench') })
	// Page lifecycle hooks stay in .uvue; shared UTS has no page-hook imports.
	onHide(() => { merchantSwipeBack.cancel() })
	onUnload(() => { merchantSwipeBack.cancel() })
</script>
<style>
.work-page{min-height:100vh;background-color:#f6f7f2;color:#25483f;padding:0 18px 30px}.work-head{padding:28px 7px 10px}.work-kicker{display:block;font-size:11px;color:#a49468;letter-spacing:1px}.work-title{display:block;font-size:24px;line-height:35px;font-weight:700;margin-top:10px}.work-note{display:block;font-size:12px;line-height:22px;color:#8b9686;margin-top:10px}.work-card{background-color:#fff;border-radius:14px;padding:20px;margin-top:16px;border:1px solid #e4ebde}.work-card-title{display:block;font-size:17px;font-weight:600;line-height:26px}.work-body{display:block;white-space:pre-wrap;line-height:26px;font-size:14px;color:#5b6f51;margin-top:15px}.work-textarea{box-sizing:border-box;width:100%;height:140px;padding:13px;margin-top:15px;font-size:14px;line-height:24px;background-color:#f8faf5;border:1px solid #e5ebdf;border-radius:8px}.work-textarea-small{height:90px}.work-upload,.work-inline{display:flex;flex-direction:row;justify-content:space-between;margin-top:16px;color:#427354;font-size:12px}.work-primary,.work-secondary{font-size:14px;border-radius:24px;margin-top:20px;padding:4px 18px}.work-primary{background-color:#1b5b4e;color:#fff}.work-secondary{background-color:#eaf0e2;color:#587347}.work-link{display:block;color:#3e7857;font-size:12px;line-height:24px;margin-top:12px}.work-item{padding:17px 0;border-bottom:1px solid #edf0e8}.work-item-title{display:block;font-size:15px;font-weight:600;line-height:25px}.work-toggle{font-size:12px;color:#687e5a;line-height:26px;margin-top:12px}.work-choices{display:flex;flex-direction:row;gap:12px;margin-top:14px;font-size:12px}.work-choices text{padding:9px 13px;border:1px solid #e4eadc;border-radius:7px;color:#768a68}.work-choices .work-choice-active{background-color:#eaf3df;border-color:#8eab71;color:#386244}.work-input{padding:12px;border:1px solid #e0e8d6;border-radius:7px;margin-top:13px;font-size:14px;height:22px}.work-error{padding:12px;background-color:#fff1e8;color:#a06544;font-size:12px;line-height:22px}.work-complete{margin-top:20px;padding:25px 18px;background-color:#edf3e3;border-radius:12px;color:#647f49;text-align:center}
</style>
