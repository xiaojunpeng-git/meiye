<template>
  <MoheAiEntry />
	<view class="merchant-detail-page">
		<view class="merchant-detail-page__header">
			<view class="merchant-detail-page__back" @tap="goBack"><text>‹</text><text>返回</text></view>
			<text class="merchant-detail-page__eyebrow">经营首页 · 客户概况</text>
			<text class="merchant-detail-page__title">会员经营明细</text>
			<text class="merchant-detail-page__subtitle">按授权组织范围查看客户规模与服务变化</text>
		</view>

		<scroll-view scroll-y="true" class="merchant-detail-page__content">
			<view class="merchant-detail-page__content-inner">
				<view class="merchant-detail-page__context"><view><text class="merchant-detail-page__context-label">当前范围</text><text class="merchant-detail-page__context-value">授权组织范围</text></view><text class="merchant-detail-page__period">本月</text></view>
				<view class="merchant-detail-page__state merchant-detail-page__state--loading" v-if="loading"><text class="merchant-detail-page__state-title">正在加载会员明细</text><text class="merchant-detail-page__state-copy">数据将按当前商家权限范围返回</text></view>
				<view class="merchant-detail-page__state" v-else-if="message.length > 0"><text class="merchant-detail-page__state-title">{{ message }}</text><view class="merchant-detail-page__retry" @tap="load"><text>重新加载</text></view></view>
				<view v-else>
					<view class="merchant-detail-page__state"><text class="merchant-detail-page__state-title">暂无会员明细</text><text class="merchant-detail-page__state-copy">当前接口尚未返回可展示的会员经营数据。</text></view>
					<view class="merchant-detail-page__section"><text class="merchant-detail-page__section-title">指标说明</text><text class="merchant-detail-page__section-copy">客户总数、新客数、服务客户和沉睡客户均由统一客户事实统计，页面不在客户端计算经营指标。</text></view>
					<view class="merchant-detail-page__section"><text class="merchant-detail-page__section-title">后续明细</text><text class="merchant-detail-page__section-copy">待接口返回趋势序列和组织分组后，将在此展示客户趋势、来源结构及可下钻列表。</text></view>
				</view>
				<view class="merchant-detail-page__freshness"><text>数据更新时间：—</text><text>口径版本：—</text></view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
  import MoheAiEntry from '../../../shared/components/mohe-ai-entry.uvue'
	const loading = ref(false)
	const message = ref('')

	onShow(() => load())

	function load() : void {
		loading.value = true
		message.value = ''
		setTimeout(() => { loading.value = false }, 260)
	}

	function goBack() : void {
		uni.navigateBack({ delta: 1 })
	}
</script>

