	.merchant-detail-page__retry { margin-top: 12px; padding: 7px 12px; border-radius: 7px; background-color: #2879ba; font-size: 11px; color: #ffffff; }
	.merchant-detail-page__section { display: flex; flex-direction: column; margin-top: 12px; padding: 14px; border-radius: 14px; background-color: #ffffff; box-shadow: 0 5px 16px rgba(45, 74, 101, 0.05); }
