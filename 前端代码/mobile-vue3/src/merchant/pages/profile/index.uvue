	}
	.merchant-profile__logout { display: flex; min-height: 48px; flex-direction: row; align-items: center; justify-content: center; margin: 18px 20px 0px 20px; border-width: 1px; border-style: solid; border-color: #e6b7b7; background-color: #fffafa; color: #a44848; font-size: 14px; font-weight: 700; }
	.merchant-profile__session { display: flex; flex-direction: row; align-items: center; justify-content: space-between; margin: 18px 20px 0px 20px; padding: 12px 0px; border-top-width: 1px; border-bottom-width: 1px; border-style: solid; border-color: #dde4ed; }
	.merchant-profile__session-label { font-size: 13px; color: #697586; }
	.merchant-profile__session-value { font-size: 13px; font-weight: 600; color: #1677cc; }
	.merchant-profile__tabs { display: flex; min-height: 64px; flex-direction: row; align-items: stretch; border-top-width: 1px; border-top-style: solid; border-top-color: #dde4ed; background-color: #ffffff; }
	.merchant-profile__tab { display: flex; min-width: 0; flex: 1; flex-direction: row; align-items: center; justify-content: center; border-top-width: 2px; border-top-style: solid; border-top-color: #ffffff; font-size: 12px; font-weight: 600; color: #526071; }
	.merchant-profile__tab--active { border-top-color: #1677cc; background-color: #f7fbff; color: #1677cc; }
</style>
