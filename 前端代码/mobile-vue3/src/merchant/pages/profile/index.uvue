<template>
	<view class="merchant-profile">
		<view class="merchant-profile__header">
			<text class="merchant-profile__eyebrow">商家端</text>
			<text class="merchant-profile__title">我的</text>
		</view>

		<scroll-view scroll-y class="merchant-profile__content">
			<view class="merchant-profile__account">
				<view class="merchant-profile__avatar" :aria-label="accountName">
					<text class="merchant-profile__avatar-label">{{ accountInitial }}</text>
				</view>
				<view class="merchant-profile__account-copy">
					<text class="merchant-profile__account-title">{{ accountName }}</text>
					<text class="merchant-profile__account-detail">{{ accountDetail }}</text>
				</view>
			</view>

			<view class="merchant-profile__section">
				<text class="merchant-profile__section-title">账号与权限</text>
				<view class="merchant-profile__list">
					<view
						v-for="entry in accountEntries"
						:key="entry.key"
						class="merchant-profile__entry"
						role="button"
						@tap="selectEntry(entry.label)"
					>
						<view class="merchant-profile__entry-copy">
							<text class="merchant-profile__entry-label">{{ entry.label }}</text>
							<text class="merchant-profile__entry-detail">{{ entry.detail }}</text>
						</view>
						<text class="merchant-profile__entry-arrow">&gt;</text>
					</view>
				</view>
			</view>

			<view class="merchant-profile__section">
				<text class="merchant-profile__section-title">工作支持</text>
				<view class="merchant-profile__list">
					<view
						v-for="entry in supportEntries"
						:key="entry.key"
						class="merchant-profile__entry"
						role="button"
						@tap="selectEntry(entry.label)"
					>
						<view class="merchant-profile__entry-copy">
							<text class="merchant-profile__entry-label">{{ entry.label }}</text>
							<text class="merchant-profile__entry-detail">{{ entry.detail }}</text>
						</view>
						<text class="merchant-profile__entry-arrow">&gt;</text>
					</view>
				</view>
			</view>

			<view class="merchant-profile__session"><text class="merchant-profile__session-label">当前商家会话</text><text class="merchant-profile__session-value">{{ sessionState }}</text></view>
			<view class="merchant-profile__logout" @tap="logout"><text>{{ loggingOut ? '正在退出商家端…' : '退出商家端' }}</text></view>

			<view v-if="selectedEntry.length > 0" class="merchant-profile__notice" role="status">
				<text class="merchant-profile__notice-title">{{ selectedEntry }}</text>
				<text class="merchant-profile__notice-copy">该功能入口已预留，正在接入账号与权限服务。</text>
			</view>
		</scroll-view>

		<view class="merchant-profile__tabs" role="tablist">
			<navigator class="merchant-profile__tab" url="/src/merchant/pages/warehouse/index" open-type="navigate" role="tab" aria-selected="false"><text>数仓</text></navigator>
			<navigator class="merchant-profile__tab" url="/src/merchant/pages/customers/index" open-type="navigate" role="tab" aria-selected="false"><text>客户</text></navigator>
			<navigator class="merchant-profile__tab" url="/src/merchant/pages/workbench/index" open-type="navigate" role="tab" aria-selected="false"><text>工作台</text></navigator>
			<navigator class="merchant-profile__tab" url="/src/merchant/pages/goals/index" open-type="navigate" role="tab" aria-selected="false"><text>目标</text></navigator>
			<view class="merchant-profile__tab merchant-profile__tab--active" role="tab" aria-selected="true"><text>我的</text></view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { currentMerchantRoot } from '../../../shared/platform/mobile-merchant-session.uts'
	import { logoutMobileMerchant } from '../../../shared/api/mobile-merchant-session-client.uts'
	import { openMerchantBootstrap } from '../../../shared/platform/mobile-navigation.uts'
	const accountEntries = [
		{ key: 'account', label: '账号资料', detail: '查看登录账号和基础资料' },
		{ key: 'security', label: '账号与安全', detail: '登录方式与设备管理' },
		{ key: 'scope', label: '门店与权限', detail: '查看当前可用门店和权限范围' }
	]
	const supportEntries = [
		{ key: 'notification', label: '消息通知', detail: '查看业务提醒和系统通知' },
		{ key: 'help', label: '帮助与反馈', detail: '获取使用帮助并提交问题反馈' },
		{ key: 'about', label: '关于', detail: '查看版本与服务信息' }
	]

	const selectedEntry = ref('')
	const accountName = ref('账号信息尚未加载')
	const accountDetail = ref('登录后可查看姓名、门店与岗位信息')
	const accountInitial = ref('账号')
	const sessionState = ref('未登录商家端')
	const loggingOut = ref(false)

	onShow(() => loadAccount())

	function loadAccount() {
		let root = currentMerchantRoot()
		if (root == null || root.employee == null) return
		let employee = root.employee
		let context = root.activeContext || {}
		accountName.value = String(employee.name || '商家人员')
		accountInitial.value = accountName.value.substring(0, 1)
		let store = String(context.storeName || context.name || '')
		let status = String(employee.status || '')
		accountDetail.value = (store.length > 0 ? store + ' · ' : '') + (status == 'ACTIVE' ? '当前在职' : '账号状态待核对')
		sessionState.value = String(root.reasonCode || '') == 'READY' ? '已登录 · 权限已加载' : '会话状态待刷新'
	}

	function selectEntry(label : string) {
		selectedEntry.value = label
	}

	function logout() {
		if (loggingOut.value) return
		loggingOut.value = true
		logoutMobileMerchant((result : any) => {
			loggingOut.value = false
			if (!result.ok) { selectedEntry.value = String(result.message || '退出商家端失败。'); return }
			sessionState.value = '已退出商家端'
			openMerchantBootstrap()
		})
	}
</script>

<style>
	.merchant-profile {
		display: flex;
		min-height: 100%;
		flex: 1;
		flex-direction: column;
		background-color: #f5f7fa;
	}

	.merchant-profile__header {
		display: flex;
		flex-direction: column;
		padding: 52px 20px 18px 20px;
		border-bottom-width: 1px;
		border-bottom-style: solid;
		border-bottom-color: #dde4ed;
		background-color: #ffffff;
	}

	.merchant-profile__eyebrow {
		font-size: 12px;
		font-weight: 600;
		line-height: 18px;
