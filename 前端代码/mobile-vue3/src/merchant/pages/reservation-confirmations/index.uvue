<template>
	<view class="confirmation-page" :class="{ 'confirmation-page--native-mini': platformUsesNativeCanvas }">
		<view class="confirmation-page__header"><view class="confirmation-page__header-row"><text class="confirmation-page__back" @tap="backToWorkbench">‹</text><text class="confirmation-page__title">预约确认</text><view class="confirmation-page__header-space"></view></view><text class="confirmation-page__subtitle">确认或拒绝会员提交的新预约</text></view>
		<view class="confirmation-page__summary"><text class="confirmation-page__summary-number">{{ totalRecords }}</text><text class="confirmation-page__summary-label">待确认</text><view class="confirmation-page__refresh" @tap="loadReservations(true)"><text>刷新</text></view></view>
		<view v-if="loading" class="confirmation-page__notice"><text>正在读取待确认预约…</text></view>
		<view v-else-if="message.length > 0" class="confirmation-page__notice"><text>{{ message }}</text><view class="confirmation-page__notice-action" @tap="loginRequired ? openMerchantLogin() : loadReservations(true)"><text>{{ loginRequired ? '前往登录' : '重新加载' }}</text></view></view>
		<scroll-view v-else scroll-y class="confirmation-page__list" @scrolltolower="loadReservations(false)">
			<view v-if="records.length == 0" class="confirmation-page__empty"><text>暂无待确认预约</text><text>会员端新建的 V3 预约会出现在这里</text></view>
			<view v-for="item in records" :key="item.reservationId" class="confirmation-page__card" @tap="openDetail(item)"><view class="confirmation-page__card-head"><view><text class="confirmation-page__member">{{ item.memberName || '未命名会员' }}</text><text class="confirmation-page__phone">{{ item.phone }}</text></view><text class="confirmation-page__status">待确认</text></view><text class="confirmation-page__time">{{ item.appointmentTime || '时间待定' }}</text><text class="confirmation-page__copy">{{ item.projectSummary || '未选择项目' }}</text><text class="confirmation-page__copy">{{ item.craftsmanSummary || '待分配手艺人' }}{{ item.roomName ? ' · ' + item.roomName : '' }}</text><text class="confirmation-page__detail-link">处理预约 ›</text></view>
			<text v-if="records.length > 0" class="confirmation-page__list-footer">{{ loadingMore ? '正在加载更多…' : ('已显示 ' + records.length + ' / ' + totalRecords + ' 条') }}</text>
		</scroll-view>

		<view v-if="detailOpen" class="confirmation-page__overlay"><view class="confirmation-page__sheet-header"><text class="confirmation-page__sheet-cancel" @tap="closeDetail">关闭</text><text class="confirmation-page__sheet-title">预约确认</text><text class="confirmation-page__sheet-space"></text></view><scroll-view scroll-y class="confirmation-page__sheet-body"><view v-if="detailLoading" class="confirmation-page__notice"><text>正在读取详情…</text></view><view v-else-if="detail == null" class="confirmation-page__notice"><text>{{ message || '预约详情暂不可用。' }}</text></view><view v-else><view class="confirmation-page__detail-card"><view class="confirmation-page__card-head"><text class="confirmation-page__member">{{ detail.member != null ? detail.member.name : '' }}</text><text class="confirmation-page__status">{{ detail.statusLabel || '待确认' }}</text></view><text class="confirmation-page__time">{{ detail.appointmentStartAt || '时间待定' }}{{ detail.appointmentEndAt ? ' 至 ' + detail.appointmentEndAt : '' }}</text><text class="confirmation-page__copy">{{ detailProjects() }}</text><text class="confirmation-page__copy">{{ detailCraftsmen() }}{{ detail.room != null && detail.room.name ? ' · ' + detail.room.name : '' }}</text><text v-if="detail.remark" class="confirmation-page__copy">备注：{{ detail.remark }}</text><text class="confirmation-page__document">预约单 {{ detail.reservationNo }}</text></view><text v-if="actionError.length > 0" class="confirmation-page__action-error">{{ actionError }}</text><view v-if="confirmationActions().length > 0" class="confirmation-page__action-row"><view v-for="action in confirmationActions()" :key="action.action" class="confirmation-page__action" :class="{ 'confirmation-page__action--primary': action.action == 'confirm-reservation', 'confirmation-page__action--danger': action.action == 'reject-reservation' }" @tap="runAction(action.action)"><text>{{ action.label }}</text></view></view><view class="confirmation-page__timeline"><text class="confirmation-page__section-label">操作记录</text><view v-for="entry in detail.timeline" :key="entry.id" class="confirmation-page__timeline-row"><text>{{ entry.title }}</text><text>{{ entry.occurredAt }}</text></view></view></view></scroll-view></view>
		<view v-if="editorOpen" class="confirmation-page__overlay"><view class="confirmation-page__sheet-header"><text class="confirmation-page__sheet-cancel" @tap="closeEditor">取消</text><text class="confirmation-page__sheet-title">修改并确认</text><text class="confirmation-page__sheet-space"></text></view><scroll-view scroll-y class="confirmation-page__sheet-body">
			<text class="confirmation-page__field-label">客户姓名（不可修改）</text><view class="confirmation-page__select confirmation-page__select--locked"><text>{{ selectedMember == null ? '' : selectedMember.name + (selectedMember.phone ? ' · ' + selectedMember.phone : '') }}</text></view>
			<text class="confirmation-page__field-label">预约项目</text><view class="confirmation-page__source-tabs"><view class="confirmation-page__source-tab" :class="{ 'confirmation-page__source-tab--active': projectSource == 'card' }" @tap="projectSource = 'card'"><text>已购买项目</text></view><view class="confirmation-page__source-tab" :class="{ 'confirmation-page__source-tab--active': projectSource == 'all' }" @tap="projectSource = 'all'"><text>全部项目</text></view></view><input class="confirmation-page__input" :value="projectKeyword" placeholder="搜索项目名称" @input="projectKeyword = $event.detail.value" /><scroll-view v-if="projectCategories().length > 1" scroll-x class="confirmation-page__category-row"><view class="confirmation-page__category" :class="{ 'confirmation-page__category--active': projectCategory == '' }" @tap="projectCategory = ''"><text>全部</text></view><view v-for="category in projectCategories()" :key="category" class="confirmation-page__category" :class="{ 'confirmation-page__category--active': projectCategory == category }" @tap="projectCategory = category"><text>{{ category }}</text></view></scroll-view><view class="confirmation-page__choices"><template v-for="project in projectOptions" :key="projectKey(project)"><view v-if="projectVisible(project)" class="confirmation-page__choice" :class="{ 'confirmation-page__choice--active': selectedProject(project) }" @tap="toggleProject(project)"><text>{{ project.name }}</text><text class="confirmation-page__choice-note">{{ project.source == 'card' ? '已购' : '未购' }}</text></view></template></view><text v-if="visibleProjectCount() == 0" class="confirmation-page__helper">没有符合条件的项目。</text><text v-else-if="selectedProjects.length > 0" class="confirmation-page__helper">已选 {{ selectedProjects.length }} 项 · {{ estimatedEndLabel() }}</text>
			<text class="confirmation-page__field-label">预约时间</text><view class="confirmation-page__datetime"><picker mode="date" :value="appointmentDate" @change="appointmentDate = $event.detail.value"><view class="confirmation-page__select"><text>{{ appointmentDate || '选择日期' }}</text><text>›</text></view></picker><picker mode="time" :value="appointmentClock" @change="appointmentClock = $event.detail.value"><view class="confirmation-page__select"><text>{{ appointmentClock || '选择时间' }}</text><text>›</text></view></picker></view><text v-if="appointmentDate && appointmentClock" class="confirmation-page__helper">{{ estimatedEndLabel() }}</text>
			<text class="confirmation-page__field-label">手艺人（可不选）</text><view class="confirmation-page__choices"><view v-for="staff in craftsmanOptions" :key="staff.staffId || staff.id" class="confirmation-page__choice" :class="{ 'confirmation-page__choice--active': selectedCraftsman(staff), 'confirmation-page__choice--disabled': staff.selectable === false }" @tap="toggleCraftsman(staff)"><text>{{ staff.name || staff.staffName }}</text><text v-if="staff.selectable === false" class="confirmation-page__choice-note">{{ staff.disabledReason || '当前不可选' }}</text></view></view><text v-if="craftsmanOptions.length == 0" class="confirmation-page__helper">当前门店没有可预约的手艺人。</text>
			<text class="confirmation-page__field-label">房间（可不选）</text><view class="confirmation-page__choices"><view class="confirmation-page__choice" :class="{ 'confirmation-page__choice--active': selectedRoomId == 0 }" @tap="clearRoom"><text>暂不分配</text></view><view v-for="room in roomOptions" :key="room.id || room.roomId" class="confirmation-page__choice" :class="{ 'confirmation-page__choice--active': selectedRoomId == Number(room.id || room.roomId), 'confirmation-page__choice--disabled': room.selectable === false }" @tap="chooseRoom(room)"><text>{{ room.name || room.label || ('房间 ' + (room.id || room.roomId)) }}</text><text v-if="room.selectable === false" class="confirmation-page__choice-note">{{ room.disabledReason || '当前不可选' }}</text></view></view><text v-if="roomOptions.length == 0" class="confirmation-page__helper">当前门店未配置可用房间，本次可暂不分配。</text>
			<text class="confirmation-page__field-label">备注（可选）</text><textarea class="confirmation-page__textarea" :value="remark" placeholder="填写预约说明" @input="remark = $event.detail.value" /><text v-if="actionError.length > 0" class="confirmation-page__action-error">{{ actionError }}</text><view class="confirmation-page__submit" @tap="submitConfirmation"><text>{{ submitting ? '正在确认…' : '保存并确认' }}</text></view>
		</scroll-view></view>

		<view v-if="rejectOpen" class="confirmation-page__dialog-mask"><view class="confirmation-page__dialog"><text class="confirmation-page__dialog-title">拒绝预约</text><text class="confirmation-page__dialog-copy">请填写拒绝原因，会员端和门店端将同步看到处理结果。</text><textarea class="confirmation-page__textarea" :value="rejectReason" placeholder="请输入拒绝原因" maxlength="200" @input="rejectReason = $event.detail.value" /><text v-if="rejectError.length > 0" class="confirmation-page__field-error">{{ rejectError }}</text><view class="confirmation-page__dialog-actions"><view class="confirmation-page__dialog-cancel" @tap="closeReject"><text>取消</text></view><view class="confirmation-page__dialog-submit" @tap="submitReject"><text>{{ submitting ? '正在提交…' : '确认拒绝' }}</text></view></view></view></view>
	</view>
</template>

<script setup lang="uts">
	import { confirmMobileReservation, openMobileReservationEditor, queryMobileReservationDetail, queryMobileReservations, rejectMobileReservation } from '../../../shared/api/mobile-reservation-client.uts'
	import { openMerchantBootstrap, openMerchantWorkbench } from '../../../shared/platform/mobile-navigation.uts'
	import { currentMobilePlatform } from '../../../shared/platform/mobile-platform.uts'
	import { currentMerchantRoot, merchantRequestSession } from '../../../shared/platform/mobile-merchant-session.uts'
	import { ensureMerchantTabAccess } from '../../../shared/platform/merchant-route-guard.uts'
	const records = ref<Array<any>>([]); const loading = ref(false); const loadingMore = ref(false); const message = ref(''); const loginRequired = ref(false); const currentPage = ref(1); const totalRecords = ref(0); const hasMore = ref(false)
	const detailOpen = ref(false); const detailLoading = ref(false); const detail = ref<any>(null); const detailId = ref(0); const submitting = ref(false); const actionError = ref(''); const rejectOpen = ref(false); const rejectReason = ref(''); const rejectError = ref(''); let linkedRefreshTimer : any = null
	const editorOpen = ref(false); const editingReservationVersion = ref(0); const projectOptions = ref<Array<any>>([]); const craftsmanOptions = ref<Array<any>>([]); const roomOptions = ref<Array<any>>([]); const selectedProjects = ref<Array<any>>([]); const selectedCraftsmen = ref<Array<any>>([]); const selectedRoomId = ref(0); const selectedRoomName = ref(''); const selectedMember = ref<any>(null); const projectSource = ref('card'); const projectKeyword = ref(''); const projectCategory = ref(''); const appointmentDate = ref(''); const appointmentClock = ref(''); const remark = ref('')
	const platformUsesNativeCanvas = currentMobilePlatform() === 'MP_WEIXIN'
	onShow(() => { startLinkedRefresh(); if (ensureMerchantTabAccess('workbench')) loadReservations(true) })
	onHide(() => { stopLinkedRefresh() })
	onUnmounted(() => { stopLinkedRefresh() })
	function startLinkedRefresh() : void { stopLinkedRefresh(); linkedRefreshTimer = setInterval(() => { refreshLinkedView() }, 15000) }
	function stopLinkedRefresh() : void { if (linkedRefreshTimer != null) { clearInterval(linkedRefreshTimer); linkedRefreshTimer = null } }
	function refreshLinkedView() : void { if (submitting.value || loading.value || detailLoading.value || rejectOpen.value) return; if (detailOpen.value && detailId.value > 0) loadDetail(false); else loadReservations(true) }
	function merchantLoginIsRequired() : boolean { return merchantRequestSession(currentMerchantRoot()) == null }
	function openMerchantLogin() : void { openMerchantBootstrap() }
	function backToWorkbench() : void { openMerchantWorkbench() }
	function payloadOf(response : any) : any { return response != null && response.body != null ? response.body.reservation : null }
	function succeeded(response : any) : boolean { let payload = payloadOf(response); return response != null && response.ok && payload != null && payload.result != null && payload.result.status == 'success' }
	function errorMessage(response : any, fallback : string) : string { let payload = payloadOf(response); return String(response != null && response.message ? response.message : (payload != null && payload.result != null ? payload.result.message : fallback)) }
	function loadReservations(reset : boolean = true) : void { if (!reset && (!hasMore.value || loadingMore.value)) return; let requestedPage = reset ? 1 : currentPage.value + 1; if (reset) { loading.value = true; message.value = ''; loginRequired.value = false } else loadingMore.value = true; queryMobileReservations({ workflow: 'confirmation', quickFilter: 'pending_confirmation', page: requestedPage, pageSize: 10 }, (response : any) => { loading.value = false; loadingMore.value = false; if (!succeeded(response)) { loginRequired.value = merchantLoginIsRequired(); message.value = loginRequired.value ? '请先完成商家端登录。' : errorMessage(response, '待确认预约暂时不可用。'); return }; let view = payloadOf(response).data != null ? payloadOf(response).data.reservation : null; let next = view != null && Array.isArray(view.records) ? view.records : []; records.value = reset ? next : records.value.concat(next); currentPage.value = Number(view != null ? view.page : requestedPage); totalRecords.value = Number(view != null ? view.total : records.value.length); hasMore.value = records.value.length < totalRecords.value }) }
	function openDetail(item : any) : void { detailId.value = Number(item.reservationId || item.id || 0); if (detailId.value <= 0) return; detailOpen.value = true; detail.value = null; message.value = ''; actionError.value = ''; loadDetail(true) }
	function loadDetail(showLoading : boolean) : void { if (detailId.value <= 0) return; if (showLoading) detailLoading.value = true; queryMobileReservationDetail(detailId.value, (response : any) => { detailLoading.value = false; if (!succeeded(response)) { if (showLoading) message.value = errorMessage(response, '预约详情暂不可用。'); return }; detail.value = payloadOf(response).data != null && payloadOf(response).data.reservation != null ? payloadOf(response).data.reservation.detail : null }) }
	function closeDetail() : void { detailOpen.value = false; detail.value = null; closeReject() }
	function detailProjects() : string { if (detail.value == null || !Array.isArray(detail.value.projects)) return '未选择项目'; let values = new Array<string>(); for (let i = 0; i < detail.value.projects.length; i++) values.push(String(detail.value.projects[i].name || '项目')); return values.join('、') }
	function detailCraftsmen() : string { if (detail.value == null || !Array.isArray(detail.value.plannedCraftsmen) || detail.value.plannedCraftsmen.length == 0) return '待分配手艺人'; let values = new Array<string>(); for (let i = 0; i < detail.value.plannedCraftsmen.length; i++) values.push(String(detail.value.plannedCraftsmen[i].name || '')); return values.join('、') }
	function confirmationActions() : Array<any> { let values = new Array<any>(); if (detail.value == null || !Array.isArray(detail.value.actions)) return values; for (let i = 0; i < detail.value.actions.length; i++) { let action = detail.value.actions[i]; if (action.action == 'confirm-reservation' || action.action == 'reject-reservation') values.push(action) }; return values }
	function uuid() : string { let text = ''; let chars = '0123456789abcdef'; for (let i = 0; i < 32; i++) { if (i == 8 || i == 12 || i == 16 || i == 20) text += '-'; let n = Math.floor(Math.random() * 16); if (i == 12) n = 4; if (i == 16) n = (n & 3) | 8; text += chars.charAt(n) }; return text }
	function command(action : string, version : number) : any { return { action: action, idempotencyKey: 'RESERVATION-' + uuid(), contexts: [{ kind: 'reservation', id: detailId.value.toString(), expectedVersion: version }] } }
	function validVersion() : number { let version = Number(detail.value != null ? (detail.value.reservationVersion || detail.value.revision || 0) : 0); if (version <= 0) actionError.value = '预约资料已过期，请关闭后重新打开。'; return version }
	function runAction(action : string) : void { if (detail.value == null || detailId.value <= 0 || submitting.value) return; actionError.value = ''; let version = validVersion(); if (version <= 0) return; if (action == 'reject-reservation') { rejectReason.value = ''; rejectError.value = ''; rejectOpen.value = true; return }; if (action == 'confirm-reservation') openConfirmationEditor() }
	function resetEditor() : void { editingReservationVersion.value = 0; projectOptions.value = []; craftsmanOptions.value = []; roomOptions.value = []; selectedProjects.value = []; selectedCraftsmen.value = []; selectedRoomId.value = 0; selectedRoomName.value = ''; selectedMember.value = null; projectSource.value = 'card'; projectKeyword.value = ''; projectCategory.value = ''; appointmentDate.value = ''; appointmentClock.value = ''; remark.value = '' }
	function openConfirmationEditor() : void { if (detailId.value <= 0) return; resetEditor(); detailLoading.value = true; openMobileReservationEditor({ mode: 'edit', reservationId: detailId.value, preparationRequestId: 'mobile-confirm-' + uuid() }, (response : any) => { detailLoading.value = false; if (!succeeded(response)) { actionError.value = errorMessage(response, '预约编辑器暂不可用。'); return }; let editor = payloadOf(response).data != null ? payloadOf(response).data.editor : null; if (editor == null || editor.draft == null) { actionError.value = '预约编辑资料不完整。'; return }; let draft = editor.draft; editingReservationVersion.value = Number(draft.reservationVersion || draft.recordVersion || draft.revision || 0); selectedMember.value = draft.member; selectedProjects.value = Array.isArray(draft.projects) ? draft.projects : []; selectedCraftsmen.value = Array.isArray(draft.craftsmen) ? draft.craftsmen : []; selectedRoomId.value = Number(draft.roomId || 0); selectedRoomName.value = draft.room != null ? String(draft.room.name || '') : ''; projectOptions.value = Array.isArray(editor.catalogOptions) ? editor.catalogOptions : []; craftsmanOptions.value = Array.isArray(editor.craftsmenOptions) ? editor.craftsmenOptions : []; roomOptions.value = Array.isArray(editor.rooms) ? editor.rooms : []; splitAppointmentTime(String(draft.appointmentTime || '')); remark.value = String(draft.remark || ''); detailOpen.value = false; editorOpen.value = true }) }
	function closeEditor() : void { if (submitting.value) return; editorOpen.value = false; resetEditor() }
	function projectKey(project : any) : string { return String(project.source || 'unpaid') + ':' + String(project.projectId || project.id || 0) + ':' + String(project.skuId || 0) + ':' + String(project.entitlementSourceDetailId || 0) }
	function selectedProject(project : any) : boolean { let key = projectKey(project); for (let i = 0; i < selectedProjects.value.length; i++) if (projectKey(selectedProjects.value[i]) == key) return true; return false }
	function toggleProject(project : any) : void { if (project.selectable === false) return; let key = projectKey(project); let next = new Array<any>(); let found = false; for (let i = 0; i < selectedProjects.value.length; i++) { if (projectKey(selectedProjects.value[i]) == key) found = true; else next.push(selectedProjects.value[i]) }; if (!found) next.push({ projectId: Number(project.projectId || project.id || 0), skuId: Number(project.skuId || 0), name: project.name, source: project.source == 'card' ? 'card' : 'unpaid', entitlementSourceDetailId: Number(project.entitlementSourceDetailId || 0), quantity: 1, appliedDurationMinutes: Number(project.appliedDurationMinutes || project.serviceDurationMinutes || 60) }); selectedProjects.value = next }
	function projectCategories() : Array<string> { let values = new Array<string>(); for (let i = 0; i < projectOptions.value.length; i++) { let category = String(projectOptions.value[i].categoryName || '全部'); if (values.indexOf(category) < 0) values.push(category) }; return values }
	function projectVisible(project : any) : boolean { if (project.selectable === false || (projectSource.value == 'card' && project.source != 'card')) return false; let category = String(project.categoryName || '全部'); if (projectCategory.value.length > 0 && projectCategory.value != category) return false; let keyword = projectKeyword.value.trim().toLowerCase(); return keyword.length == 0 || String(project.name || '').toLowerCase().indexOf(keyword) >= 0 }
	function visibleProjectCount() : number { let count = 0; for (let i = 0; i < projectOptions.value.length; i++) if (projectVisible(projectOptions.value[i])) count++; return count }
	function selectedCraftsman(staff : any) : boolean { let id = Number(staff.staffId || staff.id || 0); for (let i = 0; i < selectedCraftsmen.value.length; i++) { let value = selectedCraftsmen.value[i]; if (Number(value) == id || Number(value.staffId || value.id || 0) == id) return true }; return false }
	function toggleCraftsman(staff : any) : void { if (staff.selectable === false) return; let id = Number(staff.staffId || staff.id || 0); let next = new Array<any>(); let found = false; for (let i = 0; i < selectedCraftsmen.value.length; i++) { let value = selectedCraftsmen.value[i]; if (Number(value) == id || Number(value.staffId || value.id || 0) == id) found = true; else next.push(value) }; if (!found) next.push({ id: id, staffId: id, name: String(staff.name || staff.staffName || '') }); selectedCraftsmen.value = next }
	function chooseRoom(room : any) : void { if (room.selectable === false) return; selectedRoomId.value = Number(room.id || room.roomId || 0); selectedRoomName.value = String(room.name || room.roomName || room.label || '') }
	function clearRoom() : void { selectedRoomId.value = 0; selectedRoomName.value = '' }
	function splitAppointmentTime(value : string) : void { let parts = value.split(' '); appointmentDate.value = parts.length > 0 ? parts[0] : ''; appointmentClock.value = parts.length > 1 ? parts[1] : '' }
	function appointmentTime() : string { return appointmentDate.value.length > 0 && appointmentClock.value.length > 0 ? appointmentDate.value + ' ' + appointmentClock.value : '' }
	function estimatedEndLabel() : string { let minutes = 0; for (let i = 0; i < selectedProjects.value.length; i++) minutes += Number(selectedProjects.value[i].appliedDurationMinutes || selectedProjects.value[i].serviceDurationMinutes || 60) * Number(selectedProjects.value[i].quantity || 1); if (minutes <= 0) return '请先选择项目'; let start = appointmentTime(); if (start.length == 0) return '预计服务时长 ' + minutes.toString() + ' 分钟'; let time = new Date(start.replace(' ', 'T')).getTime(); if (isNaN(time)) return '预计服务时长 ' + minutes.toString() + ' 分钟'; let end = new Date(time + minutes * 60000); let month = (end.getMonth() + 1).toString().padStart(2, '0'); let day = end.getDate().toString().padStart(2, '0'); let hour = end.getHours().toString().padStart(2, '0'); let minute = end.getMinutes().toString().padStart(2, '0'); return '预计结束 ' + end.getFullYear().toString() + '-' + month + '-' + day + ' ' + hour + ':' + minute }
	function reservationDraft() : any { return { memberId: selectedMember.value != null ? Number(selectedMember.value.memberId || selectedMember.value.id || 0) : 0, member: selectedMember.value, projects: selectedProjects.value, craftsmen: selectedCraftsmen.value, roomId: selectedRoomId.value, roomName: selectedRoomName.value, appointmentTime: appointmentTime(), remark: remark.value.trim() } }
	function submitConfirmation() : void { if (submitting.value) return; if (selectedMember.value == null || selectedProjects.value.length == 0 || appointmentTime().length == 0) { actionError.value = '请确认客户、项目和预约时间。'; return }; submitAction('confirm-reservation', editingReservationVersion.value, '', reservationDraft()) }
	function closeReject() : void { if (submitting.value) return; rejectOpen.value = false; rejectReason.value = ''; rejectError.value = '' }
	function submitReject() : void { if (submitting.value) return; let reason = rejectReason.value.trim(); if (reason.length == 0) { rejectError.value = '请填写拒绝原因。'; return }; let version = validVersion(); if (version <= 0) { rejectError.value = actionError.value; return }; submitAction('reject-reservation', version, reason) }
	function submitAction(action : string, version : number, reason : string, reservation : any = null) : void { submitting.value = true; let payload : any = { command: command(action, version) }; if (reason.length > 0) payload.reason = reason; if (reservation != null) payload.reservation = reservation; let done = (response : any) => { submitting.value = false; if (!succeeded(response)) { let copy = errorMessage(response, '预约确认操作未完成。'); if (rejectOpen.value) rejectError.value = copy; else actionError.value = copy; return }; rejectOpen.value = false; editorOpen.value = false; detailOpen.value = false; detail.value = null; resetEditor(); loadReservations(true) }; if (action == 'confirm-reservation') confirmMobileReservation(detailId.value, payload, done); else rejectMobileReservation(detailId.value, payload, done) }
</script>

<style>
