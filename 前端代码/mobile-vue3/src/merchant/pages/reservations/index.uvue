<template>
  <MoheAiEntry />
	<view class="reservation-page" :class="{ 'reservation-page--native-mini': platformUsesNativeCanvas }">
		<view class="reservation-page__header">
			<view class="reservation-page__header-row"><text class="reservation-page__back" @tap="backToWorkbench">‹</text><text class="reservation-page__title">预约服务</text><view class="reservation-page__header-space"></view></view>
		</view>
		<view class="reservation-page__filters"><view v-for="filter in filters" :key="filter.key" class="reservation-page__filter" :class="{ 'reservation-page__filter--active': activeFilter == filter.key }" @tap="changeFilter(filter.key)"><text>{{ filter.label }}</text></view></view>
		<view v-if="loading" class="reservation-page__notice"><text>正在读取预约…</text></view>
		<view v-else-if="message.length > 0" class="reservation-page__notice"><text>{{ message }}</text><view class="reservation-page__notice-action" @tap="loginRequired ? openMerchantLogin() : loadReservations()"><text>{{ loginRequired ? '前往登录' : '重新加载' }}</text></view></view>
		<scroll-view v-else scroll-y class="reservation-page__list" @scrolltolower="loadMoreReservations">
			<view v-if="records.length == 0" class="reservation-page__empty"><text>暂无{{ activeFilterLabel() }}预约</text></view>
			<view v-for="item in records" :key="item.reservationId" class="reservation-page__card" @tap="openDetail(item)">
				<view class="reservation-page__card-head"><view><text class="reservation-page__member">{{ item.memberName || '未命名会员' }}</text><text class="reservation-page__phone">{{ item.phone }}</text></view><text class="reservation-page__status" :class="statusClass(item.status)">{{ statusLabelOf(item) }}</text></view>
				<text class="reservation-page__time">{{ item.appointmentTime || '时间待定' }}</text><text class="reservation-page__copy">{{ item.projectSummary || '未选择项目' }}</text><text class="reservation-page__copy">{{ item.craftsmanSummary || '待分配手艺人' }}{{ item.roomName ? ' · ' + item.roomName : '' }}</text>
				<text v-if="serviceCountdownLabel(item).length > 0" class="reservation-page__countdown" :class="{ 'reservation-page__countdown--overtime': serviceIsOvertime(item) }">{{ serviceCountdownLabel(item) }}</text><text class="reservation-page__detail-link">查看服务详情 ›</text>
			</view>
			<text v-if="records.length > 0" class="reservation-page__list-footer">{{ loadingMore ? '正在加载更多…' : ('已显示 ' + records.length + ' / ' + totalRecords + ' 条') }}</text>
		</scroll-view>
		<view class="reservation-page__floating-create" role="button" aria-label="新增预约" @tap="openCreateEditor"><text>{{ editorLoading ? '…' : '＋' }}</text></view>

		<view v-if="editorOpen" class="reservation-page__overlay reservation-page__editor-overlay"><view class="reservation-page__sheet-header"><text class="reservation-page__sheet-cancel" @tap="closeEditor">取消</text><text class="reservation-page__sheet-title">{{ editingReservationId > 0 ? '编辑预约' : '新增预约' }}</text><text class="reservation-page__sheet-space"></text></view><scroll-view scroll-y class="reservation-page__sheet-body">
			<text class="reservation-page__field-label">会员</text><view class="reservation-page__select" :class="{ 'reservation-page__select--locked': editingReservationId > 0 }" @tap="openMemberPicker"><text>{{ selectedMember == null ? '选择会员' : String(selectedMember.name || '') + (selectedMember.phone ? ' · ' + selectedMember.phone : '') }}</text><text>{{ editingReservationId > 0 ? '' : '›' }}</text></view>
			<view v-if="memberPickerOpen" class="reservation-page__picker"><input class="reservation-page__input" :value="memberKeyword" placeholder="搜索会员姓名或手机号" @input="memberKeyword = $event.detail.value" /><view class="reservation-page__inline-button" @tap="loadMembers"><text>{{ memberLoading ? '查询中…' : '查询' }}</text></view><view v-for="member in memberCandidates" :key="member.memberId || member.id" class="reservation-page__picker-option" @tap="selectMember(member)"><text>{{ member.name }}{{ member.phone ? ' · ' + member.phone : '' }}</text></view></view>
			<!-- 关闭归因只隐藏客户来源，项目来源仍保留。 -->
			<template v-if="businessSourceEnabled">
			<text class="reservation-page__field-label">客户来源</text><view class="reservation-page__choices"><view v-for="source in businessSources" :key="source.id" class="reservation-page__choice" :class="{ 'reservation-page__choice--active': selectedBusinessPrimaryId == Number(source.id) }" @tap="chooseBusinessPrimary(source)"><text>{{ source.name }}</text></view></view><text v-if="businessSources.length == 0" class="reservation-page__helper">当前没有可用来源，请联系平台管理员。</text>
			<template v-if="businessSourceChildren().length > 0"><text class="reservation-page__field-label">二级来源</text><view class="reservation-page__choices"><view v-if="!businessSourceRequiresSecondary()" class="reservation-page__choice" :class="{ 'reservation-page__choice--active': selectedBusinessSecondaryId == 0 }" @tap="chooseBusinessSecondary(null)"><text>不选择</text></view><view v-for="source in businessSourceChildren()" :key="source.id" class="reservation-page__choice" :class="{ 'reservation-page__choice--active': selectedBusinessSecondaryId == Number(source.id) }" @tap="chooseBusinessSecondary(source)"><text>{{ source.name }}</text></view></view></template></template>
			<text class="reservation-page__field-label">预约时间</text><view class="reservation-page__datetime"><picker mode="date" :value="appointmentDate" @change="changeAppointmentDate($event.detail.value)"><view class="reservation-page__select"><text>{{ appointmentDate || '选择日期' }}</text><text>›</text></view></picker><picker mode="time" :value="appointmentStartClock" @change="changeAppointmentStart($event.detail.value)"><view class="reservation-page__select"><text>{{ appointmentStartClock || '开始时间' }}</text><text>›</text></view></picker><picker mode="time" :value="appointmentEndClock" @change="changeAppointmentEnd($event.detail.value)"><view class="reservation-page__select"><text>{{ appointmentEndClock || '结束时间' }}</text><text>›</text></view></picker></view>
			<text class="reservation-page__field-label">预约项目（可不选）</text><view class="reservation-page__source-tabs"><view class="reservation-page__source-tab" :class="{ 'reservation-page__source-tab--active': projectSource == 'card' }" @tap="projectSource = 'card'"><text>已购买项目</text></view><view class="reservation-page__source-tab" :class="{ 'reservation-page__source-tab--active': projectSource == 'all' }" @tap="projectSource = 'all'"><text>全部项目</text></view></view><input class="reservation-page__input" :value="projectKeyword" placeholder="搜索项目名称" @input="projectKeyword = $event.detail.value" /><view class="reservation-page__choices"><view v-for="project in visibleProjects()" :key="projectKey(project)" class="reservation-page__choice" :class="{ 'reservation-page__choice--active': selectedProject(project) }" @tap="toggleProject(project)"><text>{{ project.name }}</text><text class="reservation-page__choice-note">{{ project.source == 'card' ? '已购' : '未购' }}</text></view></view><text v-if="visibleProjects().length == 0" class="reservation-page__helper">{{ selectedMember == null ? '先选择会员后查看项目。' : '没有符合条件的项目，可不选。' }}</text>
			<text class="reservation-page__field-label">手艺人（可不选）</text><view class="reservation-page__choices"><view v-for="staff in craftsmanOptions" :key="staff.staffId || staff.id" class="reservation-page__choice" :class="{ 'reservation-page__choice--active': selectedCraftsman(staff), 'reservation-page__choice--disabled': staff.selectable === false }" @tap="toggleCraftsman(staff)"><text>{{ staff.name || staff.staffName }}{{ staff.selectable === false ? ' · 该时段不可预约' : '' }}</text></view></view>
			<text class="reservation-page__field-label">房间（可不选）</text><view class="reservation-page__choices"><view class="reservation-page__choice" :class="{ 'reservation-page__choice--active': selectedRoomId == 0 }" @tap="chooseRoom(null)"><text>暂不分配</text></view><view v-for="room in roomOptions" :key="room.id || room.roomId" class="reservation-page__choice" :class="{ 'reservation-page__choice--active': selectedRoomId == Number(room.id || room.roomId), 'reservation-page__choice--disabled': room.selectable === false }" @tap="chooseRoom(room)"><text>{{ room.name || room.label }}</text></view></view>
			<text class="reservation-page__field-label">备注（可选）</text><textarea class="reservation-page__textarea" :value="remark" placeholder="填写预约说明" @input="remark = $event.detail.value" /><text v-if="editorError.length > 0" class="reservation-page__action-error">{{ editorError }}</text><view class="reservation-page__submit" @tap="submitReservation"><text>{{ submitting ? '正在保存…' : '保存预约' }}</text></view>
		</scroll-view></view>

		<view v-if="detailOpen" class="reservation-page__overlay"><view class="reservation-page__sheet-header"><text class="reservation-page__sheet-cancel" @tap="closeDetail">关闭</text><text class="reservation-page__sheet-title">预约服务详情</text><text class="reservation-page__sheet-space"></text></view><scroll-view scroll-y class="reservation-page__sheet-body"><view v-if="detailLoading" class="reservation-page__notice"><text>正在读取详情…</text></view><view v-else-if="detail == null" class="reservation-page__notice"><text>{{ message || '预约详情暂不可用。' }}</text></view><view v-else><view class="reservation-page__detail-card"><view class="reservation-page__card-head"><text class="reservation-page__member">{{ detail.member != null ? detail.member.name : '' }}</text><text class="reservation-page__status" :class="statusClass(detail.statusLabel)">{{ detail.statusLabel }}</text></view><text class="reservation-page__time">{{ detail.appointmentStartAt || '时间待定' }}{{ detail.appointmentEndAt ? ' 至 ' + detail.appointmentEndAt : '' }}</text><text class="reservation-page__copy">服务时长：{{ Number(detail.serviceDurationMinutes || 0) }} 分钟</text><text class="reservation-page__copy">{{ detailProjects() }}</text><text class="reservation-page__copy">{{ detailCraftsmen() }}{{ detail.room != null && detail.room.name ? ' · ' + detail.room.name : '' }}</text><text v-if="detail.remark" class="reservation-page__copy">备注：{{ detail.remark }}</text><view v-if="serviceCountdownLabel(detail).length > 0" class="reservation-page__timer"><text class="reservation-page__timer-caption">实际开始后计时</text><text class="reservation-page__timer-value" :class="{ 'reservation-page__timer-value--overtime': serviceIsOvertime(detail) }">{{ serviceCountdownLabel(detail) }}</text><text class="reservation-page__timer-note">倒计时归零后自动结束服务。</text></view><text v-if="detail.customServices != null && detail.customServices.length > 0" class="reservation-page__copy">定制服务：{{ customServicesSummary(detail.customServices) }}</text><text class="reservation-page__document">预约单 {{ detail.reservationNo }}</text></view><text v-if="actionError.length > 0" class="reservation-page__action-error">{{ actionError }}</text><view v-if="canChangeServiceDuration()" class="reservation-page__duration-row"><view v-if="canChangeServiceProjects()" class="reservation-page__action reservation-page__action--secondary" @tap="openServiceProjectEditor"><text>修改服务项目</text></view><view v-if="!durationEditing" class="reservation-page__action reservation-page__action--secondary" @tap="openDurationEditor"><text>修改服务时长</text></view><view v-else class="reservation-page__duration-editor"><text>服务时长（分钟）</text><input class="reservation-page__duration-input" type="number" :value="durationDraft" @input="durationDraft = $event.detail.value" /><view class="reservation-page__duration-buttons"><view class="reservation-page__action reservation-page__action--secondary" @tap="durationEditing = false"><text>取消</text></view><view class="reservation-page__action reservation-page__action--primary" @tap="saveDuration"><text>{{ submitting ? "保存中…" : "保存时长" }}</text></view></view></view></view><view v-if="serviceActions().length > 0 || canEditUnstarted() || canDeleteUnstarted()" class="reservation-page__action-row"><view v-for="action in serviceActions()" :key="action.action" class="reservation-page__action reservation-page__action--primary" :class="{ 'reservation-page__action--with-peer': canEditUnstarted() || canDeleteUnstarted() }" @tap="runAction(action.action)"><text>{{ action.label }}</text></view><view v-if="canEditUnstarted()" class="reservation-page__action reservation-page__action--secondary" :class="{ 'reservation-page__action--with-peer': canDeleteUnstarted() }" @tap="openEditEditor"><text>编辑</text></view><view v-if="canDeleteUnstarted()" class="reservation-page__action reservation-page__action--delete" @tap="deleteUnstartedReservation"><text>删除</text></view></view><view class="reservation-page__timeline"><text class="reservation-page__section-label">操作记录</text><view v-for="entry in detail.timeline" :key="entry.id" class="reservation-page__timeline-row"><text>{{ entry.title }}</text><text>{{ entry.occurredAt }}</text></view></view></view></scroll-view></view>
	</view>
	<!-- 服务中单独更换最终服务项目；预约计时和原预约时段不随项目变化。 -->
	<view v-if="projectEditing" class="reservation-page__overlay reservation-page__editor-overlay"><view class="reservation-page__sheet-header"><text class="reservation-page__sheet-cancel" @tap="projectEditing = false">取消</text><text class="reservation-page__sheet-title">修改服务项目</text><text class="reservation-page__sheet-space"></text></view><scroll-view scroll-y class="reservation-page__sheet-body"><view class="reservation-page__source-tabs"><view class="reservation-page__source-tab" :class="{ 'reservation-page__source-tab--active': serviceProjectSource == 'card' }" @tap="serviceProjectSource = 'card'"><text>已购买项目</text></view><view class="reservation-page__source-tab" :class="{ 'reservation-page__source-tab--active': serviceProjectSource == 'all' }" @tap="serviceProjectSource = 'all'"><text>全部项目</text></view></view><input class="reservation-page__input" :value="serviceProjectKeyword" placeholder="搜索项目名称" @input="serviceProjectKeyword = $event.detail.value" /><view class="reservation-page__choices"><view v-for="project in visibleServiceProjects()" :key="projectKey(project)" class="reservation-page__choice" :class="{ 'reservation-page__choice--active': serviceProjectSelected(project) }" @tap="toggleServiceProject(project)"><text>{{ project.name }}</text><text class="reservation-page__choice-note">{{ project.source == 'card' ? '已购' : '未购' }}</text></view></view><text v-if="visibleServiceProjects().length == 0" class="reservation-page__helper">没有可选项目</text><text class="reservation-page__field-label">已选项目</text><view class="reservation-page__choices"><view v-for="project in serviceProjectSelection" :key="projectKey(project)" class="reservation-page__choice reservation-page__choice--active" @tap="toggleServiceProject(project)"><text>{{ project.name }}</text><text class="reservation-page__choice-note">点击移除</text></view></view><text v-if="actionError.length > 0" class="reservation-page__action-error">{{ actionError }}</text><view class="reservation-page__submit" @tap="saveServiceProjects"><text>{{ submitting ? '正在保存…' : '保存服务项目' }}</text></view></scroll-view></view>
</template>

<script setup lang="uts">
  import MoheAiEntry from '../../../shared/components/mohe-ai-entry.uvue'
	import { cancelMobileReservation, recalculateMobileReservation, changeMobileReservationServiceDuration, changeMobileReservationServiceProjects, createMobileReservation, endMobileReservationService, openMobileReservationEditor, queryMobileReservationDetail, queryMobileReservationMembers, queryMobileReservationProjectCatalog, queryMobileReservations, startMobileReservationService, updateMobileReservation } from '../../../shared/api/mobile-reservation-client.uts'
	import { mobileHttpResultRequiresMerchantLogin } from '../../../shared/api/mobile-http.uts'
	import { openMerchantBootstrap, openMerchantWorkbench } from '../../../shared/platform/mobile-navigation.uts'
	import { confirmMobileAction, currentMobilePlatform } from '../../../shared/platform/mobile-platform.uts'
	import { clearMerchantRoot, currentMerchantRoot, merchantRequestSession } from '../../../shared/platform/mobile-merchant-session.uts'
	import { ensureMerchantTabAccess } from '../../../shared/platform/merchant-route-guard.uts'
	const records = ref<Array<any>>([]); const loading = ref(false); const loadingMore = ref(false); const message = ref(''); const loginRequired = ref(false)
	const activeFilter = ref('unstarted'); const currentPage = ref(1); const totalRecords = ref(0); const hasMore = ref(false); let listRequestSerial = 0
	const filters = [{ key: 'unstarted', label: '待服务' }, { key: 'serving', label: '服务中' }, { key: 'ended', label: '已结束' }]
	const detailOpen = ref(false); const detailLoading = ref(false); const detail = ref<any>(null); const detailId = ref(0); const submitting = ref(false); const actionError = ref(''); const clockNowMs = ref(Date.now()); let clockTimer : any = null; let linkedRefreshTimer : any = null
	let countdownKey = ''; let previousCountdownSeconds : number | null = null; let autoEndAttemptKey = ''; let playedFiveMinuteKey = ''; let playedFiveSecondKey = ''; let countdownAudio : any = null
	const durationEditing = ref(false); const durationDraft = ref('')
	const editorOpen = ref(false); const editorLoading = ref(false); const editorError = ref(''); const editingReservationId = ref(0); const editingReservationVersion = ref(0)
	const selectedMember = ref<any>(null); const memberPickerOpen = ref(false); const memberKeyword = ref(''); const memberCandidates = ref<Array<any>>([]); const memberLoading = ref(false)
	// 策略取自独立编辑接口，不能由客户端推断固定来源。
	const businessSourceEnabled = ref(true); let sourceChoiceSerial = 0; let memberCatalogSerial = 0
	const businessSources = ref<Array<any>>([]); const selectedBusinessPrimaryId = ref(0); const selectedBusinessSecondaryId = ref(0)
	const projectOptions = ref<Array<any>>([]); const projectSource = ref('card'); const projectKeyword = ref(''); const selectedProjects = ref<Array<any>>([])
	const projectEditing = ref(false); const serviceProjectOptions = ref<Array<any>>([]); const serviceProjectSelection = ref<Array<any>>([]); const serviceProjectSource = ref('card'); const serviceProjectKeyword = ref('')
	const craftsmanOptions = ref<Array<any>>([]); const selectedCraftsmen = ref<Array<any>>([]); const roomOptions = ref<Array<any>>([]); const selectedRoomId = ref(0); const selectedRoomName = ref('')
	const appointmentDate = ref(''); const appointmentStartClock = ref(''); const appointmentEndClock = ref(''); const remark = ref('')
	const platformUsesNativeCanvas = currentMobilePlatform() === 'MP_WEIXIN'
	onShow(() => { startClock(); if (ensureMerchantTabAccess('workbench')) loadReservations() })
	onHide(() => { stopClock() })
	onUnmounted(() => { stopClock() })
	function startClock() : void { stopClock(); clockNowMs.value = Date.now(); clockTimer = setInterval(() => { clockNowMs.value = Date.now(); tickServiceCountdown() }, 1000); linkedRefreshTimer = setInterval(() => { refreshLinkedView() }, 15000) }
	function stopClock() : void { if (clockTimer != null) { clearInterval(clockTimer); clockTimer = null }; if (linkedRefreshTimer != null) { clearInterval(linkedRefreshTimer); linkedRefreshTimer = null }; if (countdownAudio != null) { countdownAudio.stop(); countdownAudio.destroy(); countdownAudio = null } }
	function refreshLinkedView() : void { if (submitting.value || loading.value || loadingMore.value || detailLoading.value || editorOpen.value || editorLoading.value) return; if (detailOpen.value && detailId.value > 0) loadDetail(false); else loadReservations(true) }
	function merchantLoginIsRequired() : boolean { return merchantRequestSession(currentMerchantRoot()) == null }
	function openMerchantLogin() : void { openMerchantBootstrap() }
	// 同账号在 H5 或另一设备重新登录会替换旧会话；本地仍有 root 不代表服务端会话有效。
	// 收到服务端明确的失效码后清除旧凭据并返回登录，避免“重新加载”无限重试。
	function returnToLoginIfSessionExpired(response : any) : boolean { if (!mobileHttpResultRequiresMerchantLogin(response)) return false; clearMerchantRoot(); openMerchantBootstrap(); return true }
	function backToWorkbench() : void { openMerchantWorkbench() }
	// Display saved snapshots only; never feed these lines to service calculations.
	function customServicesSummary(items : any) : string { let parts : Array<string> = []; for (let index = 0; index < items.length; index++) { let item = items[index]; parts.push(String(item.name) + ' × ' + String(item.quantity)) }; return parts.join('、') }
	function payloadOf(response : any) : any { return response != null && response.body != null ? response.body.reservation : null }
	function succeeded(response : any) : boolean { let payload = payloadOf(response); return response != null && response.ok && payload != null && payload.result != null && payload.result.status == 'success' }
	function errorMessage(response : any, fallback : string) : string { let payload = payloadOf(response); return String(response != null && response.message ? response.message : (payload != null && payload.result != null ? payload.result.message : fallback)) }
	// 本页跨日期查询仍由服务端限定当前门店；请求序号防止旧页签或旧分页的晚到响应覆盖当前列表。
	function loadReservations(reset : boolean = true) : void { if (!reset && (loading.value || !hasMore.value || loadingMore.value)) return; let requestedPage = reset ? 1 : currentPage.value + 1; let requestedFilter = activeFilter.value; let requestSerial = ++listRequestSerial; if (reset) { loading.value = true; loadingMore.value = false; message.value = ''; loginRequired.value = false } else loadingMore.value = true; queryMobileReservations({ workflow: 'service', quickFilter: requestedFilter, allDates: true, page: requestedPage, pageSize: 10 }, (response : any) => { if (requestSerial != listRequestSerial || requestedFilter != activeFilter.value) return; loading.value = false; loadingMore.value = false; if (!succeeded(response)) { if (returnToLoginIfSessionExpired(response)) return; loginRequired.value = merchantLoginIsRequired(); message.value = loginRequired.value ? '请先完成商家端登录。' : errorMessage(response, '预约服务列表暂时不可用。'); return }; let view = payloadOf(response).data != null ? payloadOf(response).data.reservation : null; let next = view != null && Array.isArray(view.records) ? view.records : []; records.value = reset ? next : records.value.concat(next); currentPage.value = Number(view != null ? view.page : requestedPage); totalRecords.value = Number(view != null ? view.total : records.value.length); hasMore.value = records.value.length < totalRecords.value }) }
	function changeFilter(filter : string) : void { if (filter == activeFilter.value && records.value.length > 0) return; activeFilter.value = filter; loadReservations(true) }
	function activeFilterLabel() : string { for (let i = 0; i < filters.length; i++) if (filters[i].key == activeFilter.value) return filters[i].label; return '' }
	function loadMoreReservations() : void { loadReservations(false) }
	// 列表接口以 statusCode 传状态码、status 传中文名称；详情接口则以 status 传状态码。两种契约都以权威状态码为准，避免已结束预约被默认标为待服务。
	function statusLabelOf(entity : any) : string { if (entity == null) return ''; let code = String(entity.statusCode || entity.status || ''); if (code == 'IN_SERVICE') return '服务中'; if (code == 'COMPLETED') return '已结束'; if (code == 'UNSTARTED') return '待服务'; if (code == 'PENDING_CONFIRMATION') return '待确认'; let label = String(entity.statusLabel || entity.status || ''); return label.length > 0 ? label : '状态未知' }
	function statusClass(status : any) : string { let text = String(status || ''); return text == '服务中' || text == 'IN_SERVICE' ? 'reservation-page__status--serving' : (text == '已结束' || text == 'COMPLETED' ? 'reservation-page__status--ended' : 'reservation-page__status--unstarted') }
	function openDetail(item : any) : void { detailId.value = Number(item.reservationId || item.id || 0); if (detailId.value <= 0) return; countdownKey = ''; previousCountdownSeconds = null; detailOpen.value = true; detail.value = null; message.value = ''; actionError.value = ''; loadDetail(true) }
	function loadDetail(showLoading : boolean) : void { if (detailId.value <= 0) return; if (showLoading) detailLoading.value = true; queryMobileReservationDetail(detailId.value, (response : any) => { detailLoading.value = false; if (!succeeded(response)) { if (returnToLoginIfSessionExpired(response)) return; if (showLoading) message.value = errorMessage(response, '预约详情暂不可用。'); return }; detail.value = payloadOf(response).data != null && payloadOf(response).data.reservation != null ? payloadOf(response).data.reservation.detail : null }) }
	function closeDetail() : void { detailOpen.value = false; detail.value = null; durationEditing.value = false; projectEditing.value = false; if (countdownAudio != null) { countdownAudio.stop(); countdownAudio.destroy(); countdownAudio = null } }
	// 语音只随服务端配置在手机端播报；同一开始时间与截止时间只播报一次，手动结束不调用这里。
	function playCountdownVoice(path : string) : void {
		try { if (countdownAudio != null) { countdownAudio.stop(); countdownAudio.destroy() }; countdownAudio = uni.createInnerAudioContext(); countdownAudio.src = path; countdownAudio.play() } catch (_) { /* 播放失败不能阻断服务结束事务。 */ }
	}
	// 页面可见时即时提交；服务端定时任务负责页面关闭后的结束，服务端行锁防止多设备重复核销。
	function tickServiceCountdown() : void {
		if (!detailOpen.value || detail.value == null || detailId.value <= 0 || serviceExpectedEndMs(detail.value) <= 0) return
		let key = String(detailId.value) + ':' + String(serviceExpectedEndMs(detail.value))
		if (key != countdownKey) { countdownKey = key; previousCountdownSeconds = null }
		let remaining = serviceRemainingSeconds(detail.value)
		let voiceMode = Number(detail.value.serviceVoiceMode || 1)
		if (voiceMode == 1 || voiceMode == 3) {
			if (remaining <= 300 && remaining > 5 && playedFiveMinuteKey != key && (previousCountdownSeconds == null ? remaining == 300 : previousCountdownSeconds > 300)) { playedFiveMinuteKey = key; playCountdownVoice('/static/audio/reservation-five-minutes.mp3') }
			if (remaining <= 5 && remaining > 0 && playedFiveSecondKey != key && (previousCountdownSeconds == null ? remaining == 5 : previousCountdownSeconds > 5)) { playedFiveSecondKey = key; playCountdownVoice('/static/audio/reservation-time-up.mp3') }
		}
		previousCountdownSeconds = remaining
		if (remaining > 0 || detail.value.autoEndEnabled !== true || submitting.value || autoEndAttemptKey == key) return
		let version = Number(detail.value.reservationVersion || detail.value.revision || 0)
		if (version <= 0) return
		autoEndAttemptKey = key; submitting.value = true
		endMobileReservationService(detailId.value, { command: command('end-reservation-service', version) }, (response : any) => {
			submitting.value = false
			if (succeeded(response)) { closeDetail(); loadReservations(true); return }
			if (returnToLoginIfSessionExpired(response)) return
			// 不盲目重试不确定结果；刷新权威详情，定时任务会继续处理仍到期的单据。
			loadDetail(true)
		})
	}
	function detailProjects() : string { if (detail.value == null || !Array.isArray(detail.value.projects)) return '未选择项目'; let values = new Array<string>(); for (let i = 0; i < detail.value.projects.length; i++) values.push(String(detail.value.projects[i].name || '项目')); return values.join('、') }
	function detailCraftsmen() : string { if (detail.value == null || !Array.isArray(detail.value.plannedCraftsmen) || detail.value.plannedCraftsmen.length == 0) return '待分配手艺人'; let values = new Array<string>(); for (let i = 0; i < detail.value.plannedCraftsmen.length; i++) values.push(String(detail.value.plannedCraftsmen[i].name || '')); return values.join('、') }
	function serviceActions() : Array<any> { let values = new Array<any>(); if (detail.value == null || !Array.isArray(detail.value.actions)) return values; for (let i = 0; i < detail.value.actions.length; i++) { let action = detail.value.actions[i]; if (action.action == 'start-reservation-service' || action.action == 'end-reservation-service') values.push(action) }; return values }
	// 只依据后端当前详情动作与项目列表展示入口；保存仍由预约命令锁定行并复核。
	function canChangeServiceDuration() : boolean { if (detail.value == null || !Array.isArray(detail.value.actions)) return false; for (let i = 0; i < detail.value.actions.length; i++) if (detail.value.actions[i].action == 'change-reservation-service-duration' && detail.value.actions[i].enabled === true) return true; return false }
	// 仅服务中显示；保存以服务端锁定的状态与版本为准，项目变化不调整倒计时。
	function canChangeServiceProjects() : boolean { if (detail.value == null || detail.value.status != 'IN_SERVICE' || !Array.isArray(detail.value.actions)) return false; for (let i = 0; i < detail.value.actions.length; i++) if (detail.value.actions[i].action == 'change-reservation-service-projects' && detail.value.actions[i].enabled === true) return true; return false }
	function serviceProjectKey(project : any) : string { return String(project.source || 'unpaid') + ':' + String(project.projectId || project.id || 0) + ':' + String(project.entitlementSourceDetailId || 0) }
	function serviceProjectSelected(project : any) : boolean { let key = serviceProjectKey(project); for (let i = 0; i < serviceProjectSelection.value.length; i++) if (serviceProjectKey(serviceProjectSelection.value[i]) == key) return true; return false }
	function visibleServiceProjects() : Array<any> { let values = new Array<any>(); let keyword = serviceProjectKeyword.value.trim().toLowerCase(); for (let i = 0; i < serviceProjectOptions.value.length; i++) { let project = serviceProjectOptions.value[i]; if (project.selectable === false || (serviceProjectSource.value == 'card' && project.source != 'card')) continue; if (keyword.length > 0 && String(project.name || '').toLowerCase().indexOf(keyword) < 0) continue; values.push(project) }; return values }
	function toggleServiceProject(project : any) : void { if (project.selectable === false) return; let key = serviceProjectKey(project); let next = new Array<any>(); let found = false; for (let i = 0; i < serviceProjectSelection.value.length; i++) { if (serviceProjectKey(serviceProjectSelection.value[i]) == key) found = true; else next.push(serviceProjectSelection.value[i]) }; if (!found) next.push({ projectId: Number(project.projectId || project.id || 0), skuId: Number(project.skuId || 0), name: String(project.name || ''), source: project.source == 'card' ? 'card' : 'unpaid', entitlementSourceDetailId: Number(project.entitlementSourceDetailId || 0), quantity: Number(project.quantity || 1) }); serviceProjectSelection.value = next }
	function openServiceProjectEditor() : void { if (!canChangeServiceProjects() || submitting.value) return; let memberId = Number(detail.value.member != null ? detail.value.member.id || 0 : 0); if (memberId <= 0) return; actionError.value = ''; serviceProjectSelection.value = Array.isArray(detail.value.projects) ? detail.value.projects.slice() : []; serviceProjectKeyword.value = ''; serviceProjectSource.value = 'card'; serviceProjectOptions.value = []; projectEditing.value = true; queryMobileReservationProjectCatalog(memberId, (response : any) => { if (!projectEditing.value) return; if (!succeeded(response)) { if (returnToLoginIfSessionExpired(response)) return; actionError.value = errorMessage(response, '服务项目暂不可选。'); return }; let catalog = payloadOf(response).data != null ? payloadOf(response).data.reservationProjectCatalog : null; serviceProjectOptions.value = catalog != null && Array.isArray(catalog.catalogOptions) ? catalog.catalogOptions : [] }) }
	function saveServiceProjects() : void { if (!projectEditing.value || !canChangeServiceProjects() || submitting.value || detail.value == null) return; if (serviceProjectSelection.value.length == 0) { actionError.value = '请至少选择一个服务项目。'; return }; let version = Number(detail.value.reservationVersion || 0); if (version <= 0) { actionError.value = '预约已更新，请重新加载详情。'; return }; submitting.value = true; actionError.value = ''; changeMobileReservationServiceProjects(detailId.value, { projects: serviceProjectSelection.value, command: command('change-reservation-service-projects', version) }, (response : any) => { submitting.value = false; if (!succeeded(response)) { if (returnToLoginIfSessionExpired(response)) return; actionError.value = errorMessage(response, '服务项目未保存。'); return }; projectEditing.value = false; loadDetail(true); loadReservations(true) }) }
	// 入口可见；没有预约项目时仅提示补全项目，不打开可保存的时长编辑器。
	function openDurationEditor() : void { if (!canChangeServiceDuration() || submitting.value) return; if (!Array.isArray(detail.value.projects) || detail.value.projects.length == 0) { actionError.value = '请先为预约选择项目，再修改服务时长。'; return }; durationDraft.value = String(detail.value.serviceDurationMinutes || ''); actionError.value = ''; durationEditing.value = true }
	function saveDuration() : void { if (!durationEditing.value || submitting.value || detail.value == null) return; let value = durationDraft.value.trim(); let minutes = Number(value); if (!/^[1-9][0-9]*$/.test(value) || !Number.isFinite(minutes) || minutes > 71582788) { actionError.value = '请输入大于0的整数分钟。'; return }; let version = Number(detail.value.reservationVersion || 0); if (version <= 0) { actionError.value = '预约已更新，请重新加载详情。'; return }; submitting.value = true; changeMobileReservationServiceDuration(detailId.value, { serviceDurationMinutes: minutes, command: command('change-reservation-service-duration', version) }, (response : any) => { submitting.value = false; if (!succeeded(response)) { if (returnToLoginIfSessionExpired(response)) return; actionError.value = errorMessage(response, '服务时长未保存。'); return }; durationEditing.value = false; loadDetail(true); loadReservations(true) }) }
	// 只有权威详情仍处于未开始且给出编辑动作时才展示入口；服务端保存时再次校验状态与门店权限。
	function canEditUnstarted() : boolean { if (detail.value == null || detail.value.status != 'UNSTARTED' || !Array.isArray(detail.value.actions)) return false; for (let i = 0; i < detail.value.actions.length; i++) if (detail.value.actions[i].action == 'edit-reservation' && detail.value.actions[i].enabled === true) return true; return false }
	// 删除只向当前未开始且服务端声明可取消的预约开放；后端按版本及权限再校验并保留取消审计。
	function canDeleteUnstarted() : boolean { if (detail.value == null || detail.value.status != 'UNSTARTED' || !Array.isArray(detail.value.actions)) return false; for (let i = 0; i < detail.value.actions.length; i++) if (detail.value.actions[i].action == 'cancel-reservation' && detail.value.actions[i].enabled === true) return true; return false }
	function resetCreateEditor() : void {
		editorError.value = ''; editingReservationId.value = 0; editingReservationVersion.value = 0; selectedMember.value = null; memberPickerOpen.value = false; memberKeyword.value = ''; memberCandidates.value = []
		businessSourceEnabled.value = true; memberCatalogSerial++; businessSources.value = []; selectedBusinessPrimaryId.value = 0; selectedBusinessSecondaryId.value = 0; projectOptions.value = []; projectSource.value = 'card'; projectKeyword.value = ''; selectedProjects.value = []
		craftsmanOptions.value = []; selectedCraftsmen.value = []; roomOptions.value = []; selectedRoomId.value = 0; selectedRoomName.value = ''; appointmentDate.value = ''; appointmentStartClock.value = ''; appointmentEndClock.value = ''; remark.value = ''
	}
	// 编辑器负责提供当前门店可选资料；新增命令由服务端领域事务锁定资源，不携带工作台对象版本。
	function openCreateEditor() : void {
		if (editorLoading.value || submitting.value) return
		if (merchantLoginIsRequired()) { openMerchantLogin(); return }
		resetCreateEditor(); editorLoading.value = true
		openMobileReservationEditor({ mode: 'create', preparationRequestId: 'mobile-create-' + uuid() }, (response : any) => {
			editorLoading.value = false
			if (!succeeded(response)) { if (returnToLoginIfSessionExpired(response)) return; message.value = errorMessage(response, '预约编辑器暂不可用。'); return }
			let editor = payloadOf(response).data != null ? payloadOf(response).data.editor : null
			if (editor == null || editor.preparationReady !== true) { message.value = '预约编辑器准备不完整，请重新打开。'; return }
			businessSourceEnabled.value = editor.businessSourcePolicy == null || editor.businessSourcePolicy.enabled !== false; businessSources.value = Array.isArray(editor.businessSources) ? editor.businessSources : []
			craftsmanOptions.value = Array.isArray(editor.craftsmenOptions) ? editor.craftsmenOptions : []
			roomOptions.value = Array.isArray(editor.rooms) ? editor.rooms : []
			let draft = editor.draft != null ? editor.draft : {}
			selectedBusinessPrimaryId.value = Number(draft.businessSourcePrimaryId || 0); selectedBusinessSecondaryId.value = Number(draft.businessSourceSecondaryId || 0)
			let start = String(draft.appointmentStartAt || draft.appointmentTime || '').replace('T', ' ')
			let end = String(draft.appointmentEndAt || '').replace('T', ' ')
			appointmentDate.value = String(draft.appointmentDate || start.slice(0, 10))
			appointmentStartClock.value = start.length >= 16 ? start.slice(11, 16) : ''
			appointmentEndClock.value = end.length >= 16 ? end.slice(11, 16) : ''
			editorOpen.value = true
		})
	}
	// 编辑回填只接受服务端当前预约草稿，会员保持只读；预约时段中的时间戳按本地营业时区显示。
	function openEditEditor() : void {
		if (!canEditUnstarted() || detailId.value <= 0 || editorLoading.value || submitting.value) return
		let reservationId = detailId.value
		resetCreateEditor(); editorLoading.value = true; actionError.value = ''
		openMobileReservationEditor({ mode: 'edit', reservationId: reservationId, preparationRequestId: 'mobile-edit-' + uuid() }, (response : any) => {
			editorLoading.value = false
			if (!succeeded(response)) { if (returnToLoginIfSessionExpired(response)) return; actionError.value = errorMessage(response, '预约编辑器暂不可用。'); return }
			let editor = payloadOf(response).data != null ? payloadOf(response).data.editor : null
			if (editor == null || editor.preparationReady !== true || editor.draft == null) { actionError.value = '预约编辑资料不完整，请重新打开。'; return }
			let draft = editor.draft
			let version = Number(draft.reservationVersion || draft.recordVersion || draft.revision || 0)
			if (version <= 0) { actionError.value = '预约资料已过期，请重新打开。'; return }
			editingReservationId.value = reservationId; editingReservationVersion.value = version
			selectedMember.value = draft.member; selectedProjects.value = Array.isArray(draft.projects) ? draft.projects : []
			// 保留已选手艺人的点客标记，保存草稿时不能把服务端回填的人员角色压成纯 ID。
			selectedCraftsmen.value = Array.isArray(draft.craftsmen) ? draft.craftsmen : []
			selectedRoomId.value = Number(draft.roomId || 0); selectedRoomName.value = draft.room != null ? String(draft.room.name || '') : ''
			projectOptions.value = Array.isArray(editor.catalogOptions) ? editor.catalogOptions : []
			craftsmanOptions.value = Array.isArray(editor.craftsmenOptions) ? editor.craftsmenOptions : []
			roomOptions.value = Array.isArray(editor.rooms) ? editor.rooms : []
			businessSourceEnabled.value = editor.businessSourcePolicy == null || editor.businessSourcePolicy.enabled !== false; businessSources.value = Array.isArray(editor.businessSources) ? editor.businessSources : []
			selectedBusinessPrimaryId.value = Number(draft.businessSourcePrimaryId || 0); selectedBusinessSecondaryId.value = Number(draft.businessSourceSecondaryId || 0)
			projectSource.value = 'card'
			for (let i = 0; i < selectedProjects.value.length; i++) if (selectedProjects.value[i].source != 'card') projectSource.value = 'all'
			let start = scheduleParts(draft.appointmentStartAt || draft.appointmentTime || '')
			let end = scheduleParts(draft.appointmentEndAt || '')
			appointmentDate.value = start.date; appointmentStartClock.value = start.clock; appointmentEndClock.value = end.clock
			remark.value = String(draft.remark || ''); editorOpen.value = true; refreshStaffAvailability()
		})
	}
	function scheduleParts(value : any) : any { let text = String(value || '').replace('T', ' '); let numeric = Number(text); if (text.indexOf('-') < 0 && text.indexOf(':') < 0 && !Number.isNaN(numeric) && numeric > 0) { let date = new Date(numeric < 100000000000 ? numeric * 1000 : numeric); return { date: date.getFullYear().toString() + '-' + (date.getMonth() + 1).toString().padStart(2, '0') + '-' + date.getDate().toString().padStart(2, '0'), clock: date.getHours().toString().padStart(2, '0') + ':' + date.getMinutes().toString().padStart(2, '0') } }; return { date: text.slice(0, 10), clock: text.length >= 16 ? text.slice(11, 16) : '' } }
	function closeEditor() : void { if (submitting.value) return; editorOpen.value = false; resetCreateEditor() }
	function openMemberPicker() : void { if (editingReservationId.value > 0) return; memberPickerOpen.value = true; loadMembers() }
	function loadMembers() : void {
		if (memberLoading.value) return
		memberLoading.value = true
		queryMobileReservationMembers({ keyword: memberKeyword.value.trim(), page: 1, limit: 20 }, (response : any) => {
			memberLoading.value = false
			let payload = payloadOf(response); let result = payload != null && payload.data != null ? payload.data.memberCandidates : null
			if (!succeeded(response) || result == null) { if (returnToLoginIfSessionExpired(response)) return; editorError.value = errorMessage(response, '会员列表暂时不可用。'); return }
			memberCandidates.value = Array.isArray(result.records) ? result.records : []
		})
	}
	function selectMember(member : any) : void {
		// 切会员清理未确认来源；请求及手工选择双序号阻止晚到建议覆盖新草稿。
		let changed = selectedMember.value == null || Number(selectedMember.value.memberId || selectedMember.value.id || 0) != Number(member.memberId || member.id || 0)
		let requestSerial = ++memberCatalogSerial; let choiceSerial = sourceChoiceSerial
		if (changed) { selectedBusinessPrimaryId.value = 0; selectedBusinessSecondaryId.value = 0 }
		selectedMember.value = member; memberPickerOpen.value = false; selectedProjects.value = []; projectOptions.value = []; editorError.value = ''; refreshSuggestedEnd()
		queryMobileReservationProjectCatalog(Number(member.memberId || member.id || 0), (response : any) => {
			if (requestSerial != memberCatalogSerial || selectedMember.value == null || Number(selectedMember.value.memberId || selectedMember.value.id || 0) != Number(member.memberId || member.id || 0)) return
			if (!succeeded(response)) { if (returnToLoginIfSessionExpired(response)) return; editorError.value = errorMessage(response, '项目目录暂时不可用。'); return }
			let catalog = payloadOf(response).data != null ? payloadOf(response).data.reservationProjectCatalog : null
			projectOptions.value = catalog != null && Array.isArray(catalog.catalogOptions) ? catalog.catalogOptions : []
			if (changed && choiceSerial == sourceChoiceSerial && selectedBusinessPrimaryId.value == 0 && catalog != null) {
				if (catalog.businessSourcePolicy != null) businessSourceEnabled.value = catalog.businessSourcePolicy.enabled !== false
				let source = catalog.initialBusinessSource != null ? catalog.initialBusinessSource : {}
				selectedBusinessPrimaryId.value = Number(source.primarySourceId || 0); selectedBusinessSecondaryId.value = Number(source.secondarySourceId || 0)
			}
		})
	}
	function businessSourceChildren() : Array<any> { for (let i = 0; i < businessSources.value.length; i++) { let source = businessSources.value[i]; if (Number(source.id) == selectedBusinessPrimaryId.value) return Array.isArray(source.children) ? source.children : [] }; return [] }
	function businessSourceRequiresSecondary() : boolean { for (let i = 0; i < businessSources.value.length; i++) { let source = businessSources.value[i]; if (Number(source.id) == selectedBusinessPrimaryId.value) return Number(source.requireSecondary || 0) == 1 }; return false }
	function chooseBusinessPrimary(source : any) : void { sourceChoiceSerial++; selectedBusinessPrimaryId.value = Number(source.id || 0); selectedBusinessSecondaryId.value = 0 }
	function chooseBusinessSecondary(source : any) : void { sourceChoiceSerial++; selectedBusinessSecondaryId.value = source == null ? 0 : Number(source.id || 0) }
	function changeAppointmentDate(value : any) : void { appointmentDate.value = String(value || '').slice(0, 10); refreshSuggestedEnd() }
	function changeAppointmentStart(value : any) : void { appointmentStartClock.value = String(value || '').slice(0, 5); refreshSuggestedEnd() }
	function changeAppointmentEnd(value : any) : void { appointmentEndClock.value = String(value || '').slice(0, 5); refreshStaffAvailability() }
	// 项目切换时给出同日结束时间建议；跨日时要求用户调整时段，最终时长仍由 V3 服务端校验。
	function refreshSuggestedEnd() : void {
		let start = appointmentStartAt()
		if (start.length == 0) return
		let minutes = 0
		for (let i = 0; i < selectedProjects.value.length; i++) minutes += Number(selectedProjects.value[i].appliedDurationMinutes || selectedProjects.value[i].serviceDurationMinutes || 60) * Number(selectedProjects.value[i].quantity || 1)
		let end = new Date(new Date(start.replace(' ', 'T')).getTime() + (minutes > 0 ? minutes : 60) * 60000)
		let date = end.getFullYear().toString() + '-' + (end.getMonth() + 1).toString().padStart(2, '0') + '-' + end.getDate().toString().padStart(2, '0')
		appointmentEndClock.value = date == appointmentDate.value ? end.getHours().toString().padStart(2, '0') + ':' + end.getMinutes().toString().padStart(2, '0') : ''
		refreshStaffAvailability()
	}
	// 三端读取同一个后端投影。序号只丢弃晚到的界面响应，不参与业务保存。
	let staffAvailabilitySerial = 0
	function refreshStaffAvailability() : void {
		let serial = ++staffAvailabilitySerial
		if (!editorOpen.value || appointmentStartAt().length == 0 || appointmentEndAt().length == 0 || appointmentEndClock.value <= appointmentStartClock.value) return
		recalculateMobileReservation({ reservationId: editingReservationId.value, reservation: reservationDraft(), recalculationRequestId: 'staff-availability-' + serial.toString() + '-' + Date.now().toString() }, (response : any) => {
			if (serial != staffAvailabilitySerial || !editorOpen.value) return
			let payload = payloadOf(response); let plan = payload != null && payload.data != null ? payload.data.reservationPlan : null
			if (!succeeded(response) || plan == null) { editorError.value = errorMessage(response, '人员时段暂未核对。'); return }
			if (Array.isArray(plan.craftsmenOptions)) craftsmanOptions.value = plan.craftsmenOptions
		})
	}
	function projectKey(project : any) : string { return String(project.source || 'unpaid') + ':' + String(project.projectId || project.id || 0) + ':' + String(project.skuId || 0) + ':' + String(project.entitlementSourceDetailId || 0) }
	function visibleProjects() : Array<any> { let values = new Array<any>(); let keyword = projectKeyword.value.trim().toLowerCase(); for (let i = 0; i < projectOptions.value.length; i++) { let project = projectOptions.value[i]; if (project.selectable === false || (projectSource.value == 'card' && project.source != 'card')) continue; if (keyword.length > 0 && String(project.name || '').toLowerCase().indexOf(keyword) < 0) continue; values.push(project) }; return values }
	function selectedProject(project : any) : boolean { let key = projectKey(project); for (let i = 0; i < selectedProjects.value.length; i++) if (projectKey(selectedProjects.value[i]) == key) return true; return false }
	function toggleProject(project : any) : void { if (project.selectable === false) return; let key = projectKey(project); let next = new Array<any>(); let found = false; for (let i = 0; i < selectedProjects.value.length; i++) { if (projectKey(selectedProjects.value[i]) == key) found = true; else next.push(selectedProjects.value[i]) }; if (!found) next.push({ projectId: Number(project.projectId || project.id || 0), skuId: Number(project.skuId || 0), name: project.name, source: project.source == 'card' ? 'card' : 'unpaid', entitlementSourceDetailId: Number(project.entitlementSourceDetailId || 0), quantity: 1, appliedDurationMinutes: Number(project.appliedDurationMinutes || project.serviceDurationMinutes || 60) }); selectedProjects.value = next; refreshSuggestedEnd() }
	function craftsmanId(value : any) : number { return Number(value != null && typeof value == 'object' ? (value.staffId || value.id || 0) : value) }
	function selectedCraftsman(staff : any) : boolean { let id = craftsmanId(staff); for (let i = 0; i < selectedCraftsmen.value.length; i++) if (craftsmanId(selectedCraftsmen.value[i]) == id) return true; return false }
	function toggleCraftsman(staff : any) : void { if (staff.selectable === false) return; let id = craftsmanId(staff); let next = new Array<any>(); let found = false; for (let i = 0; i < selectedCraftsmen.value.length; i++) { if (craftsmanId(selectedCraftsmen.value[i]) == id) found = true; else next.push(selectedCraftsmen.value[i]) }; if (!found) next.push({ id: id, staffId: id, name: String(staff.name || staff.staffName || '') }); selectedCraftsmen.value = next }
	function chooseRoom(room : any) : void { if (room != null && room.selectable === false) return; selectedRoomId.value = room == null ? 0 : Number(room.id || room.roomId || 0); selectedRoomName.value = room == null ? '' : String(room.name || room.label || '') }
	function appointmentStartAt() : string { return appointmentDate.value && appointmentStartClock.value ? appointmentDate.value + ' ' + appointmentStartClock.value : '' }
	function appointmentEndAt() : string { return appointmentDate.value && appointmentEndClock.value ? appointmentDate.value + ' ' + appointmentEndClock.value : '' }
	function reservationDraft() : any { return { memberId: selectedMember.value != null ? Number(selectedMember.value.memberId || selectedMember.value.id || 0) : 0, member: selectedMember.value, projects: selectedProjects.value, craftsmen: selectedCraftsmen.value, roomId: selectedRoomId.value, roomName: selectedRoomName.value, businessSourcePrimaryId: selectedBusinessPrimaryId.value, businessSourceSecondaryId: selectedBusinessSecondaryId.value, appointmentTime: appointmentStartAt(), appointmentStartAt: appointmentStartAt(), appointmentEndAt: appointmentEndAt(), remark: remark.value.trim() } }
	function submitReservation() : void {
		if (submitting.value) return
		if (selectedMember.value == null || appointmentStartAt().length == 0 || appointmentEndAt().length == 0) { editorError.value = '请选择会员、预约日期、开始时间和结束时间。'; return }
		if (businessSourceEnabled.value && (selectedBusinessPrimaryId.value <= 0 || (businessSourceRequiresSecondary() && selectedBusinessSecondaryId.value <= 0))) { editorError.value = '请选择客户来源。'; return }
		if (appointmentEndClock.value <= appointmentStartClock.value) { editorError.value = '结束时间必须在预约当日且晚于开始时间。'; return }
		// 资料保存命令只携带草稿版本，不伪造工作台资源；服务端事务重查状态、版本、来源和资源占用。
		submitting.value = true; editorError.value = ''
		let editingId = editingReservationId.value
		let draft = reservationDraft()
		if (editingId > 0) draft.reservationVersion = editingReservationVersion.value
		let payload = { reservation: draft, command: { action: editingId > 0 ? 'update-reservation' : 'create-reservation', idempotencyKey: 'RESERVATION-' + uuid(), contexts: [] } }
		let done = (response : any) => {
			submitting.value = false
			if (!succeeded(response)) { if (returnToLoginIfSessionExpired(response)) return; editorError.value = errorMessage(response, '预约保存失败。'); return }
			editorOpen.value = false; resetCreateEditor(); activeFilter.value = 'unstarted'; loadReservations(true)
			if (editingId > 0 && detailOpen.value) loadDetail(true)
		}
		if (editingId > 0) updateMobileReservation(editingId, payload, done); else createMobileReservation(payload, done)
	}
	function uuid() : string { let text = ''; let chars = '0123456789abcdef'; for (let i = 0; i < 32; i++) { if (i == 8 || i == 12 || i == 16 || i == 20) text += '-'; let n = Math.floor(Math.random() * 16); if (i == 12) n = 4; if (i == 16) n = (n & 3) | 8; text += chars.charAt(n) }; return text }
	function command(action : string, version : number) : any { let contexts = new Array<any>(); if (detailId.value > 0 && version > 0) contexts.push({ kind: 'reservation', id: detailId.value.toString(), expectedVersion: version }); return { action: action, idempotencyKey: 'RESERVATION-' + uuid(), contexts: contexts } }
	// 确认后只提交逻辑取消；成功关闭详情并重查列表，失败保留详情供用户查看服务端原因。
	function deleteUnstartedReservation() : void {
		if (!canDeleteUnstarted() || detailId.value <= 0 || submitting.value) return
		actionError.value = ''
		let reservationId = detailId.value
		let version = Number(detail.value.reservationVersion || detail.value.revision || 0)
		if (version <= 0) { actionError.value = '预约资料已过期，请关闭后重新打开。'; return }
		confirmMobileAction('删除预约', '删除后预约将取消，已占用的权益和资源会释放，操作记录仍会保留。确定删除吗？', (confirmed : boolean) => {
			if (!confirmed || !canDeleteUnstarted() || detailId.value != reservationId) return
			submitting.value = true
			cancelMobileReservation(reservationId, { command: command('cancel-reservation', version) }, (response : any) => {
				submitting.value = false
				if (!succeeded(response)) { if (returnToLoginIfSessionExpired(response)) return; actionError.value = errorMessage(response, '预约删除失败。'); return }
				closeDetail(); loadReservations(true)
			})
		})
	}
	function startServiceMissingFields() : Array<string> { let missing = new Array<string>(); if (detail.value == null || !Array.isArray(detail.value.projects) || detail.value.projects.length == 0) missing.push('项目'); if (detail.value == null || !Array.isArray(detail.value.plannedCraftsmen) || detail.value.plannedCraftsmen.length == 0) missing.push('手艺人'); return missing }
	function runAction(action : string) : void { if (detail.value == null || detailId.value <= 0 || submitting.value) return; actionError.value = ''; let version = Number(detail.value.reservationVersion || detail.value.revision || 0); if (version <= 0) { actionError.value = '预约资料已过期，请关闭后重新打开。'; return }; if (action == 'start-reservation-service') { let missing = startServiceMissingFields(); if (missing.length > 0) { actionError.value = '开始服务前请先补充' + missing.join('、') + '；房间可不选。'; return } }; let title = action == 'start-reservation-service' ? '开始服务' : '结束服务'; let copy = action == 'start-reservation-service' ? '确认已到店并开始服务吗？倒计时将从实际开始时间计算。' : '确认已完成本次服务吗？'; confirmMobileAction(title, copy, (confirmed : boolean) => { if (!confirmed) return; if (action == 'end-reservation-service' && countdownAudio != null) { countdownAudio.stop(); countdownAudio.destroy(); countdownAudio = null }; submitting.value = true; let payload = { command: command(action, version) }; let done = (response : any) => { submitting.value = false; if (!succeeded(response)) { if (returnToLoginIfSessionExpired(response)) return; actionError.value = errorMessage(response, '预约服务操作未完成。'); return }; detailOpen.value = false; loadReservations() }; if (action == 'start-reservation-service') startMobileReservationService(detailId.value, payload, done); else if (action == 'end-reservation-service') endMobileReservationService(detailId.value, payload, done) }) }
	function timingOf(entity : any) : any { if (entity == null) return null; if (entity.serviceTiming != null) return entity.serviceTiming; if (entity.serviceTimer != null) return entity.serviceTimer; return entity }
	function timeValue(value : any) : number { let text = String(value || ''); if (text.length == 0) return 0; let numeric = Number(value); if (text.indexOf('-') < 0 && text.indexOf(':') < 0 && !Number.isNaN(numeric) && numeric > 0) return numeric < 100000000000 ? numeric * 1000 : numeric; let parsed = new Date(text.replace(' ', 'T')).getTime(); return Number.isNaN(parsed) ? 0 : parsed }
	// 计时只属于服务中的预约；已结束即使保留计划结束时间和实际开始快照，也不继续展示倒计时。
	function serviceExpectedEndMs(entity : any) : number { if (entity == null) return 0; let status = String(entity.statusCode || entity.status || ''); if ((status != 'IN_SERVICE' && status != '服务中') || timeValue(entity.actualServiceEndedAt || entity.actualEndAt) > 0) return 0; let timing = timingOf(entity); if (timing == null) return 0; let expected = timeValue(timing.serviceCountdownEndsAt || timing.expectedEndAt || timing.expectedFinishAt || timing.serviceExpectedEndAt); if (expected > 0) return expected; let started = timeValue(timing.actualServiceStartedAt || timing.actualStartedAt || timing.actualStartAt || timing.serviceStartedAt); let durationSeconds = Number(timing.totalDurationSeconds || timing.durationSeconds || 0); if (durationSeconds <= 0) durationSeconds = Number(timing.totalDurationMinutes || timing.durationMinutes || timing.plannedDurationMinutes || 0) * 60; return started > 0 && durationSeconds > 0 ? started + durationSeconds * 1000 : 0 }
	function serviceRemainingSeconds(entity : any) : number { let endMs = serviceExpectedEndMs(entity); return endMs > 0 ? Math.floor((endMs - clockNowMs.value) / 1000) : 0 }
	function serviceIsOvertime(entity : any) : boolean { return serviceExpectedEndMs(entity) > 0 && serviceRemainingSeconds(entity) < 0 }
	function twoDigits(value : number) : string { return value < 10 ? '0' + value.toString() : value.toString() }
	function serviceCountdownLabel(entity : any) : string { let endMs = serviceExpectedEndMs(entity); if (endMs <= 0) return ''; let remaining = serviceRemainingSeconds(entity); let overtime = remaining < 0; let total = Math.abs(remaining); let hours = Math.floor(total / 3600); let minutes = Math.floor((total % 3600) / 60); let seconds = total % 60; return (overtime ? '已超时 ' : '剩余 ') + twoDigits(hours) + ':' + twoDigits(minutes) + ':' + twoDigits(seconds) }
</script>

<style>
	.reservation-page { display: flex; min-height: 100%; flex: 1; flex-direction: column; background-color: #f3f6f8; color: #294055; }.reservation-page__header { padding: 50px 18px 14px; background-color: #ffffff; }.reservation-page__header-row { display: flex; flex-direction: row; align-items: center; justify-content: space-between; }.reservation-page__back { width: 50px; height: 32px; font-size: 34px; line-height: 28px; color: #526a7e; }.reservation-page__title { font-size: 20px; font-weight: 700; line-height: 30px; }.reservation-page__header-space { width: 50px; height: 32px; }
	.reservation-page__filters { display: flex; flex-direction: row; margin: 10px 18px; border-radius: 6px; background-color: #ffffff; }.reservation-page__filter { display: flex; height: 40px; flex: 1; align-items: center; justify-content: center; border-bottom-width: 2px; border-bottom-style: solid; border-bottom-color: transparent; font-size: 13px; color: #6c7d8e; }.reservation-page__filter--active { border-bottom-color: #2e6fb7; font-weight: 700; color: #2e6fb7; }
	.reservation-page__list { min-height: 0; flex: 1; padding: 0 18px 30px; }.reservation-page__card, .reservation-page__detail-card { display: flex; flex-direction: column; margin-bottom: 10px; padding: 14px; border-radius: 6px; background-color: #ffffff; box-shadow: 0 2px 8px rgba(33, 55, 75, 0.05); }.reservation-page__card-head { display: flex; flex-direction: row; align-items: flex-start; justify-content: space-between; }.reservation-page__member { font-size: 16px; font-weight: 700; line-height: 23px; color: #294055; }.reservation-page__phone { margin-left: 7px; font-size: 12px; line-height: 20px; color: #91a0ad; }.reservation-page__status { padding: 1px 7px; border-radius: 3px; font-size: 12px; line-height: 19px; }.reservation-page__status--unstarted { background-color: #eaf1fb; color: #2e6fb7; }.reservation-page__status--serving { background-color: #e8f6ef; color: #258152; }.reservation-page__status--ended { background-color: #eff2f5; color: #7a8996; }.reservation-page__time { margin-top: 10px; font-size: 14px; font-weight: 600; line-height: 21px; color: #435a70; }.reservation-page__copy { margin-top: 4px; font-size: 13px; line-height: 20px; color: #788897; }.reservation-page__countdown { margin-top: 9px; font-size: 14px; font-weight: 700; line-height: 21px; color: #258152; }.reservation-page__countdown--overtime { color: #bf5d5d; }.reservation-page__detail-link { margin-top: 9px; font-size: 12px; font-weight: 700; line-height: 18px; color: #2e6fb7; }.reservation-page__document { margin-top: 10px; font-size: 11px; line-height: 17px; color: #97a5b2; }
	.reservation-page__duration-row { display: flex; flex-direction: row; gap: 8px; margin-bottom: 10px; }.reservation-page__duration-row > .reservation-page__action { box-sizing: border-box; min-width: 0; min-height: 48px; height: 48px; flex: 1; }.reservation-page__duration-editor { padding: 12px; border-radius: 5px; background-color: #ffffff; }.reservation-page__duration-input { height: 38px; margin-top: 8px; padding: 0 8px; border: 1px solid #cbd6e2; }.reservation-page__duration-buttons { display: flex; flex-direction: row; gap: 8px; margin-top: 10px; }
	.reservation-page__timer { display: flex; flex-direction: column; margin-top: 13px; padding: 12px; border-radius: 5px; background-color: #f2f8f5; }.reservation-page__timer-caption { font-size: 12px; line-height: 18px; color: #6e8078; }.reservation-page__timer-value { margin-top: 3px; font-size: 24px; font-weight: 700; line-height: 32px; color: #258152; }.reservation-page__timer-value--overtime { color: #bf5d5d; }.reservation-page__timer-note { margin-top: 4px; font-size: 11px; line-height: 17px; color: #82918b; }
	.reservation-page__notice, .reservation-page__empty { display: flex; flex-direction: column; margin: 16px 18px; padding: 16px; border-radius: 6px; background-color: #ffffff; font-size: 14px; line-height: 22px; color: #607386; }.reservation-page__empty { align-items: center; margin: 0; color: #8392a0; }.reservation-page__notice-action { display: flex; align-self: flex-start; min-height: 30px; flex-direction: row; align-items: center; margin-top: 9px; padding: 0 10px; border-radius: 4px; background-color: #eef4fb; font-size: 12px; color: #2e6fb7; }.reservation-page__list-footer { display: block; padding: 12px 0 18px; text-align: center; font-size: 11px; color: #98a5af; }
	.reservation-page__overlay { position: fixed; z-index: 50; top: 0; right: 0; bottom: 0; left: 0; display: flex; flex-direction: column; background-color: #f3f6f8; }.reservation-page__editor-overlay { z-index: 60; }.reservation-page__sheet-header { display: flex; flex-direction: row; align-items: center; justify-content: space-between; padding: 48px 18px 14px; background-color: #ffffff; }.reservation-page__sheet-cancel, .reservation-page__sheet-space { width: 48px; font-size: 14px; line-height: 22px; color: #5f7488; }.reservation-page__sheet-title { font-size: 18px; font-weight: 700; line-height: 26px; color: #294055; }.reservation-page__sheet-body { min-height: 0; flex: 1; padding: 16px 18px 30px; }.reservation-page__action-error { display: block; margin: 0 0 10px; padding: 9px 11px; border-radius: 4px; background-color: #fff2f2; font-size: 12px; line-height: 18px; color: #b95151; }.reservation-page__action-row { display: flex; flex-direction: row; margin-bottom: 14px; }.reservation-page__action { display: flex; height: 42px; flex: 1; flex-direction: row; align-items: center; justify-content: center; border-radius: 4px; font-size: 14px; font-weight: 700; }.reservation-page__action--primary { background-color: #2e6fb7; color: #ffffff; }.reservation-page__action--with-peer { margin-right: 8px; }.reservation-page__action--secondary { border-width: 1px; border-style: solid; border-color: #2e6fb7; background-color: #ffffff; color: #2e6fb7; } .reservation-page__action--delete { border-width: 1px; border-style: solid; border-color: #c65b5b; background-color: #ffffff; color: #b95151; }.reservation-page__timeline { padding: 13px 14px; border-radius: 6px; background-color: #ffffff; }.reservation-page__section-label { font-size: 14px; font-weight: 700; line-height: 21px; color: #435a70; }.reservation-page__timeline-row { display: flex; flex-direction: row; justify-content: space-between; padding: 10px 0; border-bottom-width: 1px; border-bottom-style: solid; border-bottom-color: #edf1f4; font-size: 12px; line-height: 18px; color: #798b99; }
	.reservation-page--native-mini .reservation-page__header { padding-top: 84px; }.reservation-page--native-mini .reservation-page__sheet-header { padding-top: 84px; }
	.reservation-page__floating-create { position: fixed; z-index: 20; right: 18px; bottom: calc(22px + env(safe-area-inset-bottom)); display: flex; width: 56px; height: 56px; flex-direction: row; align-items: center; justify-content: center; border-radius: 28px; background-color: #2e6fb7; box-shadow: 0 10px 24px rgba(46, 111, 183, 0.28); font-size: 34px; font-weight: 300; line-height: 52px; color: #ffffff; }
	.reservation-page__field-label { display: block; margin-top: 17px; font-size: 13px; font-weight: 700; line-height: 20px; color: #435a70; }.reservation-page__select, .reservation-page__input { box-sizing: border-box; display: flex; width: 100%; min-height: 42px; flex-direction: row; align-items: center; justify-content: space-between; margin-top: 7px; padding: 0 11px; border-width: 1px; border-style: solid; border-color: #d6e0e8; border-radius: 4px; background-color: #ffffff; font-size: 14px; color: #435a70; }.reservation-page__select--locked { background-color: #f4f6f8; color: #6f8292; }.reservation-page__picker { margin-top: 7px; padding: 10px; border-radius: 4px; background-color: #ffffff; }.reservation-page__picker .reservation-page__input { margin-top: 0; }.reservation-page__inline-button { display: flex; align-self: flex-start; min-height: 30px; flex-direction: row; align-items: center; margin-top: 8px; padding: 0 10px; border-radius: 4px; background-color: #eef4fb; font-size: 12px; color: #2e6fb7; }.reservation-page__picker-option { padding: 10px 0; border-bottom-width: 1px; border-bottom-style: solid; border-bottom-color: #edf1f4; font-size: 13px; color: #50687d; }
	.reservation-page__choices { display: flex; flex-wrap: wrap; flex-direction: row; margin-top: 8px; }.reservation-page__choice { display: flex; min-height: 34px; flex-direction: row; align-items: center; margin-right: 7px; margin-bottom: 7px; padding: 0 9px; border-width: 1px; border-style: solid; border-color: #d6e0e8; border-radius: 4px; background-color: #ffffff; font-size: 12px; color: #586f82; }.reservation-page__choice--active { border-color: #2e6fb7; background-color: #e7f0fb; color: #2e6fb7; }.reservation-page__choice--disabled { border-color: #e2e7eb; background-color: #f4f6f8; color: #a0acb5; }.reservation-page__choice-note { margin-left: 4px; font-size: 10px; color: #90a0ad; }.reservation-page__helper { display: block; margin-top: 7px; font-size: 12px; line-height: 18px; color: #8493a1; }.reservation-page__source-tabs, .reservation-page__datetime { display: flex; flex-direction: row; margin-top: 7px; }.reservation-page__source-tab { display: flex; height: 34px; flex: 1; flex-direction: row; align-items: center; justify-content: center; margin-right: 8px; border-radius: 4px; background-color: #eaf0f5; font-size: 12px; color: #667b8e; }.reservation-page__source-tab:last-child { margin-right: 0; }.reservation-page__source-tab--active { background-color: #e7f0fb; font-weight: 700; color: #2e6fb7; }.reservation-page__datetime picker { flex: 1; margin-right: 8px; }.reservation-page__datetime picker:last-child { margin-right: 0; }.reservation-page__datetime .reservation-page__select { margin-top: 0; }
	.reservation-page__textarea { box-sizing: border-box; width: 100%; height: 88px; margin-top: 7px; padding: 10px; border-width: 1px; border-style: solid; border-color: #d6e0e8; border-radius: 4px; background-color: #ffffff; font-size: 14px; color: #435a70; }.reservation-page__submit { display: flex; height: 44px; flex-direction: row; align-items: center; justify-content: center; margin: 22px 0 20px; border-radius: 4px; background-color: #2e6fb7; font-size: 15px; font-weight: 700; color: #ffffff; }
</style>
