<template>
	<view class="reservation-page">
		<view class="reservation-page__header">
			<view class="reservation-page__header-row"><text class="reservation-page__back" @tap="backToWorkbench">‹</text><text class="reservation-page__title">预约管理</text><view class="reservation-page__create" @tap="openCreateEditor"><text>新增</text></view></view>
			<text class="reservation-page__subtitle">仅展示收银 V3 预约单</text><text class="reservation-page__sync-note">预约数据与门店端实时同步</text>
			<picker v-if="storeContexts.length > 1" mode="selector" :range="storeLabels" :value="activeStoreIndex" @change="selectStore"><view class="reservation-page__store reservation-page__store--switchable"><view class="reservation-page__store-copy"><text class="reservation-page__store-label">当前门店</text><text class="reservation-page__store-name">{{ activeStoreLabel }}</text></view><text class="reservation-page__store-action">{{ switchingStore ? '切换中' : '切换' }}</text></view></picker>
			<view v-else class="reservation-page__store"><view class="reservation-page__store-copy"><text class="reservation-page__store-label">当前门店</text><text class="reservation-page__store-name">{{ activeStoreLabel }}</text></view></view>
		</view>
		<view v-if="storeSwitchMessage.length > 0" class="reservation-page__store-error" role="alert"><text>{{ storeSwitchMessage }}</text></view>
		<view class="reservation-page__metrics"><view><text class="reservation-page__metric-number">{{ unstartedCount }}</text><text>未开始</text></view><view><text class="reservation-page__metric-number">{{ servingCount }}</text><text>服务中</text></view><view><text class="reservation-page__metric-number">{{ endedCount }}</text><text>已结束</text></view></view>
		<view class="reservation-page__filters"><view v-for="filter in filters" :key="filter.key" class="reservation-page__filter" :class="{ 'reservation-page__filter--active': activeFilter == filter.key }" @tap="changeFilter(filter.key)"><text>{{ filter.label }}</text></view></view>
		<view v-if="loading" class="reservation-page__notice"><text>正在读取预约…</text></view>
		<view v-else-if="message.length > 0" class="reservation-page__notice"><text>{{ message }}</text><view class="reservation-page__notice-action" @tap="loginRequired ? openMerchantLogin() : loadReservations()"><text>{{ loginRequired ? '前往登录' : '重新加载' }}</text></view></view>
		<scroll-view v-else scroll-y class="reservation-page__list" @scrolltolower="loadMoreReservations">
			<view v-if="records.length == 0" class="reservation-page__empty"><text>暂无预约</text><text>新预约会显示在这里</text></view>
			<view v-for="item in records" :key="item.reservationId" class="reservation-page__card" @tap="openDetail(item)"><view class="reservation-page__card-head"><view><text class="reservation-page__member">{{ item.memberName || '未命名会员' }}</text><text class="reservation-page__phone">{{ item.phone }}</text></view><text class="reservation-page__status" :class="statusClass(item.status)">{{ item.status }}</text></view><text class="reservation-page__time">{{ item.appointmentTime || '时间待定' }}</text><text class="reservation-page__copy">{{ item.projectSummary || '未选择项目' }}</text><text class="reservation-page__copy">{{ item.craftsmanSummary }}{{ item.roomName ? ' · ' + item.roomName : '' }}</text><text class="reservation-page__detail-link">查看详情 ›</text></view>
			<text v-if="records.length > 0" class="reservation-page__list-footer">{{ loadingMore ? '正在加载更多…' : ('已显示 ' + records.length + ' / ' + totalRecords + ' 条') }}</text>
		</scroll-view>

		<view v-if="detailOpen" class="reservation-page__overlay"><view class="reservation-page__sheet-header"><text class="reservation-page__sheet-cancel" @tap="closeDetail">关闭</text><text class="reservation-page__sheet-title">预约详情</text><text class="reservation-page__sheet-space"></text></view><scroll-view scroll-y class="reservation-page__sheet-body"><view v-if="detailLoading" class="reservation-page__notice"><text>正在读取详情…</text></view><view v-else-if="detail == null" class="reservation-page__notice"><text>{{ message || '预约详情暂不可用。' }}</text></view><view v-else><view class="reservation-page__detail-card"><view class="reservation-page__card-head"><text class="reservation-page__member">{{ detail.member != null ? detail.member.name : '' }}</text><text class="reservation-page__status" :class="statusClass(detail.statusLabel)">{{ detail.statusLabel }}</text></view><text class="reservation-page__time">{{ detail.appointmentStartAt || '时间待定' }}{{ detail.appointmentEndAt ? ' 至 ' + detail.appointmentEndAt : '' }}</text><text class="reservation-page__copy">{{ detailProjects() }}</text><text class="reservation-page__copy">{{ detailCraftsmen() }}{{ detail.room != null && detail.room.name ? ' · ' + detail.room.name : '' }}</text><text v-if="detail.remark" class="reservation-page__copy">备注：{{ detail.remark }}</text><text class="reservation-page__document">预约单 {{ detail.reservationNo }}</text></view><view v-if="detailActions().length > 0" class="reservation-page__action-row"><view v-for="action in detailActions()" :key="action.action" class="reservation-page__action" :class="{ 'reservation-page__action--primary': action.action == 'start-reservation-service' || action.action == 'end-reservation-service', 'reservation-page__action--danger': action.action == 'cancel-reservation' }" @tap="runAction(action.action)"><text>{{ action.label }}</text></view></view><view class="reservation-page__timeline"><text class="reservation-page__section-label">操作记录</text><view v-for="entry in detail.timeline" :key="entry.id" class="reservation-page__timeline-row"><text>{{ entry.title }}</text><text>{{ entry.occurredAt }}</text></view></view></view></scroll-view></view>
		<view v-if="editorOpen" class="reservation-page__overlay"><view class="reservation-page__sheet-header"><text class="reservation-page__sheet-cancel" @tap="closeEditor">取消</text><text class="reservation-page__sheet-title">{{ editingReservationId > 0 ? '编辑预约' : '新建预约' }}</text><text class="reservation-page__sheet-space"></text></view><scroll-view scroll-y class="reservation-page__sheet-body"><text class="reservation-page__field-label">会员</text><view class="reservation-page__select" :class="{ 'reservation-page__select--locked': editingReservationId > 0 }" @tap="openMemberPicker"><text>{{ selectedMember == null ? '选择会员' : selectedMember.name + (selectedMember.phone ? ' · ' + selectedMember.phone : '') }}</text><text v-if="editingReservationId == 0">›</text></view><view v-if="memberPickerOpen" class="reservation-page__picker"><input class="reservation-page__input" :value="memberKeyword" placeholder="搜索会员姓名或手机号" @input="memberKeyword = $event.detail.value" /><view class="reservation-page__inline-button" @tap="loadMembers"><text>{{ memberLoading ? '查询中' : '查询' }}</text></view><view v-for="member in memberCandidates" :key="member.memberId" class="reservation-page__picker-option" @tap="selectMember(member)"><text>{{ member.name }}{{ member.phone ? ' · ' + member.phone : '' }}</text></view></view>
				<text class="reservation-page__field-label">预约项目</text><view class="reservation-page__source-tabs"><view class="reservation-page__source-tab" :class="{ 'reservation-page__source-tab--active': projectSource == 'card' }" @tap="projectSource = 'card'"><text>已购买项目</text></view><view class="reservation-page__source-tab" :class="{ 'reservation-page__source-tab--active': projectSource == 'all' }" @tap="projectSource = 'all'"><text>全部项目</text></view></view><input class="reservation-page__input" :value="projectKeyword" placeholder="搜索项目名称" @input="projectKeyword = $event.detail.value" /><scroll-view v-if="projectCategories().length > 1" scroll-x class="reservation-page__category-row"><view class="reservation-page__category" :class="{ 'reservation-page__category--active': projectCategory == '' }" @tap="projectCategory = ''"><text>全部</text></view><view v-for="category in projectCategories()" :key="category" class="reservation-page__category" :class="{ 'reservation-page__category--active': projectCategory == category }" @tap="projectCategory = category"><text>{{ category }}</text></view></scroll-view><view v-if="selectedMember != null" class="reservation-page__choices"><template v-for="project in projectOptions" :key="projectKey(project)"><view v-if="projectVisible(project)" class="reservation-page__choice" :class="{ 'reservation-page__choice--active': selectedProject(project) }" @tap="toggleProject(project)"><text>{{ project.name }}</text><text class="reservation-page__choice-note">{{ project.source == 'card' ? '已购' : '未购' }}</text></view></template><text v-if="visibleProjectCount() == 0" class="reservation-page__helper">{{ projectSource == 'card' ? '暂无可选择的已购买项目，可切换全部项目。' : '没有符合条件的项目。' }}</text></view><text v-else class="reservation-page__helper">请先选择会员后加载项目。</text><text v-if="selectedProjects.length > 0" class="reservation-page__helper">已选 {{ selectedProjects.length }} 项 · {{ estimatedEndLabel() }}</text>
				<text class="reservation-page__field-label">预约时间（可选）</text><view class="reservation-page__datetime"><picker mode="date" :value="appointmentDate" @change="appointmentDate = $event.detail.value"><view class="reservation-page__select"><text>{{ appointmentDate || '选择日期' }}</text><text>›</text></view></picker><picker mode="time" :value="appointmentClock" @change="appointmentClock = $event.detail.value"><view class="reservation-page__select"><text>{{ appointmentClock || '选择时间' }}</text><text>›</text></view></picker></view><text v-if="appointmentDate && appointmentClock" class="reservation-page__helper">{{ estimatedEndLabel() }}</text>
				<text class="reservation-page__field-label">手艺人（可选）</text><view class="reservation-page__choices"><view v-for="staff in craftsmanOptions" :key="staff.staffId" class="reservation-page__choice" :class="{ 'reservation-page__choice--active': selectedCraftsman(staff) }" @tap="toggleCraftsman(staff)"><text>{{ staff.name }}</text></view></view>
				<text class="reservation-page__field-label">房间（可选）</text><view class="reservation-page__choices"><view v-for="room in roomOptions" :key="room.id" class="reservation-page__choice" :class="{ 'reservation-page__choice--active': selectedRoomId == Number(room.id) }" @tap="chooseRoom(room)"><text>{{ room.name || room.label || ('房间 ' + room.id) }}</text></view></view>
				<text class="reservation-page__field-label">备注（可选）</text><textarea class="reservation-page__textarea" :value="remark" placeholder="填写预约说明" @input="remark = $event.detail.value" /><view class="reservation-page__submit" @tap="submit"><text>{{ submitting ? '正在保存…' : (editingReservationId > 0 ? '保存预约' : '创建预约') }}</text></view></scroll-view></view>
	</view>
</template>

<script setup lang="uts">
	import { cancelMobileReservation, createMobileReservation, endMobileReservationService, openMobileReservationEditor, queryMobileReservationDetail, queryMobileReservationMembers, queryMobileReservationProjectCatalog, queryMobileReservations, startMobileReservationService, updateMobileReservation } from '../../../shared/api/mobile-reservation-client.uts'
	import { openMerchantBootstrap, openMerchantWorkbench } from '../../../shared/platform/mobile-navigation.uts'
	import { switchMobileMerchantContext } from '../../../shared/api/mobile-merchant-session-client.uts'
	import { confirmMobileAction } from '../../../shared/platform/mobile-platform.uts'
	import { currentMerchantRoot, merchantRequestSession } from '../../../shared/platform/mobile-merchant-session.uts'
	import { ensureMerchantTabAccess } from '../../../shared/platform/merchant-route-guard.uts'
	const records = ref<Array<any>>([]); const loading = ref(false); const loadingMore = ref(false); const message = ref(''); const loginRequired = ref(false)
	const unstartedCount = ref(0); const servingCount = ref(0); const endedCount = ref(0); const activeFilter = ref('unstarted'); const currentPage = ref(1); const totalRecords = ref(0); const hasMore = ref(false)
	const filters = [{ key: 'unstarted', label: '未开始' }, { key: 'serving', label: '服务中' }, { key: 'ended', label: '已结束' }]
	const detailOpen = ref(false); const detailLoading = ref(false); const detail = ref<any>(null); const detailId = ref(0)
	const editorOpen = ref(false); const editingReservationId = ref(0); const editingReservationVersion = ref(0); const submitting = ref(false)
	const projectOptions = ref<Array<any>>([]); const craftsmanOptions = ref<Array<any>>([]); const roomOptions = ref<Array<any>>([]); const selectedProjects = ref<Array<any>>([]); const selectedCraftsmen = ref<Array<any>>([]); const selectedRoomId = ref(0)
	const selectedMember = ref<any>(null); const memberPickerOpen = ref(false); const memberKeyword = ref(''); const memberCandidates = ref<Array<any>>([]); const memberLoading = ref(false); const projectSource = ref('card'); const projectKeyword = ref(''); const projectCategory = ref(''); const appointmentDate = ref(''); const appointmentClock = ref(''); const remark = ref('')
	const storeContexts = ref<Array<any>>([]); const storeLabels = ref<Array<string>>([]); const activeStoreIndex = ref(0); const activeStoreLabel = ref('门店信息加载中'); const switchingStore = ref(false); const storeSwitchMessage = ref('')
	onShow(() => { if (ensureMerchantTabAccess('workbench')) { loadStoreContext(); loadReservations() } })
	function loadStoreContext() : void {
		let root = currentMerchantRoot()
		let contexts = root != null && Array.isArray(root.contexts) ? root.contexts : []
		let activeId = root != null && root.activeContext != null ? String(root.activeContext.contextId || '') : String(root != null ? root.activeContextId || '' : '')
		storeContexts.value = contexts
		storeLabels.value = contexts.map((context : any) : string => String(context.label || context.storeName || '未命名门店'))
		let index = 0
		for (let position = 0; position < contexts.length; position++) if (String(contexts[position].contextId || '') == activeId) { index = position; break }
		activeStoreIndex.value = index
		activeStoreLabel.value = contexts.length > 0 ? storeLabels.value[index] : '暂无可用门店'
	}
	function selectStore(event : any) : void {
		if (switchingStore.value) return
		let index = Number(event.detail.value || 0)
		if (index < 0 || index >= storeContexts.value.length || index == activeStoreIndex.value) return
		let targetContextId = String(storeContexts.value[index].contextId || '')
		switchingStore.value = true; storeSwitchMessage.value = ''
		switchMobileMerchantContext(targetContextId, (result : any) => {
			switchingStore.value = false
			if (!result.ok) { storeSwitchMessage.value = String(result.message || '门店切换失败。'); return }
			closeEditor(); closeDetail(); loadStoreContext(); loadReservations(true)
		})
	}
	function merchantLoginIsRequired() : boolean { return merchantRequestSession(currentMerchantRoot()) == null }
	function openMerchantLogin() : void { openMerchantBootstrap() }
	function backToWorkbench() : void { openMerchantWorkbench() }
	function payloadOf(response : any) : any { return response != null && response.body != null ? response.body.reservation : null }
	function succeeded(response : any) : boolean { let payload = payloadOf(response); return response != null && response.ok && payload != null && payload.result != null && payload.result.status == 'success' }
	function errorMessage(response : any, fallback : string) : string { let payload = payloadOf(response); return String(response != null && response.message ? response.message : (payload != null && payload.result != null ? payload.result.message : fallback)) }
	function loadReservations(reset : boolean = true) : void { if (!reset && (!hasMore.value || loadingMore.value)) return; let requestedPage = reset ? 1 : currentPage.value + 1; if (reset) { loading.value = true; message.value = ''; loginRequired.value = false } else loadingMore.value = true; queryMobileReservations({ quickFilter: activeFilter.value, page: requestedPage, pageSize: 10 }, (response : any) => { loading.value = false; loadingMore.value = false; if (!succeeded(response)) { loginRequired.value = merchantLoginIsRequired(); message.value = loginRequired.value ? '请先完成商家端登录。' : errorMessage(response, '预约列表暂时不可用。'); return }; let view = payloadOf(response).data != null ? payloadOf(response).data.reservation : null; let next = view != null && Array.isArray(view.records) ? view.records : []; records.value = reset ? next : records.value.concat(next); currentPage.value = Number(view != null ? view.page : requestedPage); totalRecords.value = Number(view != null ? view.total : records.value.length); hasMore.value = records.value.length < totalRecords.value; let counts = view != null && view.quickCounts != null ? view.quickCounts : {}; unstartedCount.value = Number(counts.unstarted || 0); servingCount.value = Number(counts.serving || 0); endedCount.value = Number(counts.ended || 0) }) }
	function changeFilter(filter : string) : void { if (filter == activeFilter.value && records.value.length > 0) return; activeFilter.value = filter; loadReservations(true) }
	function loadMoreReservations() : void { loadReservations(false) }
	function statusClass(status : any) : string { let text = String(status || ''); return text == '服务中' ? 'reservation-page__status--serving' : (text == '已结束' ? 'reservation-page__status--ended' : 'reservation-page__status--unstarted') }
	function openDetail(item : any) : void { detailId.value = Number(item.reservationId || item.id || 0); if (detailId.value <= 0) return; detailOpen.value = true; detailLoading.value = true; detail.value = null; queryMobileReservationDetail(detailId.value, (response : any) => { detailLoading.value = false; if (!succeeded(response)) { message.value = errorMessage(response, '预约详情暂不可用。'); return }; detail.value = payloadOf(response).data != null && payloadOf(response).data.reservation != null ? payloadOf(response).data.reservation.detail : null }) }
	function closeDetail() : void { detailOpen.value = false; detail.value = null }
	function detailProjects() : string { if (detail.value == null || !Array.isArray(detail.value.projects)) return '未选择项目'; let values = new Array<string>(); for (let i = 0; i < detail.value.projects.length; i++) values.push(String(detail.value.projects[i].name || '项目')); return values.join('、') }
	function detailCraftsmen() : string { if (detail.value == null || !Array.isArray(detail.value.plannedCraftsmen) || detail.value.plannedCraftsmen.length == 0) return '待分配手艺人'; let values = new Array<string>(); for (let i = 0; i < detail.value.plannedCraftsmen.length; i++) values.push(String(detail.value.plannedCraftsmen[i].name || '')); return values.join('、') }
	function detailActions() : Array<any> { return detail.value != null && Array.isArray(detail.value.actions) ? detail.value.actions : [] }
	function uuid() : string { let text = ''; let chars = '0123456789abcdef'; for (let i = 0; i < 32; i++) { if (i == 8 || i == 12 || i == 16 || i == 20) text += '-'; let n = Math.floor(Math.random() * 16); if (i == 12) n = 4; if (i == 16) n = (n & 3) | 8; text += chars.charAt(n) }; return text }
	function command(action : string = '', version : number = 0) : any { let contexts = new Array<any>(); let requiresReservationContext = action == 'cancel-reservation' || action == 'start-reservation-service' || action == 'end-reservation-service'; if (requiresReservationContext && detailId.value > 0 && version > 0) contexts.push({ kind: 'reservation', id: detailId.value.toString(), expectedVersion: version }); return { action: action, idempotencyKey: 'RESERVATION-' + uuid(), contexts: contexts } }
	function runAction(action : string) : void { if (detail.value == null || detailId.value <= 0 || submitting.value) return; if (action == 'edit-reservation') { closeDetail(); openEditEditor(detailId.value); return }; submitting.value = true; let payload = { command: command(action, Number(detail.value.reservationVersion || detail.value.revision || 0)) }; let done = (response : any) => { submitting.value = false; if (!succeeded(response)) { message.value = errorMessage(response, '预约操作未完成。'); return }; detailOpen.value = false; loadReservations() }; if (action == 'cancel-reservation') { confirmMobileAction('删除预约', '确认删除这条未开始预约吗？', (confirmed : boolean) => { if (confirmed) cancelMobileReservation(detailId.value, payload, done); else submitting.value = false }); return }; if (action == 'start-reservation-service') { startMobileReservationService(detailId.value, payload, done); return }; if (action == 'end-reservation-service') { endMobileReservationService(detailId.value, payload, done); return }; submitting.value = false }
	function resetEditor() : void { editingReservationId.value = 0; editingReservationVersion.value = 0; selectedProjects.value = []; selectedCraftsmen.value = []; selectedRoomId.value = 0; selectedMember.value = null; memberPickerOpen.value = false; memberCandidates.value = []; memberKeyword.value = ''; projectOptions.value = []; projectSource.value = 'card'; projectKeyword.value = ''; projectCategory.value = ''; appointmentDate.value = ''; appointmentClock.value = ''; remark.value = '' }
	function openCreateEditor() : void { if (merchantLoginIsRequired()) { openMerchantLogin(); return }; resetEditor(); openMobileReservationEditor({ mode: 'create' }, (response : any) => { if (!succeeded(response)) { message.value = errorMessage(response, '预约编辑器暂不可用。'); return }; let editor = payloadOf(response).data != null ? payloadOf(response).data.editor : null; if (editor == null || editor.preparationReady !== true) { message.value = '预约编辑器准备不完整，请重新加载。'; return }; craftsmanOptions.value = Array.isArray(editor.craftsmenOptions) ? editor.craftsmenOptions : []; roomOptions.value = Array.isArray(editor.rooms) ? editor.rooms : []; editorOpen.value = true }) }
	function openEditEditor(reservationId : number) : void { if (reservationId <= 0) return; resetEditor(); openMobileReservationEditor({ mode: 'edit', reservationId: reservationId }, (response : any) => { if (!succeeded(response)) { message.value = errorMessage(response, '预约编辑器暂不可用。'); return }; let editor = payloadOf(response).data != null ? payloadOf(response).data.editor : null; if (editor == null || editor.draft == null) { message.value = '预约编辑资料不完整。'; return }; editingReservationId.value = reservationId; let draft = editor.draft; editingReservationVersion.value = Number(draft.reservationVersion || draft.recordVersion || draft.revision || 0); selectedMember.value = draft.member; selectedProjects.value = Array.isArray(draft.projects) ? draft.projects : []; selectedCraftsmen.value = Array.isArray(draft.craftsmen) ? draft.craftsmen : []; selectedRoomId.value = Number(draft.roomId || 0); projectOptions.value = Array.isArray(editor.catalogOptions) ? editor.catalogOptions : []; craftsmanOptions.value = Array.isArray(editor.craftsmenOptions) ? editor.craftsmenOptions : []; roomOptions.value = Array.isArray(editor.rooms) ? editor.rooms : []; splitAppointmentTime(String(draft.appointmentTime || '')); remark.value = String(draft.remark || ''); editorOpen.value = true }) }
	function closeEditor() : void { if (!submitting.value) { editorOpen.value = false; editingReservationId.value = 0; editingReservationVersion.value = 0 } }
	function openMemberPicker() : void { if (editingReservationId.value > 0) return; memberPickerOpen.value = true; loadMembers() }
	function loadMembers() : void { memberLoading.value = true; queryMobileReservationMembers({ keyword: memberKeyword.value.trim(), page: 1, limit: 20 }, (response : any) => { memberLoading.value = false; let payload = payloadOf(response); let result = payload != null && payload.data != null ? payload.data.memberCandidates : null; if (!succeeded(response) || result == null) { message.value = errorMessage(response, '会员列表暂时不可用。'); return }; memberCandidates.value = Array.isArray(result.records) ? result.records : [] }) }
	function selectMember(member : any) : void { selectedMember.value = member; memberPickerOpen.value = false; selectedProjects.value = []; projectSource.value = 'card'; queryMobileReservationProjectCatalog(Number(member.memberId || member.id || 0), (response : any) => { if (!succeeded(response)) { message.value = errorMessage(response, '项目目录暂时不可用。'); return }; let catalog = payloadOf(response).data != null ? payloadOf(response).data.reservationProjectCatalog : null; projectOptions.value = catalog != null && Array.isArray(catalog.catalogOptions) ? catalog.catalogOptions : [] }) }
	function projectKey(project : any) : string { return String(project.source || 'unpaid') + ':' + String(project.projectId || project.id || 0) + ':' + String(project.skuId || 0) + ':' + String(project.entitlementSourceDetailId || 0) }
	function selectedProject(project : any) : boolean { let key = projectKey(project); for (let i = 0; i < selectedProjects.value.length; i++) if (projectKey(selectedProjects.value[i]) == key) return true; return false }
	function toggleProject(project : any) : void { let key = projectKey(project); let next = new Array<any>(); let found = false; for (let i = 0; i < selectedProjects.value.length; i++) { if (projectKey(selectedProjects.value[i]) == key) found = true; else next.push(selectedProjects.value[i]) }; if (!found) next.push({ projectId: Number(project.projectId || project.id || 0), skuId: Number(project.skuId || 0), name: project.name, source: project.source == 'card' ? 'card' : 'unpaid', entitlementSourceDetailId: Number(project.entitlementSourceDetailId || 0), quantity: 1, appliedDurationMinutes: Number(project.appliedDurationMinutes || project.serviceDurationMinutes || 60) }); selectedProjects.value = next }
	function projectCategories() : Array<string> { let values = new Array<string>(); for (let i = 0; i < projectOptions.value.length; i++) { let category = String(projectOptions.value[i].categoryName || '全部'); if (values.indexOf(category) < 0) values.push(category) }; return values }
	function projectVisible(project : any) : boolean { if (projectSource.value == 'card' && project.source != 'card') return false; let category = String(project.categoryName || '全部'); if (projectCategory.value.length > 0 && projectCategory.value != category) return false; let keyword = projectKeyword.value.trim().toLowerCase(); return keyword.length == 0 || String(project.name || '').toLowerCase().indexOf(keyword) >= 0 }
	function visibleProjectCount() : number { let count = 0; for (let i = 0; i < projectOptions.value.length; i++) if (projectVisible(projectOptions.value[i])) count++; return count }
	function selectedCraftsman(staff : any) : boolean { let id = Number(staff.staffId || staff.id || 0); for (let i = 0; i < selectedCraftsmen.value.length; i++) if (Number(selectedCraftsmen.value[i]) == id || Number(selectedCraftsmen.value[i].staffId || selectedCraftsmen.value[i].id || 0) == id) return true; return false }
	function toggleCraftsman(staff : any) : void { let id = Number(staff.staffId || staff.id || 0); let next = new Array<any>(); let found = false; for (let i = 0; i < selectedCraftsmen.value.length; i++) { let value = selectedCraftsmen.value[i]; if (Number(value) == id || Number(value.staffId || value.id || 0) == id) found = true; else next.push(value) }; if (!found) next.push(id); selectedCraftsmen.value = next }
	function chooseRoom(room : any) : void { selectedRoomId.value = Number(room.id || room.roomId || 0) }
	function splitAppointmentTime(value : string) : void { let parts = value.split(' '); appointmentDate.value = parts.length > 0 ? parts[0] : ''; appointmentClock.value = parts.length > 1 ? parts[1] : '' }
	function appointmentTime() : string { return appointmentDate.value.length > 0 && appointmentClock.value.length > 0 ? appointmentDate.value + ' ' + appointmentClock.value : '' }
	function estimatedEndLabel() : string { let minutes = 0; for (let i = 0; i < selectedProjects.value.length; i++) minutes += Number(selectedProjects.value[i].appliedDurationMinutes || 60) * Number(selectedProjects.value[i].quantity || 1); if (minutes <= 0) return '未设置服务时长的项目默认 60 分钟'; let start = appointmentTime(); if (start.length == 0) return '预计服务时长 ' + minutes.toString() + ' 分钟'; let time = new Date(start.replace(' ', 'T')).getTime(); if (isNaN(time)) return '预计服务时长 ' + minutes.toString() + ' 分钟'; let end = new Date(time + minutes * 60000); let month = (end.getMonth() + 1).toString().padStart(2, '0'); let day = end.getDate().toString().padStart(2, '0'); let hour = end.getHours().toString().padStart(2, '0'); let minute = end.getMinutes().toString().padStart(2, '0'); return '预计结束 ' + end.getFullYear().toString() + '-' + month + '-' + day + ' ' + hour + ':' + minute }
	function reservationDraft() : any { return { memberId: selectedMember.value != null ? Number(selectedMember.value.memberId || selectedMember.value.id || 0) : 0, member: selectedMember.value, projects: selectedProjects.value, craftsmen: selectedCraftsmen.value, roomId: selectedRoomId.value, appointmentTime: appointmentTime(), remark: remark.value.trim() } }
	function submit() : void { if (submitting.value) return; if (selectedMember.value == null || selectedProjects.value.length == 0) { message.value = '请选择会员和至少一个项目。'; return }; submitting.value = true; let editing = editingReservationId.value > 0; let action = editing ? 'update-reservation' : 'create-reservation'; let version = editing ? editingReservationVersion.value : 0; let payload = { reservation: reservationDraft(), command: command(action, version) }; let done = (response : any) => { submitting.value = false; if (!succeeded(response)) { message.value = errorMessage(response, '预约保存失败。'); return }; editorOpen.value = false; editingReservationId.value = 0; editingReservationVersion.value = 0; loadReservations() }; if (editing) updateMobileReservation(editingReservationId.value, payload, done); else createMobileReservation(payload, done) }
</script>

<style>
	.reservation-page { display: flex; min-height: 100%; flex: 1; flex-direction: column; background-color: #f3f6f8; }
	.reservation-page__header { padding: 48px 18px 14px; background-color: #ffffff; }.reservation-page__header-row { display: flex; min-height: 34px; flex-direction: row; align-items: center; justify-content: space-between; }.reservation-page__back { width: 34px; font-size: 30px; line-height: 32px; color: #53687c; }.reservation-page__title { flex: 1; font-size: 19px; font-weight: 700; line-height: 28px; color: #21374b; text-align: center; }.reservation-page__create { display: flex; min-width: 50px; height: 32px; flex-direction: row; align-items: center; justify-content: center; border-radius: 4px; background-color: #2e6fb7; font-size: 13px; font-weight: 700; color: #ffffff; }.reservation-page__subtitle { margin-top: 8px; font-size: 12px; line-height: 18px; color: #8493a1; }.reservation-page__store { display: flex; min-height: 42px; flex-direction: row; align-items: center; justify-content: flex-end; margin-top: 10px; padding: 8px 10px; border-radius: 8px; background-color: #f1f6fb; }.reservation-page__store--switchable { padding-left: 12px; }.reservation-page__store-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; align-items: flex-end; }.reservation-page__store-label { font-size: 10px; line-height: 15px; color: #8998a6; }.reservation-page__store-name { max-width: 220px; overflow: hidden; font-size: 14px; font-weight: 700; line-height: 21px; color: #2e4357; text-overflow: ellipsis; white-space: nowrap; }.reservation-page__store-action { flex-shrink: 0; margin-left: 8px; padding: 4px 7px; border-radius: 4px; background-color: #e4f0fc; font-size: 11px; line-height: 17px; color: #2e6fb7; }.reservation-page__store-error { padding: 9px 18px; border-bottom-width: 1px; border-bottom-style: solid; border-bottom-color: #f0cccc; background-color: #fff7f7; font-size: 12px; line-height: 18px; color: #a44848; }
	.reservation-page__sync-note { display: block; margin-top: 2px; font-size: 10px; line-height: 15px; color: #9aa7b3; }
	.reservation-page__metrics { display: flex; flex-direction: row; margin: 12px 18px; padding: 13px 0; border-radius: 6px; background-color: #ffffff; box-shadow: 0 2px 8px rgba(33, 55, 75, 0.05); }.reservation-page__metrics > view { display: flex; flex: 1; flex-direction: column; align-items: center; font-size: 12px; color: #7c8b99; }.reservation-page__metric-number { margin-bottom: 3px; font-size: 22px; font-weight: 700; line-height: 28px; color: #2e6fb7; }
	.reservation-page__filters { display: flex; flex-direction: row; padding: 0 18px 10px; }.reservation-page__filter { display: flex; height: 32px; flex: 1; flex-direction: row; align-items: center; justify-content: center; border-bottom-width: 2px; border-bottom-style: solid; border-bottom-color: transparent; font-size: 13px; color: #6c7d8e; }.reservation-page__filter--active { border-bottom-color: #2e6fb7; font-weight: 700; color: #2e6fb7; }
	.reservation-page__list { min-height: 0; flex: 1; padding: 0 18px 30px; }.reservation-page__card, .reservation-page__detail-card { display: flex; flex-direction: column; margin-bottom: 10px; padding: 14px; border-radius: 6px; background-color: #ffffff; box-shadow: 0 2px 8px rgba(33, 55, 75, 0.05); }.reservation-page__card-head { display: flex; flex-direction: row; align-items: flex-start; justify-content: space-between; }.reservation-page__member { font-size: 16px; font-weight: 700; line-height: 23px; color: #294055; }.reservation-page__phone { margin-left: 7px; font-size: 12px; line-height: 20px; color: #91a0ad; }.reservation-page__status { padding: 1px 7px; border-radius: 3px; font-size: 12px; line-height: 19px; }.reservation-page__status--unstarted { background-color: #eaf1fb; color: #2e6fb7; }.reservation-page__status--serving { background-color: #e8f6ef; color: #258152; }.reservation-page__status--ended { background-color: #eff2f5; color: #7a8996; }.reservation-page__time { margin-top: 10px; font-size: 14px; font-weight: 600; line-height: 21px; color: #435a70; }.reservation-page__copy { margin-top: 4px; font-size: 13px; line-height: 20px; color: #788897; }.reservation-page__detail-link { margin-top: 9px; font-size: 12px; font-weight: 700; line-height: 18px; color: #2e6fb7; }.reservation-page__document { margin-top: 10px; font-size: 11px; line-height: 17px; color: #97a5b2; }
	.reservation-page__notice, .reservation-page__empty { display: flex; flex-direction: column; margin: 16px 18px; padding: 16px; border-radius: 6px; background-color: #ffffff; font-size: 14px; line-height: 22px; color: #607386; }.reservation-page__empty { align-items: center; margin: 0; color: #8392a0; }.reservation-page__empty text + text { margin-top: 5px; font-size: 12px; }.reservation-page__notice-action { display: flex; align-self: flex-start; min-height: 30px; flex-direction: row; align-items: center; margin-top: 9px; padding: 0 10px; border-radius: 4px; background-color: #eef4fb; font-size: 12px; color: #2e6fb7; }
	.reservation-page__overlay { position: fixed; z-index: 50; top: 0; right: 0; bottom: 0; left: 0; display: flex; flex-direction: column; background-color: #f3f6f8; }.reservation-page__sheet-header { display: flex; flex-direction: row; align-items: center; justify-content: space-between; padding: 48px 18px 14px; background-color: #ffffff; }.reservation-page__sheet-cancel, .reservation-page__sheet-space { width: 48px; font-size: 14px; line-height: 22px; color: #5f7488; }.reservation-page__sheet-title { font-size: 18px; font-weight: 700; line-height: 26px; color: #294055; }.reservation-page__sheet-body { min-height: 0; flex: 1; padding: 16px 18px 30px; }.reservation-page__action-row { display: flex; flex-direction: row; margin-bottom: 14px; }.reservation-page__action { display: flex; height: 38px; flex: 1; flex-direction: row; align-items: center; justify-content: center; margin-right: 8px; border-width: 1px; border-style: solid; border-color: #c8d5e1; border-radius: 4px; background-color: #ffffff; font-size: 13px; font-weight: 700; color: #50687d; }.reservation-page__action:last-child { margin-right: 0; }.reservation-page__action--primary { border-color: #2e6fb7; background-color: #2e6fb7; color: #ffffff; }.reservation-page__action--danger { border-color: #e5b9b9; color: #bf5d5d; }.reservation-page__timeline { padding: 13px 14px; border-radius: 6px; background-color: #ffffff; }.reservation-page__section-label { font-size: 14px; font-weight: 700; line-height: 21px; color: #435a70; }.reservation-page__timeline-row { display: flex; flex-direction: row; justify-content: space-between; padding: 10px 0; border-bottom-width: 1px; border-bottom-style: solid; border-bottom-color: #edf1f4; font-size: 12px; line-height: 18px; color: #798b99; }
	.reservation-page__field-label { display: block; margin-top: 17px; font-size: 13px; font-weight: 700; line-height: 20px; color: #435a70; }.reservation-page__select, .reservation-page__input { box-sizing: border-box; display: flex; width: 100%; min-height: 42px; flex-direction: row; align-items: center; justify-content: space-between; margin-top: 7px; padding: 0 11px; border-width: 1px; border-style: solid; border-color: #d6e0e8; border-radius: 4px; background-color: #ffffff; font-size: 14px; color: #435a70; }.reservation-page__select--locked { background-color: #f4f6f8; color: #8392a0; }.reservation-page__picker { margin-top: 7px; padding: 10px; border-radius: 4px; background-color: #ffffff; }.reservation-page__picker .reservation-page__input { margin-top: 0; }.reservation-page__inline-button { display: flex; align-self: flex-start; min-height: 30px; flex-direction: row; align-items: center; margin-top: 8px; padding: 0 10px; border-radius: 4px; background-color: #eef4fb; font-size: 12px; color: #2e6fb7; }.reservation-page__picker-option { padding: 10px 0; border-bottom-width: 1px; border-bottom-style: solid; border-bottom-color: #edf1f4; font-size: 13px; color: #50687d; }.reservation-page__source-tabs, .reservation-page__datetime { display: flex; flex-direction: row; margin-top: 7px; }.reservation-page__source-tab { display: flex; height: 34px; flex: 1; flex-direction: row; align-items: center; justify-content: center; margin-right: 8px; border-radius: 4px; background-color: #eaf0f5; font-size: 12px; color: #667b8e; }.reservation-page__source-tab:last-child { margin-right: 0; }.reservation-page__source-tab--active { background-color: #e7f0fb; font-weight: 700; color: #2e6fb7; }.reservation-page__datetime picker { flex: 1; margin-right: 8px; }.reservation-page__datetime picker:last-child { margin-right: 0; }.reservation-page__datetime .reservation-page__select { margin-top: 0; }.reservation-page__category-row { white-space: nowrap; margin-top: 8px; }.reservation-page__category { display: inline-flex; height: 30px; flex-direction: row; align-items: center; margin-right: 7px; padding: 0 9px; border-radius: 4px; background-color: #eef2f5; font-size: 12px; color: #718394; }.reservation-page__category--active { background-color: #e7f0fb; color: #2e6fb7; }.reservation-page__choices { display: flex; flex-wrap: wrap; flex-direction: row; margin-top: 8px; }.reservation-page__choice { display: flex; min-height: 34px; flex-direction: row; align-items: center; margin-right: 7px; margin-bottom: 7px; padding: 0 9px; border-width: 1px; border-style: solid; border-color: #d6e0e8; border-radius: 4px; background-color: #ffffff; font-size: 12px; color: #586f82; }.reservation-page__choice--active { border-color: #2e6fb7; background-color: #e7f0fb; color: #2e6fb7; }.reservation-page__choice-note { margin-left: 4px; font-size: 10px; color: #90a0ad; }.reservation-page__helper { display: block; margin-top: 7px; font-size: 12px; line-height: 18px; color: #8493a1; }.reservation-page__textarea { box-sizing: border-box; width: 100%; height: 88px; margin-top: 7px; padding: 10px; border-width: 1px; border-style: solid; border-color: #d6e0e8; border-radius: 4px; background-color: #ffffff; font-size: 14px; color: #435a70; }.reservation-page__submit { display: flex; height: 44px; flex-direction: row; align-items: center; justify-content: center; margin: 22px 0 20px; border-radius: 4px; background-color: #2e6fb7; font-size: 15px; font-weight: 700; color: #ffffff; }
</style>
