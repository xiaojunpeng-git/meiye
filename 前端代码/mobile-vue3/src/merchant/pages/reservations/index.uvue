<template>
  <MoheAiEntry />
	<view class="reservation-page" :class="{ 'reservation-page--native-mini': platformUsesNativeCanvas }">
		<view class="reservation-page__header">
			<view class="reservation-page__header-row"><text class="reservation-page__back" @tap="backToWorkbench">‹</text><text class="reservation-page__title">预约服务</text><view class="reservation-page__header-space"></view></view>
		</view>
		<view class="reservation-page__metrics"><view><text class="reservation-page__metric-number">{{ unstartedCount }}</text><text>待服务</text></view><view><text class="reservation-page__metric-number">{{ servingCount }}</text><text>服务中</text></view><view><text class="reservation-page__metric-number">{{ endedCount }}</text><text>已结束</text></view></view>
		<view class="reservation-page__filters"><view v-for="filter in filters" :key="filter.key" class="reservation-page__filter" :class="{ 'reservation-page__filter--active': activeFilter == filter.key }" @tap="changeFilter(filter.key)"><text>{{ filter.label }}</text></view></view>
		<view v-if="loading" class="reservation-page__notice"><text>正在读取预约…</text></view>
		<view v-else-if="message.length > 0" class="reservation-page__notice"><text>{{ message }}</text><view class="reservation-page__notice-action" @tap="loginRequired ? openMerchantLogin() : loadReservations()"><text>{{ loginRequired ? '前往登录' : '重新加载' }}</text></view></view>
		<scroll-view v-else scroll-y class="reservation-page__list" @scrolltolower="loadMoreReservations">
			<view v-if="records.length == 0" class="reservation-page__empty"><text>暂无{{ activeFilterLabel() }}预约</text><text>会员端和门店端的新 V3 预约会同步到这里</text></view>
			<view v-for="item in records" :key="item.reservationId" class="reservation-page__card" @tap="openDetail(item)">
				<view class="reservation-page__card-head"><view><text class="reservation-page__member">{{ item.memberName || '未命名会员' }}</text><text class="reservation-page__phone">{{ item.phone }}</text></view><text class="reservation-page__status" :class="statusClass(item.status)">{{ statusLabelOf(item) }}</text></view>
				<text class="reservation-page__time">{{ item.appointmentTime || '时间待定' }}</text><text class="reservation-page__copy">{{ item.projectSummary || '未选择项目' }}</text><text class="reservation-page__copy">{{ item.craftsmanSummary || '待分配手艺人' }}{{ item.roomName ? ' · ' + item.roomName : '' }}</text>
				<text v-if="serviceCountdownLabel(item).length > 0" class="reservation-page__countdown" :class="{ 'reservation-page__countdown--overtime': serviceIsOvertime(item) }">{{ serviceCountdownLabel(item) }}</text><text class="reservation-page__detail-link">查看服务详情 ›</text>
			</view>
			<text v-if="records.length > 0" class="reservation-page__list-footer">{{ loadingMore ? '正在加载更多…' : ('已显示 ' + records.length + ' / ' + totalRecords + ' 条') }}</text>
		</scroll-view>

		<view v-if="detailOpen" class="reservation-page__overlay"><view class="reservation-page__sheet-header"><text class="reservation-page__sheet-cancel" @tap="closeDetail">关闭</text><text class="reservation-page__sheet-title">预约服务详情</text><text class="reservation-page__sheet-space"></text></view><scroll-view scroll-y class="reservation-page__sheet-body"><view v-if="detailLoading" class="reservation-page__notice"><text>正在读取详情…</text></view><view v-else-if="detail == null" class="reservation-page__notice"><text>{{ message || '预约详情暂不可用。' }}</text></view><view v-else><view class="reservation-page__detail-card"><view class="reservation-page__card-head"><text class="reservation-page__member">{{ detail.member != null ? detail.member.name : '' }}</text><text class="reservation-page__status" :class="statusClass(detail.statusLabel)">{{ detail.statusLabel }}</text></view><text class="reservation-page__time">{{ detail.appointmentStartAt || '时间待定' }}{{ detail.appointmentEndAt ? ' 至 ' + detail.appointmentEndAt : '' }}</text><text class="reservation-page__copy">{{ detailProjects() }}</text><text class="reservation-page__copy">{{ detailCraftsmen() }}{{ detail.room != null && detail.room.name ? ' · ' + detail.room.name : '' }}</text><text v-if="detail.remark" class="reservation-page__copy">备注：{{ detail.remark }}</text><view v-if="serviceCountdownLabel(detail).length > 0" class="reservation-page__timer"><text class="reservation-page__timer-caption">实际开始后计时</text><text class="reservation-page__timer-value" :class="{ 'reservation-page__timer-value--overtime': serviceIsOvertime(detail) }">{{ serviceCountdownLabel(detail) }}</text><text class="reservation-page__timer-note">倒计时归零后只显示超时，不会自动结束服务</text></view><text class="reservation-page__document">预约单 {{ detail.reservationNo }}</text></view><text v-if="actionError.length > 0" class="reservation-page__action-error">{{ actionError }}</text><view v-if="serviceActions().length > 0" class="reservation-page__action-row"><view v-for="action in serviceActions()" :key="action.action" class="reservation-page__action reservation-page__action--primary" @tap="runAction(action.action)"><text>{{ action.label }}</text></view></view><view class="reservation-page__timeline"><text class="reservation-page__section-label">操作记录</text><view v-for="entry in detail.timeline" :key="entry.id" class="reservation-page__timeline-row"><text>{{ entry.title }}</text><text>{{ entry.occurredAt }}</text></view></view></view></scroll-view></view>
	</view>
</template>

<script setup lang="uts">
  import MoheAiEntry from '../../../shared/components/mohe-ai-entry.uvue'
	import { endMobileReservationService, queryMobileReservationDetail, queryMobileReservations, startMobileReservationService } from '../../../shared/api/mobile-reservation-client.uts'
	import { openMerchantBootstrap, openMerchantWorkbench } from '../../../shared/platform/mobile-navigation.uts'
	import { confirmMobileAction, currentMobilePlatform } from '../../../shared/platform/mobile-platform.uts'
	import { currentMerchantRoot, merchantRequestSession } from '../../../shared/platform/mobile-merchant-session.uts'
	import { ensureMerchantTabAccess } from '../../../shared/platform/merchant-route-guard.uts'
	const records = ref<Array<any>>([]); const loading = ref(false); const loadingMore = ref(false); const message = ref(''); const loginRequired = ref(false)
	const unstartedCount = ref(0); const servingCount = ref(0); const endedCount = ref(0); const activeFilter = ref('unstarted'); const currentPage = ref(1); const totalRecords = ref(0); const hasMore = ref(false)
	const filters = [{ key: 'unstarted', label: '待服务' }, { key: 'serving', label: '服务中' }, { key: 'ended', label: '已结束' }]
	const detailOpen = ref(false); const detailLoading = ref(false); const detail = ref<any>(null); const detailId = ref(0); const submitting = ref(false); const actionError = ref(''); const clockNowMs = ref(Date.now()); let clockTimer : any = null; let linkedRefreshTimer : any = null
	const platformUsesNativeCanvas = currentMobilePlatform() === 'MP_WEIXIN'
	onShow(() => { startClock(); if (ensureMerchantTabAccess('workbench')) loadReservations() })
	onHide(() => { stopClock() })
	onUnmounted(() => { stopClock() })
	function startClock() : void { stopClock(); clockNowMs.value = Date.now(); clockTimer = setInterval(() => { clockNowMs.value = Date.now() }, 1000); linkedRefreshTimer = setInterval(() => { refreshLinkedView() }, 15000) }
	function stopClock() : void { if (clockTimer != null) { clearInterval(clockTimer); clockTimer = null }; if (linkedRefreshTimer != null) { clearInterval(linkedRefreshTimer); linkedRefreshTimer = null } }
	function refreshLinkedView() : void { if (submitting.value || loading.value || detailLoading.value) return; if (detailOpen.value && detailId.value > 0) loadDetail(false); else loadReservations(true) }
	function merchantLoginIsRequired() : boolean { return merchantRequestSession(currentMerchantRoot()) == null }
	function openMerchantLogin() : void { openMerchantBootstrap() }
	function backToWorkbench() : void { openMerchantWorkbench() }
	function payloadOf(response : any) : any { return response != null && response.body != null ? response.body.reservation : null }
	function succeeded(response : any) : boolean { let payload = payloadOf(response); return response != null && response.ok && payload != null && payload.result != null && payload.result.status == 'success' }
	function errorMessage(response : any, fallback : string) : string { let payload = payloadOf(response); return String(response != null && response.message ? response.message : (payload != null && payload.result != null ? payload.result.message : fallback)) }
	function loadReservations(reset : boolean = true) : void { if (!reset && (!hasMore.value || loadingMore.value)) return; let requestedPage = reset ? 1 : currentPage.value + 1; if (reset) { loading.value = true; message.value = ''; loginRequired.value = false } else loadingMore.value = true; queryMobileReservations({ workflow: 'service', quickFilter: activeFilter.value, page: requestedPage, pageSize: 10 }, (response : any) => { loading.value = false; loadingMore.value = false; if (!succeeded(response)) { loginRequired.value = merchantLoginIsRequired(); message.value = loginRequired.value ? '请先完成商家端登录。' : errorMessage(response, '预约服务列表暂时不可用。'); return }; let view = payloadOf(response).data != null ? payloadOf(response).data.reservation : null; let next = view != null && Array.isArray(view.records) ? view.records : []; records.value = reset ? next : records.value.concat(next); currentPage.value = Number(view != null ? view.page : requestedPage); totalRecords.value = Number(view != null ? view.total : records.value.length); hasMore.value = records.value.length < totalRecords.value; let counts = view != null && view.quickCounts != null ? view.quickCounts : {}; unstartedCount.value = Number(counts.unstarted || counts.pendingService || 0); servingCount.value = Number(counts.serving || 0); endedCount.value = Number(counts.ended || 0) }) }
	function changeFilter(filter : string) : void { if (filter == activeFilter.value && records.value.length > 0) return; activeFilter.value = filter; loadReservations(true) }
	function activeFilterLabel() : string { for (let i = 0; i < filters.length; i++) if (filters[i].key == activeFilter.value) return filters[i].label; return '' }
	function loadMoreReservations() : void { loadReservations(false) }
	function statusLabelOf(entity : any) : string { if (entity == null) return ''; let label = String(entity.statusLabel || ''); if (label.length > 0) return label; let code = String(entity.status || ''); return code == 'IN_SERVICE' ? '服务中' : (code == 'COMPLETED' ? '已结束' : '待服务') }
	function statusClass(status : any) : string { let text = String(status || ''); return text == '服务中' || text == 'IN_SERVICE' ? 'reservation-page__status--serving' : (text == '已结束' || text == 'COMPLETED' ? 'reservation-page__status--ended' : 'reservation-page__status--unstarted') }
	function openDetail(item : any) : void { detailId.value = Number(item.reservationId || item.id || 0); if (detailId.value <= 0) return; detailOpen.value = true; detail.value = null; message.value = ''; actionError.value = ''; loadDetail(true) }
	function loadDetail(showLoading : boolean) : void { if (detailId.value <= 0) return; if (showLoading) detailLoading.value = true; queryMobileReservationDetail(detailId.value, (response : any) => { detailLoading.value = false; if (!succeeded(response)) { if (showLoading) message.value = errorMessage(response, '预约详情暂不可用。'); return }; detail.value = payloadOf(response).data != null && payloadOf(response).data.reservation != null ? payloadOf(response).data.reservation.detail : null }) }
	function closeDetail() : void { detailOpen.value = false; detail.value = null }
	function detailProjects() : string { if (detail.value == null || !Array.isArray(detail.value.projects)) return '未选择项目'; let values = new Array<string>(); for (let i = 0; i < detail.value.projects.length; i++) values.push(String(detail.value.projects[i].name || '项目')); return values.join('、') }
	function detailCraftsmen() : string { if (detail.value == null || !Array.isArray(detail.value.plannedCraftsmen) || detail.value.plannedCraftsmen.length == 0) return '待分配手艺人'; let values = new Array<string>(); for (let i = 0; i < detail.value.plannedCraftsmen.length; i++) values.push(String(detail.value.plannedCraftsmen[i].name || '')); return values.join('、') }
	function serviceActions() : Array<any> { let values = new Array<any>(); if (detail.value == null || !Array.isArray(detail.value.actions)) return values; for (let i = 0; i < detail.value.actions.length; i++) { let action = detail.value.actions[i]; if (action.action == 'start-reservation-service' || action.action == 'end-reservation-service') values.push(action) }; return values }
	function uuid() : string { let text = ''; let chars = '0123456789abcdef'; for (let i = 0; i < 32; i++) { if (i == 8 || i == 12 || i == 16 || i == 20) text += '-'; let n = Math.floor(Math.random() * 16); if (i == 12) n = 4; if (i == 16) n = (n & 3) | 8; text += chars.charAt(n) }; return text }
	function command(action : string, version : number) : any { let contexts = new Array<any>(); if (detailId.value > 0 && version > 0) contexts.push({ kind: 'reservation', id: detailId.value.toString(), expectedVersion: version }); return { action: action, idempotencyKey: 'RESERVATION-' + uuid(), contexts: contexts } }
	function runAction(action : string) : void { if (detail.value == null || detailId.value <= 0 || submitting.value) return; actionError.value = ''; let version = Number(detail.value.reservationVersion || detail.value.revision || 0); if (version <= 0) { actionError.value = '预约资料已过期，请关闭后重新打开。'; return }; let title = action == 'start-reservation-service' ? '开始服务' : '结束服务'; let copy = action == 'start-reservation-service' ? '确认已到店并开始服务吗？倒计时将从实际开始时间计算。' : '确认已完成本次服务吗？'; confirmMobileAction(title, copy, (confirmed : boolean) => { if (!confirmed) return; submitting.value = true; let payload = { command: command(action, version) }; let done = (response : any) => { submitting.value = false; if (!succeeded(response)) { actionError.value = errorMessage(response, '预约服务操作未完成。'); return }; detailOpen.value = false; loadReservations() }; if (action == 'start-reservation-service') startMobileReservationService(detailId.value, payload, done); else if (action == 'end-reservation-service') endMobileReservationService(detailId.value, payload, done) }) }
	function timingOf(entity : any) : any { if (entity == null) return null; if (entity.serviceTiming != null) return entity.serviceTiming; if (entity.serviceTimer != null) return entity.serviceTimer; return entity }
	function timeValue(value : any) : number { let text = String(value || ''); if (text.length == 0) return 0; let numeric = Number(value); if (text.indexOf('-') < 0 && text.indexOf(':') < 0 && !Number.isNaN(numeric) && numeric > 0) return numeric < 100000000000 ? numeric * 1000 : numeric; let parsed = new Date(text.replace(' ', 'T')).getTime(); return Number.isNaN(parsed) ? 0 : parsed }
	function serviceExpectedEndMs(entity : any) : number { let timing = timingOf(entity); if (timing == null) return 0; let expected = timeValue(timing.serviceCountdownEndsAt || timing.expectedEndAt || timing.expectedFinishAt || timing.serviceExpectedEndAt); if (expected > 0) return expected; let started = timeValue(timing.actualServiceStartedAt || timing.actualStartedAt || timing.actualStartAt || timing.serviceStartedAt); let durationSeconds = Number(timing.totalDurationSeconds || timing.durationSeconds || 0); if (durationSeconds <= 0) durationSeconds = Number(timing.totalDurationMinutes || timing.durationMinutes || timing.plannedDurationMinutes || 0) * 60; return started > 0 && durationSeconds > 0 ? started + durationSeconds * 1000 : 0 }
	function serviceRemainingSeconds(entity : any) : number { let endMs = serviceExpectedEndMs(entity); return endMs > 0 ? Math.floor((endMs - clockNowMs.value) / 1000) : 0 }
	function serviceIsOvertime(entity : any) : boolean { return serviceExpectedEndMs(entity) > 0 && serviceRemainingSeconds(entity) < 0 }
	function twoDigits(value : number) : string { return value < 10 ? '0' + value.toString() : value.toString() }
	function serviceCountdownLabel(entity : any) : string { let endMs = serviceExpectedEndMs(entity); if (endMs <= 0) return ''; let remaining = serviceRemainingSeconds(entity); let overtime = remaining < 0; let total = Math.abs(remaining); let hours = Math.floor(total / 3600); let minutes = Math.floor((total % 3600) / 60); let seconds = total % 60; return (overtime ? '已超时 ' : '剩余 ') + twoDigits(hours) + ':' + twoDigits(minutes) + ':' + twoDigits(seconds) }
</script>

<style>
	.reservation-page { display: flex; min-height: 100%; flex: 1; flex-direction: column; background-color: #f3f6f8; color: #294055; }.reservation-page__header { padding: 50px 18px 14px; background-color: #ffffff; }.reservation-page__header-row { display: flex; flex-direction: row; align-items: center; justify-content: space-between; }.reservation-page__back { width: 50px; height: 32px; font-size: 34px; line-height: 28px; color: #526a7e; }.reservation-page__title { font-size: 20px; font-weight: 700; line-height: 30px; }.reservation-page__header-space { width: 50px; height: 32px; }
	.reservation-page__metrics { display: flex; flex-direction: row; padding: 16px 18px; border-top-width: 1px; border-top-style: solid; border-top-color: #edf1f4; background-color: #ffffff; }.reservation-page__metrics view { display: flex; flex: 1; flex-direction: column; align-items: center; font-size: 12px; color: #7a8b99; }.reservation-page__metric-number { margin-bottom: 3px; font-size: 22px; font-weight: 700; color: #2e6fb7; }.reservation-page__filters { display: flex; flex-direction: row; margin: 10px 18px; border-radius: 6px; background-color: #ffffff; }.reservation-page__filter { display: flex; height: 40px; flex: 1; align-items: center; justify-content: center; border-bottom-width: 2px; border-bottom-style: solid; border-bottom-color: transparent; font-size: 13px; color: #6c7d8e; }.reservation-page__filter--active { border-bottom-color: #2e6fb7; font-weight: 700; color: #2e6fb7; }
	.reservation-page__list { min-height: 0; flex: 1; padding: 0 18px 30px; }.reservation-page__card, .reservation-page__detail-card { display: flex; flex-direction: column; margin-bottom: 10px; padding: 14px; border-radius: 6px; background-color: #ffffff; box-shadow: 0 2px 8px rgba(33, 55, 75, 0.05); }.reservation-page__card-head { display: flex; flex-direction: row; align-items: flex-start; justify-content: space-between; }.reservation-page__member { font-size: 16px; font-weight: 700; line-height: 23px; color: #294055; }.reservation-page__phone { margin-left: 7px; font-size: 12px; line-height: 20px; color: #91a0ad; }.reservation-page__status { padding: 1px 7px; border-radius: 3px; font-size: 12px; line-height: 19px; }.reservation-page__status--unstarted { background-color: #eaf1fb; color: #2e6fb7; }.reservation-page__status--serving { background-color: #e8f6ef; color: #258152; }.reservation-page__status--ended { background-color: #eff2f5; color: #7a8996; }.reservation-page__time { margin-top: 10px; font-size: 14px; font-weight: 600; line-height: 21px; color: #435a70; }.reservation-page__copy { margin-top: 4px; font-size: 13px; line-height: 20px; color: #788897; }.reservation-page__countdown { margin-top: 9px; font-size: 14px; font-weight: 700; line-height: 21px; color: #258152; }.reservation-page__countdown--overtime { color: #bf5d5d; }.reservation-page__detail-link { margin-top: 9px; font-size: 12px; font-weight: 700; line-height: 18px; color: #2e6fb7; }.reservation-page__document { margin-top: 10px; font-size: 11px; line-height: 17px; color: #97a5b2; }
	.reservation-page__timer { display: flex; flex-direction: column; margin-top: 13px; padding: 12px; border-radius: 5px; background-color: #f2f8f5; }.reservation-page__timer-caption { font-size: 12px; line-height: 18px; color: #6e8078; }.reservation-page__timer-value { margin-top: 3px; font-size: 24px; font-weight: 700; line-height: 32px; color: #258152; }.reservation-page__timer-value--overtime { color: #bf5d5d; }.reservation-page__timer-note { margin-top: 4px; font-size: 11px; line-height: 17px; color: #82918b; }
	.reservation-page__notice, .reservation-page__empty { display: flex; flex-direction: column; margin: 16px 18px; padding: 16px; border-radius: 6px; background-color: #ffffff; font-size: 14px; line-height: 22px; color: #607386; }.reservation-page__empty { align-items: center; margin: 0; color: #8392a0; }.reservation-page__empty text + text { margin-top: 5px; font-size: 12px; }.reservation-page__notice-action { display: flex; align-self: flex-start; min-height: 30px; flex-direction: row; align-items: center; margin-top: 9px; padding: 0 10px; border-radius: 4px; background-color: #eef4fb; font-size: 12px; color: #2e6fb7; }.reservation-page__list-footer { display: block; padding: 12px 0 18px; text-align: center; font-size: 11px; color: #98a5af; }
	.reservation-page__overlay { position: fixed; z-index: 50; top: 0; right: 0; bottom: 0; left: 0; display: flex; flex-direction: column; background-color: #f3f6f8; }.reservation-page__sheet-header { display: flex; flex-direction: row; align-items: center; justify-content: space-between; padding: 48px 18px 14px; background-color: #ffffff; }.reservation-page__sheet-cancel, .reservation-page__sheet-space { width: 48px; font-size: 14px; line-height: 22px; color: #5f7488; }.reservation-page__sheet-title { font-size: 18px; font-weight: 700; line-height: 26px; color: #294055; }.reservation-page__sheet-body { min-height: 0; flex: 1; padding: 16px 18px 30px; }.reservation-page__action-error { display: block; margin: 0 0 10px; padding: 9px 11px; border-radius: 4px; background-color: #fff2f2; font-size: 12px; line-height: 18px; color: #b95151; }.reservation-page__action-row { display: flex; flex-direction: row; margin-bottom: 14px; }.reservation-page__action { display: flex; height: 42px; flex: 1; flex-direction: row; align-items: center; justify-content: center; border-radius: 4px; font-size: 14px; font-weight: 700; }.reservation-page__action--primary { background-color: #2e6fb7; color: #ffffff; }.reservation-page__timeline { padding: 13px 14px; border-radius: 6px; background-color: #ffffff; }.reservation-page__section-label { font-size: 14px; font-weight: 700; line-height: 21px; color: #435a70; }.reservation-page__timeline-row { display: flex; flex-direction: row; justify-content: space-between; padding: 10px 0; border-bottom-width: 1px; border-bottom-style: solid; border-bottom-color: #edf1f4; font-size: 12px; line-height: 18px; color: #798b99; }
	.reservation-page--native-mini .reservation-page__header { padding-top: 84px; }.reservation-page--native-mini .reservation-page__sheet-header { padding-top: 84px; }
</style>
