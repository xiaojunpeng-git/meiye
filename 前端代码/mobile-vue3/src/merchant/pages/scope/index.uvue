<template>
	<view class="merchant-scope">
		<view class="merchant-scope__header"><view class="merchant-scope__back" role="button" @tap="goBack"><text>‹</text></view><text class="merchant-scope__title">门店与权限</text><view class="merchant-scope__spacer"></view></view>
		<scroll-view class="merchant-scope__content" scroll-y refresher-enabled="true" :refresher-triggered="refreshing" @refresherrefresh="onPullRefresh"><view class="merchant-scope__inner"><view class="merchant-scope__intro"><text class="merchant-scope__intro-title">我的组织权限</text><text class="merchant-scope__intro-copy">以下范围由员工数据权限实时裁剪，只读展示。</text><view class="merchant-scope__meta"><text>{{ modeLabel }}</text><text>{{ treeRows.length }} 个可见节点</text></view></view><view v-if="loading" class="merchant-scope__state"><text>正在读取组织权限…</text></view><view v-else-if="message.length > 0" class="merchant-scope__state"><text>{{ message }}</text><view class="merchant-scope__retry" @tap="load"><text>重新加载</text></view></view><view v-else-if="treeRows.length === 0" class="merchant-scope__state"><text>当前员工暂无可展示的组织权限。</text></view><view v-else class="merchant-scope__tree"><view v-for="row in treeRows" :key="row.key" class="merchant-scope__row" :style="{ paddingLeft: (14 + row.depth * 18).toString() + 'px' }"><view class="merchant-scope__node-icon" :class="row.nodeType === 'store' ? 'merchant-scope__node-icon--store' : 'merchant-scope__node-icon--org'"><text>{{ row.nodeType === 'store' ? '店' : '组' }}</text></view><view class="merchant-scope__node-copy"><text class="merchant-scope__node-name">{{ row.name }}</text><text class="merchant-scope__node-detail">{{ row.nodeType === 'store' ? '门店' : row.desc }}</text></view><text v-if="row.nodeType === 'store' && row.id === activeStoreId" class="merchant-scope__active">当前</text></view></view><view class="merchant-scope__footnote"><text>权限来源：员工数据权限与当前商家会话。</text></view></view></scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { queryMobileMerchantScope } from '../../../shared/api/mobile-merchant-profile-client.uts'

	const loading = ref(false); const refreshing = ref(false); const message = ref(''); const modeLabel = ref('当前员工范围'); const activeStoreId = ref(0); const treeRows = ref<Array<any>>([])
	onShow(() => load())
	function goBack() { uni.navigateBack() }
	function onPullRefresh() : void { if (refreshing.value) return; refreshing.value = true; load(); setTimeout(() => { refreshing.value = false }, 900) }
	function load() { loading.value = true; message.value = ''; queryMobileMerchantScope((result : any) => { loading.value = false; if (!result.ok || result.body == null) { message.value = String(result.message || '组织权限加载失败。'); return }; let body = result.body; activeStoreId.value = Number(body.activeStoreId || 0); modeLabel.value = scopeModeLabel(String(body.mode || '')); treeRows.value = flatten(Array.isArray(body.tree) ? body.tree : []) }) }
	function scopeModeLabel(mode : string) : string { if (mode === 'STORES') return '组织 / 门店权限'; if (mode === 'PERSONAL_SELF') return '个人数据权限'; return '当前员工范围' }
	function flatten(nodes : Array<any>) : Array<any> { let rows = new Array<any>(); appendNodes(nodes, 0, rows); return rows }
	function appendNodes(nodes : Array<any>, depth : number, rows : Array<any>) : void { for (let index = 0; index < nodes.length; index++) { let node = nodes[index] || {}; let type = String(node.node_type || node.nodeType || 'org'); let id = Number(node.id || 0); rows.push({ key: type + '-' + id.toString() + '-' + index.toString(), id: id, nodeType: type, name: String(node.name || node.label || '未命名节点'), desc: String(node.desc || (type === 'org' ? '组织' : '门店')), depth: depth }); let children = Array.isArray(node.children) ? node.children : []; if (children.length > 0) appendNodes(children, depth + 1, rows) } }
</script>

<style>
	.merchant-scope { display: flex; min-height: 100%; flex: 1; flex-direction: column; background-color: #f4f7fa; }.merchant-scope__header { display: flex; height: 56px; align-items: center; justify-content: space-between; padding: 0 18px; border-bottom-width: 1px; border-bottom-style: solid; border-bottom-color: #e5edf5; background-color: #ffffff; }.merchant-scope__back { display: flex; width: 38px; height: 38px; align-items: center; font-size: 34px; color: #26384d; }.merchant-scope__title { font-size: 17px; font-weight: 700; color: #26384d; }.merchant-scope__spacer { width: 38px; }.merchant-scope__content { min-height: 0; flex: 1; }.merchant-scope__inner { padding: 18px 18px 38px; }.merchant-scope__intro { padding: 17px; border-radius: 12px; background-color: #eaf3ff; }.merchant-scope__intro-title { display: block; font-size: 18px; font-weight: 700; color: #2b5278; }.merchant-scope__intro-copy { display: block; margin-top: 5px; font-size: 12px; color: #6c8499; }.merchant-scope__meta { display: flex; margin-top: 13px; flex-direction: row; justify-content: space-between; font-size: 12px; font-weight: 600; color: #3976aa; }.merchant-scope__tree { margin-top: 16px; overflow: hidden; border-radius: 12px; background-color: #ffffff; }.merchant-scope__row { display: flex; min-height: 64px; flex-direction: row; align-items: center; padding-right: 14px; border-bottom-width: 1px; border-bottom-style: solid; border-bottom-color: #edf1f5; }.merchant-scope__row:last-child { border-bottom-width: 0; }.merchant-scope__node-icon { display: flex; width: 32px; height: 32px; flex-shrink: 0; align-items: center; justify-content: center; border-radius: 9px; font-size: 12px; font-weight: 700; }.merchant-scope__node-icon--org { background-color: #e9f1ff; color: #3973bb; }.merchant-scope__node-icon--store { background-color: #fff1dc; color: #b67727; }.merchant-scope__node-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; margin-left: 10px; }.merchant-scope__node-name { overflow: hidden; font-size: 14px; font-weight: 700; color: #314a64; text-overflow: ellipsis; white-space: nowrap; }.merchant-scope__node-detail { margin-top: 3px; font-size: 11px; color: #8798aa; }.merchant-scope__active { padding: 4px 7px; border-radius: 8px; background-color: #e7f6ef; font-size: 11px; color: #26815d; }.merchant-scope__state { display: flex; min-height: 250px; align-items: center; justify-content: center; flex-direction: column; color: #71839a; font-size: 14px; text-align: center; }.merchant-scope__retry { margin-top: 12px; color: #2878c9; font-weight: 700; }.merchant-scope__footnote { margin-top: 14px; padding: 0 3px; font-size: 11px; color: #8a9baa; }
</style>
