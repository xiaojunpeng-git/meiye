<template>
	<view class="warehouse-page">
		<view class="warehouse-page__header">
			<text class="warehouse-page__eyebrow">区域经营</text>
			<view class="warehouse-page__title-row"><text class="warehouse-page__title">数仓</text><picker mode="date" fields="month" :value="month" @change="changeMonth"><view class="warehouse-page__month"><text>{{ periodLabel }}</text><text class="warehouse-page__month-arrow">⌄</text></view></picker></view>
			<scroll-view scroll-x class="warehouse-page__breadcrumbs"><view class="warehouse-page__breadcrumb-track"><view v-for="(item, index) in breadcrumbs" :key="item.entityType + '-' + item.entityId" class="warehouse-page__breadcrumb" @tap="openBreadcrumb(item)"><text :class="{ 'warehouse-page__breadcrumb--active': index === breadcrumbs.length - 1 }">{{ item.name }}</text><text v-if="index < breadcrumbs.length - 1" class="warehouse-page__breadcrumb-divider">›</text></view></view></scroll-view>
		</view>

		<scroll-view scroll-y class="warehouse-page__content">
			<view v-if="loading" class="warehouse-page__state"><text>正在读取授权组织范围…</text></view>
			<view v-else-if="message.length > 0" class="warehouse-page__state"><text>{{ message }}</text><view class="warehouse-page__retry" @tap="reload"><text>重新加载</text></view></view>
			<view v-else>
				<view class="warehouse-page__scope"><view><text class="warehouse-page__scope-label">当前范围</text><text class="warehouse-page__scope-name">{{ currentNode.name }}</text></view><text class="warehouse-page__scope-count">{{ currentNode.storeCount }} 家门店</text></view>
				<view class="warehouse-page__metrics"><view v-for="metric in summaryMetrics" :key="metric.code" class="warehouse-page__metric" :class="{ 'warehouse-page__metric--active': selectedMetricCode === metric.code }" @tap="selectMetric(metric)"><text class="warehouse-page__metric-name">{{ metric.name }}</text><text class="warehouse-page__metric-value">{{ metric.displayValue }}</text><text v-if="!metric.available" class="warehouse-page__metric-state">建设中</text></view></view>
				<view v-if="!aggregationCaughtUp" class="warehouse-page__availability"><text>{{ availabilityMessage }}</text></view>

				<scroll-view direction="horizontal" :show-scrollbar="false" class="warehouse-page__ranking-tabs"><view class="warehouse-page__ranking-track"><view v-for="item in rankingCatalog" :key="item.code" class="warehouse-page__ranking-tab" :class="{ 'warehouse-page__ranking-tab--active': selectedRankingCode === item.code }" @tap="selectRanking(item)"><text>{{ item.name }}</text></view></view></scroll-view>
				<view class="warehouse-page__ranking-head"><text>{{ selectedRankingName }}</text><text class="warehouse-page__ranking-scope">{{ currentNode.name }} · {{ periodLabel }}</text></view>
				<view v-if="rankingRows.length > 0" class="warehouse-page__ranking-list"><view v-for="(row, index) in rankingRows" :key="row.entityType + '-' + row.entityId" class="warehouse-page__ranking-row" @tap="openRow(row)"><text class="warehouse-page__rank">{{ index + 1 }}</text><view class="warehouse-page__ranking-copy"><view class="warehouse-page__ranking-name-row"><text class="warehouse-page__ranking-name">{{ row.name }}</text><text class="warehouse-page__entity-tag">{{ rowTypeLabel(row) }}</text></view><text class="warehouse-page__ranking-meta">{{ rowMeta(row) }}</text></view><text class="warehouse-page__ranking-value">{{ rowValue(row) }}</text><text v-if="rowCanOpen(row)" class="warehouse-page__chevron">›</text></view></view>
				<view class="warehouse-page__freshness"><text>更新于 {{ dataAsOf }}</text></view>
			</view>
		</scroll-view>

		<view class="warehouse-page__tabs" role="tablist"><view class="warehouse-page__tab warehouse-page__tab--active" role="tab" aria-selected="true"><text>数仓</text></view><navigator class="warehouse-page__tab" url="/src/merchant/pages/customers/index" open-type="navigate" role="tab" aria-selected="false"><text>客户</text></navigator><navigator class="warehouse-page__tab" url="/src/merchant/pages/workbench/index" open-type="navigate" role="tab" aria-selected="false"><text>工作台</text></navigator><navigator class="warehouse-page__tab" url="/src/merchant/pages/goals/index" open-type="navigate" role="tab" aria-selected="false"><text>目标</text></navigator><navigator class="warehouse-page__tab" url="/src/merchant/pages/profile/index" open-type="navigate" role="tab" aria-selected="false"><text>我的</text></navigator></view>
	</view>
</template>

<script setup lang="uts">
	import { queryMobileWarehouse } from '../../../shared/api/mobile-warehouse-client.uts'
	const now = new Date()
	const initialMonth = now.getFullYear().toString() + '-' + twoDigits(now.getMonth() + 1)
	const loading = ref(false)
	const message = ref('')
	const month = ref(initialMonth)
	const periodLabel = ref('本月')
	const currentNode = ref<any>({ entityType: 'virtual', entityId: 0, name: '授权范围', storeCount: 0 })
	const breadcrumbs = ref<Array<any>>([])
	const summaryMetrics = ref<Array<any>>([])
	const rankingRows = ref<Array<any>>([])
	const rankingCatalog = ref<Array<any>>([])
	const selectedMetricCode = ref('cash_performance')
	const selectedRankingCode = ref('organization')
	const selectedRankingName = ref('组织排行')
	const selectedRankingAvailable = ref(true)
	const metricVersion = ref('—')
	const dataAsOf = ref('—')
	const aggregationCaughtUp = ref(false)
	const availabilityMessage = ref('')
	let activeNodeType = ''
	let activeNodeId = 0

	onShow(() => reload())

	function reload() : void { loadNode(activeNodeType, activeNodeId) }
	function loadNode(nodeType : string, nodeId : number) : void {
		loading.value = true; message.value = ''
		queryMobileWarehouse({ month: month.value, nodeType: nodeType, nodeId: nodeId, rankingCode: selectedRankingCode.value }, (response : any) => {
			loading.value = false
			let payload = response != null && response.body != null ? response.body.warehouse : null
			if (!response.ok || payload == null) { message.value = String(response.message || '数仓暂时不可用。'); return }
			activeNodeType = nodeType; activeNodeId = nodeId
			periodLabel.value = String((payload.period || {}).label || month.value)
			currentNode.value = payload.currentNode || currentNode.value
			breadcrumbs.value = Array.isArray(payload.breadcrumbs) ? payload.breadcrumbs : []
			summaryMetrics.value = Array.isArray(payload.summaryMetrics) ? payload.summaryMetrics : []
			rankingRows.value = Array.isArray(payload.rankingRows) ? payload.rankingRows : []
			rankingCatalog.value = Array.isArray(payload.rankingCatalog) ? payload.rankingCatalog : []
			selectedRankingCode.value = String(payload.selectedRankingCode || selectedRankingCode.value)
			selectedRankingAvailable.value = payload.selectedRankingAvailable !== false
			metricVersion.value = String(payload.metric_version || '—')
			dataAsOf.value = formatDataTime(Number(payload.data_as_of || 0))
			aggregationCaughtUp.value = payload.aggregation_caught_up === true
			availabilityMessage.value = String(payload.availabilityMessage || '')
		})
	}
	function changeMonth(event : any) : void { month.value = String(event.detail.value || initialMonth).slice(0, 7); loadNode(activeNodeType, activeNodeId) }
	function openBreadcrumb(item : any) : void {
		let type = String(item.entityType || '')
		if (type === 'virtual') loadNode('', 0)
		else loadNode(type, Number(item.entityId || 0))
	}
	function openRow(row : any) : void { if (rowCanOpen(row)) loadNode(String(row.entityType || ''), Number(row.entityId || 0)) }
	function selectMetric(metric : any) : void { selectedMetricCode.value = String(metric.code || 'cash_performance') }
	function selectRanking(item : any) : void { selectedRankingCode.value = String(item.code || 'organization'); selectedRankingName.value = String(item.name || '组织排行'); loadNode(activeNodeType, activeNodeId) }
	function rowValue(row : any) : string {
		if (selectedRankingCode.value !== 'organization') return String(row.displayValue || '—')
		let values = Array.isArray(row.metrics) ? row.metrics : []
		for (let index = 0; index < values.length; index++) if (String(values[index].code || '') === selectedMetricCode.value) return String(values[index].displayValue || '—')
		return '—'
	}
	function rowTypeLabel(row : any) : string { let type = String(row.entityType || ''); if (type === 'organization') return '组织'; if (type === 'store') return '门店'; if (type === 'employee') return '员工'; return '项目' }
	function rowMeta(row : any) : string { if (selectedRankingCode.value === 'organization') return Number(row.storeCount || 0).toString() + ' 家门店'; return selectedRankingCode.value === 'project_count' ? '本月完成服务' : String(currentNode.value.name || '') }
	function rowCanOpen(row : any) : boolean { let type = String(row.entityType || ''); return selectedRankingCode.value === 'organization' && (type === 'organization' || type === 'store') }
	function formatDataTime(timestamp : number) : string {
		if (timestamp <= 0) return '—'
		let value = new Date(timestamp * 1000)
		return twoDigits(value.getMonth() + 1) + '-' + twoDigits(value.getDate()) + ' ' + twoDigits(value.getHours()) + ':' + twoDigits(value.getMinutes())
	}
	function twoDigits(value : number) : string { return value < 10 ? '0' + value.toString() : value.toString() }
</script>

<style>
	.warehouse-page { display: flex; min-height: 100%; flex: 1; flex-direction: column; background-color: #f3f5f7; color: #20252b; }
	.warehouse-page__header { display: flex; flex-direction: column; padding: 42px 18px 13px 18px; border-bottom-width: 1px; border-bottom-style: solid; border-bottom-color: #e7eaee; background-color: #ffffff; }
	.warehouse-page__eyebrow { font-size: 11px; font-weight: 600; line-height: 16px; color: #778291; }
	.warehouse-page__title-row { display: flex; flex-direction: row; align-items: center; justify-content: space-between; margin-top: 2px; }
	.warehouse-page__title { font-size: 25px; font-weight: 700; line-height: 34px; color: #20252b; }
	.warehouse-page__month { display: flex; min-width: 92px; height: 32px; flex-direction: row; align-items: center; justify-content: center; padding: 0 8px; border-radius: 6px; background-color: #f1f4f6; font-size: 13px; font-weight: 600; color: #344252; }
	.warehouse-page__month-arrow { margin-left: 6px; color: #7b8794; }
	.warehouse-page__breadcrumbs { margin-top: 8px; white-space: nowrap; }
	.warehouse-page__breadcrumb-track, .warehouse-page__breadcrumb { display: flex; flex-direction: row; align-items: center; }
	.warehouse-page__breadcrumb { flex: none; font-size: 12px; line-height: 18px; color: #788494; }
	.warehouse-page__breadcrumb--active { font-weight: 700; color: #1677cc; }
	.warehouse-page__breadcrumb-divider { margin: 0 6px; color: #adb5bf; }
	.warehouse-page__content { min-height: 0; flex: 1; padding: 0 0 86px 0; }
	.warehouse-page__scope { display: flex; flex-direction: row; align-items: flex-end; justify-content: space-between; padding: 17px 18px 11px 18px; background-color: #ffffff; }
	.warehouse-page__scope-label { display: block; font-size: 11px; line-height: 16px; color: #87919e; }
	.warehouse-page__scope-name { display: block; margin-top: 3px; font-size: 18px; font-weight: 700; line-height: 25px; color: #232930; }
	.warehouse-page__scope-count { padding-bottom: 2px; font-size: 12px; color: #788391; }
	.warehouse-page__metrics { display: flex; flex-direction: row; flex-wrap: wrap; padding: 0 18px 17px 18px; border-bottom-width: 1px; border-bottom-style: solid; border-bottom-color: #e7eaee; background-color: #ffffff; }
	.warehouse-page__metric { display: flex; box-sizing: border-box; width: 50%; min-height: 76px; flex-direction: column; justify-content: center; padding: 10px 12px; border-bottom-width: 1px; border-bottom-style: solid; border-bottom-color: #eef1f3; }
	.warehouse-page__metric:nth-child(odd) { border-right-width: 1px; border-right-style: solid; border-right-color: #eef1f3; }
	.warehouse-page__metric--active { background-color: #f3f8fc; }
	.warehouse-page__metric-name { font-size: 11px; line-height: 16px; color: #758190; }
	.warehouse-page__metric-value { margin-top: 4px; font-size: 22px; font-weight: 700; line-height: 29px; color: #222a32; }
	.warehouse-page__metric--active .warehouse-page__metric-name, .warehouse-page__metric--active .warehouse-page__metric-value { color: #126eac; }
	.warehouse-page__metric-state { margin-top: 2px; font-size: 10px; color: #9a6b1f; }
	.warehouse-page__availability { padding: 10px 18px; border-bottom-width: 1px; border-bottom-style: solid; border-bottom-color: #ecd9b7; background-color: #fffaf1; font-size: 12px; line-height: 18px; color: #765820; }
	.warehouse-page__ranking-tabs { margin-top: 10px; padding: 0 8px; border-top-width: 1px; border-bottom-width: 1px; border-style: solid; border-color: #e7eaee; background-color: #ffffff; white-space: nowrap; }
	.warehouse-page__ranking-track { display: flex; width: 520px; flex-direction: row; }
	.warehouse-page__ranking-tab { display: flex; width: 104px; flex: none; height: 43px; align-items: center; justify-content: center; border-bottom-width: 2px; border-bottom-style: solid; border-bottom-color: transparent; font-size: 13px; color: #697586; white-space: nowrap; }
	.warehouse-page__ranking-tab--active { border-bottom-color: #1677cc; font-weight: 700; color: #1677cc; }
	.warehouse-page__ranking-head { display: flex; min-height: 49px; flex-direction: row; align-items: center; justify-content: space-between; padding: 0 18px; border-bottom-width: 1px; border-bottom-style: solid; border-bottom-color: #e7eaee; background-color: #ffffff; font-size: 15px; font-weight: 700; }
	.warehouse-page__ranking-scope { max-width: 55%; overflow: hidden; font-size: 11px; font-weight: 400; color: #909aa6; text-overflow: ellipsis; white-space: nowrap; }
	.warehouse-page__ranking-list { display: flex; flex-direction: column; background-color: #ffffff; }
	.warehouse-page__ranking-row { display: flex; min-height: 66px; flex-direction: row; align-items: center; padding: 0 18px; border-bottom-width: 1px; border-bottom-style: solid; border-bottom-color: #edf0f2; }
	.warehouse-page__rank { display: flex; width: 28px; height: 28px; flex-shrink: 0; align-items: center; justify-content: center; border-radius: 6px; background-color: #f1f4f6; font-size: 12px; font-weight: 700; color: #6f7a88; }
	.warehouse-page__ranking-copy { min-width: 0; flex: 1; margin-left: 10px; }
	.warehouse-page__ranking-name-row { display: flex; flex-direction: row; align-items: center; }
	.warehouse-page__ranking-name { overflow: hidden; font-size: 14px; font-weight: 700; line-height: 21px; color: #27303a; text-overflow: ellipsis; white-space: nowrap; }
	.warehouse-page__entity-tag { flex: none; margin-left: 7px; padding: 1px 5px; border-radius: 3px; background-color: #edf3f7; font-size: 10px; line-height: 15px; color: #607487; }
	.warehouse-page__ranking-meta { display: block; margin-top: 2px; font-size: 11px; line-height: 17px; color: #919aa5; }
	.warehouse-page__ranking-value { margin-left: 10px; font-size: 16px; font-weight: 700; color: #26313d; }
	.warehouse-page__chevron { margin-left: 7px; font-size: 20px; color: #a2abb5; }
	.warehouse-page__state { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 150px; padding: 20px; background-color: #ffffff; font-size: 14px; text-align: center; color: #687483; }
	.warehouse-page__state--inline { min-height: 120px; }
	.warehouse-page__state-copy { margin-top: 6px; font-size: 12px; line-height: 18px; color: #9099a4; }
	.warehouse-page__retry { margin-top: 12px; padding: 8px 13px; border-radius: 5px; background-color: #1677cc; color: #ffffff; }
	.warehouse-page__freshness { display: flex; flex-direction: row; justify-content: flex-end; padding: 10px 18px 18px 18px; background-color: #ffffff; font-size: 10px; line-height: 16px; color: #a0a8b2; }
	.warehouse-page__tabs { display: flex; min-height: 62px; flex-direction: row; border-top-width: 1px; border-top-style: solid; border-top-color: #dde4ed; background-color: #ffffff; }
	.warehouse-page__tab { display: flex; min-width: 0; flex: 1; flex-direction: row; align-items: center; justify-content: center; border-top-width: 2px; border-top-style: solid; border-top-color: #ffffff; font-size: 12px; font-weight: 600; color: #697586; }
	.warehouse-page__tab--active { border-top-color: #1677cc; background-color: #f7fbff; color: #1677cc; }
</style>
