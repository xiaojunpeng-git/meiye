// Page components stay platform-neutral.  Navigation is owned by this shared
// capability boundary so App and mini-program adapters keep one route policy.
export function openMerchantCustomers() : void {
	uni.reLaunch({ url: '/src/merchant/pages/customers/index' })
}

export function openMerchantWorkbench() : void {
	uni.reLaunch({ url: '/src/merchant/pages/workbench/index' })
}

export function openMerchantCustomerCare(memberId : string = '') : void {
	let suffix = memberId.length > 0 ? '?memberId=' + memberId : ''
	uni.navigateTo({ url: '/src/merchant/pages/customer-care/index' + suffix })
}

export function openMerchantBootstrap() : void {
	uni.reLaunch({ url: '/src/app/pages/bootstrap/index' })
}

export function openMerchantBootstrapForCustomers() : void {
	uni.reLaunch({ url: '/src/app/pages/bootstrap/index?returnTarget=customers' })
}

// Return routes are intentionally enumerated here.  Login must never accept a
// caller-provided URL, otherwise an unauthenticated deep link could become an
// open navigation surface after the merchant session is established.
export function openMerchantBootstrapForCustomerDetail(memberId : string, lookup : string) : void {
	uni.reLaunch({
		url: '/src/app/pages/bootstrap/index?returnTarget=customer-detail&memberId=' + encodeURIComponent(memberId) + '&lookup=' + encodeURIComponent(lookup)
	})
}

export function openMerchantCustomerDetail(memberId : string, lookup : string) : void {
	uni.navigateTo({ url: '/src/merchant/pages/customer-detail/index?id=' + memberId + '&lookup=' + lookup })
}

export function openMerchantCustomerProfile(mode : string, memberId : string = '', lookup : string = '') : void {
	let suffix = '?mode=' + encodeURIComponent(mode)
	if (memberId.length > 0) suffix += '&id=' + encodeURIComponent(memberId)
	if (lookup.length > 0) suffix += '&lookup=' + encodeURIComponent(lookup)
	uni.navigateTo({ url: '/src/merchant/pages/customer-profile/index' + suffix })
}

export function replaceMerchantCustomerDetail(memberId : string, lookup : string) : void {
	uni.redirectTo({ url: '/src/merchant/pages/customer-detail/index?id=' + encodeURIComponent(memberId) + '&lookup=' + encodeURIComponent(lookup) })
}

export function returnFromMerchantCustomerProfile() : void {
	uni.navigateBack()
}

export function openMerchantCustomerDetailAfterBootstrap(memberId : string, lookup : string) : void {
	uni.reLaunch({ url: '/src/merchant/pages/customer-detail/index?id=' + encodeURIComponent(memberId) + '&lookup=' + encodeURIComponent(lookup) })
}

export function openMerchantCustomerOrderDetail(memberId : string, orderId : string) : void {
	uni.navigateTo({ url: '/src/merchant/pages/customer-order-detail/index?memberId=' + memberId + '&orderId=' + orderId })
}

export function returnFromMerchantCustomerOrderDetail() : void {
	uni.navigateBack()
}

export function returnFromMerchantCustomerDetail() : void {
	uni.navigateBack()
}
