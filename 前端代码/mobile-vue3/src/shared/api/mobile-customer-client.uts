import { buildMobileRequestPlan, mobileRequestPlanMatchesContract } from './request-context.uts'
import { sendMobileRequest } from './mobile-http.uts'
import { mobileApiOrigin } from '../platform/mobile-runtime-config.uts'
import { currentMerchantRoot, merchantRequestSession } from '../platform/mobile-merchant-session.uts'

// UTS cannot import JSON contract files in the HBuilderX compiler. This runtime
// mirror contains only the transport fields and is asserted against the frozen
// JSON contracts by the mobile test suite.
const customerTransportContract : any = {
	contractVersion: 'mobile-merchant-v1',
	endpoints: {
		queryExclusiveCustomers: { method: 'POST', path: '/mobile/merchant/customers/exclusive/query', requestMetadataProfile: 'MERCHANT_SESSION' },
		queryCustomers: { method: 'POST', path: '/mobile/merchant/customers/query', requestMetadataProfile: 'MERCHANT_SESSION' },
		queryCustomerServiceRecords: { method: 'POST', path: '/mobile/merchant/customers/service-records', requestMetadataProfile: 'MERCHANT_SESSION' },
		queryCustomerRecentSummary: { method: 'POST', path: '/mobile/merchant/customers/recent-summary', requestMetadataProfile: 'MERCHANT_SESSION' },
		queryCustomerOrderRecords: { method: 'POST', path: '/mobile/merchant/customers/order-records', requestMetadataProfile: 'MERCHANT_SESSION' },
		queryCustomerOrderRecordDetail: { method: 'POST', path: '/mobile/merchant/customers/order-record-detail', requestMetadataProfile: 'MERCHANT_SESSION' },
		queryCustomerAssetRecords: { method: 'POST', path: '/mobile/merchant/customers/asset-records', requestMetadataProfile: 'MERCHANT_SESSION' },
		customerProfileDraft: { method: 'GET', path: '/mobile/merchant/customers/profile-draft', requestMetadataProfile: 'MERCHANT_SESSION' },
		customerProfileAvatarUpload: { method: 'POST', path: '/mobile/merchant/customers/profile-avatar', requestMetadataProfile: 'MERCHANT_SESSION' },
		customerProfileDetail: { method: 'GET', path: '/mobile/merchant/customers/:memberId/profile', requestMetadataProfile: 'MERCHANT_SESSION' },
		createCustomerProfile: { method: 'POST', path: '/mobile/merchant/customers/profile', requestMetadataProfile: 'MERCHANT_SESSION' },
		updateCustomerProfile: { method: 'PUT', path: '/mobile/merchant/customers/:memberId/profile', requestMetadataProfile: 'MERCHANT_SESSION' },
		createCustomer: { method: 'POST', path: '/mobile/merchant/customers', requestMetadataProfile: 'MERCHANT_SESSION' },
		unifiedQueryCapabilities: { method: 'GET', path: '/mobile/merchant/customers/unified-query-capabilities', requestMetadataProfile: 'MERCHANT_SESSION' },
		unifiedQueryCommand: { method: 'POST', path: '/mobile/merchant/customers/unified-query/commands', requestMetadataProfile: 'MERCHANT_SESSION' },
		listAudiences: { method: 'GET', path: '/mobile/merchant/customer-audiences', requestMetadataProfile: 'MERCHANT_SESSION' },
		createAudience: { method: 'POST', path: '/mobile/merchant/customer-audiences', requestMetadataProfile: 'MERCHANT_SESSION' },
		overviewAudience: { method: 'GET', path: '/mobile/merchant/customer-audiences/:audienceId/overview', requestMetadataProfile: 'MERCHANT_SESSION' },
		queryAudienceMembers: { method: 'POST', path: '/mobile/merchant/customer-audiences/:audienceId/members/query', requestMetadataProfile: 'MERCHANT_SESSION' }
	},
	requestMetadataProfiles: {
		MERCHANT_SESSION: {
			required: {
				'X-Mobile-Contract-Version': 'contractVersion',
				'X-Mobile-Client-Session-Id': 'clientSessionId',
				'X-Mobile-Platform': 'platform',
				'X-Mobile-Request-Id': 'requestId',
				Authorization: 'Bearer <merchantToken>',
				'X-Mobile-Active-Context-Id': 'activeContextId',
				'X-Mobile-State-Context-Id': 'stateContextId'
			},
			forbidden: ['X-Mobile-App-Session', 'Cookie', 'queryToken', 'bodyToken', 'headerAlias']
		}
	}
}

function merchantPlan(endpointName : string) : any {
	let root = currentMerchantRoot()
	let session = merchantRequestSession(root)
	if (session == null) return null
	let plan = buildMobileRequestPlan(customerTransportContract, endpointName, session)
	return mobileRequestPlanMatchesContract(customerTransportContract, endpointName, session, plan) ? plan : null
}

export function queryMobileCustomers(exclusiveOnly : boolean, payload : any, done : (value : any) => void) : void {
	let endpoint = exclusiveOnly ? 'queryExclusiveCustomers' : 'queryCustomers'
	let plan = merchantPlan(endpoint)
	if (plan == null) { done({ ok: false, message: '请先完成商家端登录。', body: null }); return }
	sendMobileRequest(plan, payload, done)
}

