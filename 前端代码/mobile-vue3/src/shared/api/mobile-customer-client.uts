	if (plan == null) { done({ ok: false, message: '请先完成商家端登录。', body: null }); return }
	sendMobileRequest(plan, {}, done)
}

export function uploadMobileCustomerProfileAvatar(filePath : string, idempotencyKey : string, done : (value : any) => void) : void {
	let plan = merchantPlan('customerProfileAvatarUpload')
	let origin = mobileApiOrigin()
	if (plan == null) { done({ ok: false, message: '请先完成商家端登录。', body: null }); return }
	if (origin.length == 0 || filePath.length == 0) { done({ ok: false, message: '未选择头像图片。', body: null }); return }
	uni.uploadFile({
		url: origin + '/api' + plan.path, filePath: filePath, name: 'file', header: plan.headers, formData: { idempotencyKey: idempotencyKey },
		success: (response : any) => {
			let payload : any = null
			try { payload = typeof response.data === 'string' ? JSON.parse(response.data) : response.data } catch (error) { payload = null }
			let ok = response.statusCode >= 200 && response.statusCode < 300 && payload != null && payload.protocolCode == null && payload.errorCode == null
			let message = payload != null ? String(payload.message || '') : ''
			done({ ok: ok, statusCode: response.statusCode, body: payload, message: ok ? '' : (message || '头像上传未完成。') })
		},
		fail: () => done({ ok: false, statusCode: 0, body: null, message: '头像上传失败，请检查网络后重试。' })
	})
}

export function queryMobileCustomerProfile(memberId : string, done : (value : any) => void) : void {
	let plan = merchantPlan('customerProfileDetail')
	if (plan == null) { done({ ok: false, message: '请先完成商家端登录。', body: null }); return }
	plan.path = plan.path.replace(':memberId', memberId)
	sendMobileRequest(plan, {}, done)
}

