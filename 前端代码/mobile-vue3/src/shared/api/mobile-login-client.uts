import { mobileApiOrigin, setMobileApiOrigin } from '../platform/mobile-runtime-config.uts'
import { saveMerchantRoot } from '../platform/mobile-merchant-session.uts'
import { currentMobilePlatform } from '../platform/mobile-platform.uts'
import { merchantRootInstallDecision } from '../../app/state/root-state.uts'

const CLIENT_SESSION_KEY = 'mobile.client.session.id'
const DEVICE_KEY = 'mobile.installation.id'

function opaque(prefix : string) : string {
	return prefix + '-' + Date.now().toString() + '-' + Math.floor(Math.random() * 100000000).toString()
}

function storedOpaque(key : string, prefix : string) : string {
	let value = String(uni.getStorageSync(key) || '')
	if (value.length >= 8) return value
	value = opaque(prefix)
	uni.setStorageSync(key, value)
	return value
}

function commonHeaders(contractVersion : string) : any {
	return {
		'X-Mobile-Contract-Version': contractVersion,
		'X-Mobile-Client-Session-Id': storedOpaque(CLIENT_SESSION_KEY, 'mobile-client'),
		'X-Mobile-Platform': currentMobilePlatform(),
		'X-Mobile-Request-Id': opaque('mobile-request')
	}
}

function request(method : string, path : string, headers : any, payload : any, done : (value : any) => void) : void {
	let origin = mobileApiOrigin()
	if (origin.length == 0) { done({ ok: false, message: '请先填写服务地址。', body: null }); return }
	let requestHeaders : any = { 'Content-Type': 'application/json' }
	let names = Object.keys(headers)
	for (let index = 0; index < names.length; index++) requestHeaders[names[index]] = headers[names[index]]
	uni.request({
		url: origin + '/api' + path,
		method: method,
		header: requestHeaders,
		data: payload,
		success: (response : any) => {
			let body = response.data
			let ok = response.statusCode >= 200 && response.statusCode < 300 && body != null && body.protocolCode == null && body.errorCode == null
			done({ ok: ok, message: ok ? '' : String((body != null && body.message) || '请求未完成。'), body: body })
		},
		fail: () => done({ ok: false, message: '无法连接服务地址。', body: null })
	})
}

export function currentMobileApiOrigin() : string {
	return mobileApiOrigin()
}

export function updateMobileApiOrigin(value : string) : boolean {
	return setMobileApiOrigin(value)
}

export function enterMerchantWithPassword(account : string, password : string, done : (value : any) => void) : void {
	let normalizedAccount = account.trim()
	if (normalizedAccount.length == 0 || password.length == 0) {
		done({ ok: false, message: '请输入员工账号和密码。' })
		return
	}
	let deviceId = storedOpaque(DEVICE_KEY, 'mobile-device')
	request('POST', '/mobile/merchant/password-login', commonHeaders('mobile-merchant-v1'), {
		account: normalizedAccount, pwd: password, installationId: deviceId, idempotencyKey: opaque('merchant-password')
	}, (merchant : any) => {
		if (!merchant.ok) { done(merchant); return }
		let root = merchant.body
		let decision = merchantRootInstallDecision(
			String(root.contractVersion || ''), 'mobile-merchant-v1', root.employee != null && root.employee.status == 'ACTIVE',
			Number(root.authVersion || 0), String(root.activeContextId || ''), String(root.stateContextId || ''),
			String(root.stateRevision || ''), root.dataScope != null && root.dataScope.authorized == true,
			Number(root.dataScope != null ? root.dataScope.scopeEntryCount || 0 : 0), String(root.dataScope != null ? root.dataScope.scopeDigest || '' : '')
		)
		if (decision != 'ACCEPT') { done({ ok: false, message: '商家端根状态校验失败：' + decision }); return }
		saveMerchantRoot(root)
		done({ ok: true, message: '', root: root })
	})
}

// The same sequence is used by App and mini-program adapters.  The local
// development provider accepts its configured captcha/SMS values; production
// callers supply their provider-issued captcha token and never receive an SMS
// code from this client.
export function enterMerchantWithSms(phone : string, captchaProviderToken : string, smsCode : string, done : (value : any) => void) : void {
	let normalizedPhone = phone.trim()
	if (!/^1[3-9][0-9]{9}$/.test(normalizedPhone)) { done({ ok: false, message: '请输入 11 位手机号码。' }); return }
	if (!/^[0-9]{6}$/.test(smsCode.trim())) { done({ ok: false, message: '请输入 6 位验证码。' }); return }
	let deviceId = storedOpaque(DEVICE_KEY, 'mobile-device')
	let publicHeaders = commonHeaders('mobile-auth-v1')
	request('POST', '/mobile/auth/captcha/challenges', publicHeaders, {
		phone: normalizedPhone, purpose: 'APP_LOGIN', deviceId: deviceId
	}, (captcha : any) => {
		if (!captcha.ok) { done(captcha); return }
		request('POST', '/mobile/auth/captcha/verify', commonHeaders('mobile-auth-v1'), {
			challengeId: String(captcha.body.challengeId || ''), deviceId: deviceId, captchaProviderToken: captchaProviderToken.trim()
		}, (proof : any) => {
			if (!proof.ok) { done(proof); return }
			request('POST', '/mobile/auth/sms/challenges', commonHeaders('mobile-auth-v1'), {
				phone: normalizedPhone, purpose: 'APP_LOGIN', deviceId: deviceId,
				captchaProof: String(proof.body.captchaProof || ''), idempotencyKey: opaque('sms')
			}, (sms : any) => {
				if (!sms.ok) { done(sms); return }
				request('POST', '/mobile/auth/sms/verify', commonHeaders('mobile-auth-v1'), {
					challengeId: String(sms.body.challengeId || ''), code: smsCode.trim(), idempotencyKey: opaque('verify')
				}, (verified : any) => {
					if (!verified.ok) { done(verified); return }
					let appToken = String(verified.body.appSession != null ? verified.body.appSession.accessToken || '' : '')
					if (appToken.length == 0 || !Array.isArray(verified.body.availableModes) || verified.body.availableModes.indexOf('merchant') < 0) {
						done({ ok: false, message: '当前手机号没有可用的商家端身份。' }); return
					}
					let exchangeHeaders = commonHeaders('mobile-merchant-v1')
					exchangeHeaders['X-Mobile-App-Session'] = appToken
					request('POST', '/mobile/merchant/session', exchangeHeaders, { idempotencyKey: opaque('merchant-session') }, (merchant : any) => {
						if (!merchant.ok) { done(merchant); return }
						let root = merchant.body
						let decision = merchantRootInstallDecision(
							String(root.contractVersion || ''), 'mobile-merchant-v1', root.employee != null && root.employee.status == 'ACTIVE',
							Number(root.authVersion || 0), String(root.activeContextId || ''), String(root.stateContextId || ''),
							String(root.stateRevision || ''), root.dataScope != null && root.dataScope.authorized == true,
							Number(root.dataScope != null ? root.dataScope.scopeEntryCount || 0 : 0), String(root.dataScope != null ? root.dataScope.scopeDigest || '' : '')
						)
						if (decision != 'ACCEPT') { done({ ok: false, message: '商家端根状态校验失败：' + decision }); return }
						uni.setStorageSync('mobile.app.session', verified.body.appSession)
						saveMerchantRoot(root)
						done({ ok: true, message: '', root: root })
					})
				})
			})
		})
	})
}
