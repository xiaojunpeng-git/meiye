<template>
  <view v-if="enabled" class="ai-entry" role="button" aria-label="打开魔核 AI 工作台" @tap="openPanel"><image class="ai-entry-icon" src="/static/mohe-ai-entry-orbits.gif" mode="aspectFit" /></view>
  <view v-if="opened" class="ai-panel" :class="{ 'ai-panel--native-mini': platformUsesNativeCanvas }" :style="platformUsesNativeCanvas ? { paddingTop: nativePanelTop + 'px' } : {}">
    <view class="ai-workspace-head">
      <!-- 左右对称避让原生胶囊，让标题相对屏幕居中；退出沿用closePanel，不删除会话或取消任务。 -->
      <view class="ai-title-row" :style="platformUsesNativeCanvas ? { height: nativeTitleHeight + 'px', paddingLeft: nativeCapsuleSpace + 'px', paddingRight: nativeCapsuleSpace + 'px' } : {}">
        <view class="ai-back-button" role="button" aria-label="退出魔核 AI" @tap="closePanel"><text class="ai-back-chevron">‹</text></view>
        <text class="ai-title">魔核AI 1.0</text>
      </view>
      <!-- 标语独立放在标题行下方，保留原生胶囊对齐和返回按钮触控区域。 -->
      <text class="ai-brand-tagline">够智能、够准确、够便捷</text>
    </view>
    <scroll-view scroll-y="true" class="ai-messages" :scroll-into-view="messageAnchor">
      <view v-for="(item,index) in displayed" :key="index" :id="turnAnchor(item,index)" class="ai-message">
        <view class="ai-user-turn"><text class="ai-turn-label">你问</text><text class="ai-question">{{ item.question }}</text></view>
        <text v-if="elapsedLabel(item.elapsed_seconds).length > 0" class="ai-run-complete">{{ elapsedLabel(item.elapsed_seconds) }}</text>
        <view class="ai-answer-turn"><text class="ai-turn-label">魔核 AI</text><view v-if="collectionSections(item.presentation).length > 0" class="ai-answer-presentation"><view v-for="section in collectionSections(item.presentation)" :key="section.id" class="ai-answer-section-group"><text class="ai-answer-section">{{ section.title }}</text><text class="ai-answer">{{ section.answer.summary }}</text><view v-for="(card,ci) in section.answer.cards || []" :key="ci" class="ai-card"><text class="ai-card-label">{{ card.metric_name }}</text><text class="ai-number">{{ card.display_value }}{{ card.unit }}</text><text v-if="card.period_label" class="ai-note">{{ card.period_label }}</text></view><view v-if="section.answer.table != null" class="ai-result-table"><view class="ai-result-table__row ai-result-table__head"><text v-for="column in section.answer.table.columns" :key="column.key" class="ai-result-table__cell">{{ column.label }}</text></view><view v-for="(row,ri) in section.answer.table.rows" :key="ri" class="ai-result-table__row"><text v-for="column in section.answer.table.columns" :key="column.key" class="ai-result-table__cell">{{ row[column.key] }}</text></view></view></view></view><view v-else-if="answerPresentation(item.presentation) != null" class="ai-answer-presentation"><view v-for="presentation in [answerPresentation(item.presentation)]" :key="presentation.version"><text class="ai-answer-headline">{{ presentation.headline }}</text><view v-for="(group,gi) in presentationGroups(presentation.facts)" :key="gi" class="ai-answer-section-group"><text v-if="group.section.length > 0" class="ai-answer-section">{{ group.section }}</text><view class="ai-answer-facts"><view v-for="(fact,fi) in group.facts" :key="fi" class="ai-answer-fact-wrap"><view class="ai-answer-fact"><text class="ai-answer-fact__label">{{ fact.label }}</text><text class="ai-answer-fact__value" :class="{ 'ai-number--count': fact.unit != '元' }">{{ fact.value }}<text class="ai-unit">{{ fact.unit }}</text></text></view></view></view></view><text v-if="presentation.period_label.length > 0" class="ai-note ai-answer-period">{{ presentation.period_label }}</text><text v-for="(note,ni) in presentation.notes" :key="ni" class="ai-note ai-answer-note">{{ note }}</text></view></view><text v-else class="ai-answer">{{ item.answer }}</text></view>
        <view v-for="(card,ci) in item.cards" :key="ci" class="ai-card">
          <text class="ai-card-label">{{ card.metric_name }}</text>
          <text class="ai-number">{{ card.display_value }}{{ card.unit }}</text>
          <text v-if="card.period_label" class="ai-note">{{ card.period_label }}</text>
          <view v-if="tooltipText(card.tooltip).length > 0" class="ai-card-detail-toggle" role="button" @tap="toggleCardDetail(cardKey(item,ci))"><text class="ai-card-detail-chevron">›</text><text>{{ cardDetailVisible(cardKey(item,ci)) ? '收起统计口径' : '统计口径' }}</text></view>
          <text v-if="cardDetailVisible(cardKey(item,ci))" class="ai-card-detail">{{ tooltipText(card.tooltip) }}</text>
        </view>
        <view v-if="item.table != null" class="ai-result-table"><view class="ai-result-table__row ai-result-table__head"><text v-for="column in item.table.columns" :key="column.key" class="ai-result-table__cell">{{ column.label }}</text></view><view v-for="(row,ri) in item.table.rows" :key="ri" class="ai-result-table__row"><text v-for="column in item.table.columns" :key="column.key" class="ai-result-table__cell">{{ row[column.key] }}</text></view></view>
        <view v-if="item.export_status != null" class="ai-card"><text class="ai-note">{{ exportStatusLabel(item.export_status) }}</text><button v-if="item.export_status == 'succeeded' && exportSource(item) != null" size="mini" @tap="downloadExcel(item)">下载 Excel</button></view>
      </view>
      <view v-if="activeQuestion.length > 0" :id="activeQuestionAnchor" class="ai-message ai-message--active">
        <view class="ai-user-turn"><text class="ai-turn-label">你问</text><text class="ai-question">{{ activeQuestion }}</text></view>
        <view v-if="clarification == null" class="ai-run-status"><text class="ai-run-elapsed">已处理 {{ activeElapsedSeconds }} 秒</text><text class="ai-run-thinking">{{ activeRunState }}</text></view>
      </view>
      <!-- 确认卡属于当前提问，必须位于阅读占位之前；不能让用户穿过整屏空白寻找操作。 -->
      <view v-if="clarification != null" id="ai-guidance-current" class="ai-message ai-guidance">
        <view class="ai-guidance-head"><text>请确认</text><button class="ai-guidance-cancel" :disabled="guidanceBusy || closeRequestedState" @tap="cancelRun">取消查询</button></view>
        <text v-if="clarification.schema_version == guidanceSchema" class="ai-note">第 {{ clarification.round_no }} 步</text>
        <view v-for="(item,si) in clarification.confirmed_summary || []" :key="si"><text class="ai-note">{{ item.label }}：{{ item.value }}</text></view>
        <text class="ai-guidance-question">{{ currentGuidanceQuestion() }}</text>
        <view v-for="field in currentGuidanceFields()" :key="field.key">
          <text class="ai-guidance-label">{{ field.label }}</text>
          <picker v-if="field.type == 'date'" mode="date" :start="field.min || ''" :end="field.max || ''" :disabled="guidanceBusy || guidanceUnknown || closeRequestedState" @change="selectDate(field.key,$event)"><text class="ai-choice">{{ choices[field.key] || '选择日期' }}</text></picker>
          <view v-else-if="field.options.length <= 3" role="radiogroup" :aria-label="field.label"><button v-for="(option,oi) in field.options" :key="option.value" class="ai-guidance-option" :class="{ 'ai-guidance-option--selected': choices[field.key] == option.value }" role="radio" :aria-checked="choices[field.key] == option.value" :disabled="guidanceBusy || guidanceUnknown || closeRequestedState" @tap="chooseValue(field,option)"><text class="ai-guidance-number">{{ oi + 1 }}</text><text class="ai-guidance-option-label">{{ option.label }}</text></button></view>
          <picker v-else :range="field.options" range-key="label" :disabled="guidanceBusy || guidanceUnknown || closeRequestedState" @change="selectOption(field,$event)"><text class="ai-choice">{{ choiceLabels[field.key] || '请选择' }}</text></picker>
        </view>
        <text v-if="progress.length > 0" class="ai-guidance-error" role="alert">{{ progress }}</text>
        <view class="ai-guidance-actions"><button class="ai-guidance-confirm" :disabled="guidanceBusy || closeRequestedState" @tap="confirmChoices">{{ guidanceBusy ? '正在提交' : guidanceUnknown ? '重试确认' : '确认并继续' }}</button></view>
        <view v-if="clarification.revisable_steps != null && clarification.revisable_steps.length > 0"><text class="ai-note">修改已确认条件</text><button v-for="oldStep in clarification.revisable_steps" :key="oldStep.id" size="mini" :disabled="guidanceBusy || guidanceUnknown || closeRequestedState" @tap="editGuidance(oldStep)">{{ oldStep.question }}</button><button v-if="revisingId.length > 0" size="mini" :disabled="guidanceBusy || guidanceUnknown || closeRequestedState" @tap="resetGuidanceChoices">返回当前问题</button></view>
      </view>
      <view v-if="activeQuestion.length > 0 && clarification == null" class="ai-reading-runway"></view>
    </scroll-view>
    <view class="ai-footer">
      <text v-if="showFooterProgress()" class="ai-note ai-progress">{{ progress }}</text>
      <view v-if="composerOptionsOpen" class="ai-composer-options">
        <view class="ai-composer-options__head"><text>{{ historyOpen ? '历史对话' : '更多操作' }}</text><button class="ai-composer-options__close" aria-label="关闭菜单" @tap="closeComposerOptions">×</button></view>
        <view v-if="!historyOpen" class="ai-composer-options__actions">
          <button class="ai-composer-option" :class="{ 'ai-composer-option--selected': wantExcel && excelAvailable }" :disabled="!excelAvailable" :aria-pressed="wantExcel && excelAvailable" @tap="toggleExcel">生成Execl<text class="ai-composer-option__state">{{ wantExcel && excelAvailable ? '已选中' : '' }}</text></button>
          <button class="ai-composer-option" :disabled="busy || pending != null" @tap="createConversationFromMenu">新增对话</button>
          <button class="ai-composer-option" :disabled="busy || pending != null || displayed.length == 0" @tap="confirmClearConversation">清空对话</button>
          <button class="ai-composer-option" :disabled="busy || pending != null" @tap="openHistory">历史对话</button>
        </view>
        <view v-else class="ai-composer-history"><button class="ai-composer-history__back" @tap="historyOpen = false">‹ 返回</button><scroll-view v-if="recentConversations.length > 0" scroll-y="true" class="ai-composer-history__list"><button v-for="session in recentConversations" :key="session.id" class="ai-composer-history__item" :class="{ 'ai-composer-history__item--current': session.id == conversation }" @tap="selectConversation(session.id)">{{ conversationTitle(session) }}</button></scroll-view><text v-else class="ai-composer-history__empty">暂无历史对话</text></view>
      </view>
      <!-- A single line stays between the two actions; wrapped text grows above them. -->
      <view class="ai-composer" :class="{ 'ai-composer--expanded': composerExpanded }">
        <button class="ai-composer-more" :class="{ 'ai-composer-more--selected': composerOptionsOpen }" aria-label="更多操作" :aria-expanded="composerOptionsOpen" @tap="toggleComposerOptions"><view class="ai-icon-action"><view class="ai-icon-action__stroke"></view><view class="ai-icon-action__stroke ai-icon-action__stroke--plus"></view></view></button>
        <!-- 双端不展示默认提示；无障碍名称不填入用户问题。 -->
        <textarea v-model="question" aria-label="输入问题" :maxlength="4000" :fixed="platformUsesNativeCanvas" :auto-height="false" :style="{ height: composerInputHeight + 'px' }" class="ai-input" @input="onComposerInput" @linechange="onComposerLineChange"/>
        <button v-if="!busy" class="ai-submit" :disabled="question.trim().length == 0" aria-label="发送问题" @tap="submit"><view class="ai-icon-send"><view class="ai-icon-send__shaft"></view><view class="ai-icon-send__head-left"></view><view class="ai-icon-send__head-right"></view></view></button>
        <button v-else class="ai-submit ai-submit--stop" aria-label="停止回答" @tap="cancelRun">停止</button>
      </view>
    </view>
  </view>
</template>
<script setup lang="uts">
import { mobileAiRequest, downloadMobileAi } from '../api/mobile-ai-client.uts'
import { currentMobilePlatform } from '../platform/mobile-platform.uts'
const enabled = ref(false), opened = ref(false), busy = ref(false)
// 原生胶囊坐标决定单行导航的顶部、高度和对称留白，标题不偏移也不覆盖胶囊。
const platformUsesNativeCanvas = currentMobilePlatform() === 'MP_WEIXIN'
const nativePanelTop = ref(0)
const nativeTitleHeight = ref(32), nativeCapsuleSpace = ref(100)
// 打开面板时重新测量；坐标不可用时采用状态栏后的标准导航区域。
function measureNativePanelTop() : void {
  if (!platformUsesNativeCanvas) return
  const capsule = uni.getMenuButtonBoundingClientRect()
  const windowInfo = uni.getWindowInfo()
  const statusBarHeight = Number(windowInfo.statusBarHeight || 0)
  const top = Number(capsule.top), height = Number(capsule.height), left = Number(capsule.left)
  nativePanelTop.value = Number.isFinite(top) && top >= statusBarHeight ? top : statusBarHeight + 6
  nativeTitleHeight.value = Number.isFinite(height) && height > 0 ? height : 32
  nativeCapsuleSpace.value = Number.isFinite(left) && left > 0 ? Math.max(0, Number(windowInfo.windowWidth) - left) : 100
}
const question = ref(''), progress = ref(''), displayed = ref<Array<any>>([]), activeQuestion = ref(''), activeQuestionAnchor = ref(''), messageAnchor = ref(''), activeElapsedSeconds = ref(0), activeRunState = ref('正在思考'), expandedCardKeys = ref<Array<string>>([])
const clarification = ref<any>(null), choices = ref<any>({}), choiceLabels = ref<any>({})
const guidanceSchema = 'mohe-clarification-v2'
const guidanceBusy = ref(false), guidanceUnknown = ref(false), closeRequestedState = ref(false), revisingId = ref('')
let guidanceSubmission : any = null, queuedClarificationId = '', activeGuidanceSchema = ''
const composerOptionsOpen = ref(false), historyOpen = ref(false), recentConversations = ref<Array<any>>([]), composerExpanded = ref(false)
const composerInputHeight = ref(38)
// 原生textarea以真实换行事件驱动显式高度，不依赖模拟器的auto-height布局。
// 28px行高+10px内边距，与ai-input保持一致；最多144px，超出由原生输入框滚动。
// 不读取question：真机linechange可能早于v-model更新；输入区宽度不得随展开改变。
function onComposerLineChange(event : any) : void {
  const lines = Number(event.detail.lineCount)
  if (!Number.isFinite(lines) || lines < 1) return
  composerInputHeight.value = Math.min(144, 28 * lines + 10)
  composerExpanded.value = lines > 1
}
// 清空和发送立即复位，不等待原生控件再次上报行数；不修改输入内容或触发查询。
function resetComposerSize() : void {
  composerInputHeight.value = 38
  composerExpanded.value = false
}
function onComposerInput(event : any) : void {
  if (event.detail.value == '') resetComposerSize()
}
const wantExcel = ref(false)
const excelAvailable = ref(false)
// The button chooses the existing export format; unavailable exports cannot
// be selected, and tapping does not start a query or file generation task.
function toggleExcel() : void {
  if (!excelAvailable.value) return
  wantExcel.value = !wantExcel.value
}
function closeComposerOptions() : void { composerOptionsOpen.value = false; historyOpen.value = false }
function toggleComposerOptions() : void { if (composerOptionsOpen.value) closeComposerOptions(); else { historyOpen.value = false; composerOptionsOpen.value = true } }
// Delivery proofs are transient device state, never serialized into chat history.
let exportSources : Array<any> = []
let exportLifecycle = 0
function exportStatusLabel(status : string) : string { return status == 'succeeded' ? 'Excel 已生成' : status == 'running' ? 'Excel 正在生成…' : status == 'pending' ? 'Excel 正在排队…' : 'Excel 生成失败，问答结果不受影响。' }
function exportSource(item : any) : any { let found : any = null; exportSources.some((source : any) => { if (source.run_id == item.run_id && source.generation == item.generation) { found = source; return true }; return false }); return found }
function setExportStatus(source : any,status : string) : void {
  // Keep the receipt on its original turn even if the merchant opens another
  // conversation while the independent file worker is still running.
  let all = load()
  all.forEach((session : any) => { if (session.id == source.export_conversation) session.rounds = session.rounds.map((item : any) => item.run_id == source.run_id && item.generation == source.generation ? {...item,export_status:status} : item) })
  uni.setStorageSync(storageKey,all)
  if (conversation == source.export_conversation) displayed.value = displayed.value.map((item : any) => item.run_id == source.run_id && item.generation == source.generation ? {...item,export_status:status} : item)
}
// A file task starts only after the answer is visible and keeps polling while
// the next customer question uses the ordinary, independent Run path.
function startIndependentExport(source : any) : void {
  source.export_conversation = conversation
  let expectedLifecycle = exportLifecycle
  exportSources.push(source)
  let proof : any = {client_session_id:sessionId,run_delivery_token:source.run_delivery_token,generation:source.generation}
  let path = '/runs/' + source.run_id
  let observe = (receipt : any) : void => {
    if (expectedLifecycle != exportLifecycle) return
    let status = String(receipt.status || 'failed'); setExportStatus(source,status)
    if (status != 'pending' && status != 'running') return
    setTimeout(() => { if (expectedLifecycle != exportLifecycle) return
      mobileAiRequest('GET',path + '/export-status',proof,(result : any) => { if (result.ok) observe(result.data); else setExportStatus(source,'failed') })
    },1500)
  }
  setExportStatus(source,'pending')
  mobileAiRequest('POST',path + '/export',proof,(result : any) => { if (result.ok) observe(result.data); else setExportStatus(source,'failed') })
}
let bootstrap : any = null, run : any = null, pending : any = null, compatibilityExecuting = false
let conversation = '', storageKey = '', runtimeKey = '', sessionId = '', entryId = id(), timer : any = null, expiryTimer : any = null, elapsedTimer : any = null, closeRequested = false, lifecycle = 0, clientDeliveryStartedAt = 0
function id() : string { return 'device-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2) + Math.random().toString(36).slice(2) }
function turnAnchor(item : any,index : number) : string { return item != null && typeof item.run_id == 'string' && item.run_id.length > 0 ? 'ai-turn-' + item.run_id + '-' + String(item.generation || 0) : 'ai-history-' + String(index) }
function refreshActiveElapsed() : void { activeElapsedSeconds.value = Math.max(0,Math.floor((Date.now() - clientDeliveryStartedAt) / 1000)) }
function startActiveRunStatus() : void {
  if (activeQuestion.value.length == 0) return
  // The timer starts from the customer's submit/confirmation action, rather
  // than from queue admission, so the visible number covers every wait before
  // the first answer without exposing server internals or query content.
  activeRunState.value = '正在思考'; refreshActiveElapsed()
  if (elapsedTimer != null) clearInterval(elapsedTimer)
  elapsedTimer = setInterval(() => refreshActiveElapsed(),250)
}
// 等待用户选择不是模型处理时间；每次确认重新计时，恢复旧会话也不得继续累加等待。
function pauseForGuidance() : void {
  if (elapsedTimer != null) clearInterval(elapsedTimer)
  elapsedTimer = null
  activeRunState.value = '请确认下方问题'
  messageAnchor.value = ''
  nextTick(() => { messageAnchor.value = 'ai-guidance-current' })
}
function completedElapsedSeconds() : number { return Number.isSafeInteger(clientDeliveryStartedAt) && clientDeliveryStartedAt > 0 ? Math.max(0,Math.floor((Date.now() - clientDeliveryStartedAt) / 1000)) : 0 }
// Keep the visible duration customer-centred: it measures send-to-first-answer
// on this device, not an unverified server duration. Zero-second answers stay
// quiet so the label only appears when it adds useful reading context.
function elapsedLabel(value : any) : string { let seconds = Number.isSafeInteger(value) && value > 0 ? Number(value) : 0; if (seconds == 0) return ''; let minutes = Math.floor(seconds / 60), remainder = seconds % 60; return minutes > 0 ? '用时 ' + String(minutes) + ' 分钟' + (remainder > 0 ? ' ' + String(remainder) + ' 秒' : '') : '用时 ' + String(seconds) + ' 秒' }
function finishActiveRunStatus() : void { if (elapsedTimer != null) clearInterval(elapsedTimer); elapsedTimer = null; activeElapsedSeconds.value = 0; activeRunState.value = '正在思考' }
// Admission failure is not a running query. Remove only its waiting bubble;
// retained history and an uncertain request's idempotency key stay untouched.
function stopQuestionWait() : void {
  finishActiveRunStatus(); activeQuestion.value = ''; activeQuestionAnchor.value = ''; busy.value = false
}
// Authentication loss stops observation, not the server task. Preserve its
// recovery envelope for the same account after login; never claim cancellation
// or automatically replay the question with a different login context.
function pauseForExpiredLogin(result : any) : boolean {
  if (result == null || result.ok === true || result.reason != 'MERCHANT_SESSION_EXPIRED') return false
  lifecycle++; if (timer != null) clearTimeout(timer); timer = null
  if (pending != null && typeof pending.question == 'string') question.value = pending.question
  stopQuestionWait(); guidanceBusy.value = false; clarification.value = null
  if (run != null || pending != null) persistActive(true)
  progress.value = '登录已失效，请退出魔核 AI，重新登录商家端后再试。'
  return true
}
function showActiveQuestion(value : string) : void {
  activeQuestion.value = value; activeQuestionAnchor.value = 'ai-active-' + id()
  // Native scroll-view clamps a newest short turn at its lower edge unless
  // content follows it. The visual runway below this turn makes the active
  // question reachable at the reading top without becoming transcript data.
  messageAnchor.value = activeQuestionAnchor.value; startActiveRunStatus()
}
// A terminal error already rendered in its turn must not be repeated above the composer.
function showFooterProgress() : boolean { if (progress.value.length == 0 || activeQuestion.value.length > 0) return false; const last = displayed.value.length > 0 ? displayed.value[displayed.value.length - 1] : null; return last == null || String(last.answer || '').trim() != progress.value.trim() }
function presentationReady(value : any) : boolean { return value != null && value.version == 1 && typeof value.headline == 'string' && typeof value.period_label == 'string' && Array.isArray(value.facts) && Array.isArray(value.notes) && value.facts.every((item : any) => item != null && typeof item.label == 'string' && typeof item.value == 'string' && typeof item.unit == 'string' && (item.section == null || typeof item.section == 'string')) && value.notes.every((note : any) => typeof note == 'string') }
function collectionSections(value : any) : Array<any> { if (value == null || !Array.isArray(value.sections) || value.sections.length < 2 || value.sections.length > 4) return []; let seen : Array<string> = [], out : Array<any> = []; value.sections.forEach((section : any) => { if (section != null && typeof section.id == 'string' && /^q[1-4]$/.test(section.id) && seen.indexOf(section.id) < 0 && typeof section.title == 'string' && section.title.length > 0 && section.title.length <= 64 && section.answer != null && typeof section.answer == 'object' && !Array.isArray(section.answer) && !Array.isArray(section.answer.sections)) { seen.push(section.id); out.push(section) } }); return out.length == value.sections.length ? out : [] }
// Stored turns contain the whole answer, as on desktop. Older flat presentations remain readable.
function answerPresentation(answer : any) : any { if (answer == null) return null; if (presentationReady(answer.presentation)) return answer.presentation; return presentationReady(answer) ? answer : null }
// Group only by the server-provided section, preserving fact order and values; never infer metric meaning from labels.
function presentationGroups(facts : Array<any>) : Array<any> { let groups : Array<any> = []; facts.forEach((fact : any) => { const section = typeof fact.section == 'string' ? fact.section : ''; let group : any = null; groups.forEach((candidate : any) => { if (candidate.section == section) group = candidate }); if (group == null) { group = {section:section,facts:[]}; groups.push(group) }; group.facts.push(fact) }); return groups }
function tooltipText(value : any) : string { if (value == null) return ''; if (typeof value == 'string') return String(value); let lines : Array<string> = []; ['summary','include','exclude','timing','note'].forEach((key : string) => { if (typeof value[key] == 'string' && String(value[key]).length > 0) { let label = key == 'include' ? '包含：' : key == 'exclude' ? '不包含：' : key == 'timing' ? '统计时间：' : key == 'note' ? '说明：' : ''; lines.push(label + String(value[key])) } }); return lines.join('\n') }
function cardKey(item : any,index : number) : string { return String(item != null && item.run_id != null ? item.run_id : 'history') + ':' + String(item != null && item.generation != null ? item.generation : 0) + ':' + String(index) }
function cardDetailVisible(key : string) : boolean { return expandedCardKeys.value.indexOf(key) >= 0 }
function toggleCardDetail(key : string) : void { let next = expandedCardKeys.value.slice(); let index = next.indexOf(key); if (index >= 0) next.splice(index,1); else next.push(key); expandedCardKeys.value = next }
function terminal() : boolean { return run != null && ['COMPLETED','PARTIAL_SUCCEEDED','FAILED','CANCELLED'].indexOf(String(run.status)) >= 0 }
function load() : Array<any> { let raw = uni.getStorageSync(storageKey); let now = Date.now(); let all : Array<any> = []; if (Array.isArray(raw)) raw.forEach((s : any) => { if (s != null && typeof s.id == 'string' && Number.isSafeInteger(s.created_at) && s.created_at <= now && s.created_at + 86400000 > now && Array.isArray(s.rounds)) { s.rounds = s.rounds.filter((r : any) => r != null && typeof r.question == 'string' && typeof r.answer == 'string' && Number.isSafeInteger(r.created_at) && r.created_at <= now && r.created_at + 86400000 > now); all.push(s) } }); uni.setStorageSync(storageKey,all); return all }
