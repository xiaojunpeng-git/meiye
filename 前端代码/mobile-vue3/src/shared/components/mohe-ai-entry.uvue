  all.forEach((s : any) => { if (s.id == conversation && s.rounds.some((item : any) => item.run_id == row.run_id && item.generation == row.generation)) duplicate = true })
  if (!displayed.value.some((item : any) => item.run_id == row.run_id && item.generation == row.generation)) displayed.value.push(row)
