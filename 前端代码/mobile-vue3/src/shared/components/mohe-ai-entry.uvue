<template>
  <view v-if="enabled" class="ai-entry" @tap="openPanel"><text>魔核 AI</text></view>
  <view v-if="opened" class="ai-panel">
    <view class="ai-head"><text class="ai-title">魔核 AI</text><button size="mini" @tap="showHistory">历史</button><button size="mini" @tap="newConversation">新对话</button><button size="mini" @tap="closePanel">关闭</button></view>
    <scroll-view scroll-y="true" class="ai-messages">
      <text class="ai-note">会话仅存本设备，保留 24 小时。指标与权限以报表为准。</text>
      <view v-for="(item,index) in displayed" :key="index" class="ai-message"><text class="ai-question">{{ item.question }}</text><text>{{ item.answer }}</text>
        <view v-for="(card,ci) in item.cards" :key="ci" class="ai-card"><text>{{ card.metric_name }}</text><text class="ai-number">{{ card.display_value }}{{ card.unit }}</text><text class="ai-note">{{ tooltipText(card.tooltip) }}</text></view>
        <view v-if="item.table != null" class="ai-card"><view v-for="(row,ri) in item.table.rows" :key="ri"><text v-for="column in item.table.columns" :key="column.key">{{ column.label }}：{{ row[column.key] }}　</text></view></view>
      </view>
      <view v-if="clarification != null" class="ai-message"><text>{{ clarification.question }}</text><view v-for="field in clarification.fields" :key="field.key"><text>{{ field.label }}</text><picker v-if="field.type == 'date'" mode="date" @change="selectDate(field.key,$event)"><text class="ai-choice">{{ choices[field.key] || '选择日期' }}</text></picker><picker v-else :range="field.options" range-key="label" @change="selectOption(field,$event)"><text class="ai-choice">{{ choiceLabels[field.key] || '请选择' }}</text></picker></view><button size="mini" @tap="confirmChoices">确认查询</button></view>
      <button v-if="exportReady" size="mini" @tap="downloadExcel">下载 Excel</button>
    </scroll-view>
    <view class="ai-footer"><text class="ai-note">{{ progress }}</text><textarea v-model="question" :placeholder="questionHint()" :maxlength="4000" class="ai-input"/><view class="ai-head"><switch :checked="wantExcel" :disabled="!excelAvailable" @change="wantExcel=$event.detail.value"/><text>{{ excelAvailable ? '同时生成 Excel' : 'Excel 暂未开放' }}</text><button size="mini" :disabled="busy" @tap="submit">发送</button><button size="mini" @tap="cancelRun">停止</button></view></view>
  </view>
</template>
<script setup lang="uts">
import { mobileAiRequest, downloadMobileAi } from '../api/mobile-ai-client.uts'
const enabled = ref(false), opened = ref(false), busy = ref(false)
const question = ref(''), progress = ref(''), displayed = ref<Array<any>>([])
const clarification = ref<any>(null), choices = ref<any>({}), choiceLabels = ref<any>({})
const wantExcel = ref(false), exportReady = ref(false)
const excelAvailable = ref(false)
let bootstrap : any = null, run : any = null, pending : any = null
let conversation = '', storageKey = '', sessionId = '', timer : any = null, expiryTimer : any = null, closeRequested = false
function id() : string { return 'device-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2) + Math.random().toString(36).slice(2) }
function questionHint() : string { return bootstrap != null && bootstrap.capabilities != null && Array.isArray(bootstrap.capabilities.metric_codes) && bootstrap.capabilities.metric_codes.indexOf('consume_amount') >= 0 ? '例如：今天本店消耗业绩多少？' : '请输入要查询的指标和日期' }
function tooltipText(value : any) : string { if (value == null) return ''; if (typeof value == 'string') return String(value); let lines : Array<string> = []; ['summary','include','exclude','timing','note'].forEach((key : string) => { if (typeof value[key] == 'string' && String(value[key]).length > 0) { let label = key == 'include' ? '包含：' : key == 'exclude' ? '不包含：' : key == 'timing' ? '统计时间：' : key == 'note' ? '说明：' : ''; lines.push(label + String(value[key])) } }); return lines.join('\n') }
function terminal() : boolean { return run != null && ['COMPLETED','PARTIAL_SUCCEEDED','FAILED','CANCELLED'].indexOf(String(run.status)) >= 0 }
function load() : Array<any> { let raw = uni.getStorageSync(storageKey); let now = Date.now(); let all : Array<any> = []; if (Array.isArray(raw)) raw.forEach((s : any) => { if (s != null && typeof s.created_at == 'number' && s.created_at <= now && s.created_at + 86400000 > now && Array.isArray(s.rounds)) all.push(s) }); uni.setStorageSync(storageKey,all); return all }
function newConversation() : void { if (busy.value || (pending != null && run == null)) return; let all = load(); conversation = id(); all.push({id:conversation,created_at:Date.now(),rounds:[]}); uni.setStorageSync(storageKey,all); displayed.value = []; run = null; clarification.value = null; exportReady.value = false }
function openPanel() : void { opened.value = true; if (conversation.length == 0) newConversation() }
function binding() : any { return {client_session_id:sessionId,generation:run.generation,run_delivery_token:run.run_delivery_token} }
function schedulePoll() : void { if (timer != null) clearTimeout(timer); timer = setTimeout(() => { if (run == null || terminal()) return; mobileAiRequest('GET','/runs/' + run.run_id,binding(),(r : any) => { if (r.ok) accept(r.data); else { progress.value = '连接中断，暂未确认任务结果。'; schedulePoll() } }) },1500) }
function accept(value : any) : void {
  if (value == null || (run != null && (value.run_id != run.run_id || value.generation != run.generation || terminal()))) return
  if (run != null && value.run_delivery_token == null) value.run_delivery_token = run.run_delivery_token
  run = value; progress.value = typeof run.progress == 'string' ? run.progress : '正在处理'
  if (terminal()) { busy.value = false; clarification.value = null; if (timer != null) clearTimeout(timer)
    if (run.answer != null && ['COMPLETED','PARTIAL_SUCCEEDED'].indexOf(String(run.status)) >= 0) { let answer = run.answer; exportReady.value = answer.export != null && answer.export.file_ref != null; let row : any = {question:pending.question,answer:String(answer.summary || ''),cards:answer.cards || [],table:answer.table || null,created_at:Date.now()}; displayed.value.push(row); let all = load(); all.forEach((s : any) => { if (s.id == conversation) s.rounds.push(row) }); uni.setStorageSync(storageKey,all) }
    else progress.value = run.status == 'CANCELLED' ? '已取消' : '本次未能完成，请重新提问。'; pending = null; return }
  if (run.status == 'WAITING_CLARIFICATION') clarification.value = run.clarification; else schedulePoll()
}
function submit() : void {
  if (busy.value || question.value.trim().length == 0) return
  let history : Array<any> = []; load().forEach((s : any) => { if (s.id == conversation) s.rounds.slice(-20).forEach((r : any) => history.push({question:r.question,answer:r.answer})) })
  if (pending == null) pending = {client_request_id:id(),conversation_id:conversation,client_session_id:sessionId,window_token:bootstrap.window_token,question:question.value.trim(),history:history,output_format:wantExcel.value ? 'screen_and_xlsx' : 'screen'}
  exportReady.value = false
  busy.value = true; closeRequested = false; run = null; question.value = ''; progress.value = '正在接纳请求'
  mobileAiRequest('POST','/runs',pending,(r : any) => { if (!r.ok) { busy.value = false; question.value = pending.question; if (r.responseKnown) { pending = null; progress.value = r.message } else progress.value = '请求结果暂未确认，再次发送将重试同一任务。'; return }; if (r.data.accepted === false) { busy.value = false; pending = null; progress.value = r.data.message || '当前使用人数较多，请稍后再问。'; return }; accept(r.data); if (terminal()) return; if (closeRequested) { cancelRun(); return }; let body : any = binding(); body.question = pending.question; body.history = pending.history; body.output_format = pending.output_format; mobileAiRequest('POST','/runs/' + run.run_id + '/execute',body,(e : any) => { if (e.ok) accept(e.data); else schedulePoll() }) })
}
function cancelRun() : void { closeRequested = true; if (run == null || terminal()) return; progress.value = '正在取消'; mobileAiRequest('POST','/runs/' + run.run_id + '/cancel',binding(),(r : any) => { if (r.ok) accept(r.data); else { progress.value = '暂未确认取消结果。'; schedulePoll() } }) }
function closePanel() : void { cancelRun(); opened.value = false }
function downloadExcel() : void { if (run == null || !terminal() || !exportReady.value) return; downloadMobileAi(run,sessionId,String(run.answer.export.filename || '经营数据.xlsx'),(message : string) => { progress.value = message }) }
function selectDate(key : string,event : any) : void { choices.value[key] = event.detail.value }
function selectOption(field : any,event : any) : void { let option = field.options[Number(event.detail.value)]; choices.value[field.key] = option.value; choiceLabels.value[field.key] = option.label }
function confirmChoices() : void { let body : any = binding(); body.clarification_id = clarification.value.id; body.choices = choices.value; mobileAiRequest('POST','/runs/' + run.run_id + '/clarify',body,(r : any) => { if (r.ok) { clarification.value = null; accept(r.data) } else progress.value = '条件确认未完成，请重试。' }) }
function showHistory() : void { if (busy.value || (pending != null && run == null)) return; let all = load(); if (all.length == 0) return; uni.showActionSheet({itemList:all.map((s : any) => s.rounds.length > 0 ? String(s.rounds[0].question).slice(0,25) : '新对话'),success:(r : any) => { conversation = all[r.tapIndex].id; displayed.value = all[r.tapIndex].rounds; run = null; exportReady.value = false }}) }
onMounted(() => { sessionId = id(); mobileAiRequest('GET','/bootstrap',{client_session_id:sessionId},(r : any) => { if (!r.ok || !r.data.enabled) return; bootstrap = r.data; storageKey = 'mohe-ai:v1:' + encodeURIComponent(String(bootstrap.identity_key)); excelAvailable.value = bootstrap.capabilities != null && Array.isArray(bootstrap.capabilities.output_formats) && bootstrap.capabilities.output_formats.indexOf('screen_and_xlsx') >= 0; enabled.value = true }); expiryTimer = setInterval(() => { if (storageKey.length > 0 && !load().some((s : any) => s.id == conversation)) { displayed.value = []; progress.value = '会话已到期，请新建对话。' } },30000) })
onUnmounted(() => { cancelRun(); if (timer != null) clearTimeout(timer); if (expiryTimer != null) clearInterval(expiryTimer) })
</script>
<style>
.ai-entry{position:fixed;left:0;top:50%;z-index:9999;background-color:#5142b5;padding:12px;border-radius:0 12px 12px 0;color:#fff}.ai-panel{position:fixed;left:12px;right:12px;top:40px;bottom:30px;z-index:10000;background-color:#fff;border-radius:16px;padding:14px;display:flex;flex-direction:column}.ai-head{display:flex;flex-direction:row;align-items:center;gap:6px}.ai-title{font-size:18px;flex:1}.ai-messages{flex:1;height:0}.ai-message{padding:12px;margin-top:10px;background-color:#f5f6fa;border-radius:10px}.ai-question{display:block;color:#5142b5;margin-bottom:8px}.ai-note{font-size:12px;color:#65758b}.ai-card{padding:12px;margin-top:8px;background-color:#fff}.ai-number{display:block;font-size:26px;color:#1f5f8b}.ai-input{height:70px;width:100%;background-color:#f5f6fa}.ai-footer{padding-top:12px}.ai-choice{padding:8px;display:block;color:#5142b5}
</style>
