  clientDeliveryStartedAt = 0
  let elapsed = Math.min(300000,Math.max(0,Date.now() - startedAt))
  mobileAiRequest('POST','/runs/' + source.run_id + '/delivery',{client_session_id:sessionId,generation:source.generation,run_delivery_token:source.run_delivery_token,client_elapsed_ms:elapsed},(_: any) => {})
}
function reportVisibleDeliveryAfterRender(source : any) : void {
