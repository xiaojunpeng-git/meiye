function conversationTitle(value : any) : string { let first = value != null && Array.isArray(value.rounds) && value.rounds.length > 0 ? value.rounds[0] : null; return first != null && typeof first.question == 'string' && first.question.trim().length > 0 ? first.question.trim() : '新对话' }
function openHistory() : void {
  if (busy.value || pending != null) return
  recentConversations.value = load().filter((session : any) => session.id == conversation || session.rounds.length > 0).reverse()
  historyOpen.value = true
}
// Switching conversations changes only the visible local transcript; an
// unfinished Run cannot be silently moved under another conversation ID.
function selectConversation(targetId : string) : void {
  if (busy.value || pending != null) return
  let selected : any = null
  load().some((session : any) => { if (session.id == targetId) { selected = session; return true }; return false })
  if (selected == null) { closeComposerOptions(); return }
  conversation = targetId; uni.setStorageSync(storageKey + ':current',conversation); displayed.value = selected.rounds.slice(); expandedCardKeys.value = []
  question.value = ''; progress.value = ''; messageAnchor.value = ''; resetComposerSize()
  closeComposerOptions()
}
function createConversationFromMenu() : void {
  if (busy.value || pending != null) return
  newConversation(); question.value = ''; progress.value = ''; resetComposerSize(); closeComposerOptions()
}
// Clear means deleting only this local conversation after confirmation. Other
// sessions and independently generated Excel files remain untouched.
function confirmClearConversation() : void {
  if (busy.value || pending != null || displayed.value.length == 0) return
  let targetId = conversation
  uni.showModal({title:'清空对话',content:'清空当前对话记录？其他历史对话不会删除。',confirmText:'清空',success:(result : any) => {
    if (!result.confirm || !opened.value || busy.value || pending != null || conversation != targetId) return
