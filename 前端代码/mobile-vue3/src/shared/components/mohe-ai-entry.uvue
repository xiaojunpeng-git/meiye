    if (run.answer != null && ['COMPLETED','PARTIAL_SUCCEEDED'].indexOf(String(run.status)) >= 0 && pending != null && typeof pending.question == 'string') { let answer = run.answer; let elapsedSeconds = completedElapsedSeconds(); let row : any = {question:pending.question,answer:String(answer.summary || ''),cards:answer.cards || [],table:answer.table || null,presentation:answer,elapsed_seconds:elapsedSeconds,run_id:run.run_id,generation:run.generation,created_at:Date.now()}; finishActiveRunStatus(); appendTranscript(row); reportVisibleDeliveryAfterRender(run); if (pending.want_excel === true && run.status == 'COMPLETED') startIndependentExport({...run}) }
    else { let terminalMessage = run.status == 'CANCELLED' ? '已取消' : (typeof run.message == 'string' && run.message.length > 0 ? run.message : '本次未能完成，请重新提问。'); if (pending != null && typeof pending.question == 'string') { let elapsedSeconds = completedElapsedSeconds(); finishActiveRunStatus(); appendTranscript({question:pending.question,answer:terminalMessage,cards:[],table:null,presentation:{summary:terminalMessage,terminal_status:run.status},context_eligible:false,elapsed_seconds:elapsedSeconds,run_id:run.run_id,generation:run.generation,created_at:Date.now()}) }; progress.value = terminalMessage; clientDeliveryStartedAt = 0 }; activeQuestion.value = ''; activeQuestionAnchor.value = ''; pending = null; markResolvedRun(); return }
