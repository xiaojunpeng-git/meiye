<template>
  <view v-if="enabled" class="ai-entry" role="button" aria-label="打开魔核 AI 工作台" @tap="openPanel"><image class="ai-entry-icon" src="/static/mohe-ai-entry-orbits.gif" mode="aspectFit" /></view>
  <view v-if="opened" class="ai-panel" :class="{ 'ai-panel--native-mini': platformUsesNativeCanvas }">
    <view v-if="historyDrawerOpen" class="ai-history-mask" @tap="hideHistory"></view>
    <view v-if="historyDrawerOpen" class="ai-history-drawer">
      <view class="ai-history-drawer__title"><text>近期对话</text></view>
      <scroll-view scroll-y="true" class="ai-history-drawer__list">
        <view v-for="item in historySessions" :key="item.id" class="ai-history-drawer__item" :class="{ 'ai-history-drawer__item--active': item.id == conversation }">
          <view class="ai-history-drawer__select" role="button" @tap="selectHistory(item.id)"><text>{{ historyTitle(item) }}</text></view>
          <view class="ai-history-drawer__delete" :class="{ 'ai-history-drawer__delete--disabled': busy && item.id == conversation }" role="button" :aria-label="'删除对话：' + historyTitle(item)" @tap.stop="deleteHistory(item.id)"><text>×</text></view>
        </view>
      </scroll-view>
    </view>
    <view class="ai-workspace-head">
      <view class="ai-workspace-icon-button ai-workspace-menu" role="button" aria-label="查看近期对话" @tap="showHistory"><view class="ai-icon-menu"><view class="ai-icon-menu__line"></view><view class="ai-icon-menu__line"></view><view class="ai-icon-menu__line"></view></view></view>
      <text class="ai-title">魔核 AI</text>
      <!-- 新建与退出共用同一图标骨架，避免两个头部操作出现尺寸和线宽差异。 -->
      <view class="ai-workspace-actions">
        <view class="ai-workspace-icon-button" role="button" aria-label="新建对话" @tap="newConversation"><view class="ai-icon-action"><view class="ai-icon-action__stroke"></view><view class="ai-icon-action__stroke ai-icon-action__stroke--plus"></view></view></view>
        <view class="ai-workspace-icon-button" role="button" aria-label="退出魔核 AI" @tap="closePanel"><view class="ai-icon-action ai-icon-action--close"><view class="ai-icon-action__stroke"></view><view class="ai-icon-action__stroke ai-icon-action__stroke--close"></view></view></view>
      </view>
    </view>
    <scroll-view scroll-y="true" class="ai-messages" :scroll-into-view="messageAnchor">
      <view v-for="(item,index) in displayed" :key="index" :id="turnAnchor(item,index)" class="ai-message">
        <view class="ai-user-turn"><text class="ai-turn-label">你问</text><text class="ai-question">{{ item.question }}</text></view>
        <view class="ai-answer-turn"><text class="ai-turn-label">魔核 AI</text><view v-if="collectionSections(item.presentation).length > 0" class="ai-answer-presentation"><view v-for="section in collectionSections(item.presentation)" :key="section.id" class="ai-answer-section-group"><text class="ai-answer-section">{{ section.title }}</text><text class="ai-answer">{{ section.answer.summary }}</text><view v-for="(card,ci) in section.answer.cards || []" :key="ci" class="ai-card"><text class="ai-card-label">{{ card.metric_name }}</text><text class="ai-number">{{ card.display_value }}{{ card.unit }}</text><text v-if="card.period_label" class="ai-note">{{ card.period_label }}</text></view><view v-if="section.answer.table != null" class="ai-result-table"><view class="ai-result-table__row ai-result-table__head"><text v-for="column in section.answer.table.columns" :key="column.key" class="ai-result-table__cell">{{ column.label }}</text></view><view v-for="(row,ri) in section.answer.table.rows" :key="ri" class="ai-result-table__row"><text v-for="column in section.answer.table.columns" :key="column.key" class="ai-result-table__cell">{{ row[column.key] }}</text></view></view></view></view><view v-else-if="presentationReady(item.presentation)" class="ai-answer-presentation"><text class="ai-answer-headline">{{ item.presentation.headline }}</text><view v-if="item.presentation.facts.length > 0" class="ai-answer-facts"><view v-for="(fact,fi) in item.presentation.facts" :key="fi" class="ai-answer-fact-wrap"><text v-if="showPresentationSection(item.presentation.facts,fi)" class="ai-answer-section">{{ fact.section }}</text><view class="ai-answer-fact"><text class="ai-answer-fact__label">{{ fact.label }}</text><text class="ai-answer-fact__value">{{ fact.value }}{{ fact.unit }}</text></view></view></view><text class="ai-note ai-answer-period">{{ item.presentation.period_label }}</text><text v-for="(note,ni) in item.presentation.notes" :key="ni" class="ai-note ai-answer-note">{{ note }}</text></view><text v-else class="ai-answer">{{ item.answer }}</text></view>
        <view v-for="(card,ci) in item.cards" :key="ci" class="ai-card">
          <text class="ai-card-label">{{ card.metric_name }}</text>
          <text class="ai-number">{{ card.display_value }}{{ card.unit }}</text>
          <text v-if="card.period_label" class="ai-note">{{ card.period_label }}</text>
          <view v-if="tooltipText(card.tooltip).length > 0" class="ai-card-detail-toggle" role="button" @tap="toggleCardDetail(cardKey(item,ci))"><text class="ai-card-detail-chevron">›</text><text>{{ cardDetailVisible(cardKey(item,ci)) ? '收起统计口径' : '统计口径' }}</text></view>
          <text v-if="cardDetailVisible(cardKey(item,ci))" class="ai-card-detail">{{ tooltipText(card.tooltip) }}</text>
        </view>
        <view v-if="item.table != null" class="ai-result-table"><view class="ai-result-table__row ai-result-table__head"><text v-for="column in item.table.columns" :key="column.key" class="ai-result-table__cell">{{ column.label }}</text></view><view v-for="(row,ri) in item.table.rows" :key="ri" class="ai-result-table__row"><text v-for="column in item.table.columns" :key="column.key" class="ai-result-table__cell">{{ row[column.key] }}</text></view></view>
      </view>
      <view v-if="activeQuestion.length > 0" :id="activeQuestionAnchor" class="ai-message ai-message--active">
        <view class="ai-user-turn"><text class="ai-turn-label">你问</text><text class="ai-question">{{ activeQuestion }}</text></view>
      </view>
      <view v-if="clarification != null" class="ai-message">
        <text v-if="clarification.schema_version == guidanceSchema" class="ai-note">第 {{ clarification.round_no }} 步 · 最多 {{ clarification.max_clarification_rounds }} 步，明确后立即查询</text>
        <view v-for="(item,si) in clarification.confirmed_summary || []" :key="si"><text class="ai-note">{{ item.label }}：{{ item.value }}</text></view>
        <text>{{ currentGuidanceQuestion() }}</text>
        <view v-for="field in currentGuidanceFields()" :key="field.key">
          <text>{{ field.label }}</text>
          <picker v-if="field.type == 'date'" mode="date" :start="field.min || ''" :end="field.max || ''" :disabled="guidanceBusy || guidanceUnknown || closeRequestedState" @change="selectDate(field.key,$event)"><text class="ai-choice">{{ choices[field.key] || '选择日期' }}</text></picker>
          <view v-else-if="field.options.length <= 3"><button v-for="option in field.options" :key="option.value" size="mini" :disabled="guidanceBusy || guidanceUnknown || closeRequestedState" @tap="chooseValue(field,option)">{{ choices[field.key] == option.value ? '● ' : '○ ' }}{{ option.label }}</button></view>
          <picker v-else :range="field.options" range-key="label" :disabled="guidanceBusy || guidanceUnknown || closeRequestedState" @change="selectOption(field,$event)"><text class="ai-choice">{{ choiceLabels[field.key] || '请选择' }}</text></picker>
        </view>
        <button size="mini" :disabled="guidanceBusy || closeRequestedState" @tap="confirmChoices">{{ guidanceUnknown ? '重试确认' : clarification.schema_version == guidanceSchema ? '确认并继续' : '确认查询' }}</button>
        <view v-if="clarification.revisable_steps != null && clarification.revisable_steps.length > 0"><text class="ai-note">修改已确认条件</text><button v-for="oldStep in clarification.revisable_steps" :key="oldStep.id" size="mini" :disabled="guidanceBusy || guidanceUnknown || closeRequestedState" @tap="editGuidance(oldStep)">{{ oldStep.question }}</button><button v-if="revisingId.length > 0" size="mini" :disabled="guidanceBusy || guidanceUnknown || closeRequestedState" @tap="resetGuidanceChoices">返回当前问题</button></view>
      </view>
      <button v-if="exportReady" size="mini" @tap="downloadExcel">下载 Excel</button>
    </scroll-view>
    <view class="ai-footer"><text v-if="progress.length > 0" class="ai-note ai-progress">{{ progress }}</text><view class="ai-composer"><textarea v-model="question" :placeholder="questionHint()" :maxlength="4000" class="ai-input"/><view class="ai-footer-actions"><view class="ai-export-option" role="button" aria-label="同时生成 Excel"><switch :checked="wantExcel" :disabled="!excelAvailable" @change="wantExcel=$event.detail.value"/><text class="ai-export-label">{{ excelAvailable ? '同时生成 Excel' : 'Excel 暂未开放' }}</text></view><view class="ai-submit" :class="{ 'ai-submit--disabled': busy }" role="button" :aria-label="busy ? '正在处理' : '发送问题'" @tap="submit"><view class="ai-icon-send"><view class="ai-icon-send__shaft"></view><view class="ai-icon-send__head-left"></view><view class="ai-icon-send__head-right"></view></view></view><view v-if="busy" class="ai-stop" role="button" @tap="cancelRun"><text>停止</text></view></view></view></view>
  </view>
</template>
<script setup lang="uts">
import { mobileAiRequest, downloadMobileAi } from '../api/mobile-ai-client.uts'
import { currentMobilePlatform } from '../platform/mobile-platform.uts'
const enabled = ref(false), opened = ref(false), busy = ref(false)
// The WeChat mini-program draws its native capsule above the page WebView.
// Keep panel actions below that reserved strip without changing H5/App layout.
const platformUsesNativeCanvas = currentMobilePlatform() === 'MP_WEIXIN'
const question = ref(''), progress = ref(''), displayed = ref<Array<any>>([]), activeQuestion = ref(''), activeQuestionAnchor = ref(''), messageAnchor = ref(''), expandedCardKeys = ref<Array<string>>([]), historyDrawerOpen = ref(false), historySessions = ref<Array<any>>([])
const clarification = ref<any>(null), choices = ref<any>({}), choiceLabels = ref<any>({})
const guidanceSchema = 'mohe-clarification-v2'
const guidanceBusy = ref(false), guidanceUnknown = ref(false), closeRequestedState = ref(false), revisingId = ref('')
let guidanceSubmission : any = null, queuedClarificationId = '', activeGuidanceSchema = ''
const wantExcel = ref(false), exportReady = ref(false)
const excelAvailable = ref(false)
let bootstrap : any = null, run : any = null, pending : any = null, compatibilityExecuting = false
let conversation = '', storageKey = '', runtimeKey = '', sessionId = '', entryId = id(), timer : any = null, expiryTimer : any = null, closeRequested = false, lifecycle = 0, clientDeliveryStartedAt = 0
function id() : string { return 'device-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2) + Math.random().toString(36).slice(2) }
function turnAnchor(item : any,index : number) : string { return item != null && typeof item.run_id == 'string' && item.run_id.length > 0 ? 'ai-turn-' + item.run_id + '-' + String(item.generation || 0) : 'ai-history-' + String(index) }
function showActiveQuestion(value : string) : void { activeQuestion.value = value; activeQuestionAnchor.value = 'ai-active-' + id(); messageAnchor.value = activeQuestionAnchor.value }
function questionHint() : string { return '继续问，例如：按销量看呢？' }
function presentationReady(value : any) : boolean { return value != null && value.version == 1 && typeof value.headline == 'string' && typeof value.period_label == 'string' && Array.isArray(value.facts) && Array.isArray(value.notes) && value.facts.every((item : any) => item != null && typeof item.label == 'string' && typeof item.value == 'string' && typeof item.unit == 'string' && (item.section == null || typeof item.section == 'string')) && value.notes.every((note : any) => typeof note == 'string') }
function collectionSections(value : any) : Array<any> { if (value == null || !Array.isArray(value.sections) || value.sections.length < 2 || value.sections.length > 4) return []; let seen : Array<string> = [], out : Array<any> = []; value.sections.forEach((section : any) => { if (section != null && typeof section.id == 'string' && /^q[1-4]$/.test(section.id) && seen.indexOf(section.id) < 0 && typeof section.title == 'string' && section.title.length > 0 && section.title.length <= 64 && section.answer != null && typeof section.answer == 'object' && !Array.isArray(section.answer) && !Array.isArray(section.answer.sections)) { seen.push(section.id); out.push(section) } }); return out.length == value.sections.length ? out : [] }
function showPresentationSection(facts : any[], index : number) : boolean { const current = facts[index]; return current != null && typeof current.section == 'string' && current.section != '' && (index == 0 || facts[index - 1] == null || facts[index - 1].section != current.section) }
function tooltipText(value : any) : string { if (value == null) return ''; if (typeof value == 'string') return String(value); let lines : Array<string> = []; ['summary','include','exclude','timing','note'].forEach((key : string) => { if (typeof value[key] == 'string' && String(value[key]).length > 0) { let label = key == 'include' ? '包含：' : key == 'exclude' ? '不包含：' : key == 'timing' ? '统计时间：' : key == 'note' ? '说明：' : ''; lines.push(label + String(value[key])) } }); return lines.join('\n') }
function cardKey(item : any,index : number) : string { return String(item != null && item.run_id != null ? item.run_id : 'history') + ':' + String(item != null && item.generation != null ? item.generation : 0) + ':' + String(index) }
function cardDetailVisible(key : string) : boolean { return expandedCardKeys.value.indexOf(key) >= 0 }
function toggleCardDetail(key : string) : void { let next = expandedCardKeys.value.slice(); let index = next.indexOf(key); if (index >= 0) next.splice(index,1); else next.push(key); expandedCardKeys.value = next }
function terminal() : boolean { return run != null && ['COMPLETED','PARTIAL_SUCCEEDED','FAILED','CANCELLED'].indexOf(String(run.status)) >= 0 }
function load() : Array<any> { let raw = uni.getStorageSync(storageKey); let now = Date.now(); let all : Array<any> = []; if (Array.isArray(raw)) raw.forEach((s : any) => { if (s != null && typeof s.id == 'string' && Number.isSafeInteger(s.created_at) && s.created_at <= now && s.created_at + 86400000 > now && Array.isArray(s.rounds)) { s.rounds = s.rounds.filter((r : any) => r != null && typeof r.question == 'string' && typeof r.answer == 'string' && Number.isSafeInteger(r.created_at) && r.created_at <= now && r.created_at + 86400000 > now); all.push(s) } }); uni.setStorageSync(storageKey,all); return all }
// A failed turn is still useful conversation evidence: it records what the
// customer was trying to ask. Its answer and any unverified candidate are not
// usable query context, so only a completed row may supply context_ref.
function contextEligible(row : any) : boolean { return row == null || row.context_eligible !== false }
function appendTranscript(row : any) : void {
  let all = load(), duplicate = false
  all.forEach((s : any) => { if (s.id == conversation && s.rounds.some((item : any) => item.run_id == row.run_id && item.generation == row.generation)) duplicate = true })
  if (!displayed.value.some((item : any) => item.run_id == row.run_id && item.generation == row.generation)) displayed.value.push(row)
  if (!duplicate) { all.forEach((s : any) => { if (s.id == conversation) s.rounds.push(row) }); uni.setStorageSync(storageKey,all) }
  messageAnchor.value = turnAnchor(row,displayed.value.length - 1)
}
function validStoredGuidanceSubmission(value : any) : boolean { return value != null && typeof value == 'object' && typeof value.clarification_id == 'string' && value.clarification_id.length > 0 && typeof value.client_submission_id == 'string' && value.client_submission_id.length > 0 && value.choices != null && typeof value.choices == 'object' && !Array.isArray(value.choices) && (value.schema_version == null || value.schema_version == guidanceSchema) && (value.intent_revision == null || Number.isSafeInteger(value.intent_revision)) && (value.step_revision == null || Number.isSafeInteger(value.step_revision)) }
function validResolvedRun(value : any) : boolean { return value != null && typeof value.run_id == 'string' && value.run_id.length > 0 && Number.isSafeInteger(value.generation) && value.generation >= 1 }
function activeRecord() : any { let value = uni.getStorageSync(runtimeKey); let now = Date.now(); if (value == null || typeof value.session_id != 'string' || typeof value.conversation_id != 'string' || !Number.isSafeInteger(value.created_at) || value.created_at > now || value.created_at + 86400000 <= now || (value.run == null && value.pending == null && !validResolvedRun(value.resolved_run)) || (value.resolved_run != null && !validResolvedRun(value.resolved_run)) || (value.queued_clarification_id != null && typeof value.queued_clarification_id != 'string') || (value.guidance_submission != null && !validStoredGuidanceSubmission(value.guidance_submission))) { if (runtimeKey.length > 0) uni.removeStorageSync(runtimeKey); return null }; return value }
function sameRunRecord(left : any,right : any) : boolean { return left != null && right != null && typeof left.run_id == 'string' && left.run_id == right.run_id && Number.isSafeInteger(left.generation) && left.generation == right.generation }
function versionIsNewer(left : any,right : any) : boolean { return left != null && right != null && Number.isSafeInteger(left.version) && (!Number.isSafeInteger(right.version) || left.version > right.version) }
// A retired component may only write the record it still owns.  During a page
// transition the replacement entry can already have a newer Run projection.
function ownsActiveRecord() : boolean {
  let stored = activeRecord()
  if (stored == null || stored.session_id != sessionId || stored.conversation_id != conversation) return false
  // A replacement component claims the record before it resumes polling. An
  // old component may still receive lifecycle cleanup afterwards, but must not
  // replace newer local-only state such as a queued clarification submission.
  if (stored.owner_id != null && stored.owner_id != entryId) return false
  if (run == null) return pending != null && stored.run == null && samePendingRecord(stored,pending)
  return sameRunRecord(stored.run,run) && !versionIsNewer(stored.run,run)
}
function mayWriteActiveRecord(claim : boolean = false,replaceResolved : boolean = false) : boolean { let stored = activeRecord(); return stored == null || stored.owner_id == null || stored.owner_id == entryId || claim || (replaceResolved && validResolvedRun(stored.resolved_run)) }
function persistActive(retired : boolean = false,claim : boolean = false,replaceResolved : boolean = false) : void { if (runtimeKey.length == 0 || !mayWriteActiveRecord(claim,replaceResolved)) return; if (retired && !ownsActiveRecord()) return; if ((run == null && pending == null) || terminal()) { uni.removeStorageSync(runtimeKey); return }; uni.setStorageSync(runtimeKey,{created_at:Date.now(),session_id:sessionId,conversation_id:conversation,owner_id:entryId,close_requested:closeRequested,queued_clarification_id:queuedClarificationId,guidance_submission:guidanceSubmission,client_delivery_started_at:clientDeliveryStartedAt,run:run,pending:pending}) }
function clearActive(force : boolean = false) : void { if (runtimeKey.length == 0 || !mayWriteActiveRecord(force)) return; uni.removeStorageSync(runtimeKey) }
// A completed Run is retained as an owner-scoped tombstone.  This is not a
// second chat history: it only prevents callbacks from a retired native page
// from recreating an already-finished request after its replacement rendered it.
function markResolvedRun(value : any = run,claim : boolean = false) : void { if (!validResolvedRun(value) || !mayWriteActiveRecord(claim)) return; uni.setStorageSync(runtimeKey,{created_at:Date.now(),session_id:sessionId,conversation_id:conversation,owner_id:entryId,resolved_run:{run_id:value.run_id,generation:value.generation,version:value.version || null}}) }
function samePendingRecord(value : any,submitted : any) : boolean { return value != null && value.pending != null && submitted != null && typeof submitted.client_request_id == 'string' && value.pending.client_request_id == submitted.client_request_id }
// A create acknowledgement can arrive after this native entry has been
// recycled.  It may only update the exact persisted request which produced
// it; a retired page must never overwrite a newer conversation or UI state.
function retainLateAdmission(accepted : any,submitted : any) : any {
  if (accepted == null || typeof accepted.run_id != 'string') return null
  let stored = activeRecord()
  if (!samePendingRecord(stored,submitted)) return null
  // A normal page switch is not an instruction to discard a just-completed
  // result.  Preserve it for the replacement entry; explicit close is the
  // only path which is allowed to retire it without showing an answer.
  if (['COMPLETED','PARTIAL_SUCCEEDED','FAILED','CANCELLED'].indexOf(String(accepted.status || '')) >= 0 && stored.close_requested === true) { clearActive(true); return null }
  let current = stored.run
  // Creation replies are normally version 1.  If the replacement entry has
  // already observed a later version of this exact Run, retain that richer
  // state.  A different Run with the same request envelope is never replaced.
  if (current != null && !sameRunRecord(current,accepted)) return null
  let selected = current != null && !versionIsNewer(accepted,current) ? current : accepted
  let retained : any = {created_at:Date.now(),session_id:stored.session_id,conversation_id:stored.conversation_id,owner_id:stored.owner_id || null,close_requested:stored.close_requested === true,queued_clarification_id:stored.queued_clarification_id || '',guidance_submission:stored.guidance_submission || null,client_delivery_started_at:stored.client_delivery_started_at,run:selected,pending:stored.pending}
  uni.setStorageSync(runtimeKey,retained)
  return retained
}
function cancelLateAdmission(submitted : any,retained : any) : void {
  if (retained == null || retained.close_requested !== true || retained.run == null || typeof retained.run.run_id != 'string') return
  let source = retained.run, body : any = {client_session_id:submitted.client_session_id,generation:source.generation,run_delivery_token:source.run_delivery_token}
  mobileAiRequest('POST','/runs/' + source.run_id + '/cancel',body,(r : any) => {
    // Clear only if this is still the exact admission from the closed page.
    // A replacement entry may already have started another query meanwhile.
    if (!r.ok || r.data == null || ['COMPLETED','PARTIAL_SUCCEEDED','FAILED','CANCELLED'].indexOf(String(r.data.status || '')) < 0) return
    let stored = activeRecord()
    if (stored != null && stored.close_requested === true && samePendingRecord(stored,submitted) && sameRunRecord(stored.run,source)) clearActive(true)
  })
}
function unavailable(value : any) : boolean { return value != null && value.responseKnown === true && ['AI_RUN_EXPIRED','AI_RUN_NOT_FOUND'].indexOf(String(value.reason || '')) >= 0 }
function abandonUnavailableRun() : void { if (timer != null) clearTimeout(timer); run = null; pending = null; compatibilityExecuting = false; busy.value = false; queuedClarificationId = ''; clarification.value = null; clearGuidance(); exportReady.value = false; closeRequested = false; closeRequestedState.value = false; clientDeliveryStartedAt = 0; activeQuestion.value = ''; activeQuestionAnchor.value = ''; messageAnchor.value = ''; clearActive(); progress.value = '上一次任务已失效，请重新提问。' }
function newConversation() : void { if (busy.value || (pending != null && run == null)) return; lifecycle++; queuedClarificationId = ''; let all = load(); conversation = id(); all.push({id:conversation,created_at:Date.now(),rounds:[]}); uni.setStorageSync(storageKey,all); displayed.value = []; expandedCardKeys.value = []; activeQuestion.value = ''; activeQuestionAnchor.value = ''; messageAnchor.value = ''; run = null; clarification.value = null; clearGuidance(); exportReady.value = false; let stored = activeRecord(); if (stored == null || !validResolvedRun(stored.resolved_run)) clearActive() }
function openPanel() : void { opened.value = true; if (conversation.length == 0) newConversation() }
function binding() : any { return {client_session_id:sessionId,generation:run.generation,run_delivery_token:run.run_delivery_token} }
// The device reports only the bounded, user-observed time at which a verified
// final answer becomes visible.  This best-effort diagnostic never includes
// the question, answer, identity or a clock timestamp.
function reportVisibleDelivery(source : any) : void {
  let startedAt = clientDeliveryStartedAt
  if (source == null || !Number.isSafeInteger(startedAt) || startedAt <= 0) return
  clientDeliveryStartedAt = 0
  let elapsed = Math.min(300000,Math.max(0,Date.now() - startedAt))
  mobileAiRequest('POST','/runs/' + source.run_id + '/delivery',{client_session_id:sessionId,generation:source.generation,run_delivery_token:source.run_delivery_token,client_elapsed_ms:elapsed},(_: any) => {})
}
function reportVisibleDeliveryAfterRender(source : any) : void {
  let expectedLifecycle = lifecycle
  // Let the reactive update commit before recording customer-visible delivery.
  // If this entry was recycled first, its replacement owns the observation.
  setTimeout(() => { if (expectedLifecycle == lifecycle && run != null && terminal() && sameRunRecord(run,source)) reportVisibleDelivery(source) },0)
}
// The Run response decides its own execution path. Bootstrap is just a
// snapshot and may have changed after this customer request was accepted.
function needsCompatibilityExecution(value : any) : boolean { return value != null && (value.execution_mode == 'compatibility' || (value.execution_mode == null && (bootstrap == null || bootstrap.async_execution !== true))) }
function schedulePoll() : void {
  if (timer != null) clearTimeout(timer)
  let source = run, expectedLifecycle = lifecycle
  timer = setTimeout(() => {
    if (source == null || expectedLifecycle != lifecycle || run == null || terminal() || run.run_id != source.run_id || run.generation != source.generation) return
    mobileAiRequest('GET','/runs/' + source.run_id,binding(),(r : any) => {
      if (expectedLifecycle != lifecycle || run == null || run.run_id != source.run_id || run.generation != source.generation) return
      if (r.ok) { accept(r.data); if (!terminal() && (run.status != 'WAITING_CLARIFICATION' || closeRequestedState.value || (run.clarification != null && queuedClarificationId == run.clarification.id))) schedulePoll() }
      else { if (unavailable(r)) { abandonUnavailableRun(); return }; progress.value = closeRequestedState.value ? '暂未确认取消结果。' : '连接中断，暂未确认任务结果。'; persistActive(); schedulePoll() }
    })
  },1000)
}
function accept(value : any) : void {
  if (value == null || (run != null && (value.run_id != run.run_id || value.generation != run.generation || terminal()))) return
  if (value.version != null && (!Number.isSafeInteger(value.version) || value.version < 1)) return
  if (run != null && Number.isSafeInteger(run.version) && (!Number.isSafeInteger(value.version) || value.version <= run.version)) return
  if (run != null && value.run_delivery_token == null) value.run_delivery_token = run.run_delivery_token
  run = value; progress.value = typeof run.progress == 'string' ? run.progress : '正在处理'
  if (terminal()) { busy.value = false; compatibilityExecuting = false; queuedClarificationId = ''; clarification.value = null; clearGuidance(); if (timer != null) clearTimeout(timer)
    if (run.answer != null && ['COMPLETED','PARTIAL_SUCCEEDED'].indexOf(String(run.status)) >= 0 && pending != null && typeof pending.question == 'string') { let answer = run.answer; exportReady.value = answer.export != null && answer.export.file_ref != null; let row : any = {question:pending.question,answer:String(answer.summary || ''),cards:answer.cards || [],table:answer.table || null,presentation:answer,run_id:run.run_id,generation:run.generation,created_at:Date.now()}; appendTranscript(row); reportVisibleDeliveryAfterRender(run) }
    else { let terminalMessage = run.status == 'CANCELLED' ? '已取消' : (typeof run.message == 'string' && run.message.length > 0 ? run.message : '本次未能完成，请重新提问。'); if (pending != null && typeof pending.question == 'string') { appendTranscript({question:pending.question,answer:terminalMessage,cards:[],table:null,presentation:{summary:terminalMessage,terminal_status:run.status},context_eligible:false,run_id:run.run_id,generation:run.generation,created_at:Date.now()}) }; progress.value = terminalMessage; clientDeliveryStartedAt = 0 }; activeQuestion.value = ''; activeQuestionAnchor.value = ''; pending = null; markResolvedRun(); return }
  if (run.status == 'WAITING_CLARIFICATION' && !closeRequestedState.value) {
    let c = run.clarification
    if (!validGuidance(c)) { clarification.value = null; clearGuidance(); progress.value = '引导信息不完整，请重新确认任务状态。'; return }
    if (run.clarification_rejected === true && queuedClarificationId == c.id) {
      queuedClarificationId = ''
      progress.value = '所选条件格式不完整，请检查后重新确认。'
    }
    // A successful choice is queued while the Run still projects the previous
    // clarification. Keep observing that Run; do not offer the same controls
    // again or make the customer manually refresh for the final answer.
    if (queuedClarificationId == c.id) { clarification.value = null; clearGuidance(); schedulePoll(); persistActive(); return }
    if (c.schema_version == guidanceSchema) activeGuidanceSchema = guidanceSchema
    let same = clarification.value != null && clarification.value.id == c.id && clarification.value.step_revision == c.step_revision && clarification.value.intent_revision == c.intent_revision
    clarification.value = c; if (!same) clearGuidance()
  } else { queuedClarificationId = ''; clarification.value = null; clearGuidance(); schedulePoll() }
  persistActive()
}
function submit() : void {
  if (busy.value || (pending == null && question.value.trim().length == 0)) return
  // Another merchant page can start a Run after this entry bootstrapped.  Join
  // that request before accepting a new question, while keeping the typed text.
  let existing = activeRecord()
  if (existing != null && !validResolvedRun(existing.resolved_run) && !ownsActiveRecord()) { busy.value = true; progress.value = '正在恢复已开始的查询，完成后可继续提问。'; sessionId = existing.session_id; bootstrapSession(true); return }
  let history : Array<any> = []; let contextRef = ''
  load().forEach((s : any) => { if (s.id == conversation) { s.rounds.slice(-20).forEach((r : any) => history.push({question:r.question,answer:r.answer})); let last : any = null; s.rounds.slice().reverse().some((r : any) => { if (contextEligible(r)) { last = r; return true }; return false }); if (last != null && last.presentation != null && typeof last.presentation.context_ref == 'string') contextRef = last.presentation.context_ref } })
  let isNewRequest = pending == null
  if (isNewRequest) { activeGuidanceSchema = String(bootstrap.guidance_schema_version || ''); pending = {client_request_id:id(),conversation_id:conversation,client_session_id:sessionId,window_token:bootstrap.window_token,question:question.value.trim(),history:history,output_format:wantExcel.value ? 'screen_and_xlsx' : 'screen'}; if (activeGuidanceSchema == guidanceSchema) pending.guidance_schema_version = guidanceSchema; if (contextRef.length > 0) pending.context_ref = contextRef; closeRequested = false; closeRequestedState.value = false; showActiveQuestion(pending.question); clientDeliveryStartedAt = Date.now() }
  let restoringCancelledRequest = !isNewRequest && closeRequested
  exportReady.value = false
  busy.value = true; closeRequested = restoringCancelledRequest; closeRequestedState.value = restoringCancelledRequest; run = null; question.value = ''; progress.value = '正在接纳请求'
  // A new customer question may replace only a completion tombstone.  It must
  // never take over another still-active page's Run.
  persistActive(false,false,isNewRequest)
  let stored = activeRecord()
  if (stored == null || stored.owner_id != entryId || !samePendingRecord(stored,pending)) { let unsentQuestion = pending.question; pending = null; busy.value = stored != null; question.value = unsentQuestion; progress.value = stored == null ? '暂未保存请求，请重试发送。' : '正在恢复已开始的查询，完成后可继续提问。'; if (stored != null) { sessionId = stored.session_id; bootstrapSession(true) }; return }
  let expectedLifecycle = lifecycle, submitted = pending
  mobileAiRequest('POST','/runs',submitted,(r : any) => {
    if (expectedLifecycle != lifecycle) { if (r.ok && r.data != null && r.data.accepted !== false) { let retained = retainLateAdmission(r.data,submitted); cancelLateAdmission(submitted,retained) }; return }
    if (!r.ok) { busy.value = false; question.value = pending.question; if (r.responseKnown) { pending = null; clearActive(); progress.value = r.message } else { progress.value = '请求结果暂未确认，再次发送将重试同一任务。'; persistActive() }; return }
    if (r.data.accepted === false) { busy.value = false; pending = null; clearActive(); progress.value = r.data.message || '当前使用人数较多，请稍后再问。'; return }
    // New servers accept only after durable queueing.  During a staged rollout
    // keep the old synchronous trigger for a server that has not enabled its
    // compatible consumer yet.
    accept(r.data)
    if (terminal()) return
    if (closeRequested) { cancelRun(); return }
    if (needsCompatibilityExecution(run)) executeCompatibility(run,expectedLifecycle)
    schedulePoll()
  })
}
function executeCompatibility(source : any,expectedLifecycle : number) : void {
  if (compatibilityExecuting || pending == null || source == null || terminal() || closeRequested || !needsCompatibilityExecution(source)) return
  compatibilityExecuting = true
  let body : any = binding(); body.question = pending.question; body.history = pending.history; body.output_format = pending.output_format
  if (pending.context_ref != null) body.context_ref = pending.context_ref
  mobileAiRequest('POST','/runs/' + source.run_id + '/execute',body,(e : any) => {
    compatibilityExecuting = false
    if (expectedLifecycle != lifecycle || run == null || run.run_id != source.run_id || run.generation != source.generation) return
    if (e.ok) accept(e.data)
    else if (unavailable(e)) abandonUnavailableRun()
    else schedulePoll()
  })
}
function cancelRun() : void {
  if (terminal() || (run == null && pending == null)) return
  closeRequested = true; closeRequestedState.value = true; persistActive(); if (run == null || terminal()) return
  let source = run, expectedLifecycle = lifecycle
  progress.value = '正在取消'
  mobileAiRequest('POST','/runs/' + source.run_id + '/cancel',binding(),(r : any) => {
    // A page transition keeps the Run alive for the replacement entry.  A
    // delayed cancellation response from this retired component must not clear
    // that replacement's durable recovery record.
    if (expectedLifecycle != lifecycle || run == null || run.run_id != source.run_id || run.generation != source.generation) return
    if (r.ok) accept(r.data); else { progress.value = '暂未确认取消结果。'; schedulePoll() }
  })
}
// 头部“退出”只关闭魔核 AI 工作区；复用既有取消链路，避免留下不可见的运行中任务。
function closePanel() : void { cancelRun(); opened.value = false }
function downloadExcel() : void { if (run == null || !terminal() || !exportReady.value) return; downloadMobileAi(run,sessionId,String(run.answer.export.filename || '经营数据.xlsx'),(message : string) => { progress.value = message }) }
function validGuidance(c : any) : boolean {
  if (c == null || typeof c.id != 'string' || c.id.length == 0 || !Array.isArray(c.fields) || c.fields.length == 0) return false
  let modern = c.schema_version == guidanceSchema
  if ((activeGuidanceSchema == guidanceSchema && !modern) || (c.schema_version != null && !modern)) return false
  if (modern && (!Number.isSafeInteger(c.step_revision) || c.step_revision < 1 || !Number.isSafeInteger(c.intent_revision) || c.intent_revision < 1 || !Number.isSafeInteger(c.round_no) || c.round_no < 1 || [3,4,5].indexOf(c.max_clarification_rounds) < 0 || c.round_no > c.max_clarification_rounds || !Array.isArray(c.confirmed_summary))) return false
  if (!validGuidanceFields(c.fields,modern)) return false
  if (modern) {
    for (let i = 0; i < c.confirmed_summary.length; i++) { let item = c.confirmed_summary[i]; if (item == null || typeof item.label != 'string' || typeof item.value != 'string') return false }
    if (c.revisable_steps != null) {
      if (!Array.isArray(c.revisable_steps) || c.revisable_steps.length > 5) return false
      let seen : Array<string> = []
      for (let i = 0; i < c.revisable_steps.length; i++) { let old = c.revisable_steps[i]; if (old == null || typeof old.id != 'string' || seen.indexOf(old.id) >= 0 || typeof old.question != 'string' || old.choices == null || !validGuidanceFields(old.fields,true)) return false; seen.push(old.id) }
    }
  }
  return true
}
function validGuidanceFields(fields : any,modern : boolean) : boolean {
  if (!Array.isArray(fields) || fields.length == 0) return false
  if (modern && !(fields.length == 1 || (fields.length == 2 && fields.every((field : any) => field != null && field.type == 'date')))) return false
  let seen : Array<string> = []
  for (let i = 0; i < fields.length; i++) {
    let field = fields[i]; if (field == null || typeof field.key != 'string' || field.key.length == 0 || ['__proto__','prototype','constructor'].indexOf(field.key) >= 0 || seen.indexOf(field.key) >= 0 || typeof field.label != 'string') return false; seen.push(field.key)
    if (field.type == 'date') continue
    if (field.type != null && ['select','single_choice'].indexOf(field.type) < 0) return false
    if (!Array.isArray(field.options) || field.options.length == 0) return false
    let optionKeys : Array<string> = []
    for (let oi = 0; oi < field.options.length; oi++) { let option = field.options[oi]; if (option == null || typeof option.label != 'string' || typeof option.value != 'string' || optionKeys.indexOf(option.value) >= 0) return false; optionKeys.push(option.value) }
  }
  return true
}
function clearGuidance() : void { choices.value = {}; choiceLabels.value = {}; guidanceBusy.value = false; guidanceUnknown.value = false; revisingId.value = ''; guidanceSubmission = null }
function currentGuidanceFields() : Array<any> { if (clarification.value == null) return []; let c = clarification.value; if (revisingId.value.length > 0 && Array.isArray(c.revisable_steps)) { let old = c.revisable_steps.find((item : any) => item.id == revisingId.value); if (old != null) return old.fields }; return c.fields }
function currentGuidanceQuestion() : string { if (clarification.value == null) return ''; if (revisingId.value.length > 0) { let old = clarification.value.revisable_steps.find((item : any) => item.id == revisingId.value); if (old != null) return '修改：' + String(old.question) }; return String(clarification.value.question || '请选择本次要查询的内容') }
function editGuidance(old : any) : void { if (guidanceBusy.value || guidanceUnknown.value || closeRequestedState.value) return; revisingId.value = old.id; choices.value = {}; choiceLabels.value = {}; old.fields.forEach((field : any) => { if (typeof old.choices[field.key] == 'string') choices.value[field.key] = old.choices[field.key]; if (Array.isArray(field.options)) field.options.forEach((option : any) => { if (option.value == choices.value[field.key]) choiceLabels.value[field.key] = option.label }) }) }
function resetGuidanceChoices() : void { if (guidanceBusy.value || guidanceUnknown.value || closeRequestedState.value) return; clearGuidance() }
function selectDate(key : string,event : any) : void { if (!guidanceBusy.value && !guidanceUnknown.value && !closeRequestedState.value) choices.value[key] = event.detail.value }
function chooseValue(field : any,option : any) : void { if (guidanceBusy.value || guidanceUnknown.value || closeRequestedState.value) return; choices.value[field.key] = option.value; choiceLabels.value[field.key] = option.label }
function selectOption(field : any,event : any) : void { let option = field.options[Number(event.detail.value)]; if (option != null) chooseValue(field,option) }
function confirmChoices() : void {
  if (guidanceBusy.value || closeRequestedState.value || run == null || terminal() || run.status != 'WAITING_CLARIFICATION' || clarification.value == null || !mayWriteActiveRecord()) return
  let c = clarification.value
  if (guidanceSubmission == null) {
    let submittedChoices : any = {}; let invalid = false
    currentGuidanceFields().forEach((field : any) => { let value = choices.value[field.key]; if (typeof value != 'string' || value.length == 0) invalid = true; else submittedChoices[field.key] = value })
    if (invalid) { progress.value = '请完成当前选择或填写有效日期。'; return }
    let body : any = binding(); body.clarification_id = c.id; body.choices = submittedChoices
    if (c.schema_version == guidanceSchema) { body.schema_version = guidanceSchema; body.step_revision = c.step_revision; body.intent_revision = c.intent_revision; body.client_submission_id = id(); if (revisingId.value.length > 0) body.revise_clarification_id = revisingId.value }
    guidanceSubmission = body
  }
  let submitted = guidanceSubmission; guidanceBusy.value = true
  // A clarification is a new customer action.  Its latency excludes the time
  // spent reading the previous guidance, while still measuring the complete
  // post-confirmation execution until the verified answer is visible.
  clientDeliveryStartedAt = Date.now()
  // Persist before I/O. If the app is interrupted after sending but before a
  // response arrives, the identical client_submission_id remains available
  // for a safe idempotent retry after the next status read.
  persistActive()
  let source = run, expectedLifecycle = lifecycle
  mobileAiRequest('POST','/runs/' + source.run_id + '/clarify',submitted,(r : any) => {
    if (expectedLifecycle != lifecycle || run == null || run.run_id != source.run_id || run.generation != source.generation) return
    if (r.ok) {
      queuedClarificationId = c.id
      guidanceSubmission = null; guidanceUnknown.value = false; guidanceBusy.value = false
      accept(r.data)
      // A replay acknowledgement can keep the exact same Run version.  Save
      // its queued-step marker before the panel is closed or reloaded, then
      // continue polling until the worker publishes a different state.
      if (!terminal()) persistActive()
      if (!terminal()) schedulePoll()
      return
    }
    if (clarification.value == null || clarification.value.id != c.id || clarification.value.intent_revision != c.intent_revision || closeRequestedState.value) return
    guidanceBusy.value = false
    if (r.responseKnown) { guidanceSubmission = null; guidanceUnknown.value = false; progress.value = r.message; persistActive() }
    else { guidanceUnknown.value = true; progress.value = '提交结果暂未确认，请重试确认同一次选择。'; persistActive() }
  })
}
function resumeActive(record : any) : void {
  conversation = record.conversation_id; run = record.run; pending = record.pending; if (pending != null && typeof pending.question == 'string') showActiveQuestion(pending.question); else { activeQuestion.value = ''; activeQuestionAnchor.value = ''; messageAnchor.value = '' }; clientDeliveryStartedAt = Number.isSafeInteger(record.client_delivery_started_at) && record.client_delivery_started_at > 0 ? record.client_delivery_started_at : 0; queuedClarificationId = typeof record.queued_clarification_id == 'string' ? record.queued_clarification_id : ''; guidanceSubmission = validStoredGuidanceSubmission(record.guidance_submission) ? record.guidance_submission : null; closeRequested = record.close_requested === true; closeRequestedState.value = closeRequested; busy.value = true
  if (validResolvedRun(record.resolved_run)) { let all = load(); all.forEach((s : any) => { if (s.id == conversation) displayed.value = s.rounds || [] }); busy.value = false; return }
  // Only a late create acknowledgement can persist a terminal Run. Hydrate it
  // through the normal terminal renderer so a page switch never hides a real
  // result, while an explicit close has already cleared its record above.
  if (terminal()) { let completed = run; run = null; markResolvedRun(completed,true); accept(completed); return }
  // Claim the durable projection before I/O. On native route changes the old
  // entry can unmount after this replacement is already active; ownership is
  // what prevents its teardown write from discarding this page's local state.
  persistActive(false,true)
  if (run == null) { if (pending == null) { busy.value = false; clearActive(); return }; pending.client_session_id = sessionId; pending.window_token = bootstrap.window_token; persistActive(); busy.value = false; submit(); return }
  let source = run, expectedLifecycle = lifecycle
  mobileAiRequest('GET','/runs/' + source.run_id,binding(),(r : any) => {
    if (expectedLifecycle != lifecycle || run == null || run.run_id != source.run_id || run.generation != source.generation) return
    if (r.ok) {
      // A reload often reads exactly the last persisted version.  It still
      // represents an active Run and must continue polling even when accept
      // correctly rejects it as a duplicate projection.
      if (r.data != null && typeof r.data.progress == 'string') progress.value = r.data.progress
      accept(r.data)
      if (closeRequested) { cancelRun(); return }
      // A restored Run can have the same version as the locally persisted
      // snapshot.  Hydrate its current guidance explicitly because accept()
      // correctly ignores duplicate versions to protect against stale polls.
      let restoredClarificationId = run.clarification != null && typeof run.clarification.id == 'string' ? run.clarification.id : ''
      if (run.status == 'WAITING_CLARIFICATION' && clarification.value == null && queuedClarificationId != restoredClarificationId && validGuidance(run.clarification)) {
        clarification.value = run.clarification
        if (run.clarification.schema_version == guidanceSchema) activeGuidanceSchema = guidanceSchema
      }
      // Retry only the exact saved submission for the step the server still
      // presents. A newer guidance step or final answer discards the old
      // local envelope instead of letting it mutate current intent.
      if (guidanceSubmission != null) {
        let c = clarification.value
        let same = c != null && guidanceSubmission.clarification_id == c.id && (c.schema_version != guidanceSchema || (guidanceSubmission.schema_version == guidanceSchema && guidanceSubmission.intent_revision == c.intent_revision && guidanceSubmission.step_revision == c.step_revision))
        if (same && queuedClarificationId.length == 0 && run.clarification_rejected !== true) { confirmChoices(); return }
        guidanceSubmission = null; persistActive()
      }
      if (!terminal() && needsCompatibilityExecution(run)) {
        if (pending != null) executeCompatibility(run,expectedLifecycle)
        else if (['READY','RECEIVED'].indexOf(String(run.status)) >= 0) { abandonUnavailableRun(); return }
      }
      if (!terminal() && (run.status != 'WAITING_CLARIFICATION' || closeRequestedState.value || (run.clarification != null && queuedClarificationId == run.clarification.id))) schedulePoll()
      return
    }
    if (unavailable(r)) { abandonUnavailableRun(); return }
    if (!r.responseKnown) { progress.value = closeRequestedState.value ? '暂未确认取消结果。' : '连接中断，正在重新确认任务状态。'; persistActive(); schedulePoll(); return }
    busy.value = false; pending = null; run = null; closeRequested = false; closeRequestedState.value = false; clearActive(); progress.value = '上一次任务已失效，请重新提问。'
  })
}
function bootstrapSession(restore : boolean = false) : void { let expectedLifecycle = lifecycle; mobileAiRequest('GET','/bootstrap',{client_session_id:sessionId},(r : any) => { if (expectedLifecycle != lifecycle) return; if (!r.ok || r.data == null || r.data.enabled !== true) { if (restore) { busy.value = false; progress.value = '暂未恢复查询，请重试发送。' }; return }; bootstrap = r.data; storageKey = 'mohe-ai:v1:' + encodeURIComponent(String(bootstrap.identity_key)); runtimeKey = 'mohe-ai:v1:runtime:' + encodeURIComponent(String(bootstrap.identity_key)); let record = activeRecord(); if (!restore && record != null && record.session_id != sessionId) { sessionId = record.session_id; bootstrapSession(true); return }; excelAvailable.value = bootstrap.capabilities != null && Array.isArray(bootstrap.capabilities.output_formats) && bootstrap.capabilities.output_formats.indexOf('screen_and_xlsx') >= 0; enabled.value = true; if (record != null) resumeActive(record); else if (restore) { busy.value = false; progress.value = '上一次任务已结束，可以继续提问。' } }) }
function historyTitle(item : any) : string { return item != null && Array.isArray(item.rounds) && item.rounds.length > 0 && item.rounds[0] != null && typeof item.rounds[0].question == 'string' && item.rounds[0].question.length > 0 ? String(item.rounds[0].question) : '新对话' }
function refreshHistory() : void { historySessions.value = load().slice().reverse() }
function hideHistory() : void { historyDrawerOpen.value = false }
function selectHistory(id : string) : void { let selected : any = null; load().some((item : any) => { if (item.id == id) { selected = item; return true }; return false }); if (selected == null) { refreshHistory(); return }; conversation = selected.id; displayed.value = selected.rounds; expandedCardKeys.value = []; activeQuestion.value = ''; activeQuestionAnchor.value = ''; messageAnchor.value = ''; run = null; exportReady.value = false; hideHistory() }
function deleteHistory(id : string) : void { if (busy.value && id == conversation) return; let all = load().filter((item : any) => item.id != id); uni.setStorageSync(storageKey,all); if (id == conversation) { newConversation(); } refreshHistory() }
function showHistory() : void { if (busy.value || (pending != null && run == null)) return; refreshHistory(); historyDrawerOpen.value = true }
onMounted(() => { sessionId = id(); bootstrapSession(); expiryTimer = setInterval(() => { if (storageKey.length > 0 && !load().some((s : any) => s.id == conversation)) { displayed.value = []; progress.value = '会话已到期，请新建对话。' } },30000) })
// The entry is mounted on each merchant page.  Page navigation and native
// component recycling are not an instruction to abandon a customer's query;
// keep the durable run for the next page to resume.  Only the explicit
// “停止” and “关闭” actions call cancelRun().
onUnmounted(() => { lifecycle++; persistActive(true); if (timer != null) clearTimeout(timer); if (expiryTimer != null) clearInterval(expiryTimer) })
</script>
<style>
.ai-entry{position:fixed;right:24px;bottom:calc(92px + env(safe-area-inset-bottom));z-index:9999;width:60px;height:60px;border-radius:50%;box-shadow:0 10px 26px rgba(31,99,199,.32)}.ai-entry-icon{display:block;width:60px;height:60px;border-radius:50%}
.ai-panel{position:fixed;left:0;right:0;top:0;bottom:0;z-index:10000;box-sizing:border-box;background-color:#fff;display:flex;flex-direction:column;overflow:hidden;color:#111827}.ai-panel--native-mini{padding-top:calc(72px + env(safe-area-inset-top))}
.ai-history-mask{position:absolute;z-index:20;left:0;right:0;top:0;bottom:0;background-color:rgba(16,24,39,.28)}.ai-history-drawer{position:absolute;z-index:21;left:0;top:0;bottom:0;width:82%;box-sizing:border-box;background-color:#fff;box-shadow:12px 0 30px rgba(16,24,39,.14)}.ai-history-drawer__title{height:64px;padding:0 30px;display:flex;align-items:center;color:#78859a;font-size:17px}.ai-history-drawer__list{height:calc(100% - 64px);padding:0 18px;box-sizing:border-box}.ai-history-drawer__item{display:flex;flex-direction:row;align-items:center;min-height:56px;margin:0 0 6px;border-radius:12px}.ai-history-drawer__select{min-width:0;flex:1;padding:0 14px;overflow:hidden;color:#202b3b;font-size:18px;line-height:56px;text-overflow:ellipsis;white-space:nowrap}.ai-history-drawer__item--active .ai-history-drawer__select{background-color:#ece9ff;color:#263f90;border-radius:12px}.ai-history-drawer__delete{flex:0 0 auto;width:34px;height:34px;margin-left:4px;display:flex;align-items:center;justify-content:center;border-radius:50%;background-color:#f2f4f8;color:#66758c;font-size:25px;font-weight:300;line-height:1}.ai-history-drawer__delete--disabled{opacity:.35}.ai-workspace-head{flex:0 0 auto;height:70px;padding:0 18px;display:flex;flex-direction:row;align-items:center;border-bottom:1px solid #dde2eb}.ai-workspace-icon-button{flex:0 0 auto;width:42px;height:42px;display:flex;align-items:center;justify-content:center}.ai-workspace-actions{flex:0 0 auto;display:flex;flex-direction:row;align-items:center}.ai-title{min-width:0;flex:1;margin-left:12px;font-size:28px;font-weight:700;letter-spacing:.01em}.ai-icon-menu{width:28px;height:22px;display:flex;flex-direction:column;justify-content:space-between}.ai-icon-menu__line{height:3px;border-radius:3px;background-color:#101827}
/* 右上角加号与叉号仅通过旋转同一线条生成，统一尺寸、颜色和按压反馈。 */
.ai-icon-action{position:relative;width:26px;height:26px}.ai-icon-action__stroke{position:absolute;left:4px;top:12px;width:18px;height:2px;border-radius:2px;background-color:#101827}.ai-icon-action__stroke--plus{transform:rotate(90deg)}.ai-icon-action--close .ai-icon-action__stroke{left:3px;width:20px;transform:rotate(45deg)}.ai-icon-action--close .ai-icon-action__stroke--close{transform:rotate(-45deg)}.ai-workspace-icon-button:active{background-color:#f2f5fa;border-radius:50%}
.ai-messages{min-height:0;flex:1;height:0;padding:0 36px}.ai-message{padding:0;margin:38px 0 48px;background-color:#fff}.ai-user-turn{max-width:82%;margin-left:auto;padding:16px 22px;background-color:#17191e;border-radius:27px 27px 6px 27px;color:#fff}.ai-answer-turn{padding:0;margin-top:50px}.ai-turn-label{display:none}.ai-question{display:block;color:#fff;font-size:20px;font-weight:400;line-height:1.55}.ai-answer{display:block;color:#101827;font-size:24px;font-weight:400;line-height:1.75;white-space:pre-wrap}.ai-answer-presentation{display:block}.ai-answer-headline{display:block;color:#101827;font-size:25px;font-weight:600;line-height:1.55}.ai-answer-facts{display:flex;flex-direction:row;flex-wrap:wrap;gap:10px;margin-top:18px}.ai-answer-fact-wrap{min-width:calc(50% - 5px);flex:1}.ai-answer-section{display:block;margin:4px 0 8px;color:#53647d;font-size:14px;font-weight:600}.ai-answer-fact{box-sizing:border-box;padding:13px 14px;border-left:3px solid #2865c7;border-radius:9px;background-color:#f5f8fd}.ai-answer-fact__label{display:block;color:#62708a;font-size:15px;line-height:1.5}.ai-answer-fact__value{display:block;margin-top:3px;color:#101827;font-size:24px;font-weight:600;line-height:1.35}.ai-note{font-size:15px;color:#758198;line-height:1.65}.ai-answer-period{display:block;margin-top:14px}.ai-answer-note{display:block;margin-top:4px}
.ai-card{padding:22px 0 4px;margin-top:22px;background-color:#fff;border-top:1px solid #e0e5ed}.ai-card-label{display:block;margin-bottom:5px;color:#111827;font-size:18px;font-weight:500}.ai-number{display:block;font-size:34px;font-weight:600;color:#111827}.ai-card-detail-toggle{display:flex;flex-direction:row;align-items:center;margin-top:14px;padding:10px 0;color:#6c7890;font-size:16px}.ai-card-detail-chevron{margin-right:8px;font-size:27px;font-weight:300;line-height:16px}.ai-card-detail{display:block;margin-top:8px;white-space:pre-wrap;font-size:14px;line-height:1.8;color:#65758b}.ai-result-table{margin-top:30px;border-top:1px solid #d9dee7}.ai-result-table__row{display:flex;flex-direction:row;align-items:center;min-height:56px;border-bottom:1px solid #d9dee7}.ai-result-table__head{min-height:48px}.ai-result-table__cell{min-width:0;flex:1;box-sizing:border-box;padding:0 4px;color:#111827;font-size:17px;line-height:1.35;text-align:left}.ai-result-table__cell:last-child{text-align:right}.ai-result-table__head .ai-result-table__cell{color:#758198;font-size:15px}
.ai-footer{flex:0 0 auto;padding:12px 36px calc(22px + env(safe-area-inset-bottom));background-color:#fff}.ai-progress{display:block;margin-bottom:8px}.ai-composer{box-sizing:border-box;border:1px solid #d4dbe7;border-radius:25px;background-color:#fff;box-shadow:0 8px 25px rgba(22,36,61,.05);overflow:hidden}.ai-input{box-sizing:border-box;min-height:84px;max-height:132px;width:100%;padding:18px 20px 8px;background-color:#fff;border:0;font-size:20px;line-height:1.5}.ai-footer-actions{display:flex;flex-direction:row;align-items:center;min-height:60px;padding:0 12px 12px 20px}.ai-export-option{min-width:0;flex:1;display:flex;flex-direction:row;align-items:center}.ai-export-label{min-width:0;margin-left:10px;color:#56647b;font-size:17px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ai-submit{flex:0 0 auto;display:flex;align-items:center;justify-content:center;width:56px;height:56px;margin-left:12px;border-radius:50%;background-color:#2865c7;color:#fff}.ai-submit--disabled{background-color:#9eabbf}.ai-icon-send{position:relative;width:27px;height:27px}.ai-icon-send__shaft{position:absolute;left:12px;top:3px;width:3px;height:21px;border-radius:3px;background-color:#fff}.ai-icon-send__head-left{position:absolute;left:8px;top:3px;width:3px;height:12px;border-radius:3px;background-color:#fff;transform:rotate(45deg)}.ai-icon-send__head-right{position:absolute;right:8px;top:3px;width:3px;height:12px;border-radius:3px;background-color:#fff;transform:rotate(-45deg)}.ai-stop{flex:0 0 auto;margin-left:10px;color:#667085;font-size:14px}.ai-choice{padding:8px;display:block;color:#1f63c7}
.ai-panel--native-mini .ai-history-drawer{width:86%}.ai-panel--native-mini .ai-history-drawer__title{height:58px;padding:0 22px;font-size:16px}.ai-panel--native-mini .ai-history-drawer__list{height:calc(100% - 58px);padding:0 12px}.ai-panel--native-mini .ai-history-drawer__item{min-height:52px;margin-bottom:4px}.ai-panel--native-mini .ai-history-drawer__select{padding:0 12px;font-size:16px;line-height:52px}.ai-panel--native-mini .ai-history-drawer__delete{width:30px;height:30px;font-size:22px}.ai-panel--native-mini .ai-workspace-head{height:62px;padding:0 14px}.ai-panel--native-mini .ai-workspace-icon-button{width:38px;height:38px}.ai-panel--native-mini .ai-title{font-size:23px}.ai-panel--native-mini .ai-messages{padding:0 20px}.ai-panel--native-mini .ai-message{margin:26px 0 34px}.ai-panel--native-mini .ai-answer-turn{margin-top:35px}.ai-panel--native-mini .ai-answer{font-size:19px}.ai-panel--native-mini .ai-card{padding-top:18px;margin-top:18px}.ai-panel--native-mini .ai-card-label{font-size:16px}.ai-panel--native-mini .ai-card-detail-toggle{font-size:14px}.ai-panel--native-mini .ai-footer{padding:8px 18px calc(14px + env(safe-area-inset-bottom))}.ai-panel--native-mini .ai-input{min-height:60px;max-height:96px;padding:12px 14px 4px;font-size:17px}.ai-panel--native-mini .ai-footer-actions{min-height:44px;padding:0 8px 8px 14px}.ai-panel--native-mini .ai-export-label{font-size:15px}.ai-panel--native-mini .ai-submit{width:42px;height:42px;margin-left:8px}.ai-panel--native-mini .ai-icon-send{width:24px;height:24px}.ai-panel--native-mini .ai-icon-send__shaft{left:11px;top:2px;height:20px}.ai-panel--native-mini .ai-icon-send__head-left{left:7px;top:2px}.ai-panel--native-mini .ai-icon-send__head-right{right:7px;top:2px}
