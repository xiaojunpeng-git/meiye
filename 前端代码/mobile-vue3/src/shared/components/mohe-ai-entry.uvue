function unavailable(value : any) : boolean { return value != null && value.responseKnown === true && ['AI_RUN_EXPIRED','AI_RUN_NOT_FOUND'].indexOf(String(value.reason || '')) >= 0 }
function abandonUnavailableRun() : void { if (timer != null) clearTimeout(timer); finishActiveRunStatus(); run = null; pending = null; compatibilityExecuting = false; busy.value = false; queuedClarificationId = ''; clarification.value = null; clearGuidance(); closeRequested = false; closeRequestedState.value = false; clientDeliveryStartedAt = 0; activeQuestion.value = ''; activeQuestionAnchor.value = ''; messageAnchor.value = ''; clearActive(); progress.value = '上一次任务已失效，请重新提问。' }
function newConversation() : void {
