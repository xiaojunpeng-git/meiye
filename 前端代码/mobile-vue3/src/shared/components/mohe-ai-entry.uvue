function validStoredGuidanceSubmission(value : any) : boolean { return value != null && typeof value == 'object' && typeof value.clarification_id == 'string' && value.clarification_id.length > 0 && typeof value.client_submission_id == 'string' && value.client_submission_id.length > 0 && value.choices != null && typeof value.choices == 'object' && !Array.isArray(value.choices) && (value.schema_version == null || value.schema_version == guidanceSchema) && (value.intent_revision == null || Number.isSafeInteger(value.intent_revision)) && (value.step_revision == null || Number.isSafeInteger(value.step_revision)) }
