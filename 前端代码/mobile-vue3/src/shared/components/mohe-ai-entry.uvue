// 头部“退出”只关闭魔核 AI 工作区；复用既有取消链路，避免留下不可见的运行中任务。
function closePanel() : void { cancelRun(); opened.value = false; closeComposerOptions() }
function downloadExcel(item : any) : void { let source = exportSource(item); if (source == null) return; downloadMobileAi(source,sessionId,'经营数据.xlsx',(message : string) => { progress.value = message }) }
function validGuidance(c : any) : boolean {
  if (c == null || typeof c.id != 'string' || c.id.length == 0 || !Array.isArray(c.fields) || c.fields.length == 0) return false
  let modern = c.schema_version == guidanceSchema
  if ((activeGuidanceSchema == guidanceSchema && !modern) || (c.schema_version != null && !modern)) return false
  if (modern && (!Number.isSafeInteger(c.step_revision) || c.step_revision < 1 || !Number.isSafeInteger(c.intent_revision) || c.intent_revision < 1 || !Number.isSafeInteger(c.round_no) || c.round_no < 1 || [3,4,5].indexOf(c.max_clarification_rounds) < 0 || c.round_no > c.max_clarification_rounds || !Array.isArray(c.confirmed_summary))) return false
  if (!validGuidanceFields(c.fields,modern)) return false
  if (modern) {
    for (let i = 0; i < c.confirmed_summary.length; i++) { let item = c.confirmed_summary[i]; if (item == null || typeof item.label != 'string' || typeof item.value != 'string') return false }
    if (c.revisable_steps != null) {
      if (!Array.isArray(c.revisable_steps) || c.revisable_steps.length > 5) return false
      let seen : Array<string> = []
      for (let i = 0; i < c.revisable_steps.length; i++) { let old = c.revisable_steps[i]; if (old == null || typeof old.id != 'string' || seen.indexOf(old.id) >= 0 || typeof old.question != 'string' || old.choices == null || !validGuidanceFields(old.fields,true)) return false; seen.push(old.id) }
    }
  }
  return true
}
function validGuidanceFields(fields : any,modern : boolean) : boolean {
  if (!Array.isArray(fields) || fields.length == 0) return false
  if (modern && !(fields.length == 1 || (fields.length == 2 && fields.every((field : any) => field != null && field.type == 'date')))) return false
  let seen : Array<string> = []
  for (let i = 0; i < fields.length; i++) {
    let field = fields[i]; if (field == null || typeof field.key != 'string' || field.key.length == 0 || ['__proto__','prototype','constructor'].indexOf(field.key) >= 0 || seen.indexOf(field.key) >= 0 || typeof field.label != 'string') return false; seen.push(field.key)
    if (field.type == 'date') continue
    if (field.type != null && ['select','single_choice'].indexOf(field.type) < 0) return false
    if (!Array.isArray(field.options) || field.options.length == 0) return false
    let optionKeys : Array<string> = []
    for (let oi = 0; oi < field.options.length; oi++) { let option = field.options[oi]; if (option == null || typeof option.label != 'string' || typeof option.value != 'string' || optionKeys.indexOf(option.value) >= 0) return false; optionKeys.push(option.value) }
  }
  return true
}
function clearGuidance() : void { choices.value = {}; choiceLabels.value = {}; guidanceBusy.value = false; guidanceUnknown.value = false; revisingId.value = ''; guidanceSubmission = null }
function currentGuidanceFields() : Array<any> { if (clarification.value == null) return []; let c = clarification.value; if (revisingId.value.length > 0 && Array.isArray(c.revisable_steps)) { let old = c.revisable_steps.find((item : any) => item.id == revisingId.value); if (old != null) return old.fields }; return c.fields }
function currentGuidanceQuestion() : string { if (clarification.value == null) return ''; if (revisingId.value.length > 0) { let old = clarification.value.revisable_steps.find((item : any) => item.id == revisingId.value); if (old != null) return '修改：' + String(old.question) }; return String(clarification.value.question || '请选择本次要查询的内容') }
function editGuidance(old : any) : void { if (guidanceBusy.value || guidanceUnknown.value || closeRequestedState.value) return; revisingId.value = old.id; choices.value = {}; choiceLabels.value = {}; old.fields.forEach((field : any) => { if (typeof old.choices[field.key] == 'string') choices.value[field.key] = old.choices[field.key]; if (Array.isArray(field.options)) field.options.forEach((option : any) => { if (option.value == choices.value[field.key]) choiceLabels.value[field.key] = option.label }) }) }
function resetGuidanceChoices() : void { if (guidanceBusy.value || guidanceUnknown.value || closeRequestedState.value) return; clearGuidance() }
function selectDate(key : string,event : any) : void { if (!guidanceBusy.value && !guidanceUnknown.value && !closeRequestedState.value) choices.value[key] = event.detail.value }
function chooseValue(field : any,option : any) : void { if (guidanceBusy.value || guidanceUnknown.value || closeRequestedState.value) return; choices.value[field.key] = option.value; choiceLabels.value[field.key] = option.label }
function selectOption(field : any,event : any) : void { let option = field.options[Number(event.detail.value)]; if (option != null) chooseValue(field,option) }
function confirmChoices() : void {
  if (guidanceBusy.value || closeRequestedState.value || run == null || terminal() || run.status != 'WAITING_CLARIFICATION' || clarification.value == null || !mayWriteActiveRecord()) return
  let c = clarification.value
  if (guidanceSubmission == null) {
    let submittedChoices : any = {}; let invalid = false
    currentGuidanceFields().forEach((field : any) => { let value = choices.value[field.key]; if (typeof value != 'string' || value.length == 0) invalid = true; else submittedChoices[field.key] = value })
    if (invalid) { progress.value = '请完成当前选择或填写有效日期。'; return }
    let body : any = binding(); body.clarification_id = c.id; body.choices = submittedChoices
    if (c.schema_version == guidanceSchema) { body.schema_version = guidanceSchema; body.step_revision = c.step_revision; body.intent_revision = c.intent_revision; body.client_submission_id = id(); if (revisingId.value.length > 0) body.revise_clarification_id = revisingId.value }
    guidanceSubmission = body
  }
  let submitted = guidanceSubmission; guidanceBusy.value = true
  // A clarification is a new customer action.  Its latency excludes the time
  // spent reading the previous guidance, while still measuring the complete
  // post-confirmation execution until the verified answer is visible.
  clientDeliveryStartedAt = Date.now()
  startActiveRunStatus()
  // Persist before I/O. If the app is interrupted after sending but before a
  // response arrives, the identical client_submission_id remains available
  // for a safe idempotent retry after the next status read.
  persistActive()
  let source = run, expectedLifecycle = lifecycle
  mobileAiRequest('POST','/runs/' + source.run_id + '/clarify',submitted,(r : any) => {
    if (expectedLifecycle != lifecycle || run == null || run.run_id != source.run_id || run.generation != source.generation) return
    if (pauseForExpiredLogin(r)) return
    if (r.ok) {
      queuedClarificationId = c.id
      guidanceSubmission = null; guidanceUnknown.value = false; guidanceBusy.value = false
      accept(r.data)
      // A replay acknowledgement can keep the exact same Run version.  Save
      // its queued-step marker before the panel is closed or reloaded, then
      // continue polling until the worker publishes a different state.
      if (!terminal()) persistActive()
      if (!terminal()) schedulePoll()
      return
    }
    if (clarification.value == null || clarification.value.id != c.id || clarification.value.intent_revision != c.intent_revision || closeRequestedState.value) return
    guidanceBusy.value = false
    if (r.responseKnown) { guidanceSubmission = null; guidanceUnknown.value = false; progress.value = r.message; persistActive() }
    else { guidanceUnknown.value = true; progress.value = '提交结果暂未确认，请重试确认同一次选择。'; persistActive() }
    pauseForGuidance()
  })
}
function resumeActive(record : any) : void {
  conversation = record.conversation_id; run = record.run; pending = record.pending; clientDeliveryStartedAt = Number.isSafeInteger(record.client_delivery_started_at) && record.client_delivery_started_at > 0 ? record.client_delivery_started_at : Date.now(); if (pending != null && typeof pending.question == 'string') showActiveQuestion(pending.question); else { finishActiveRunStatus(); activeQuestion.value = ''; activeQuestionAnchor.value = ''; messageAnchor.value = '' }; queuedClarificationId = typeof record.queued_clarification_id == 'string' ? record.queued_clarification_id : ''; guidanceSubmission = validStoredGuidanceSubmission(record.guidance_submission) ? record.guidance_submission : null; closeRequested = record.close_requested === true; closeRequestedState.value = closeRequested; busy.value = true
  if (validResolvedRun(record.resolved_run)) { let all = load(); all.forEach((s : any) => { if (s.id == conversation) displayed.value = s.rounds || [] }); busy.value = false; return }
  // Only a late create acknowledgement can persist a terminal Run. Hydrate it
  // through the normal terminal renderer so a page switch never hides a real
  // result, while an explicit close has already cleared its record above.
  if (terminal()) { let completed = run; run = null; markResolvedRun(completed,true); accept(completed); return }
  // Claim the durable projection before I/O. On native route changes the old
  // entry can unmount after this replacement is already active; ownership is
  // what prevents its teardown write from discarding this page's local state.
  persistActive(false,true)
  if (run == null) { if (pending == null) { busy.value = false; clearActive(); return }; pending.client_session_id = sessionId; pending.window_token = bootstrap.window_token; persistActive(); busy.value = false; submit(); return }
  let source = run, expectedLifecycle = lifecycle
  mobileAiRequest('GET','/runs/' + source.run_id,binding(),(r : any) => {
    if (expectedLifecycle != lifecycle || run == null || run.run_id != source.run_id || run.generation != source.generation) return
    if (pauseForExpiredLogin(r)) return
    if (r.ok) {
      // A reload often reads exactly the last persisted version.  It still
      // represents an active Run and must continue polling even when accept
      // correctly rejects it as a duplicate projection.
      if (r.data != null && typeof r.data.progress == 'string') progress.value = r.data.progress
      accept(r.data)
      if (closeRequested) { cancelRun(); return }
      // A restored Run can have the same version as the locally persisted
      // snapshot.  Hydrate its current guidance explicitly because accept()
      // correctly ignores duplicate versions to protect against stale polls.
      let restoredClarificationId = run.clarification != null && typeof run.clarification.id == 'string' ? run.clarification.id : ''
      if (run.status == 'WAITING_CLARIFICATION' && clarification.value == null && queuedClarificationId != restoredClarificationId && validGuidance(run.clarification)) {
        clarification.value = run.clarification
        if (run.clarification.schema_version == guidanceSchema) activeGuidanceSchema = guidanceSchema
        pauseForGuidance()
      }
      // Retry only the exact saved submission for the step the server still
      // presents. A newer guidance step or final answer discards the old
      // local envelope instead of letting it mutate current intent.
      if (guidanceSubmission != null) {
        let c = clarification.value
        let same = c != null && guidanceSubmission.clarification_id == c.id && (c.schema_version != guidanceSchema || (guidanceSubmission.schema_version == guidanceSchema && guidanceSubmission.intent_revision == c.intent_revision && guidanceSubmission.step_revision == c.step_revision))
        if (same && queuedClarificationId.length == 0 && run.clarification_rejected !== true) { confirmChoices(); return }
        guidanceSubmission = null; persistActive()
      }
      if (!terminal() && needsCompatibilityExecution(run)) {
        if (pending != null) executeCompatibility(run,expectedLifecycle)
        else if (['READY','RECEIVED'].indexOf(String(run.status)) >= 0) { abandonUnavailableRun(); return }
      }
      if (!terminal() && (run.status != 'WAITING_CLARIFICATION' || closeRequestedState.value || (run.clarification != null && queuedClarificationId == run.clarification.id))) schedulePoll()
      return
    }
    if (unavailable(r)) { abandonUnavailableRun(); return }
    if (!r.responseKnown) { progress.value = closeRequestedState.value ? '暂未确认取消结果。' : '连接中断，正在重新确认任务状态。'; persistActive(); schedulePoll(); return }
    abandonUnavailableRun()
  })
}
// Bootstrap uses the same authentication failure path as active observation;
// a restore failure must never leave an invisible or endless waiting turn.
function bootstrapSession(restore : boolean = false) : void {
  let expectedLifecycle = lifecycle
  mobileAiRequest('GET','/bootstrap',{client_session_id:sessionId},(r : any) => {
    if (expectedLifecycle != lifecycle || pauseForExpiredLogin(r)) return
    if (!r.ok || r.data == null || r.data.enabled !== true) { if (restore) { stopQuestionWait(); progress.value = '暂未恢复查询，请重试发送。' }; return }
    bootstrap = r.data
    storageKey = 'mohe-ai:v1:' + encodeURIComponent(String(bootstrap.identity_key))
    runtimeKey = 'mohe-ai:v1:runtime:' + encodeURIComponent(String(bootstrap.identity_key))
    let record = activeRecord()
    if (!restore && record != null && record.session_id != sessionId) { sessionId = record.session_id; bootstrapSession(true); return }
    excelAvailable.value = bootstrap.capabilities != null && Array.isArray(bootstrap.capabilities.output_formats) && bootstrap.capabilities.output_formats.indexOf('screen_and_xlsx') >= 0
    enabled.value = true
    // A completed Run tombstone protects against late callbacks, but must not
    // reopen a different conversation after the merchant selected history.
    let selectedId = String(uni.getStorageSync(storageKey + ':current') || '')
    if (record != null && (!validResolvedRun(record.resolved_run) || selectedId.length == 0 || selectedId == record.conversation_id)) resumeActive(record)
    else if (restore) { busy.value = false; progress.value = '上一次任务已结束，可以继续提问。' }
  })
}
onMounted(() => { sessionId = id(); bootstrapSession(); expiryTimer = setInterval(() => { if (storageKey.length > 0 && !load().some((s : any) => s.id == conversation)) { displayed.value = []; progress.value = '会话已到期，请新建对话。' } },30000) })
// The entry is mounted on each merchant page.  Page navigation and native
// component recycling are not an instruction to abandon a customer's query;
// keep the durable run for the next page to resume.  Only the explicit
// “停止” and “关闭” actions call cancelRun().
onUnmounted(() => { lifecycle++; exportLifecycle++; persistActive(true); if (timer != null) clearTimeout(timer); if (expiryTimer != null) clearInterval(expiryTimer); finishActiveRunStatus() })
</script>
<style>
.ai-brand-tagline{display:block;width:100%;margin-top:4px;font-size:12px;line-height:18px;font-weight:400;color:#667085;text-align:center}
.ai-entry{position:fixed;right:24px;bottom:calc(92px + env(safe-area-inset-bottom));z-index:9999;width:60px;height:60px;border-radius:50%;box-shadow:0 10px 26px rgba(31,99,199,.32)}.ai-entry-icon{display:block;width:60px;height:60px;border-radius:50%}
.ai-panel{position:fixed;left:0;right:0;top:0;bottom:0;z-index:10000;box-sizing:border-box;background-color:#fff;display:flex;flex-direction:column;overflow:hidden;color:#111827}
.ai-workspace-head{flex:0 0 auto;padding:0 14px 8px;border-bottom:1px solid #dde2eb}.ai-title-row{position:relative;height:44px;width:100%;box-sizing:border-box;padding:0 44px;display:flex;flex-direction:row;align-items:center;justify-content:center}.ai-back-button{position:absolute;left:0;top:0;bottom:0;width:44px;display:flex;align-items:center;justify-content:center}.ai-back-button:active{background-color:#f2f5fa;border-radius:12px}.ai-back-chevron{font-size:34px;line-height:32px;font-weight:400}.ai-title{min-width:0;white-space:nowrap;font-size:20px;font-weight:700;letter-spacing:.01em;text-align:center}
/* 底部加号承载会话与导出操作，与顶部单行退出导航相互独立。 */
.ai-icon-action{position:relative;width:26px;height:26px}.ai-icon-action__stroke{position:absolute;left:4px;top:12px;width:18px;height:2px;border-radius:2px;background-color:#101827}.ai-icon-action__stroke--plus{transform:rotate(90deg)}
.ai-messages{min-height:0;flex:1;height:0;padding:0 36px}.ai-message{padding:0;margin:38px 0 48px;background-color:#fff}.ai-user-turn{max-width:82%;margin-left:auto;padding:16px 22px;background-color:#17191e;border-radius:27px 27px 6px 27px;color:#fff}.ai-answer-turn{padding:0;margin-top:20px}.ai-turn-label{display:none}.ai-question{display:block;color:#fff;font-size:20px;font-weight:400;line-height:1.55}.ai-message--active .ai-user-turn{margin-bottom:0}.ai-run-status{margin:26px 0 0;color:#98a0aa}.ai-run-elapsed{display:block;font-size:15px;line-height:1.5}.ai-run-thinking{display:block;margin-top:18px;padding-top:18px;border-top:1px solid #edf0f3;font-size:18px;line-height:1.5}.ai-reading-runway{min-height:520px;pointer-events:none}.ai-answer{display:block;color:#101827;font-size:24px;font-weight:400;line-height:1.75;white-space:pre-wrap}.ai-answer-presentation{display:block}.ai-answer-headline{display:block;color:#101827;font-size:25px;font-weight:600;line-height:1.55}.ai-number--count{color:#357a72}.ai-unit{font-size:14px;font-weight:400;margin-left:4px;color:#65758b}.ai-answer-section-group{margin-top:16px}.ai-answer-facts{display:flex;flex-direction:row;flex-wrap:wrap;gap:10px;margin-top:18px}.ai-answer-fact-wrap{min-width:0;width:calc(50% - 5px);flex-grow:0}.ai-answer-section{display:block;margin:4px 0 8px;color:#53647d;font-size:14px;font-weight:600}.ai-answer-fact{box-sizing:border-box;padding:13px 14px;border:1px solid #e2e8f0;border-radius:14px;background-color:#f6f9fd}.ai-answer-fact__label{display:block;color:#62708a;font-size:15px;line-height:1.5}.ai-answer-fact__value{display:block;margin-top:3px;color:#1f5f8b;font-size:24px;font-weight:600;line-height:1.35}.ai-note{font-size:15px;color:#758198;line-height:1.65}.ai-answer-period{display:block;margin-top:14px}.ai-answer-note{display:block;margin-top:4px}
.ai-card{padding:16px;margin-top:14px;background-color:#f6f9fd;border:1px solid #e2e8f0;border-radius:14px}.ai-card-label{display:block;margin-bottom:5px;color:#111827;font-size:18px;font-weight:500}.ai-number{display:block;font-size:28px;font-weight:600;color:#1f5f8b}.ai-card-detail-toggle{display:flex;flex-direction:row;align-items:center;margin-top:14px;padding:10px 0;color:#6c7890;font-size:16px}.ai-card-detail-chevron{margin-right:8px;font-size:27px;font-weight:300;line-height:16px}.ai-card-detail{display:block;margin-top:8px;white-space:pre-wrap;font-size:14px;line-height:1.8;color:#65758b}.ai-result-table{margin-top:30px;border-top:1px solid #d9dee7}.ai-result-table__row{display:flex;flex-direction:row;align-items:center;min-height:56px;border-bottom:1px solid #d9dee7}.ai-result-table__head{min-height:48px}.ai-result-table__cell{min-width:0;flex:1;box-sizing:border-box;padding:0 4px;color:#111827;font-size:17px;line-height:1.35;text-align:left}.ai-result-table__cell:last-child{text-align:right}.ai-result-table__head .ai-result-table__cell{color:#758198;font-size:15px}
.ai-footer{flex:0 0 auto;padding:12px 36px calc(22px + env(safe-area-inset-bottom));background-color:#fff}.ai-progress{display:block;margin-bottom:8px}.ai-composer{position:relative;box-sizing:border-box;min-height:56px;padding:8px 54px;border:1px solid #d4dbe7;border-radius:28px;background-color:#fff;box-shadow:0 4px 16px rgba(22,36,61,.04)}.ai-composer--expanded{padding:12px 54px 56px;border-radius:24px}
/* 加号菜单沿输入框上缘纵向排列，保留原生键盘和安全区；不另做平行业务入口。 */
.ai-composer-options{display:flex;flex-direction:column;box-sizing:border-box;width:100%;margin-bottom:10px;padding:14px;border:1px solid #e3e6eb;border-radius:20px;background-color:#fff;box-shadow:0 8px 30px rgba(22,36,61,.1)}
.ai-composer-options__head{display:flex;flex-direction:row;align-items:center;justify-content:space-between;margin-bottom:8px;color:#687386;font-size:14px}.ai-composer-options__close{width:32px;height:32px;margin:0;padding:0;border:0;background-color:transparent;color:#6b7280;font-size:24px;line-height:32px}.ai-composer-options__actions{display:flex;flex-direction:column;gap:4px}.ai-composer-option{display:flex;flex-direction:row;align-items:center;justify-content:space-between;box-sizing:border-box;width:100%;min-height:48px;margin:0;padding:0 12px;border:0;border-radius:12px;background-color:#fff;color:#111827;font-size:16px;text-align:left}.ai-composer-option--selected{background-color:#17191e;color:#fff}.ai-composer-option[disabled]{color:#a3aab5}.ai-composer-option__state{font-size:13px}.ai-composer-history__back{margin:0 0 6px;padding:6px 10px;border:0;background-color:transparent;color:#53647d;text-align:left;font-size:15px}.ai-composer-history__list{max-height:240px;height:240px}.ai-composer-history__item{display:block;box-sizing:border-box;width:100%;min-height:46px;margin:0;padding:10px 12px;border:0;border-bottom:1px solid #edf0f3;background-color:#fff;color:#111827;text-align:left;font-size:15px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ai-composer-history__item--current{background-color:#f1f4f8}.ai-composer-history__empty{display:block;padding:12px;color:#8792a2;font-size:14px}.ai-composer-option::after,.ai-composer-options__close::after,.ai-composer-history__back::after,.ai-composer-history__item::after{border:0}
.ai-composer-more{position:absolute;left:8px;bottom:8px;display:flex;align-items:center;justify-content:center;width:38px;height:38px;margin:0;padding:0;border:0;border-radius:50%;background-color:transparent;color:#111}.ai-composer-more--selected{background-color:#eeecff}.ai-composer-more::after,.ai-submit::after{border:0}.ai-input{box-sizing:border-box;min-height:38px;max-height:144px;width:100%;padding:5px 0;background-color:transparent;border:0;font-size:17px;line-height:28px}.ai-submit{position:absolute;right:8px;bottom:8px;display:flex;align-items:center;justify-content:center;width:38px;height:38px;margin:0;padding:0;border:0;border-radius:50%;background-color:#111;color:#fff;line-height:38px}.ai-submit[disabled]{background-color:#9eabbf;color:#fff}.ai-submit--stop{font-size:12px}.ai-icon-send{position:relative;width:27px;height:27px}.ai-icon-send__shaft{position:absolute;left:12px;top:3px;width:3px;height:21px;border-radius:3px;background-color:#fff}.ai-icon-send__head-left{position:absolute;left:8px;top:3px;width:3px;height:12px;border-radius:3px;background-color:#fff;transform:rotate(45deg)}.ai-icon-send__head-right{position:absolute;right:8px;top:3px;width:3px;height:12px;border-radius:3px;background-color:#fff;transform:rotate(-45deg)}.ai-choice{padding:8px;display:block;color:#1f63c7}
.ai-run-complete{display:block;margin-top:18px;color:#7a8493;font-size:15px;line-height:1.5}
/* 小程序问答正文参考同机手机阅读密度：提问、各类摘要及标题统一收敛；指标卡保留数值层级。 */
.ai-panel--native-mini .ai-messages{padding:0 20px}.ai-panel--native-mini .ai-message{margin:26px 0 34px}.ai-panel--native-mini .ai-answer-turn{margin-top:20px}.ai-panel--native-mini .ai-question{font-size:17px;line-height:1.6}.ai-panel--native-mini .ai-run-status{margin-top:20px}.ai-panel--native-mini .ai-run-elapsed{font-size:14px}.ai-panel--native-mini .ai-run-thinking{margin-top:14px;padding-top:14px;font-size:16px}.ai-panel--native-mini .ai-reading-runway{min-height:420px}.ai-panel--native-mini .ai-answer{font-size:17px;line-height:1.65}.ai-panel--native-mini .ai-answer-headline{font-size:19px;line-height:1.55}.ai-panel--native-mini .ai-card{padding:14px;margin-top:12px}.ai-panel--native-mini .ai-card-label{font-size:16px}.ai-panel--native-mini .ai-card-detail-toggle{font-size:14px}.ai-panel--native-mini .ai-footer{padding:8px 18px calc(14px + env(safe-area-inset-bottom))}.ai-panel--native-mini .ai-icon-send{width:24px;height:24px}.ai-panel--native-mini .ai-icon-send__shaft{left:11px;top:2px;height:20px}.ai-panel--native-mini .ai-icon-send__head-left{left:7px;top:2px}.ai-panel--native-mini .ai-icon-send__head-right{right:7px;top:2px}
/* 窄屏优先完整显示数值；只改变排版，不截断或重新计算指标。 */
@media (max-width:360px){.ai-answer-fact-wrap{width:100%}.ai-title{font-size:17px}}
/* 确认卡沿用黑白工作台，编号只作选项顺序，提交仍使用后端 option.value。 */
.ai-message.ai-guidance{padding:18px;border:1px solid #e5e5e7;border-radius:22px;background-color:#fff;margin-top:0}
.ai-guidance-head{display:flex;flex-direction:row;align-items:center;justify-content:space-between;color:#777;font-size:14px;margin-bottom:8px}
.ai-guidance-cancel{margin:0;padding:4px 0;background-color:transparent;color:#777;font-size:13px;line-height:24px}
.ai-guidance-cancel::after,.ai-guidance-option::after,.ai-guidance-confirm::after{border:0}
.ai-guidance-question{display:block;margin:10px 0 18px;color:#202124;font-size:17px;font-weight:600;line-height:1.65}
.ai-guidance-label{display:block;margin:12px 0 8px;color:#777;font-size:13px}
.ai-guidance-option{display:flex;flex-direction:row;align-items:center;box-sizing:border-box;width:100%;margin:6px 0;padding:12px;border:1px solid transparent;border-radius:16px;background-color:#fff;color:#202124;text-align:left;line-height:1.5}
.ai-guidance-option--selected{background-color:#f3f3f4;border-color:#d9d9dc}
.ai-guidance-number{flex-shrink:0;display:flex;align-items:center;justify-content:center;width:30px;height:30px;margin-right:12px;border:1px solid #dedee1;border-radius:50%;background-color:#f3f3f4;color:#737377;font-size:14px}
.ai-guidance-option-label{flex:1;min-width:0;font-size:16px;white-space:normal}
.ai-guidance-actions{display:flex;flex-direction:row;justify-content:flex-end;margin-top:18px}
.ai-guidance-confirm{margin:0;padding:0 18px;border-radius:24px;background-color:#17191e;color:#fff;font-size:15px;line-height:44px}
.ai-guidance-confirm[disabled]{background-color:#aaa;color:#fff}
.ai-guidance-error{display:block;margin-top:12px;color:#b42318;font-size:14px;line-height:1.5}
</style>
