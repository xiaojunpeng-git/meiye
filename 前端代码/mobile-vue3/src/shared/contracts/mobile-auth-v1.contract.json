{
  "contractVersion": "mobile-auth-v1",
  "errorContract": "mobile-api-errors-v1",
  "requestMetadataProfiles": {
    "PUBLIC": {
      "required": {"X-Mobile-Contract-Version": "contractVersion", "X-Mobile-Client-Session-Id": "clientSessionId", "X-Mobile-Platform": "platform", "X-Mobile-Request-Id": "requestId"},
      "forbidden": ["Authorization", "X-Mobile-App-Session", "Cookie", "queryToken", "bodyToken", "headerAlias"]
    }
  },
  "phoneVerificationMethods": ["SMS", "WECHAT_MINI_PROGRAM"],
  "endpoints": {
    "createCaptchaChallenge": {"method": "POST", "path": "/mobile/auth/captcha/challenges", "requestMetadataProfile": "PUBLIC"},
    "verifyCaptchaChallenge": {"method": "POST", "path": "/mobile/auth/captcha/verify", "requestMetadataProfile": "PUBLIC"},
    "createSmsChallenge": {
      "method": "POST", "path": "/mobile/auth/sms/challenges", "requestMetadataProfile": "PUBLIC",
      "request": {"required": ["phone", "purpose", "deviceId", "captchaProof", "idempotencyKey"], "purposeEnum": ["APP_LOGIN"], "phonePattern": "^1[3-9][0-9]{9}$"},
      "success": {"required": ["contractVersion", "challengeId", "maskedPhone", "expiresAt", "resendAfterSeconds"], "forbidden": ["code", "verificationCode", "providerPayload", "resendAfter"]},
      "clientRules": {"resendAfterSecondsType": "NON_NEGATIVE_INTEGER", "resendAuthority": "SERVER_RELATIVE_SECONDS", "expiresAtUse": "DISPLAY_ONLY"}
    },
    "verifySmsChallenge": {
      "method": "POST", "path": "/mobile/auth/sms/verify", "requestMetadataProfile": "PUBLIC",
      "request": {"required": ["challengeId", "code", "idempotencyKey"], "codeType": "STRING", "codePattern": "^[0-9]{6}$"},
      "success": {"required": ["contractVersion", "appSession", "phoneVerification", "availableModes"], "appSessionRequired": ["accessToken", "expiresAt"], "phoneVerificationRequired": ["status", "maskedPhone", "verifiedAt", "method", "verificationVersion"], "availableModesRequired": ["member", "merchant"]}
    }
  },
  "phoneVerification": {"verificationVersionSource": "identityVersion", "merchantEligibilitySeconds": 300},
  "security": {"ordinaryUserTokenProvesPhoneVerification": false, "clientPhoneParameterIsTrusted": false, "legacyPhoneConflictFailsClosed": true, "verificationVersionMustBePositive": true, "providerUnknownCreatesVerification": false}
}
