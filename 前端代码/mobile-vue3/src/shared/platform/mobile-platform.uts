export function currentMobilePlatform() : string {
	let platform = 'UNKNOWN'

	// #ifdef WEB
	platform = 'WEB'
	// #endif

	// #ifdef MP-WEIXIN
	platform = 'MP_WEIXIN'
	// #endif

	// #ifdef APP-ANDROID
	platform = 'APP_ANDROID'
	// #endif

	// #ifdef APP-IOS
	platform = 'APP_IOS'
	// #endif

	// #ifdef APP-HARMONY
	platform = 'APP_HARMONY'
	// #endif

	return platform
}

export function declaredPlatformCapabilityCount() : number {
	return declaredPlatformCapabilities().length
}

export function declaredPlatformCapabilities() : string[] {
	return [
		'STORAGE',
		'SAFE_AREA',
		'CLIPBOARD',
		'PHONE_CALL',
		'SCAN_CODE'
	]
}

export function showMobileNotice(title : string) : void {
	uni.showToast({ title: title, icon: 'none' })
}

export function chooseMobileImage(done : (filePath : string, message : string) => void) : void {
	uni.chooseImage({
		count: 1, sizeType: ['compressed'], sourceType: ['album', 'camera'],
		success: (result : any) => {
			let paths = result != null && Array.isArray(result.tempFilePaths) ? result.tempFilePaths : []
			done(paths.length > 0 ? String(paths[0]) : '', paths.length > 0 ? '' : '未选择头像图片。')
		},
		fail: () => done('', '未选择头像图片。')
	})
}

// A phone action is only an OS handoff.  It never changes a business task,
// creates a customer-care record, or reports a successful contact.
export function callMobilePhone(phone : string) : void {
	let value = String(phone || '').trim()
	if (value.length === 0) { showMobileNotice('会员没有可用手机号。'); return }
	uni.makePhoneCall({ phoneNumber: value })
}
