{
	"contractVersion": "merchant-root-policy-v1",
	"serverBeforeClient": true,
	"stateContextIdMustBeNonEmpty": true,
	"stateRevisionType": "STRING",
	"stateRevisionPattern": "^[1-9][0-9]*$",
	"successRootReasonCodes": [
		"READY",
		"BOOTSTRAPPED",
		"CONTEXT_SWITCHED"
	],
	"decisionOrder": [
		"REQUIRE_COMPLETE_ROOT_RESPONSE",
		"REQUIRE_SUPPORTED_CONTRACT_VERSION",
		"REQUIRE_INSTALLABLE_MERCHANT_IDENTITY",
		"REQUIRE_STATE_CONTEXT",
		"REQUIRE_VALID_STATE_REVISION",
		"REJECT_ORDINARY_RESPONSE_DURING_SWITCH_INTENT",
		"REQUIRE_EXPLICIT_SWITCH_TO_CHANGE_ANY_ROOT_CONTEXT",
		"VALIDATE_EXPLICIT_SWITCH_ROOT",
		"REJECT_STALE_REVISION_WITHIN_SAME_CONTEXT",
		"REJECT_DUPLICATE_REVISION_WITHIN_SAME_CONTEXT",
		"REJECT_STALE_REQUEST_GENERATION_BEFORE_INSTALL"
	],
	"contextRules": {
		"compareRevisionAcrossDifferentStateContexts": false,
		"ordinaryResponseCanChangeStateContext": false,
		"ordinaryResponseCanChangeActiveContextId": false,
		"ordinaryResponseCanChangeBusinessContextId": false,
		"explicitSwitchResponseCanChangeStateContext": true,
		"explicitSwitchMustRotateStateContextId": true,
		"explicitSwitchMustRotateActiveContextId": true,
		"explicitSwitchBusinessContextMustMatchTarget": true,
		"newStateContextInitialRevision": "1",
		"clearOldRootBeforeInstallingSwitchResponse": true,
		"clearResourceVersionStoreBeforeInstallingSwitchResponse": true,
		"oldContextMustBeRejectedByServer": true
	},
	"responseRules": {
		"onlyCompleteRootReplacementMayContainState": true,
		"queryMayContainState": false,
		"toastMayContainState": false,
		"navigationMayContainState": false
	},
	"generationRules": {
		"requestGenerationIsClientOnly": true,
		"requestGenerationType": "POSITIVE_INTEGER",
		"requestGenerationMayOverrideServerContextError": false,
		"staleGenerationMayInstallExplicitSwitch": false,
		"incrementOnAccountPhoneEmployeeStoreOrganizationOrModeChange": true
	},
	"merchantReadyInstallRequirements": {
		"completeMerchantRoot": true,
		"contractVersionMatches": true,
		"merchantTokenNonEmpty": true,
		"employeeActive": true,
		"authVersionPositive": true,
		"activeContextIdNonEmpty": true,
		"stateContextIdNonEmpty": true,
		"stateRevisionValid": true,
		"activeBusinessContextIdNonEmpty": true,
		"activeContextAppearsExactlyOnceInContexts": true,
		"contextIdsUnique": true,
		"capabilitiesArray": true,
		"availableActionsArray": true,
		"dataScopeAuthorized": true,
		"scopeEntryCountPositive": true,
		"scopeDigestNonEmpty": true
	},
	"rootStateAllowedFields": [
		"platform",
		"appSession",
		"phoneVerification",
		"modeState",
		"merchantSession",
		"activeContextId",
		"activeContext",
		"contexts",
		"capabilities",
		"dataScope",
		"availableActions",
		"stateContextId",
		"stateRevision",
		"requestGeneration"
	],
	"businessResourceStateAllowedInRoot": false,
	"clearMerchantRootFields": [
		"merchantSession",
		"merchantToken",
		"expiresAt",
		"employee",
		"authVersion",
		"activeContextId",
		"activeContext",
		"contexts",
		"capabilities",
		"dataScope",
		"availableActions",
		"reasonCode",
		"stateContextId",
		"stateRevision"
	],
	"merchantSessionInvalidTarget": "MEMBER_READY",
	"appOrPhoneIdentityInvalidTarget": "SESSION_INVALID"
}
